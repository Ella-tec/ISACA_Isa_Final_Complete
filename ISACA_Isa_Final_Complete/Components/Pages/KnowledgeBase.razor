@page "/knowledge-base"
@rendermode InteractiveServer
<PageTitle>Knowledge Base | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">RESOURCES</p>
            <h1>Knowledge base</h1>
            <p class="isa-intro">Find approved guidance, chapter resources, and support articles — search and filter by topic.</p>
        </div>
        <span class="isa-pill">Sample catalog</span>
    </div>

    <div class="isa-notice">This page currently uses sample article metadata. Connect your approved content repository to enable authoritative document search.</div>

    <div class="isa-searchbar">
        <span aria-hidden="true">⌕</span>
        <InputText class="form-control" @bind-Value="SearchTerm" placeholder="Search articles, topics, or keywords..." />
        <InputSelect class="form-select" @bind-Value="SelectedCategory">
            <option value="All">All categories</option>
            <option>Membership</option>
            <option>Events</option>
            <option>Certification</option>
            <option>Policies</option>
            <option>Technology</option>
            <option>Governance</option>
        </InputSelect>
    </div>

    <div class="isa-stat-grid isa-stat-grid--three">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">▤</span>
            <span class="isa-stat-label">Articles</span>
            <strong>@Articles.Count</strong>
            <small>Demo catalog</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">◉</span>
            <span class="isa-stat-label">Categories</span>
            <strong>@Articles.Select(a => a.Category).Distinct().Count()</strong>
            <small>Organized by topic</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon purple">✓</span>
            <span class="isa-stat-label">Matching</span>
            <strong>@FilteredArticles.Count</strong>
            <small>Current filters</small>
        </article>
    </div>

    <div class="isa-article-grid">
        @foreach (var article in FilteredArticles)
        {
            <article class="isa-article-card">
                <div class="isa-article-top">
                    <span class="isa-article-icon">@article.Icon</span>
                    <span class="isa-pill">@article.Category</span>
                </div>
                <h2>@article.Title</h2>
                <p>@article.Description</p>
                <div class="isa-article-bottom">
                    <span>Updated @article.Updated</span>
                    <button class="isa-text-button" @onclick="() => SelectedArticle = article">View details ↗</button>
                </div>
            </article>
        }
    </div>

    @if (FilteredArticles.Count == 0)
    {
        <div class="isa-empty">No sample articles match your search. Try a different keyword or category.</div>
    }

    @if (SelectedArticle is not null)
    {
        <div class="isa-modal-backdrop" role="presentation" @onclick="() => SelectedArticle = null">
            <section class="isa-modal" role="dialog" aria-modal="true" aria-label="Article details" @onclick:stopPropagation="true">
                <button class="isa-modal-close" @onclick="() => SelectedArticle = null" aria-label="Close">×</button>
                <span class="isa-pill">@SelectedArticle.Category</span>
                <h2 style="margin-top:.6rem">@SelectedArticle.Title</h2>
                <p>@SelectedArticle.Description</p>
                <div style="margin:1rem 0;padding:1rem;background:#f4f7fb;border-radius:10px;font-size:.88rem">
                    <strong>Sample preview content</strong>
                    <p style="margin:.4rem 0 0;color:var(--isa-muted)">
                        This is placeholder body text. In production, Isa would surface approved excerpts
                        from your chapter guidance library with source citations and last-reviewed dates.
                    </p>
                </div>
                <div style="display:flex;gap:.5rem;flex-wrap:wrap">
                    <span class="isa-badge isa-badge--blue">Updated @SelectedArticle.Updated</span>
                    <span class="isa-badge isa-badge--gray">Sample only</span>
                </div>
                <p class="isa-muted" style="margin-top:1rem;font-size:.82rem">
                    Replace with approved article content and citations before production use.
                </p>
            </section>
        </div>
    }
</section>

@code {
    private string SearchTerm = "";
    private string SelectedCategory = "All";
    private Article? SelectedArticle;

    private List<Article> Articles = new()
    {
        new() { Title = "Membership support basics", Category = "Membership", Description = "Common membership questions, renewal steps, and where to request help.", Updated = "Oct 2026", Icon = "👤" },
        new() { Title = "Planning a chapter event", Category = "Events", Description = "A starter checklist for event planning, registration, and follow-up.", Updated = "Oct 2026", Icon = "▦" },
        new() { Title = "Certification pathways", Category = "Certification", Description = "A high-level guide to exploring ISACA certification resources.", Updated = "Sep 2026", Icon = "🎓" },
        new() { Title = "Content review policy", Category = "Policies", Description = "Sample review workflow for validating content before publication.", Updated = "Sep 2026", Icon = "✓" },
        new() { Title = "Troubleshooting access", Category = "Technology", Description = "Basic steps for documenting an access issue and requesting support.", Updated = "Aug 2026", Icon = "⚙" },
        new() { Title = "Chapter communications", Category = "Membership", Description = "Guidance for clear, consistent member communications.", Updated = "Aug 2026", Icon = "✉" },
        new() { Title = "Board officer handbook overview", Category = "Governance", Description = "Roles, responsibilities, and key deadlines for chapter leaders.", Updated = "Oct 2026", Icon = "📋" },
        new() { Title = "CPE reporting guide", Category = "Certification", Description = "How to report continuing professional education hours for events.", Updated = "Sep 2026", Icon = "📊" }
    };

    private List<Article> FilteredArticles => Articles
        .Where(a => (SelectedCategory == "All" || a.Category == SelectedCategory) &&
                    (string.IsNullOrWhiteSpace(SearchTerm) ||
                     (a.Title + " " + a.Description + " " + a.Category).Contains(SearchTerm, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    private sealed class Article
    {
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Description { get; set; } = "";
        public string Updated { get; set; } = "";
        public string Icon { get; set; } = "▤";
    }
}
