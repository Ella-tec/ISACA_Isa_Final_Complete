@page "/events"
@rendermode InteractiveServer
<PageTitle>Events & Calendar | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">CHAPTER EXPERIENCE</p>
            <h1>Events & calendar</h1>
            <p class="isa-intro">Keep chapter activities, webinars, and learning opportunities organized in one place.</p>
        </div>
        <button class="isa-btn isa-btn--primary" @onclick="() => ShowForm = !ShowForm">
            @(ShowForm ? "Hide form" : "+ Add event")
        </button>
    </div>

    <div class="isa-notice">Events shown here are sample entries stored in memory for this demo. They are not published to an external calendar.</div>

    <div class="isa-stat-grid isa-stat-grid--three">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">▦</span>
            <span class="isa-stat-label">Upcoming</span>
            <strong>@EventsList.Count(e => e.Date >= DateTime.Today)</strong>
            <small>Scheduled events</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">◉</span>
            <span class="isa-stat-label">This month</span>
            <strong>@EventsList.Count(e => e.Date.Month == DateTime.Today.Month && e.Date.Year == DateTime.Today.Year)</strong>
            <small>@DateTime.Today.ToString("MMMM")</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon purple">文</span>
            <span class="isa-stat-label">Online</span>
            <strong>@EventsList.Count(e => e.Location.Contains("Online", StringComparison.OrdinalIgnoreCase))</strong>
            <small>Virtual sessions</small>
        </article>
    </div>

    @if (ShowForm)
    {
        <article class="isa-panel" style="margin-bottom:1.25rem">
            <div class="isa-panel-heading">
                <div><h2>Add an event</h2><p>Create a local sample event for this session</p></div>
            </div>
            <EditForm Model="NewEvent" OnValidSubmit="AddEvent">
                <div class="isa-form-grid">
                    <label class="isa-field">Event name <InputText class="form-control" @bind-Value="NewEvent.Title" /></label>
                    <label class="isa-field">Date <InputDate class="form-control" @bind-Value="NewEvent.Date" /></label>
                    <label class="isa-field">Event type
                        <InputSelect class="form-select" @bind-Value="NewEvent.Type">
                            <option>Webinar</option>
                            <option>Networking</option>
                            <option>Workshop</option>
                            <option>Meeting</option>
                            <option>Conference</option>
                        </InputSelect>
                    </label>
                    <label class="isa-field">Location / link <InputText class="form-control" @bind-Value="NewEvent.Location" /></label>
                </div>
                <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem">
                    <button class="isa-btn isa-btn--primary" type="submit">Add event</button>
                    @if (!string.IsNullOrWhiteSpace(Message))
                    {
                        <span class="isa-success" role="status">@Message</span>
                    }
                </div>
            </EditForm>
        </article>
    }

    <div class="isa-content-grid">
        <article class="isa-panel">
            <div class="isa-panel-heading">
                <div><h2>Upcoming events</h2><p>@EventsList.Count event(s) in this sample list</p></div>
                <InputSelect class="form-select isa-status-select" @bind-Value="TypeFilter" style="min-width:130px">
                    <option value="">All types</option>
                    <option>Webinar</option>
                    <option>Networking</option>
                    <option>Workshop</option>
                    <option>Meeting</option>
                    <option>Conference</option>
                </InputSelect>
            </div>
            @foreach (var ev in FilteredEvents)
            {
                <div class="isa-event-row">
                    <div class="isa-event-date">
                        <strong>@ev.Date.ToString("dd")</strong>
                        <span>@ev.Date.ToString("MMM")</span>
                    </div>
                    <div class="isa-event-copy">
                        <strong>@ev.Title</strong>
                        <span>@ev.Type · @ev.Location</span>
                    </div>
                    <span class="isa-pill">@ev.Date.ToString("ddd")</span>
                    <button type="button" class="isa-btn isa-btn--ghost" style="padding:.25rem .5rem;font-size:.75rem" @onclick="() => RemoveEvent(ev)" title="Remove">✕</button>
                </div>
            }
            @if (!FilteredEvents.Any())
            {
                <div class="isa-empty">No events match the selected filter.</div>
            }
        </article>

        <article class="isa-panel">
            <div class="isa-panel-heading">
                <div><h2>By type</h2><p>Distribution of sample events</p></div>
            </div>
            @foreach (var g in EventsList.GroupBy(e => e.Type).OrderByDescending(g => g.Count()))
            {
                var pct = EventsList.Count == 0 ? 0 : (int)Math.Round(100.0 * g.Count() / EventsList.Count);
                <div class="isa-category-row">
                    <div><span>@g.Key</span><strong>@g.Count()</strong></div>
                    <div class="isa-progress"><span style="width:@($"{pct}%")"></span></div>
                </div>
            }
            <h3 class="isa-subheading">Planning tips</h3>
            <ul class="isa-action-list">
                <li>Publish registration links at least 3 weeks ahead</li>
                <li>Collect CPE eligibility details before the event</li>
                <li>Send a reminder 48 hours prior</li>
                <li>Log attendance for chapter reporting</li>
            </ul>
        </article>
    </div>
</section>

@code {
    private bool ShowForm;
    private string TypeFilter = "";
    private string? Message;

    private List<ChapterEvent> EventsList = new()
    {
        new() { Title = "ISACA Chapter Meetup", Date = DateTime.Today.AddDays(5), Type = "Networking", Location = "Kansas City" },
        new() { Title = "Security Awareness Webinar", Date = DateTime.Today.AddDays(12), Type = "Webinar", Location = "Online" },
        new() { Title = "Career Development Workshop", Date = DateTime.Today.AddDays(19), Type = "Workshop", Location = "Online" },
        new() { Title = "Board planning meeting", Date = DateTime.Today.AddDays(8), Type = "Meeting", Location = "Hybrid" },
        new() { Title = "CPE Lunch & Learn", Date = DateTime.Today.AddDays(26), Type = "Webinar", Location = "Online" }
    };

    private ChapterEvent NewEvent = new() { Date = DateTime.Today.AddDays(7), Type = "Webinar" };

    private IEnumerable<ChapterEvent> FilteredEvents => EventsList
        .Where(e => string.IsNullOrWhiteSpace(TypeFilter) || e.Type == TypeFilter)
        .OrderBy(e => e.Date);

    private void AddEvent()
    {
        if (string.IsNullOrWhiteSpace(NewEvent.Title))
        {
            Message = "Please enter an event name.";
            return;
        }
        EventsList.Add(new ChapterEvent
        {
            Title = NewEvent.Title.Trim(),
            Date = NewEvent.Date,
            Type = NewEvent.Type,
            Location = string.IsNullOrWhiteSpace(NewEvent.Location) ? "To be confirmed" : NewEvent.Location.Trim()
        });
        Message = $"Added “{NewEvent.Title}” to this session's sample list.";
        NewEvent = new ChapterEvent { Date = DateTime.Today.AddDays(7), Type = "Webinar" };
    }

    private void RemoveEvent(ChapterEvent ev)
    {
        EventsList.Remove(ev);
        Message = $"Removed “{ev.Title}”.";
    }

    private sealed class ChapterEvent
    {
        public string Title { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        public string Type { get; set; } = "Webinar";
        public string Location { get; set; } = "";
    }
}
