
# ==========================================
# ISA Chat App - Git Ignore
# ==========================================

# Build output (regenerated by dotnet build / dotnet run)
bin/
obj/
publish/

# Runtime files from isa-run.ps1 / start-isa.bat
*.log
isa.pid

# Old backup copies of files
*.bak
*.bak2

# Visual Studio local settings
.vs/

# Local databases (rebuilt or created at runtime)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
data/stale-*.old

# Loose stray folders at the repository root
/IsaChatApp/
/Web/

# Real API keys and secrets
# Copy dev-keys.example.json to dev-keys.json for local use
dev-keys.json

# Local configuration files may contain passwords,
# connection strings, or API keys
appsettings.json
appsettings.Development.json

# Local Keycloak passwords and credentials
keycloak/dev-passwords.local.csv
/keycloak/import/isa-realm.json

# Local account data
/directory/keycloak_accounts.csv

# Zip made to send the Keycloak folder to a teammate
keycloak.zip
