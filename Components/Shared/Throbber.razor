@* Floating bubble + chat badge brand mark *@
<div class="tru-throbber @(Spinning ? "is-spin" : null) @(SpinOnHover ? "hover-spin" : null) @CssClass"
     style="@Style" role="status" aria-label="@Label">
    <span class="tru-throbber__ring" aria-hidden="true"></span>
    <span class="tru-throbber__word">TRU</span>
</div>

@code {
    [Parameter] public bool Spinning { get; set; }
    [Parameter] public bool SpinOnHover { get; set; }
    [Parameter] public string Label { get; set; } = "TRU Ask";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string? Color { get; set; }
    [Parameter] public double Size { get; set; } = 64;
}
