@* ============================================================
   IsaRail.razor

   Slim rail on the left of the chat.
     Hide      — tucks the rail away
     Today     — first-90-days window (if shown)
     Notebook  — succession notebook (if shown)
     Backstage — Config / dashboards for staff roles only
   ============================================================ *@

<nav class="isa-rail @(Closing ? "is-closing" : "")" style="@Style" aria-label="Isa menu">
    <button type="button" class="isa-rail__btn isa-rail__hide" @onclick="OnHide"
            title="Hide the menu" aria-label="Hide the menu">
        <svg viewBox="0 0 24 24" class="isa-rail__hideIcon" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 6l-6 6 6 6M19 5v14" />
        </svg>
        <span class="isa-rail__label">Hide</span>
    </button>

    <ul class="isa-rail__list">
        @if (ShowToday)
        {
            <li>
                <button type="button" class="isa-rail__btn isa-rail__btn--today" @onclick="OnToggleToday"
                        aria-pressed="@(TodayOpen ? "true" : "false")"
                        title="@(TodayOpen ? "Close Today" : "Open Today")"
                        aria-label="@TodayLabel">
                    <span class="isa-rail__tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <rect x="3" y="4.5" width="18" height="16" rx="2.5" />
                            <path d="M3 9.5h18M8 2.5v4M16 2.5v4" />
                        </svg>
                        @if (StepsLeftToday > 0)
                        {
                            <span class="isa-rail__count" aria-hidden="true">@StepsLeftToday</span>
                        }
                    </span>
                    <span class="isa-rail__label">Today</span>
                </button>
            </li>
        }
        @if (ShowNotebook)
        {
            <li>
                <button type="button" class="isa-rail__btn isa-rail__btn--notebook" @onclick="OnToggleNotebook"
                        aria-pressed="@(NotebookOpen ? "true" : "false")"
                        title="@(NotebookOpen ? "Close the notebook" : "Open the succession notebook")"
                        aria-label="Notebook">
                    <span class="isa-rail__tile">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3Z" />
                            <path d="M5 17a3 3 0 0 1 3-3h11" />
                            <path d="M9 8h6" />
                        </svg>
                    </span>
                    <span class="isa-rail__label">Notebook</span>
                </button>
            </li>
        }
    </ul>

    @if (Backstage.Count > 0)
    {
        <div class="isa-rail__backstage">
            <button type="button" class="isa-rail__btn isa-rail__btn--backstage" @onclick="ToggleBackstage"
                    aria-expanded="@(_backstageOpen ? "true" : "false")" aria-haspopup="menu"
                    title="Backstage: Config and dashboards" aria-label="Backstage: Config and dashboards">
                <span class="isa-rail__tile">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
                        <rect x="3.5" y="3.5" width="7" height="9" rx="1.5" />
                        <rect x="13.5" y="3.5" width="7" height="5" rx="1.5" />
                        <rect x="13.5" y="11.5" width="7" height="9" rx="1.5" />
                        <rect x="3.5" y="15.5" width="7" height="5" rx="1.5" />
                    </svg>
                </span>
                <span class="isa-rail__label">Backstage</span>
            </button>
            @if (_backstageOpen)
            {
                <div class="isa-rail__menu" role="menu" aria-label="Backstage">
                    @foreach (var item in Backstage)
                    {
                        <button type="button" class="isa-rail__menuItem" role="menuitem" @onclick="() => PickBackstage(item.Path)">@item.Name</button>
                    }
                </div>
            }
        </div>
    }
</nav>

@code {
    public record BackstageItem(string Name, string Path);

    [Parameter] public string? Style { get; set; }
    [Parameter] public bool Closing { get; set; }
    [Parameter] public bool ShowToday { get; set; }
    [Parameter] public bool ShowNotebook { get; set; }
    [Parameter] public int StepsLeftToday { get; set; }
    [Parameter] public bool TodayOpen { get; set; }
    [Parameter] public bool NotebookOpen { get; set; }
    [Parameter] public IReadOnlyList<BackstageItem> Backstage { get; set; } = Array.Empty<BackstageItem>();

    [Parameter] public EventCallback OnHide { get; set; }
    [Parameter] public EventCallback OnToggleToday { get; set; }
    [Parameter] public EventCallback OnToggleNotebook { get; set; }
    [Parameter] public EventCallback<string> OnOpenBackstage { get; set; }

    private string TodayLabel => StepsLeftToday switch
    {
        0 => "Today",
        1 => "Today, 1 step for today",
        _ => $"Today, {StepsLeftToday} steps for today"
    };

    private bool _backstageOpen;
    private void ToggleBackstage() => _backstageOpen = !_backstageOpen;

    private async Task PickBackstage(string path)
    {
        _backstageOpen = false;
        await OnOpenBackstage.InvokeAsync(path);
    }
}
