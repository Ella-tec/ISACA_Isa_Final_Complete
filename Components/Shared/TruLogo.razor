@* TRU brand sphere — rotating rings + color glow *@
<svg class="tru-logo @CssClass" viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="TRU">
  <defs>
    <linearGradient id="core-@Id" x1="20%" y1="10%" x2="80%" y2="90%">
      <stop offset="0%" stop-color="#1d2d5c">
        <animate attributeName="stop-color" values="#1d2d5c;#00a4e4;#07649d;#36ac91;#6cb33f;#00a4e4;#1d2d5c" dur="8s" repeatCount="indefinite" />
      </stop>
      <stop offset="45%" stop-color="#00a4e4">
        <animate attributeName="stop-color" values="#00a4e4;#36ac91;#6cb33f;#07649d;#1d2d5c;#00a4e4" dur="8s" repeatCount="indefinite" />
      </stop>
      <stop offset="100%" stop-color="#36ac91">
        <animate attributeName="stop-color" values="#36ac91;#6cb33f;#00a4e4;#1d2d5c;#07649d;#36ac91" dur="8s" repeatCount="indefinite" />
      </stop>
    </linearGradient>
    <linearGradient id="ring1-@Id" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#1d2d5c"/>
      <stop offset="50%" stop-color="#00a4e4"/>
      <stop offset="100%" stop-color="#6cb33f"/>
    </linearGradient>
    <linearGradient id="ring2-@Id" x1="100%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#6cb33f"/>
      <stop offset="50%" stop-color="#36ac91"/>
      <stop offset="100%" stop-color="#00a4e4"/>
    </linearGradient>
    <filter id="soft-@Id" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#00a4e4" flood-opacity="0.45"/>
    </filter>
  </defs>
  <circle cx="60" cy="60" r="52" fill="url(#core-@Id)" filter="url(#soft-@Id)" opacity="0.96"/>
  <g class="tru-logo__orbit">
    <ellipse cx="60" cy="60" rx="48" ry="28" fill="none" stroke="url(#ring1-@Id)" stroke-width="5" opacity="0.9" transform="rotate(-28 60 60)">
      <animateTransform attributeName="transform" type="rotate" from="-28 60 60" to="332 60 60" dur="10s" repeatCount="indefinite" />
    </ellipse>
    <ellipse cx="60" cy="60" rx="46" ry="26" fill="none" stroke="url(#ring2-@Id)" stroke-width="4" opacity="0.8" transform="rotate(42 60 60)">
      <animateTransform attributeName="transform" type="rotate" from="42 60 60" to="-318 60 60" dur="14s" repeatCount="indefinite" />
    </ellipse>
    <ellipse cx="60" cy="60" rx="44" ry="22" fill="none" stroke="#e8f7ff" stroke-width="2.5" opacity="0.55" transform="rotate(-8 60 60)">
      <animateTransform attributeName="transform" type="rotate" from="-8 60 60" to="352 60 60" dur="18s" repeatCount="indefinite" />
    </ellipse>
  </g>
  <text x="60" y="68" text-anchor="middle" font-family="Roboto Slab, Georgia, serif" font-weight="700" font-size="28" fill="#ffffff" letter-spacing="1">TRU</text>
</svg>
@code {
    [Parameter] public string CssClass { get; set; } = "";
    private string Id { get; } = Guid.NewGuid().ToString("N")[..6];
}
