@page "/governance"
@rendermode InteractiveServer

<PageTitle>Governance & Policies | Isa</PageTitle>

<style>
.gov{--navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;--purple:#6558b1;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);max-width:1220px;margin:0 auto;padding-bottom:2rem}
.gov-hero{border-radius:20px;padding:1.75rem 2rem;color:#fff;margin-bottom:1rem;width:100%;box-sizing:border-box;
background:linear-gradient(115deg,#6558b1 0%,#1d2d5c 50%,#07649d 100%);box-shadow:0 16px 44px rgba(29,45,92,.18)}
.gov-hero h1{margin:.2rem 0 .35rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.9rem}
.gov-hero p{margin:0;opacity:.92;max-width:52ch;line-height:1.45}
.gov-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:.75rem;margin-bottom:1rem}
.gov-kpi{background:#fff;border-radius:16px;padding:1.15rem;border:1px solid var(--line);box-shadow:0 8px 24px rgba(29,45,92,.06);
cursor:pointer;text-align:left;font-family:inherit;color:inherit;transition:transform .12s,border-color .12s}
.gov-kpi:hover{transform:translateY(-2px);border-color:var(--blue)}
.gov-kpi.on{border-color:var(--purple);box-shadow:0 0 0 2px rgba(101,88,177,.28)}
.gov-kpi .l{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.gov-kpi .v{font-size:1.55rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;margin:.15rem 0}
.gov-kpi .t{font-size:.8rem;color:var(--muted)}
.gov-detail{background:#f0eef8;border-radius:14px;padding:1rem 1.2rem;margin-bottom:1rem;border:1px solid #d5d0ea;font-size:.9rem;line-height:1.45}
.gov-grid{display:grid;grid-template-columns:1.2fr 1fr;gap:.85rem;margin-bottom:1rem}
.gov-card{background:#fff;border-radius:16px;padding:1.2rem;border:1px solid var(--line);box-shadow:0 8px 24px rgba(29,45,92,.06)}
.gov-card h2{margin:0 0 .25rem;font-size:1.05rem}
.gov-card .sub{margin:0 0 .75rem;font-size:.82rem;color:var(--muted)}
.gov-row{display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.7rem 0;border-bottom:1px solid var(--line)}
.gov-row:last-child{border-bottom:0}
.gov-row strong{display:block;font-size:.92rem}
.gov-row small{color:var(--muted);font-size:.8rem}
.gov-btn{border:none;cursor:pointer;padding:.4rem .85rem;border-radius:9px;font-weight:600;font-size:.82rem;font-family:inherit;
background:linear-gradient(135deg,var(--navy),var(--purple));color:#fff}
.gov-btn-g{background:var(--light);color:var(--navy);border:1px solid var(--line)}
.gov-bars{display:flex;align-items:flex-end;gap:8px;height:120px;margin:.5rem 0 1.3rem}
.gov-bar{flex:1;border-radius:7px 7px 3px 3px;background:linear-gradient(180deg,var(--purple),var(--mid));cursor:pointer;min-height:10px;border:none;padding:0;position:relative}
.gov-bar:hover{filter:brightness(1.1)}
.gov-bar span{position:absolute;bottom:-1.2rem;left:50%;transform:translateX(-50%);font-size:.65rem;color:var(--muted);white-space:nowrap}
.gov-check{display:flex;align-items:flex-start;gap:.5rem;padding:.4rem 0;font-size:.88rem}
.gov-check input{margin-top:.2rem}
.gov-search{width:100%;box-sizing:border-box;padding:.55rem .75rem;border-radius:10px;border:1px solid var(--line);font-family:inherit;margin-bottom:.75rem}
@@media(max-width:900px){.gov-kpis{grid-template-columns:1fr 1fr}.gov-grid{grid-template-columns:1fr}}
</style>

<section class="gov">
    <header class="gov-hero">
        <div style="font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">Trust &amp; compliance</div>
        <h1>Governance &amp; policies</h1>
        <p>Policy register and review calendar — every metric is a button. Charts and rows open detail and actions.</p>
    </header>

    <div class="gov-kpis">
        <button type="button" class="gov-kpi @(focus=="all"?"on":null)" @onclick='() => SetFocus("all")'>
            <div class="l">Policy records</div><div class="v">@total</div><div class="t">In register →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="ok"?"on":null)" @onclick='() => SetFocus("ok")'>
            <div class="l">Approved</div><div class="v">@approved</div><div class="t">Current →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="rev"?"on":null)" @onclick='() => SetFocus("rev")'>
            <div class="l">Needs review</div><div class="v">@needs</div><div class="t">Action →</div>
        </button>
        <button type="button" class="gov-kpi @(focus=="next"?"on":null)" @onclick='() => SetFocus("next")'>
            <div class="l">Next review</div><div class="v">@nextLabel</div><div class="t">@nextYear →</div>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(detail))
    {
        <div class="gov-detail">@detail</div>
    }

    <div class="gov-grid">
        <article class="gov-card">
            <h2>Policy register</h2>
            <p class="sub">Filter and open policies</p>
            <input class="gov-search" @bind="search" @bind:event="oninput" placeholder="Search policies…" />
            @foreach (var p in Filtered)
            {
                <div class="gov-row">
                    <div>
                        <strong>@p.Title</strong>
                        <small>@p.Owner · @p.Status</small>
                    </div>
                    <button type="button" class="gov-btn" @onclick="() => OpenPolicy(p)">Open</button>
                </div>
            }
            <div style="margin-top:1.1rem">
                <h2 style="font-size:.95rem">Review load by quarter</h2>
                <div class="gov-bars">
                    @foreach (var q in quarters)
                    {
                        <button type="button" class="gov-bar" style="height:@q.H%" @onclick="() => ShowQuarter(q)">
                            <span>@q.Label</span>
                        </button>
                    }
                </div>
            </div>
        </article>
        <article class="gov-card">
            <h2>Review calendar</h2>
            <p class="sub">Upcoming policy reviews</p>
            @foreach (var c in calendar)
            {
                <div class="gov-row">
                    <div>
                        <strong>@c.Title</strong>
                        <small>@c.When · @c.Owner</small>
                    </div>
                    <button type="button" class="gov-btn gov-btn-g" @onclick="() => Plan(c)">Plan</button>
                </div>
            }
            <h2 style="font-size:.95rem;margin:1.1rem 0 .5rem">Suggested review checklist</h2>
            @foreach (var ck in checks)
            {
                <label class="gov-check">
                    <input type="checkbox" @bind="ck.Done" />
                    <span>@ck.Text</span>
                </label>
            }
            <p class="sub" style="margin-top:.5rem">Checklist is session-local and resets on restart.</p>
            <div style="margin-top:.75rem;display:flex;gap:.4rem;flex-wrap:wrap">
                <a class="gov-btn" href="content-health">Content health</a>
                <a class="gov-btn gov-btn-g" href="knowledge-base">Related articles</a>
            </div>
        </article>
    </div>
</section>

@code {
    private string focus = "all";
    private string detail = "";
    private string search = "";
    private string nextLabel = "Nov";
    private string nextYear = "2026";
    private int total = 5, approved = 3, needs = 2;

    private sealed class Policy
    {
        public string Title { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Status { get; set; } = "";
    }
    private sealed class CalItem
    {
        public string Title { get; set; } = "";
        public string When { get; set; } = "";
        public string Owner { get; set; } = "";
    }
    private sealed class Quarter
    {
        public string Label { get; set; } = "";
        public int H { get; set; }
        public string Note { get; set; } = "";
    }
    private sealed class Check
    {
        public string Text { get; set; } = "";
        public bool Done { get; set; }
    }

    private List<Policy> policies = new();
    private List<CalItem> calendar = new();
    private List<Quarter> quarters = new();
    private List<Check> checks = new();

    private IEnumerable<Policy> Filtered =>
        string.IsNullOrWhiteSpace(search)
            ? policies
            : policies.Where(p => p.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
                || p.Owner.Contains(search, StringComparison.OrdinalIgnoreCase)
                || p.Status.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        policies = new List<Policy>
        {
            new() { Title = "Knowledge content approval", Owner = "Content team", Status = "In review" },
            new() { Title = "Support escalation procedure", Owner = "Chapter operations", Status = "Approved" },
            new() { Title = "Access and role management", Owner = "Administrator", Status = "Approved" },
            new() { Title = "AI answer quality review", Owner = "AI project team", Status = "Needs review" },
            new() { Title = "Board officer handbook", Owner = "Board", Status = "Approved" },
        };
        calendar = new List<CalItem>
        {
            new() { Title = "Access and role management", When = "Nov 2026", Owner = "Administrator" },
            new() { Title = "Support escalation procedure", When = "Dec 2026", Owner = "Chapter operations" },
            new() { Title = "AI answer quality review", When = "Dec 2026", Owner = "AI project team" },
            new() { Title = "Knowledge content approval", When = "Jan 2027", Owner = "Content team" },
        };
        quarters = new List<Quarter>
        {
            new() { Label = "Q1", H = 55, Note = "Board handbook cycle" },
            new() { Label = "Q2", H = 40, Note = "Light review load" },
            new() { Label = "Q3", H = 70, Note = "Escalation + access" },
            new() { Label = "Q4", H = 90, Note = "AI + knowledge peak" },
        };
        checks = new List<Check>
        {
            new() { Text = "Confirm the source is authoritative" },
            new() { Text = "Assign a policy owner" },
            new() { Text = "Record approval and review dates" },
            new() { Text = "Check links and references" },
            new() { Text = "Schedule the next review" },
        };
        SetFocus("all");
    }

    private void SetFocus(string key)
    {
        focus = key;
        detail = key switch
        {
            "all" => $"Policy register contains {total} records. Use search and Open to review ownership and status.",
            "ok" => $"{approved} policies are Approved. Keep evidence of last review date in the register.",
            "rev" => $"{needs} policies need review (In review or Needs review). Prioritize AI answer quality and knowledge approval.",
            "next" => $"Next scheduled review window starts {nextLabel} {nextYear} (Access and role management).",
            _ => ""
        };
    }

    private void OpenPolicy(Policy p)
    {
        detail = $"Opened: {p.Title} — Owner: {p.Owner}, Status: {p.Status}. Attach evidence and set next review in your chapter records.";
        focus = p.Status.Contains("review", StringComparison.OrdinalIgnoreCase) ? "rev" : "ok";
    }

    private void Plan(CalItem c)
    {
        detail = $"Planned review: {c.Title} ({c.When}) — Owner {c.Owner}. Add agenda item to the board/ops calendar.";
    }

    private void ShowQuarter(Quarter q)
    {
        detail = $"{q.Label} review load: {q.Note} (relative chart height {q.H}%).";
    }
}
