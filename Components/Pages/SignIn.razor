@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

<PageTitle>Sign in | TRU</PageTitle>

<style>
html,body{margin:0!important;padding:0!important}
.signin{--ink:#24436b;--pale:#eaf4fb;--teal:#239f9a;--muted:#71839a;--line:#dfe9f1;display:grid!important;grid-template-columns:minmax(0,1.05fr) minmax(380px,.95fr)!important;width:100%!important;min-height:100vh!important;min-height:100dvh!important;margin:0!important;background:#fff;font-family:"Roboto",system-ui,sans-serif;color:var(--ink)}
.signin__brand{position:relative;display:flex!important;align-items:center!important;justify-content:center!important;min-height:100vh!important;min-height:100dvh!important;overflow:hidden!important;background:linear-gradient(145deg,#f4f9fd,#e8f3fa)!important}
.signin__brand:before,.signin__brand:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(35,159,154,.18);pointer-events:none}.signin__brand:before{width:min(60vw,520px);aspect-ratio:1}.signin__brand:after{width:min(46vw,400px);aspect-ratio:1;border-color:rgba(36,67,107,.10)}
.signin__lattice,.signin__orbits{display:none!important}.signin__orbitStage{position:relative;z-index:2;width:auto!important;height:auto!important;display:grid;place-items:center}.signin__core{width:auto!important;height:auto!important;min-width:0!important;min-height:0!important}
.signin__sphere{width:clamp(118px,15vw,178px)!important;height:clamp(118px,15vw,178px)!important;border-radius:30px!important;background:#fff!important;border:1px solid #d9e9f4;box-shadow:0 18px 50px rgba(36,67,107,.10)!important;display:grid;place-items:center;animation:none!important}
.signin__sphereText{font-family:"Roboto",system-ui,sans-serif!important;font-size:clamp(2.2rem,4vw,3.25rem)!important;font-weight:800!important;letter-spacing:.08em!important;color:var(--ink)!important;text-shadow:none!important}
.signin__panel{display:flex!important;align-items:center!important;justify-content:center!important;min-height:100vh!important;min-height:100dvh!important;padding:2.5rem 2rem;background:#fff!important;box-sizing:border-box}
.signin__card{width:100%;max-width:390px;background:#fff;border-radius:18px;padding:2.1rem 2rem;border:1px solid var(--line);box-shadow:0 14px 40px rgba(36,67,107,.07)}
.signin__title{margin:0 0 .4rem;font-size:1.8rem;font-weight:700;color:var(--ink)}.signin__lede{margin:0 0 1.5rem;color:var(--muted);font-size:.92rem}
.signin__error{margin-bottom:1rem;padding:.75rem .9rem;border-left:4px solid var(--teal);border-radius:8px;background:var(--pale);color:var(--ink);font-size:.88rem}
.signin__field{margin-bottom:1.05rem}.signin__label{display:block;margin-bottom:.4rem;font-weight:700;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:#52728f}
.signin__input,.signin__field input{display:block;width:100%;padding:.8rem .9rem;border:1px solid #d5e3ed;border-radius:10px;background:#f5f9fc;color:var(--ink);font:inherit;font-size:.95rem;box-sizing:border-box}
.signin__input:focus,.signin__field input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(35,159,154,.13);background:#fff}
.signin__submit{width:100%;margin-top:.3rem;padding:.85rem 1rem;border:0;border-radius:10px;background:var(--ink);color:#fff;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;transition:background .2s,transform .2s}.signin__submit:hover{background:var(--teal);transform:translateY(-1px)}
.signin__note{margin:1.2rem 0 0;font-size:.8rem;line-height:1.6;color:#8494a8}.signin__back{display:inline-block;margin-top:1rem;color:var(--teal);font-weight:700;font-size:.88rem;text-decoration:none}.signin__back:hover{color:var(--ink);text-decoration:underline}
@@media(max-width:900px){.signin{grid-template-columns:1fr!important}.signin__brand{min-height:230px!important}.signin__brand:before{width:220px}.signin__brand:after{width:170px}.signin__sphere{width:100px!important;height:100px!important}.signin__panel{min-height:auto!important;padding:1.5rem 1.1rem 2rem}.signin__card{padding:1.6rem 1.3rem}}
@@media(prefers-reduced-motion:reduce){.signin__submit{transition:none}}
</style>

<div class="signin">
    <aside class="signin__brand">
        <div class="signin__orbitStage"><div class="signin__core"><div class="signin__sphere" role="img" aria-label="TRU logo"><span class="signin__sphereText">TRU</span></div></div></div></aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">Sign in</h1>
            <p class="signin__lede">Use the email and password for your TRU account.</p>

            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }

            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in" class="signin__form">
                    <DataAnnotationsValidator />
                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="signin__input" @bind-Value="Input.Email"
                                   type="text" inputmode="email" autocomplete="username"
                                   autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="signin__input" @bind-Value="Input.Password"
                                   type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="signin__submit">Sign in</button>
                </EditForm>
            }

            <p class="signin__note">TRU is a prototype. Test accounts are set up by the project team.</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; Back to TRU home</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "isa-sign-in")]
    private SignInInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
