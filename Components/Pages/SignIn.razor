@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

<PageTitle>Sign in | TRU</PageTitle>

<style>
html,body{margin:0!important;padding:0!important}
.signin{
  --ink:#0e1a2e;--teal:#36ac91;--blue:#00a4e4;--green:#6cb33f;--muted:#8b9bb4;--line:rgba(255,255,255,.12);
  display:grid!important;grid-template-columns:minmax(0,1.1fr) minmax(360px,.9fr)!important;
  width:100%!important;min-height:100vh!important;min-height:100dvh!important;margin:0!important;
  font-family:"Roboto",system-ui,sans-serif;color:#e8eef6;
}
.signin__brand{
  position:relative;display:flex!important;align-items:center!important;justify-content:center!important;
  min-height:100vh!important;min-height:100dvh!important;overflow:hidden!important;
  background:
    radial-gradient(ellipse 80% 60% at 50% 45%, rgba(0,164,228,.12), transparent 55%),
    radial-gradient(ellipse 50% 40% at 70% 80%, rgba(108,179,63,.08), transparent 50%),
    linear-gradient(160deg,#050a14 0%,#0a1424 40%,#0d1b30 100%)!important;
}
/* stars */
.signin__brand:before{
  content:"";position:absolute;inset:0;pointer-events:none;opacity:.7;
  background-image:
    radial-gradient(1.5px 1.5px at 12% 18%, #fff, transparent),
    radial-gradient(1px 1px at 28% 72%, rgba(255,255,255,.8), transparent),
    radial-gradient(1.5px 1.5px at 48% 22%, #fff, transparent),
    radial-gradient(1px 1px at 62% 58%, rgba(255,255,255,.7), transparent),
    radial-gradient(1.5px 1.5px at 78% 14%, #fff, transparent),
    radial-gradient(1px 1px at 88% 68%, rgba(255,255,255,.75), transparent),
    radial-gradient(1px 1px at 18% 42%, rgba(255,255,255,.6), transparent),
    radial-gradient(1.5px 1.5px at 55% 88%, #fff, transparent),
    radial-gradient(1px 1px at 35% 8%, rgba(255,255,255,.7), transparent),
    radial-gradient(1px 1px at 92% 40%, rgba(255,255,255,.65), transparent);
  background-size:100% 100%;
}
.signin__orbitStage{
  position:relative;z-index:2;width:min(70vw,480px);height:min(70vw,480px);
  display:grid;place-items:center;
}
.signin__orbits{position:absolute;inset:0;pointer-events:none}
.signin__orbit{
  position:absolute;left:50%;top:50%;border-radius:50%;
  border:1px solid rgba(0,164,228,.18);
  transform:translate(-50%,-50%);
}
.signin__orbit:nth-child(1){width:22%;height:22%}
.signin__orbit:nth-child(2){width:34%;height:34%;border-color:rgba(54,172,145,.2)}
.signin__orbit:nth-child(3){width:46%;height:46%}
.signin__orbit:nth-child(4){width:58%;height:58%;border-color:rgba(108,179,63,.16)}
.signin__orbit:nth-child(5){width:70%;height:70%}
.signin__orbit:nth-child(6){width:82%;height:82%;border-color:rgba(0,164,228,.14)}
.signin__orbit:nth-child(7){width:94%;height:94%;border-color:rgba(255,255,255,.1)}
.signin__orbit:nth-child(8){width:106%;height:106%;border-color:rgba(255,255,255,.07)}
.signin__orbit:nth-child(9){width:118%;height:118%;border-color:rgba(255,255,255,.05)}
.signin__planet{
  position:absolute;left:50%;top:50%;width:100%;height:100%;
  transform:translate(-50%,-50%);
  animation:tru-spin var(--d,28s) linear infinite;
  pointer-events:none;z-index:3;
}
.signin__planet:after{
  content:"";position:absolute;left:50%;top:3%;
  width:var(--s,8px);height:var(--s,8px);margin-left:calc(var(--s,8px)/-2);
  border-radius:50%;background:var(--c,#00a4e4);
  box-shadow:0 0 10px var(--c,#00a4e4),0 0 2px #fff;
}
.signin__planet:nth-of-type(2){--d:16s;--c:#6cb33f;--s:7px;transform:translate(-50%,-50%) rotate(20deg)}
.signin__planet:nth-of-type(3){--d:22s;--c:#00a4e4;--s:9px;transform:translate(-50%,-50%) rotate(55deg)}
.signin__planet:nth-of-type(4){--d:28s;--c:#fbb034;--s:8px;transform:translate(-50%,-50%) rotate(100deg)}
.signin__planet:nth-of-type(5){--d:34s;--c:#36ac91;--s:10px;transform:translate(-50%,-50%) rotate(140deg)}
.signin__planet:nth-of-type(6){--d:40s;--c:#6558b1;--s:7px;transform:translate(-50%,-50%) rotate(180deg)}
.signin__planet:nth-of-type(7){--d:48s;--c:#e57524;--s:8px;transform:translate(-50%,-50%) rotate(220deg)}
.signin__planet:nth-of-type(8){--d:56s;--c:#00a4e4;--s:6px;transform:translate(-50%,-50%) rotate(265deg)}
.signin__planet:nth-of-type(9){--d:64s;--c:#6cb33f;--s:9px;transform:translate(-50%,-50%) rotate(305deg)}
.signin__planet:nth-of-type(10){--d:72s;--c:#e8eef6;--s:5px;transform:translate(-50%,-50%) rotate(340deg)}
.signin__core{position:relative;z-index:5;width:clamp(110px,18vw,150px);height:clamp(110px,18vw,150px);display:grid;place-items:center}
.signin__sun{
  width:100%;height:100%;border-radius:50%;
  background:
    radial-gradient(circle at 35% 30%, rgba(255,255,255,.5), transparent 35%),
    linear-gradient(145deg,#00a4e4 0%,#36ac91 45%,#6cb33f 100%);
  box-shadow:
    0 0 0 6px rgba(0,164,228,.15),
    0 0 0 14px rgba(0,164,228,.06),
    0 0 40px rgba(0,164,228,.45),
    0 0 80px rgba(54,172,145,.25),
    inset -8px -10px 20px rgba(0,40,60,.25);
  display:grid;place-items:center;
  animation:tru-pulse 5s ease-in-out infinite;
}
.signin__sun span{
  font-family:"Roboto Slab",Georgia,serif;font-weight:700;font-size:clamp(1.1rem,2.5vw,1.5rem);
  color:#fff;letter-spacing:.12em;text-shadow:0 2px 8px rgba(0,0,0,.3);
}
@@keyframes tru-spin{to{transform:translate(-50%,-50%) rotate(360deg)}}
@@keyframes tru-pulse{
  0%,100%{box-shadow:0 0 0 6px rgba(0,164,228,.15),0 0 0 14px rgba(0,164,228,.06),0 0 40px rgba(0,164,228,.4),0 0 80px rgba(54,172,145,.2),inset -8px -10px 20px rgba(0,40,60,.25)}
  50%{box-shadow:0 0 0 8px rgba(0,164,228,.2),0 0 0 20px rgba(0,164,228,.08),0 0 56px rgba(0,164,228,.55),0 0 100px rgba(54,172,145,.3),inset -8px -10px 20px rgba(0,40,60,.25)}
}

.signin__panel{
  display:flex!important;align-items:center!important;justify-content:center!important;
  min-height:100vh!important;min-height:100dvh!important;padding:2rem;
  background:linear-gradient(180deg,#f4f8fc,#eef3f8)!important;box-sizing:border-box;
}
.signin__card{
  width:100%;max-width:400px;
  background:rgba(255,255,255,.92);backdrop-filter:blur(12px);
  border-radius:20px;padding:2rem 1.9rem 1.7rem;
  border:1px solid rgba(29,45,92,.08);
  box-shadow:0 20px 50px rgba(14,26,46,.1),0 1px 0 rgba(255,255,255,.8) inset;
  color:#0e1a2e;
}
.signin__title{margin:0 0 .35rem;font-size:1.7rem;font-weight:700;color:#0e1a2e}
.signin__lede{margin:0 0 1.4rem;color:#5f6b85;font-size:.92rem}
.signin__error{margin-bottom:1rem;padding:.75rem .9rem;border-left:4px solid #e31837;border-radius:8px;background:#fdecee;color:#9b1027;font-size:.88rem}
.signin__field{margin-bottom:1rem}
.signin__label{display:block;margin-bottom:.35rem;font-weight:700;font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:#07649d}
.signin__input,.signin__field input{
  display:block;width:100%;padding:.8rem .9rem;border:1.5px solid #d0dce8;border-radius:11px;
  background:#f5f9fc;color:#0e1a2e;font:inherit;font-size:.95rem;box-sizing:border-box;
}
.signin__input:focus,.signin__field input:focus{outline:none;border-color:#00a4e4;box-shadow:0 0 0 4px rgba(0,164,228,.15);background:#fff}
.signin__submit{
  width:100%;margin-top:.35rem;padding:.9rem 1rem;border:0;border-radius:11px;
  background:linear-gradient(135deg,#1d2d5c,#07649d);color:#fff;
  font:inherit;font-weight:700;font-size:.95rem;cursor:pointer;
  box-shadow:0 8px 20px rgba(29,45,92,.2);
}
.signin__submit:hover{filter:brightness(1.08)}
.signin__note{margin:1.15rem 0 0;font-size:.8rem;color:#8494a8;line-height:1.5}
.signin__back{display:inline-block;margin-top:.9rem;color:#36ac91;font-weight:700;font-size:.88rem;text-decoration:none}
.signin__back:hover{color:#07649d;text-decoration:underline}

@@media(max-width:900px){
  .signin{grid-template-columns:1fr!important}
  .signin__brand{min-height:300px!important}
  .signin__orbitStage{width:min(70vw,320px);height:min(70vw,320px)}
  .signin__panel{min-height:auto!important;padding:1.5rem 1.1rem 2rem}
}
@@media(prefers-reduced-motion:reduce){
  .signin__planet,.signin__sun{animation:none!important}
}
</style>

<div class="signin">
    <aside class="signin__brand">
        <div class="signin__orbitStage">
            <div class="signin__orbits" aria-hidden="true">
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
            </div>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <div class="signin__core">
                <div class="signin__sun" role="img" aria-label="TRU"><span>TRU</span></div>
            </div>
        </div>
    </aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">Sign in</h1>
            <p class="signin__lede">Use the email and password for your TRU account.</p>
            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }
            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in">
                    <DataAnnotationsValidator />
                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="signin__input" @bind-Value="Input.Email" type="text" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="signin__input" @bind-Value="Input.Password" type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="signin__submit">Sign in</button>
                </EditForm>
            }
            <p class="signin__note">TRU is a prototype. Test accounts are set up by the project team.</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; Back to TRU home</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm(FormName = "isa-sign-in")] private SignInInput? Input { get; set; }
    protected override void OnInitialized() => Input ??= new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")] public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")] public string Password { get; set; } = string.Empty;
    }
}
