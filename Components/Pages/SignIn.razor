@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

<PageTitle>Sign in | TRU</PageTitle>

<style>
html, body { margin: 0 !important; padding: 0 !important; }
.signin {
  --navy-deep: #1d2d5c;
  --blue: #00a4e4;
  --mid: #07649d;
  --muted: #5f6b85;
  --line: #e2e8f0;
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  width: 100% !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  margin: 0 !important;
  background: #f4f7fb;
  font-family: "Roboto", system-ui, sans-serif;
  color: var(--navy-deep);
}

.signin__brand {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  overflow: hidden !important;
  background:
    radial-gradient(ellipse 70% 55% at 55% 48%, rgba(0, 164, 228, 0.18), transparent 55%),
    linear-gradient(165deg, #060d18 0%, #0c1a30 40%, #12233f 100%) !important;
}

/* Green triangle lattice — left edge */
.signin__lattice {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 32px;
  z-index: 5;
  pointer-events: none;
  background-color: #1a5c45;
  background-image:
    linear-gradient(45deg, #0f3d2e 25%, transparent 25%),
    linear-gradient(-45deg, #2d8a6a 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #6cb33f 75%),
    linear-gradient(-45deg, transparent 75%, #8fd15a 75%),
    linear-gradient(45deg, #36ac91 25%, transparent 25%),
    linear-gradient(-45deg, #4db89a 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #a8d98a 75%),
    linear-gradient(-45deg, transparent 75%, #1f6b55 75%);
  background-size: 16px 16px;
  background-position:
    0 0, 0 8px, 8px -8px, -8px 0,
    0 0, 0 8px, 8px -8px, -8px 0;
  border-right: 2px solid #0a2e22;
}

.signin__rings {
  position: absolute;
  left: -50px;
  top: -30px;
  bottom: -30px;
  width: 150px;
  z-index: 1;
  opacity: 0.4;
  pointer-events: none;
}
.signin__rings span {
  position: absolute;
  left: 0;
  border-radius: 50%;
  border: 16px solid #1a4a9c;
  box-sizing: border-box;
}
.signin__rings .r1 { top: 0; width: 140px; height: 140px; }
.signin__rings .r2 { top: 110px; width: 130px; height: 130px; border-color: #2563c7; border-width: 18px; }
.signin__rings .r3 { top: 230px; width: 145px; height: 145px; border-color: #1d2d5c; border-width: 20px; }
.signin__rings .r4 { top: 370px; width: 125px; height: 125px; border-color: #2b6de0; }
.signin__rings .r5 { top: 500px; width: 140px; height: 140px; border-color: #1a4a9c; }

.signin__orbitStage {
  position: relative;
  z-index: 3;
  width: min(400px, 75%);
  height: min(400px, 75%);
  display: grid;
  place-items: center;
}
.signin__orbits { position: absolute; inset: 0; display: grid; place-items: center; }
.signin__orbit {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(0, 164, 228, 0.2);
  box-sizing: border-box;
  animation: siOrbit linear infinite;
}
.signin__orbit--1 { width: 18%; height: 18%; animation-duration: 22s; border-color: rgba(0,164,228,.38); }
.signin__orbit--2 { width: 28%; height: 28%; animation-duration: 28s; animation-direction: reverse; border-color: rgba(54,172,145,.3); }
.signin__orbit--3 { width: 38%; height: 38%; animation-duration: 34s; border-color: rgba(0,164,228,.26); }
.signin__orbit--4 { width: 48%; height: 48%; animation-duration: 42s; animation-direction: reverse; border-color: rgba(108,179,63,.24); }
.signin__orbit--5 { width: 58%; height: 58%; animation-duration: 50s; border-color: rgba(0,164,228,.2); }
.signin__orbit--6 { width: 68%; height: 68%; animation-duration: 58s; animation-direction: reverse; border-color: rgba(7,100,157,.26); }
.signin__orbit--7 { width: 78%; height: 78%; animation-duration: 68s; border-color: rgba(0,164,228,.16); }
.signin__orbit--8 { width: 88%; height: 88%; animation-duration: 80s; animation-direction: reverse; border-color: rgba(54,172,145,.14); }
.signin__orbit--9 { width: 100%; height: 100%; animation-duration: 95s; border-color: rgba(255,255,255,.1); }

.signin__planet {
  position: absolute; top: 0; left: 50%;
  width: 5px; height: 5px; margin-left: -2.5px; margin-top: -2.5px;
  border-radius: 50%; background: #00a4e4; box-shadow: 0 0 8px rgba(0,164,228,.8);
}
.signin__orbit--2 .signin__planet { background: #36ac91; left: 22%; }
.signin__orbit--3 .signin__planet { background: #6cb33f; left: 72%; width: 4px; height: 4px; }
.signin__orbit--4 .signin__planet { background: #00a4e4; left: 30%; }
.signin__orbit--5 .signin__planet { background: #fbb034; left: 82%; box-shadow: 0 0 6px rgba(251,176,52,.7); }
.signin__orbit--6 .signin__planet { background: #00a4e4; left: 14%; width: 4px; height: 4px; }
.signin__orbit--7 .signin__planet { background: #36ac91; left: 58%; }
.signin__orbit--8 .signin__planet { background: #e8eef6; left: 42%; width: 3px; height: 3px; opacity: .75; }
.signin__orbit--9 .signin__planet { background: #00a4e4; left: 26%; width: 6px; height: 6px; }

@@keyframes siOrbit { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.signin__core {
  position: relative; z-index: 4;
  width: 16%; height: 16%; min-width: 72px; min-height: 72px;
  display: grid; place-items: center;
}
.signin__sphere {
  width: 100%; height: 100%; border-radius: 50%;
  background: linear-gradient(145deg, #00a4e4 0%, #36ac91 48%, #6cb33f 100%);
  box-shadow: 0 0 0 4px rgba(255,255,255,.14), 0 0 42px rgba(0,164,228,.45), inset 0 -8px 18px rgba(0,0,0,.14);
  display: grid; place-items: center;
  animation: siPulse 4.5s ease-in-out infinite;
}
.signin__sphereText {
  font-family: "Roboto Slab", Georgia, serif; font-weight: 700;
  font-size: clamp(0.85rem, 2vw, 1.15rem); color: #fff; letter-spacing: 0.08em;
}
@@keyframes siPulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(255,255,255,.14), 0 0 36px rgba(0,164,228,.4), inset 0 -8px 18px rgba(0,0,0,.14); }
  50% { box-shadow: 0 0 0 6px rgba(255,255,255,.2), 0 0 54px rgba(0,164,228,.55), inset 0 -8px 18px rgba(0,0,0,.14); }
}

.signin__panel {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  padding: 2.5rem 2rem;
  background: linear-gradient(180deg, #f7fafc 0%, #eef2f7 100%);
  box-sizing: border-box;
}
.signin__card {
  width: 100%; max-width: 400px; background: #fff; border-radius: 18px;
  padding: 1.75rem 1.85rem 1.6rem; border: 1px solid var(--line);
  box-shadow: 0 16px 48px rgba(29, 45, 92, 0.08);
}
.signin__title { margin: 0 0 0.35rem; font-size: 1.55rem; font-weight: 700; color: var(--navy-deep); }
.signin__lede { margin: 0 0 1.35rem; color: var(--muted); font-size: 0.92rem; }
.signin__error {
  margin-bottom: 1rem; padding: 0.75rem 0.9rem;
  border-left: 4px solid #e31837; border-radius: 8px;
  background: #fdecee; color: #9b1027; font-size: 0.88rem;
}
.signin__field { margin-bottom: 1.05rem; }
.signin__label {
  display: block; margin-bottom: 0.35rem; font-weight: 700;
  font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid);
}
.signin__input, .signin__field input {
  display: block; width: 100%; padding: 0.75rem 0.9rem;
  border: 1.5px solid #c9d3e0; border-radius: 10px;
  background: #f8fafc; color: var(--navy-deep);
  font: inherit; font-size: 0.95rem; box-sizing: border-box;
}
.signin__input:focus, .signin__field input:focus {
  outline: none; border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(0, 164, 228, 0.2); background: #fff;
}
.signin__submit {
  width: 100%; margin-top: 0.25rem; padding: 0.85rem 1rem;
  border: none; border-radius: 10px;
  background: linear-gradient(135deg, var(--navy-deep), var(--mid));
  color: #fff; font: inherit; font-weight: 600; font-size: 0.95rem; cursor: pointer;
}
.signin__submit:hover { filter: brightness(1.08); }
.signin__note { margin: 1.25rem 0 0; font-size: 0.8rem; color: var(--muted); }
.signin__back {
  display: inline-block; margin-top: 0.85rem;
  color: var(--mid); font-weight: 600; font-size: 0.88rem; text-decoration: none;
}
.signin__back:hover { color: var(--navy-deep); text-decoration: underline; }

@@media (max-width: 900px) {
  .signin { grid-template-columns: 1fr !important; }
  .signin__brand { min-height: 280px !important; }
  .signin__orbitStage { width: min(260px, 70vw); height: min(260px, 70vw); }
  .signin__panel { min-height: auto !important; padding: 1.75rem 1.25rem 2rem; }
}
@@media (prefers-reduced-motion: reduce) {
  .signin__orbit, .signin__sphere { animation: none !important; }
}
</style>

<div class="signin">
    <aside class="signin__brand">
        <div class="signin__lattice" aria-hidden="true"></div>
        <div class="signin__rings" aria-hidden="true">
            <span class="r1"></span><span class="r2"></span><span class="r3"></span>
            <span class="r4"></span><span class="r5"></span>
        </div>

        <div class="signin__orbitStage">
            <div class="signin__orbits" aria-hidden="true">
                <div class="signin__orbit signin__orbit--1"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--2"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--3"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--4"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--5"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--6"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--7"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--8"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--9"><span class="signin__planet"></span></div>
            </div>
            <div class="signin__core">
                <div class="signin__sphere">
                    <span class="signin__sphereText">TRU</span>
                </div>
            </div>
        </div>
    </aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">Sign in</h1>
            <p class="signin__lede">Use the email and password for your TRU account.</p>

            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }

            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in" class="signin__form">
                    <DataAnnotationsValidator />
                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="signin__input" @bind-Value="Input.Email"
                                   type="text" inputmode="email" autocomplete="username"
                                   autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="signin__input" @bind-Value="Input.Password"
                                   type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="signin__submit">Sign in</button>
                </EditForm>
            }

            <p class="signin__note">TRU is a prototype. Test accounts are set up by the project team.</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; Back to TRU home</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "isa-sign-in")]
    private SignInInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
