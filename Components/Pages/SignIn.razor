@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sign in | TRU</PageTitle>

<style>
html, body { margin: 0 !important; padding: 0 !important; background: #fff !important; }
.si {
  --ink: #1a2744; --navy: #0a1f4d; --navy-deep: #071636; --blue: #0076a8;
  --muted: #5a6a84; --line: #e4e9f0;
  font-family: "Roboto", system-ui, sans-serif; color: var(--ink);
  min-height: 100vh; background: #fff;
}
.si a { text-decoration: none; color: inherit; }

.si-top {
  background: #fff; display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; padding: .85rem 1.75rem; flex-wrap: wrap; border-bottom: 1px solid var(--line);
}
.si-top__brand { display: flex; align-items: center; gap: .65rem; font-weight: 700; font-size: 1.05rem; color: var(--ink); }
.si-top__brand .logo {
  width: 42px; height: 42px; border-radius: 50%;
  background: linear-gradient(145deg, #00a4e4, #2a9b8f 55%, #5aaf3a);
  color: #fff; display: grid; place-items: center; font-size: .7rem; font-weight: 800; letter-spacing: .05em;
}
.si-search {
  flex: 1 1 200px; max-width: 340px; margin: 0 auto;
  display: flex; align-items: center; gap: .35rem;
  background: #f2f5f9; border-radius: 999px; padding: .5rem 1rem; border: 1px solid transparent;
}
.si-search:focus-within { border-color: #c5d4e8; background: #fff; }
.si-search input { flex: 1; border: 0; background: transparent; outline: none; font: inherit; font-size: .9rem; color: var(--ink); }
.si-search button { border: 0; background: transparent; cursor: pointer; color: var(--muted); font-size: 1.05rem; line-height: 1; padding: 0; }
.si-top__actions { display: flex; align-items: center; gap: 1rem; }
.si-top__actions a { font-size: .88rem; font-weight: 600; color: #3a4a6b; }
.si-top__actions a:hover { color: var(--blue); }
.si-top__sign {
  display: inline-flex; padding: .5rem 1.2rem; border-radius: 8px;
  background: var(--navy); color: #fff !important; font-weight: 700; font-size: .86rem;
}
.si-top__sign:hover { background: #123066; }

.si-nav {
  background: #fff; display: flex; justify-content: center; flex-wrap: wrap;
  gap: .2rem 1.6rem; padding: .65rem 1.25rem .75rem; border-bottom: 1px solid var(--line);
}
.si-nav a { font-size: .9rem; font-weight: 600; color: #2c3a56; padding: .25rem 0; }
.si-nav a:hover { color: var(--blue); }

.si-hero {
  position: relative; width: 100%; min-height: clamp(380px, 54vh, 540px);
  overflow: hidden; background: var(--navy);
}
.si-hero__slide {
  position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .9s ease;
  background-size: cover; background-position: center 25%; display: flex; align-items: center;
}
.si-hero__slide.is-on { opacity: 1; visibility: visible; z-index: 1; }
.si-hero__shade {
  position: absolute; inset: 0;
  background: linear-gradient(100deg, rgba(7,22,54,.94) 0%, rgba(10,31,77,.88) 38%, rgba(10,31,77,.55) 62%, rgba(10,31,77,.3) 100%);
}
.si-hero__inner {
  position: relative; z-index: 2; max-width: 1120px; width: 100%; margin: 0 auto;
  padding: 3.25rem 1.75rem 4.25rem; color: #fff;
}
.si-hero__crumb { font-size: .8rem; opacity: .7; margin-bottom: 1rem; font-weight: 500; }
.si-hero__inner h1 {
  margin: 0 0 .75rem; font-size: clamp(2rem, 4.2vw, 3.1rem); font-weight: 700;
  line-height: 1.12; max-width: 14ch; color: #fff;
}
.si-hero__inner p {
  margin: 0 0 1.5rem; font-size: clamp(1rem, 1.5vw, 1.15rem); opacity: .92;
  max-width: 34rem; line-height: 1.55; color: #e8eef8;
}
.si-btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: .75rem 1.5rem; border-radius: 4px; font-weight: 700; font-size: .9rem;
  border: none; cursor: pointer; font-family: inherit; letter-spacing: .02em;
  background: #fff; color: var(--navy);
}
.si-btn:hover { background: #e8eef8; }
.si-hero__controls {
  position: absolute; bottom: 1.4rem; left: 50%; transform: translateX(-50%); z-index: 5;
  display: flex; align-items: center; gap: .45rem;
  background: rgba(255,255,255,.15); backdrop-filter: blur(10px);
  padding: .4rem .6rem; border-radius: 999px;
}
.si-hero__controls button {
  width: 36px; height: 36px; border-radius: 50%; border: none; cursor: pointer;
  background: rgba(255,255,255,.9); color: var(--navy); font-size: 1rem; font-weight: 700;
  display: grid; place-items: center;
}
.si-hero__controls button.pause { font-size: .65rem; }
.si-hero__dots { display: flex; gap: 5px; padding: 0 .3rem; }
.si-hero__dot {
  width: 9px; height: 9px; border-radius: 50%; border: none; padding: 0;
  background: rgba(255,255,255,.4); cursor: pointer;
}
.si-hero__dot.is-on { background: #fff; width: 20px; border-radius: 5px; }

.si-bar {
  background: var(--navy-deep); color: #b8c4d8; text-align: center;
  padding: 1rem 1.25rem; font-size: .95rem; font-weight: 500; letter-spacing: .02em;
}
.si-bar a { color: #fff; font-weight: 700; margin-left: .4rem; }
.si-bar a:hover { text-decoration: underline; }

/* Insights section — ISACA style */
.si-insights {
  max-width: 1120px; margin: 0 auto; padding: 3rem 1.5rem 2.5rem; text-align: center;
}
.si-insights h2 {
  margin: 0 0 .75rem; font-size: clamp(1.45rem, 2.6vw, 1.9rem); font-weight: 700; color: var(--ink);
}
.si-insights > p {
  margin: 0 auto 2.25rem; max-width: 40rem; font-size: 1.02rem; line-height: 1.65; color: var(--muted);
}
.si-cards {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; text-align: left;
}
.si-card {
  background: #fff; border-radius: 4px; overflow: hidden;
  transition: transform .2s ease, box-shadow .2s ease;
}
.si-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(10,31,77,.12); }
.si-card__img {
  aspect-ratio: 3/4; background: #e8eef5 center/cover no-repeat;
  border-radius: 4px; margin-bottom: .85rem;
}
.si-card__type {
  font-size: .75rem; font-weight: 600; color: var(--muted); margin: 0 0 .25rem;
}
.si-card h3 {
  margin: 0 0 .45rem; font-size: 1.02rem; font-weight: 700; line-height: 1.3; color: var(--ink);
}
.si-card p {
  margin: 0; font-size: .88rem; line-height: 1.5; color: var(--muted);
}

/* Compact login under insights */
.si-login-wrap {
  max-width: 400px; margin: 0 auto 3rem; padding: 0 1.25rem;
}
.si-login {
  background: #fff; border: 1px solid var(--line); border-radius: 12px;
  padding: 1.4rem 1.3rem 1.25rem; box-shadow: 0 8px 28px rgba(10,31,77,.06);
}
.si-login h3 { margin: 0 0 .2rem; font-size: 1.15rem; font-weight: 700; text-align: center; }
.si-login > p { margin: 0 0 1rem; font-size: .84rem; color: var(--muted); text-align: center; }
.si-error {
  margin-bottom: .85rem; padding: .65rem .8rem; border-left: 4px solid #e31837;
  border-radius: 8px; background: #fdecee; color: #9b1027; font-size: .85rem;
}
.si-field { margin-bottom: .85rem; }
.si-label {
  display: block; margin-bottom: .3rem; font-weight: 700; font-size: .68rem;
  letter-spacing: .08em; text-transform: uppercase; color: #07649d;
}
.si-input {
  display: block; width: 100%; padding: .72rem .85rem; border: 1.5px solid #d0dce8;
  border-radius: 8px; background: #f7f9fc; color: var(--ink); font: inherit; font-size: .95rem;
  box-sizing: border-box;
}
.si-input:focus {
  outline: none; border-color: #00a4e4; box-shadow: 0 0 0 3px rgba(0,164,228,.12); background: #fff;
}
.si-submit {
  width: 100%; margin-top: .2rem; padding: .8rem 1rem; border: 0; border-radius: 8px;
  background: var(--navy); color: #fff; font: inherit; font-weight: 700; font-size: .95rem; cursor: pointer;
}
.si-submit:hover { background: #123066; }

.si-foot {
  text-align: center; padding: 1.25rem; font-size: .78rem; color: #8a96ab;
  border-top: 1px solid var(--line);
}

@@media (max-width: 960px) {
  .si-cards { grid-template-columns: 1fr 1fr; }
}
@@media (max-width: 720px) {
  .si-search { max-width: none; order: 3; flex-basis: 100%; }
  .si-hero__inner { padding: 2.5rem 1.25rem 3.5rem; }
  .si-cards { grid-template-columns: 1fr; max-width: 320px; margin: 0 auto; }
}
</style>

<div class="si">
    <header class="si-top">
        <a class="si-top__brand" href="/sign-in">
            <span class="logo">TRU</span>
            Chapter support
        </a>
        <form class="si-search" @onsubmit="HandleSearch" @onsubmit:preventDefault>
            <input type="search" @bind="searchQ" placeholder="Search" aria-label="Search" />
            <button type="submit" title="Search">⌕</button>
        </form>
        <div class="si-top__actions">
            <a href="https://www.isaca.org/" target="_blank" rel="noopener">Get support</a>
            <a class="si-top__sign" href="#si-login">Sign in</a>
        </div>
    </header>

    <nav class="si-nav" aria-label="Main">
        <a href="/resource-library">Resource library</a>
        <a href="/knowledge-base">Knowledge base</a>
        <a href="/events">Events</a>
        <a href="/market-trends">Market trends</a>
        <a href="/contact">Contact</a>
    </nav>

    <section class="si-hero" aria-label="Featured">
        @for (var i = 0; i < heroes.Length; i++)
        {
            var h = heroes[i];
            <div class="si-hero__slide @(i == heroIndex ? "is-on" : null)" style="background-image:url('@h.Image')">
                <div class="si-hero__shade"></div>
                <div class="si-hero__inner">
                    <div class="si-hero__crumb">@h.Crumb</div>
                    <h1>@h.Title</h1>
                    <p>@h.Caption</p>
                    <a class="si-btn" href="@h.PrimaryHref">@h.PrimaryLabel</a>
                </div>
            </div>
        }
        <div class="si-hero__controls">
            <button type="button" @onclick="PrevHero" aria-label="Previous">‹</button>
            <button type="button" class="pause" @onclick="TogglePause" aria-label="@(paused ? "Play" : "Pause")">@(paused ? "▶" : "❚❚")</button>
            <div class="si-hero__dots">
                @for (var i = 0; i < heroes.Length; i++)
                {
                    var di = i;
                    <button type="button" class="si-hero__dot @(i == heroIndex ? "is-on" : null)" @onclick="() => heroIndex = di"></button>
                }
            </div>
            <button type="button" @onclick="NextHero" aria-label="Next">›</button>
        </div>
    </section>

    <div class="si-bar">
        ALREADY HAVE AN ACCOUNT?
        <a href="#si-login">SIGN IN TO TRU →</a>
    </div>

    <section class="si-insights">
        <h2>Stay ahead with ISACA insights and thought leadership</h2>
        <p>
            Explore the latest digital trust assets, frameworks, models, white papers and resources
            to keep you at the forefront of your career and build a better digital world.
        </p>
        <div class="si-cards">
            <a class="si-card" href="https://www.isaca.org/resources/white-papers/2026/security-debt-the-unseen-risk-undermining-cyber-resilience" target="_blank" rel="noopener">
                <div class="si-card__img" style="background-image:url('https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=600&q=80'); background-color:#1a5c45;"></div>
                <div class="si-card__type">White Paper</div>
                <h3>Security Debt: The Unseen Risk Undermining Cyber Resilience</h3>
                <p>This paper explores where security debt comes from, how it grows, and its impact on resilience.</p>
            </a>
            <a class="si-card" href="https://www.isaca.org/resources/isaca-journal/issues/2026/volume-6" target="_blank" rel="noopener">
                <div class="si-card__img" style="background-image:url('https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=600&q=80'); background-color:#1d2d5c;"></div>
                <div class="si-card__type">ISACA Journal</div>
                <h3>Volume 6, 2026</h3>
                <p>Managing risk in emerging tech, dispelling guardrails and more.</p>
            </a>
            <a class="si-card" href="https://www.isaca.org/store2/product/WPAIAT" target="_blank" rel="noopener">
                <div class="si-card__img" style="background-image:url('https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=600&q=80'); background-color:#0a3d5c;"></div>
                <div class="si-card__type">Tool</div>
                <h3>AI Impact Assessment Tool | Digital | English</h3>
                <p>Help enterprises consider the possible ethical consequences associated with their AI projects.</p>
            </a>
            <a class="si-card" href="https://www.isaca.org/resources/white-papers/2025/leveraging-cobit-for-effective-ai-system-governance" target="_blank" rel="noopener">
                <div class="si-card__img" style="background-image:url('https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=600&q=80'); background-color:#1565a8;"></div>
                <div class="si-card__type">White Paper</div>
                <h3>Leveraging COBIT for Effective AI System Governance</h3>
                <p>Govern AI systems more effectively with help from the COBIT framework.</p>
            </a>
        </div>
    </section>

    <div class="si-login-wrap" id="si-login">
        <div class="si-login">
            <h3>Sign in</h3>
            <p>Use the email and password for your TRU account.</p>
            @if (ErrorMessage is not null)
            {
                <div class="si-error" role="alert">@ErrorMessage</div>
            }
            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in">
                    <DataAnnotationsValidator />
                    <div class="si-field">
                        <label class="si-label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="si-input" @bind-Value="Input.Email" type="text" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="si-field">
                        <label class="si-label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="si-input" @bind-Value="Input.Password" type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="si-submit">Sign in</button>
                </EditForm>
            }
        </div>
    </div>

    <footer class="si-foot">TRU · Chapter support</footer>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm(FormName = "isa-sign-in")] private SignInInput? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }
    private string searchQ = "";
    private int heroIndex;
    private bool paused;
    private System.Threading.Timer? heroTimer;

    private record Hero(string Crumb, string Title, string Caption, string Image, string PrimaryLabel, string PrimaryHref);
    private static readonly Hero[] heroes =
    {
        new("Home · Chapter support", "Empowering your chapter",
            "Guides, knowledge, events, and tools for ISACA chapter officers and volunteers.",
            "https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1800&q=85",
            "Open resource library", "/resource-library"),
        new("Home · Events", "Mark your calendar",
            "Plan webinars, meetups, and CPE sessions with the Events workspace.",
            "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1800&q=85",
            "View events", "/events"),
        new("Home · Knowledge", "The leader's compass",
            "Approved chapter guidance and certification paths for your team.",
            "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1800&q=85",
            "Knowledge base", "/knowledge-base"),
        new("Home · Resources", "Advance trust in technology",
            "Policies, frameworks, and market context for chapter leaders.",
            "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1800&q=85",
            "Market trends", "/market-trends"),
    };

    protected override void OnInitialized()
    {
        Input ??= new();
        StartTimer();
    }

    private void StartTimer()
    {
        heroTimer?.Dispose();
        if (paused) return;
        heroTimer = new System.Threading.Timer(_ =>
        {
            heroIndex = (heroIndex + 1) % heroes.Length;
            _ = InvokeAsync(StateHasChanged);
        }, null, 6500, 6500);
    }

    private void TogglePause()
    {
        paused = !paused;
        if (paused) heroTimer?.Dispose();
        else StartTimer();
    }

    private void PrevHero() => heroIndex = heroIndex == 0 ? heroes.Length - 1 : heroIndex - 1;
    private void NextHero() => heroIndex = (heroIndex + 1) % heroes.Length;

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQ)) return;
        var q = searchQ.Trim().ToLowerInvariant();
        if (q.Contains("event") || q.Contains("calendar")) Navigation.NavigateTo("/events");
        else if (q.Contains("knowledge") || q.Contains("article")) Navigation.NavigateTo("/knowledge-base");
        else if (q.Contains("market") || q.Contains("trend")) Navigation.NavigateTo("/market-trends");
        else if (q.Contains("contact")) Navigation.NavigateTo("/contact");
        else Navigation.NavigateTo("/resource-library");
    }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    public void Dispose() => heroTimer?.Dispose();

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")] public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")] public string Password { get; set; } = string.Empty;
    }
}
