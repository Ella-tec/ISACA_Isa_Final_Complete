@page "/sign-in"
@layout AuthLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>TRU</PageTitle>

<style>
html, body { margin: 0 !important; padding: 0 !important; background: #fff !important; }
.si {
  --ink: #1a2744; --navy: #0a1f4d; --blue: #0076a8; --muted: #5a6a84; --line: #e4e9f0;
  font-family: "Roboto", system-ui, sans-serif; color: var(--ink);
  min-height: 100vh; background: #fff;
}
.si a { text-decoration: none; color: inherit; }
.si-top {
  background: #fff; display: flex; align-items: center; justify-content: space-between;
  gap: .75rem; padding: .55rem 1.25rem; flex-wrap: wrap; border-bottom: 1px solid var(--line);
}
.si-top__brand { display: none !important; }
.si-search {
  flex: 1 1 160px; max-width: 280px; margin: 0 auto;
  display: flex; align-items: center; gap: .25rem;
  background: #f2f5f9; border-radius: 999px; padding: .38rem .8rem;
}
.si-search input { flex: 1; border: 0; background: transparent; outline: none; font: inherit; font-size: .84rem; color: var(--ink); }
.si-search button { border: 0; background: transparent; cursor: pointer; color: var(--muted); font-size: .95rem; padding: 0; }
.si-top__sign {
  display: inline-flex; padding: .4rem 1rem; border-radius: 7px;
  background: var(--navy); color: #fff; font-weight: 700; font-size: .82rem;
  border: 0; cursor: pointer; font-family: inherit;
}
.si-top__sign:hover { background: #123066; }
.si-hero {
  position: relative; width: 100%; min-height: clamp(380px, 52vh, 560px);
  overflow: hidden; background: var(--navy);
}
.si-hero__slide {
  position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .8s ease;
  background-size: cover; background-position: center 30%; display: flex; align-items: center;
}
.si-hero__slide.is-on { opacity: 1; visibility: visible; z-index: 1; }
.si-hero__shade {
  position: absolute; inset: 0;
  background: linear-gradient(100deg, rgba(7,22,54,.93) 0%, rgba(10,31,77,.78) 42%, rgba(10,31,77,.35) 100%);
}
.si-hero__inner {
  position: relative; z-index: 2; max-width: 1100px; width: 100%; margin: 0 auto;
  padding: 2.5rem 1.5rem 3.5rem; color: #fff;
}
.si-hero__crumb { font-size: .75rem; opacity: .7; margin-bottom: .6rem; }
.si-hero__inner h1 {
  margin: 0 0 .5rem; font-size: clamp(1.85rem, 4vw, 2.75rem); font-weight: 700;
  line-height: 1.12; max-width: 14ch; color: #fff;
}
.si-hero__inner p {
  margin: 0 0 1.15rem; font-size: clamp(.92rem, 1.4vw, 1.08rem); opacity: .93;
  max-width: 32rem; line-height: 1.5; color: #e8eef8;
}
.si-btn {
  display: inline-flex; align-items: center; justify-content: center;
  padding: .65rem 1.25rem; border-radius: 4px; font-weight: 700; font-size: .88rem;
  border: none; cursor: pointer; font-family: inherit;
  background: #fff !important; color: #0a1f4d !important;
  box-shadow: 0 2px 10px rgba(0,0,0,.12);
}
.si-btn:hover { background: #e8eef8 !important; }
.si-hero__nav {
  position: absolute; top: 50%; transform: translateY(-50%); z-index: 5;
  width: 36px; height: 36px; border-radius: 50%; border: none; cursor: pointer;
  background: rgba(255,255,255,.88); color: var(--navy); font-size: 1.15rem; font-weight: 700;
  display: grid; place-items: center; box-shadow: 0 4px 12px rgba(0,0,0,.12);
}
.si-hero__nav.prev { left: 14px; }
.si-hero__nav.next { right: 14px; }
.si-hero__dots {
  position: absolute; bottom: 16px; left: 50%; transform: translateX(-50%); z-index: 5;
  display: flex; align-items: center; gap: 6px;
}
.si-hero__dot {
  width: 7px; height: 7px; border-radius: 50%; border: none; padding: 0;
  background: rgba(255,255,255,.45); cursor: pointer;
  transition: width .25s ease, border-radius .25s ease, background .25s ease;
}
.si-hero__dot.is-on { background: #fff; width: 18px; border-radius: 999px; }
.si-vid {
  width: 100%; max-width: min(1680px, 100%); margin: 0 auto;
  padding: 1rem clamp(0.75rem, 2vw, 1.5rem) 1.25rem; box-sizing: border-box;
}
.si-vid__frame {
  position: relative; width: 100%; aspect-ratio: 16 / 9;
  border-radius: 16px; overflow: hidden; background: #000;
  box-shadow: 0 8px 28px rgba(15,23,42,.12);
}
.si-vid__frame iframe {
  position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block;
}
.si-vid__hint {
  margin: .45rem 0 0; font-size: .78rem; color: var(--muted); text-align: center;
}
.si-insights {
  width: 100%; margin: 0; padding: 1.75rem 1.5rem 2rem; text-align: center; box-sizing: border-box;
}
.si-insights h2 {
  margin: 0 0 .35rem; font-size: clamp(1.25rem, 2.2vw, 1.55rem); font-weight: 700; color: var(--ink);
}
.si-insights > p {
  margin: 0 auto 1.25rem; max-width: 42rem; font-size: .9rem; line-height: 1.5; color: var(--muted);
}
.si-cards {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; text-align: left;
  width: 100%; max-width: min(1680px, 100%); margin: 0 auto;
  padding: 0 clamp(0.5rem, 2vw, 1.25rem); box-sizing: border-box;
}
.si-card {
  background: #fff; border-radius: 12px; overflow: hidden;
  border: 1px solid #eef1f6;
  transition: transform .15s ease, box-shadow .15s ease;
  min-width: 0;
}
.si-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(10,31,77,.1); }
.si-card__img {
  width: 100%; aspect-ratio: 16/9; object-fit: cover; display: block; background: #d8e2ee;
}
.si-card__body { padding: .7rem .85rem .85rem; }
.si-card__type { font-size: .68rem; font-weight: 600; color: var(--muted); margin: 0 0 .15rem; }
.si-card h3 { margin: 0 0 .25rem; font-size: .92rem; font-weight: 700; line-height: 1.3; color: var(--ink); }
.si-card p { margin: 0; font-size: .78rem; line-height: 1.4; color: var(--muted); }
.si-modal-bg {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(7, 22, 54, .55); backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center; padding: 1.25rem;
}
.si-modal {
  width: 100%; max-width: 380px; background: #fff; border-radius: 12px;
  padding: 1.35rem 1.25rem 1.2rem; box-shadow: 0 20px 50px rgba(7,22,54,.25); position: relative;
}
.si-modal__close {
  position: absolute; top: .6rem; right: .7rem;
  width: 28px; height: 28px; border: 0; border-radius: 50%;
  background: #f0f4f9; color: var(--ink); font-size: 1.1rem; cursor: pointer;
  display: grid; place-items: center; line-height: 1;
}
.si-modal h3 { margin: 0 0 .2rem; font-size: 1.15rem; font-weight: 700; text-align: center; }
.si-modal > p { margin: 0 0 .95rem; font-size: .82rem; color: var(--muted); text-align: center; }
.si-error {
  margin-bottom: .75rem; padding: .55rem .7rem; border-left: 4px solid #e31837;
  border-radius: 6px; background: #fdecee; color: #9b1027; font-size: .82rem;
}
.si-field { margin-bottom: .75rem; }
.si-label {
  display: block; margin-bottom: .25rem; font-weight: 700; font-size: .65rem;
  letter-spacing: .08em; text-transform: uppercase; color: #07649d;
}
.si-input {
  display: block; width: 100%; padding: .65rem .8rem; border: 1.5px solid #d0dce8;
  border-radius: 7px; background: #f7f9fc; color: var(--ink); font: inherit; font-size: .9rem;
  box-sizing: border-box;
}
.si-input:focus {
  outline: none; border-color: #00a4e4; box-shadow: 0 0 0 3px rgba(0,164,228,.12); background: #fff;
}
.si-submit {
  width: 100%; margin-top: .15rem; padding: .72rem 1rem; border: 0; border-radius: 7px;
  background: var(--navy); color: #fff; font: inherit; font-weight: 700; font-size: .9rem; cursor: pointer;
}
.si-submit:hover { background: #123066; }
@@media (max-width: 1100px) { .si-cards { grid-template-columns: repeat(3, 1fr); } }
@@media (max-width: 800px) {
  .si-cards { grid-template-columns: 1fr 1fr; }
  .si-search { max-width: none; order: 3; flex-basis: 100%; }
  .si-hero { min-height: clamp(300px, 42vh, 420px); }
}
@@media (max-width: 520px) { .si-cards { grid-template-columns: 1fr; max-width: 100%; padding: 0 .75rem; } }
</style>

<div class="si">
    <header class="si-top">
        <form class="si-search" @onsubmit="HandleSearch" @onsubmit:preventDefault>
            <input type="search" @bind="searchQ" placeholder="Search" aria-label="Search" />
            <button type="submit" title="Search">⌕</button>
        </form>
        <button type="button" class="si-top__sign" @onclick="OpenLogin">Sign in</button>
    </header>

    <section class="si-hero" aria-label="Featured">
        @for (var i = 0; i < heroes.Length; i++)
        {
            var h = heroes[i];
            <div class="si-hero__slide @(i == heroIndex ? "is-on" : null)" style="background-image:url('@h.Image')">
                <div class="si-hero__shade"></div>
                <div class="si-hero__inner">
                    <div class="si-hero__crumb">@h.Crumb</div>
                    <h1>@h.Title</h1>
                    <p>@h.Caption</p>
                    <a class="si-btn" href="@h.PrimaryHref">@h.PrimaryLabel</a>
                </div>
            </div>
        }
        <button type="button" class="si-hero__nav prev" @onclick="PrevHero" aria-label="Previous">‹</button>
        <button type="button" class="si-hero__nav next" @onclick="NextHero" aria-label="Next">›</button>
        <div class="si-hero__dots">
            @for (var i = 0; i < heroes.Length; i++)
            {
                var di = i;
                <button type="button" class="si-hero__dot @(i == heroIndex ? "is-on" : null)" @onclick="() => heroIndex = di" aria-label="Slide @(i+1)"></button>
            }
        </div>
    </section>

    <div class="si-vid">
        <div class="si-vid__frame">
            <iframe src="@VideoEmbed" title="ISACA videos"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
        <p class="si-vid__hint">Videos play automatically and loop nonstop. Starts muted — use the volume control to unmute.</p>
    </div>

    <section class="si-insights">
        <h2>Stay ahead with ISACA insights and thought leadership</h2>
        <p>Explore digital trust assets, frameworks, white papers and resources for your career.</p>
        <div class="si-cards">
            <a class="si-card" href="https://www.isaca.org/resources/white-papers/2026/security-debt-the-unseen-risk-undermining-cyber-resilience" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">White Paper</div>
                    <h3>Security Debt: The Unseen Risk</h3>
                    <p>Where security debt comes from and its impact on resilience.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/resources/isaca-journal/issues/2026/volume-6" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">ISACA Journal</div>
                    <h3>Volume 6, 2026</h3>
                    <p>Managing risk in emerging tech and more.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/store2/product/WPAIAT" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">Tool</div>
                    <h3>AI Impact Assessment Tool</h3>
                    <p>Ethical consequences of AI projects.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/resources/white-papers/2025/leveraging-cobit-for-effective-ai-system-governance" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">White Paper</div>
                    <h3>COBIT for AI System Governance</h3>
                    <p>Govern AI systems with the COBIT framework.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/credentialing/cisa" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1507679799987-c73779587ccf?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">Credential</div>
                    <h3>CISA</h3>
                    <p>Audit and assess information systems.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/credentialing/cism" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">Credential</div>
                    <h3>CISM</h3>
                    <p>Design enterprise security programs.</p>
                </div>
            </a>
            <a class="si-card" href="https://www.isaca.org/credentialing/crisc" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">Credential</div>
                    <h3>CRISC</h3>
                    <p>Manage IT risk and implement controls.</p>
                </div>
            </a>
            <a class="si-card" href="https://trainotracksolutions.weebly.com/blog/top-isaca-certifications-for-professionals" target="_blank" rel="noopener">
                <img class="si-card__img" src="https://images.unsplash.com/photo-1434030216411-0b793f4b4173?auto=format&fit=crop&w=640&q=80" alt="" loading="lazy" />
                <div class="si-card__body">
                    <div class="si-card__type">Guide</div>
                    <h3>Top ISACA certifications</h3>
                    <p>CISA, CISM, CRISC, CGEIT, CDPSE paths.</p>
                </div>
            </a>
        </div>
    </section>
</div>

@if (showLogin)
{
    <div class="si-modal-bg" @onclick="CloseLogin">
        <div class="si-modal" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="si-login-title">
            <button type="button" class="si-modal__close" @onclick="CloseLogin" aria-label="Close">×</button>
            <h3 id="si-login-title">Sign in</h3>
            <p>Use the email and password for your TRU account.</p>
            @if (ErrorMessage is not null)
            {
                <div class="si-error" role="alert">@ErrorMessage</div>
            }
            <form method="post" action="/account/login">
                <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
                <div class="si-field">
                    <label class="si-label" for="signin-email">Email address</label>
                    <input id="signin-email" class="si-input" name="email" type="email" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" required value="@Input.Email" />
                </div>
                <div class="si-field">
                    <label class="si-label" for="signin-password">Password</label>
                    <input id="signin-password" class="si-input" name="password" type="password" autocomplete="current-password" required />
                </div>
                <button type="submit" class="si-submit">Sign in</button>
            </form>
        </div>
    </div>
}

@code {
    private SignInInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "error")] private string? ErrorCode { get; set; }
    private string? ErrorMessage { get; set; }
    private string searchQ = "";
    private int heroIndex;
    private bool showLogin;
    private System.Threading.Timer? heroTimer;

    private record Hero(string Crumb, string Title, string Caption, string Image, string PrimaryLabel, string PrimaryHref);
    private static readonly string[] VideoIds =
    {
        "Chw9iTTHyhk", "0Y9WFhfsQlk", "wi2be8nt6lw", "GWUrA8DpTOk",
        "cJpY4wHTKxo", "KSEdwhUTxCk", "em8vqDlINqU", "nOPTmNSsYJg"
    };
    private string VideoEmbed =>
        $"https://www.youtube-nocookie.com/embed/{VideoIds[0]}"
        + "?autoplay=1&mute=1&rel=0&modestbranding=1&playsinline=1&controls=1&fs=1"
        + $"&playlist={string.Join(",", VideoIds)}&loop=1";

    private static readonly Hero[] heroes =
    {
        new("Home", "Empowering your chapter",
            "Guides, knowledge, events, and tools for ISACA chapter officers and volunteers.",
            "https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=85",
            "Open resource library", "/resource-library"),
        new("Home · Events", "Mark your calendar",
            "Plan webinars, meetups, and CPE sessions with the Events workspace.",
            "https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&w=1600&q=85",
            "View events", "/events"),
        new("Home · Knowledge", "The leader's compass",
            "Approved chapter guidance and certification paths for your team.",
            "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1600&q=85",
            "Knowledge base", "/knowledge-base"),
        new("Home · Resources", "Advance trust in technology",
            "Policies, frameworks, and market context for chapter leaders.",
            "https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=85",
            "Market trends", "/market-trends"),
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(ErrorCode))
        {
            ErrorMessage = ErrorCode switch
            {
                "credentials" => "That email and password don't match a TRU account.",
                "config" => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
            showLogin = true;
        }
        StartTimer();
    }

    private void OpenLogin() { showLogin = true; }
    private void CloseLogin() { showLogin = false; }

    private void StartTimer()
    {
        heroTimer?.Dispose();
        heroTimer = new System.Threading.Timer(_ =>
        {
            heroIndex = (heroIndex + 1) % heroes.Length;
            _ = InvokeAsync(StateHasChanged);
        }, null, 6500, 6500);
    }

    private void PrevHero() => heroIndex = heroIndex == 0 ? heroes.Length - 1 : heroIndex - 1;
    private void NextHero() => heroIndex = (heroIndex + 1) % heroes.Length;

    private void HandleSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQ)) return;
        var q = searchQ.Trim().ToLowerInvariant();
        if (q.Contains("event") || q.Contains("calendar")) Navigation.NavigateTo("/events");
        else if (q.Contains("knowledge") || q.Contains("article")) Navigation.NavigateTo("/knowledge-base");
        else if (q.Contains("market") || q.Contains("trend")) Navigation.NavigateTo("/market-trends");
        else if (q.Contains("contact")) Navigation.NavigateTo("/contact");
        else Navigation.NavigateTo("/resource-library");
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    public void Dispose() => heroTimer?.Dispose();

    private sealed class SignInInput
    {
        public string Email { get; set; } = "staff.dev@example.org";
        public string Password { get; set; } = string.Empty;
    }
}
