@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

<PageTitle>Sign in | TRU</PageTitle>

<style>
html,body{margin:0!important;padding:0!important}
.signin{--ink:#24436b;--pale:#eaf4fb;--teal:#239f9a;--muted:#71839a;--line:#dfe9f1;display:grid!important;grid-template-columns:minmax(0,1.05fr) minmax(380px,.95fr)!important;width:100%!important;min-height:100vh!important;min-height:100dvh!important;margin:0!important;background:#fff;font-family:"Roboto",system-ui,sans-serif;color:var(--ink)}
.signin__brand{position:relative;display:flex!important;align-items:center!important;justify-content:center!important;min-height:100vh!important;min-height:100dvh!important;overflow:hidden!important;background:linear-gradient(145deg,#f7fbfe 0%,#eaf5fb 55%,#f8fcff 100%)!important}
.signin__panel{display:flex!important;align-items:center!important;justify-content:center!important;min-height:100vh!important;min-height:100dvh!important;padding:2.5rem 2rem;background:#fff!important;box-sizing:border-box}
.signin__card{width:100%;max-width:390px;background:#fff;border-radius:18px;padding:2.1rem 2rem;border:1px solid var(--line);box-shadow:0 14px 40px rgba(36,67,107,.07)}
.signin__title{margin:0 0 .4rem;font-size:1.8rem;font-weight:700;color:var(--ink)}
.signin__lede{margin:0 0 1.5rem;color:var(--muted);font-size:.92rem}
.signin__error{margin-bottom:1rem;padding:.75rem .9rem;border-left:4px solid var(--teal);border-radius:8px;background:var(--pale);color:var(--ink);font-size:.88rem}
.signin__field{margin-bottom:1.05rem}
.signin__label{display:block;margin-bottom:.4rem;font-weight:700;font-size:.72rem;letter-spacing:.06em;text-transform:uppercase;color:#52728f}
.signin__input,.signin__field input{display:block;width:100%;padding:.8rem .9rem;border:1px solid #d5e3ed;border-radius:10px;background:#f5f9fc;color:var(--ink);font:inherit;font-size:.95rem;box-sizing:border-box}
.signin__input:focus,.signin__field input:focus{outline:none;border-color:var(--teal);box-shadow:0 0 0 3px rgba(35,159,154,.13);background:#fff}
.signin__submit{width:100%;margin-top:.3rem;padding:.85rem 1rem;border:0;border-radius:10px;background:var(--ink);color:#fff;font:inherit;font-weight:700;font-size:.95rem;cursor:pointer}
.signin__submit:hover{background:var(--teal)}
.signin__note{margin:1.2rem 0 0;font-size:.8rem;line-height:1.6;color:#8494a8}
.signin__back{display:inline-block;margin-top:1rem;color:var(--teal);font-weight:700;font-size:.88rem;text-decoration:none}
.signin__back:hover{color:var(--ink);text-decoration:underline}

.signin__orbitStage{position:relative!important;display:grid!important;place-items:center!important;width:min(72vw,610px)!important;height:min(72vw,610px)!important;max-height:78vh!important;isolation:isolate}
.signin__orbitStage:before{content:"";position:absolute;inset:20%;border-radius:50%;background:radial-gradient(circle,rgba(35,159,154,.10),rgba(234,244,251,.02) 65%,transparent 72%);z-index:-1}
.signin__orbits{position:absolute!important;inset:0!important;display:block!important;pointer-events:none}
.signin__orbit{position:absolute!important;left:50%!important;top:50%!important;border:1px solid rgba(36,67,107,.16)!important;border-radius:50%!important;transform:translate(-50%,-50%) rotate(-18deg)!important;animation:tru-orbit-breathe 8s ease-in-out infinite alternate}
.signin__orbit:nth-child(1){width:20%;height:20%;animation-delay:-.5s}
.signin__orbit:nth-child(2){width:29%;height:29%;animation-delay:-1s}
.signin__orbit:nth-child(3){width:38%;height:38%;animation-delay:-1.5s}
.signin__orbit:nth-child(4){width:47%;height:47%;animation-delay:-2s}
.signin__orbit:nth-child(5){width:56%;height:56%;animation-delay:-2.5s}
.signin__orbit:nth-child(6){width:65%;height:65%;animation-delay:-3s}
.signin__orbit:nth-child(7){width:74%;height:74%;animation-delay:-3.5s}
.signin__orbit:nth-child(8){width:83%;height:83%;animation-delay:-4s}
.signin__orbit:nth-child(9){width:92%;height:92%;animation-delay:-4.5s}
.signin__core{position:relative!important;z-index:5!important;width:clamp(145px,19vw,205px)!important;height:clamp(145px,19vw,205px)!important;display:grid;place-items:center}
.signin__sphere{width:100%!important;height:100%!important;border-radius:50%!important;background:#fff!important;border:7px solid rgba(255,255,255,.96)!important;box-shadow:0 12px 34px rgba(36,67,107,.13),0 0 0 1px #dcecf4!important;display:grid!important;place-items:center!important;overflow:hidden}
.signin__logoSvg{width:100%;height:100%;display:block}
.signin__planet{position:absolute;left:50%;top:50%;width:100%;height:100%;pointer-events:none;transform:translate(-50%,-50%);animation:tru-planet-spin var(--orbit-duration,24s) linear infinite;z-index:4}
.signin__planet:after{content:"";position:absolute;left:50%;top:4%;width:clamp(6px,.8vw,10px);height:clamp(6px,.8vw,10px);border-radius:50%;background:var(--planet-color,#239f9a);box-shadow:0 0 0 4px rgba(35,159,154,.10),0 2px 7px rgba(36,67,107,.16);transform:translateX(-50%)}
.signin__planet:nth-of-type(2){--orbit-duration:18s;--planet-color:#239f9a;transform:translate(-50%,-50%) rotate(16deg)}
.signin__planet:nth-of-type(3){--orbit-duration:23s;--planet-color:#5b9bd5;transform:translate(-50%,-50%) rotate(56deg)}
.signin__planet:nth-of-type(4){--orbit-duration:29s;--planet-color:#6bbf8a;transform:translate(-50%,-50%) rotate(96deg)}
.signin__planet:nth-of-type(5){--orbit-duration:34s;--planet-color:#80b8d8;transform:translate(-50%,-50%) rotate(136deg)}
.signin__planet:nth-of-type(6){--orbit-duration:39s;--planet-color:#239f9a;transform:translate(-50%,-50%) rotate(176deg)}
.signin__planet:nth-of-type(7){--orbit-duration:44s;--planet-color:#6bbf8a;transform:translate(-50%,-50%) rotate(216deg)}
.signin__planet:nth-of-type(8){--orbit-duration:49s;--planet-color:#5b9bd5;transform:translate(-50%,-50%) rotate(256deg)}
.signin__planet:nth-of-type(9){--orbit-duration:54s;--planet-color:#80b8d8;transform:translate(-50%,-50%) rotate(296deg)}
.signin__planet:nth-of-type(10){--orbit-duration:59s;--planet-color:#239f9a;transform:translate(-50%,-50%) rotate(326deg)}

@@keyframes tru-orbit-breathe{from{opacity:.48}to{opacity:1}}
@@keyframes tru-planet-spin{from{transform:translate(-50%,-50%) rotate(0deg)}to{transform:translate(-50%,-50%) rotate(360deg)}}
@@media(max-width:900px){
  .signin{grid-template-columns:1fr!important}
  .signin__brand{min-height:280px!important}
  .signin__orbitStage{width:min(80vw,360px)!important;height:min(80vw,360px)!important;max-height:none!important}
  .signin__core{width:130px!important;height:130px!important}
  .signin__panel{min-height:auto!important;padding:1.5rem 1.1rem 2rem}
  .signin__card{padding:1.6rem 1.3rem}
}
@@media(prefers-reduced-motion:reduce){
  .signin__orbit,.signin__planet{animation:none!important}
  .signin__submit{transition:none}
}
</style>

<div class="signin">
    <aside class="signin__brand">
        <div class="signin__orbitStage" aria-label="TRU logo surrounded by nine orbiting planets">
            <div class="signin__orbits" aria-hidden="true">
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
                <span class="signin__orbit"></span><span class="signin__orbit"></span><span class="signin__orbit"></span>
            </div>
            <span class="signin__planet" aria-hidden="true"></span><span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span><span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span><span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span><span class="signin__planet" aria-hidden="true"></span>
            <span class="signin__planet" aria-hidden="true"></span>
            <div class="signin__core">
                <div class="signin__sphere" role="img" aria-label="TRU logo">
                    <svg class="signin__logoSvg" viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-labelledby="truLogoTitle">
                        <title id="truLogoTitle">TRU logo</title>
                        <defs>
                            <linearGradient id="truLogoGreen" x1="0" y1="1" x2="1" y2="0"><stop offset="0" stop-color="#20a957"/><stop offset=".55" stop-color="#48c94e"/><stop offset="1" stop-color="#b5e96c"/></linearGradient>
                            <linearGradient id="truLogoBlue" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#087ac1"/><stop offset=".55" stop-color="#00b8d9"/><stop offset="1" stop-color="#35d5c4"/></linearGradient>
                        </defs>
                        <circle cx="100" cy="100" r="96" fill="#fff"/>
                        <ellipse cx="86" cy="100" rx="57" ry="77" transform="rotate(24 86 100)" fill="url(#truLogoBlue)"/>
                        <ellipse cx="115" cy="100" rx="57" ry="77" transform="rotate(-24 115 100)" fill="url(#truLogoGreen)"/>
                        <ellipse cx="100" cy="100" rx="49" ry="69" transform="rotate(10 100 100)" fill="#0e8c9c" opacity=".72"/>
                        <ellipse cx="100" cy="100" rx="44" ry="62" fill="url(#truLogoGreen)" stroke="#dff7e6" stroke-width="3"/>
                        <path d="M54 71 C70 43 110 34 135 56" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round" opacity=".9"/>
                        <path d="M63 139 C91 166 128 145 142 119" fill="none" stroke="#d8fff0" stroke-width="5" stroke-linecap="round" opacity=".8"/>
                        <text x="100" y="111" text-anchor="middle" font-family="Georgia,serif" font-size="37" font-weight="bold" letter-spacing="2" fill="#fff" stroke="#0e827e" stroke-width=".8" paint-order="stroke">TRU</text>
                    </svg>
                </div>
            </div>
        </div>
    </aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">Sign in</h1>
            <p class="signin__lede">Use the email and password for your TRU account.</p>
            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }
            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in" class="signin__form">
                    <DataAnnotationsValidator />
                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="signin__input" @bind-Value="Input.Email" type="text" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="signin__input" @bind-Value="Input.Password" type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="signin__submit">Sign in</button>
                </EditForm>
            }
            <p class="signin__note">TRU is a prototype. Test accounts are set up by the project team.</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; Back to TRU home</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromForm(FormName = "isa-sign-in")] private SignInInput? Input { get; set; }
    protected override void OnInitialized() => Input ??= new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")] public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")] public string Password { get; set; } = string.Empty;
    }
}
