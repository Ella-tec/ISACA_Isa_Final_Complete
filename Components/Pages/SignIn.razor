        <a class="si-top__brand" href="/sign-in">
            <span class="mark">TRU</span>
            <span class="txt"><strong>TRU</strong><small>Learn · Ask · Grow</small></span>
        </a>
        <button type="button" class="si-top__sign" @onclick="OpenLogin">Sign in →</button>
    </header>

    <section class="si-hero">
