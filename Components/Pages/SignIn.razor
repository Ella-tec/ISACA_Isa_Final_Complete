@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

@* Sign-in: top-left brand text + animated crossing Cs (user HTML) *@

<PageTitle>Sign in | Isa</PageTitle>

<div class="signin">

    <aside class="signin__brand">
        @* Text stays top-left, separate from the Cs *@
        <div class="signin__brandInner">
            <p class="signin__brandName">Isa</p>
            <p class="signin__brandTag">Chapter Support Assistant</p>
            <p class="signin__brandLine">@Text.BrandLine</p>
        </div>

        @* Exact crossing-C animation from provided HTML *@
        <div class="signin__logoStage" aria-hidden="true">
            <div class="signin__logo">
                <div class="signin__c signin__c--blue"></div>
                <div class="signin__c signin__c--green"></div>
                <div class="signin__cGlow"></div>
            </div>
        </div>
    </aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">@Text.Title</h1>
            <p class="signin__lede">@Text.Lede</p>

            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }

            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in" class="signin__form">
                    <DataAnnotationsValidator />

                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">@Text.EmailLabel</label>
                        <InputText id="signin-email"
                                   class="signin__input"
                                   @bind-Value="Input.Email"
                                   type="text"
                                   inputmode="email"
                                   autocomplete="username"
                                   autocapitalize="none"
                                   spellcheck="false"
                                   dir="auto" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>

                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">@Text.PasswordLabel</label>
                        <InputText id="signin-password"
                                   class="signin__input"
                                   @bind-Value="Input.Password"
                                   type="password"
                                   autocomplete="current-password"
                                   dir="auto" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>

                    <button type="submit" class="signin__submit">@Text.SubmitButton</button>
                </EditForm>
            }

            <p class="signin__note">@Text.PrototypeNote</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; @Text.BackLink</a>
        </div>
    </main>

</div>

@code {
    private static class Text
    {
        public const string BrandLine = "Answers from ISACA's approved chapter guidance, with the sources to prove it.";
        public const string Title = "Sign in";
        public const string Lede = "Use the email address and password for your Isa account.";
        public const string EmailLabel = "Email address";
        public const string PasswordLabel = "Password";
        public const string SubmitButton = "Sign in";
        public const string PrototypeNote = "Isa is a prototype. Test accounts are set up by the project team.";
        public const string BackLink = "Back to Isa home";
        public const string EmailRequired = "Enter your email address.";
        public const string PasswordRequired = "Enter your password.";
        public const string WrongCredentials = "That email address and password don't match an Isa account. Check them and try again.";
        public const string ServiceUnavailable = "The sign-in service isn't reachable right now. Please try again in a few minutes.";
        public const string NotConfigured = "Sign-in isn't set up on this server yet. A developer can find the details in the app log.";
    }

    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "isa-sign-in")]
    private SignInInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        var result = await SignInService.SignInAsync(Input.Email, Input.Password);

        if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
        {
            await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
            Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
            return;
        }

        ErrorMessage = result.Outcome switch
        {
            SignInOutcome.WrongCredentials => Text.WrongCredentials,
            SignInOutcome.NotConfigured => Text.NotConfigured,
            _ => Text.ServiceUnavailable
        };

        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl)
        && ReturnUrl.StartsWith('/')
        && !ReturnUrl.StartsWith("//")
        && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl
            : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = Text.EmailRequired)]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = Text.PasswordRequired)]
        public string Password { get; set; } = string.Empty;
    }
}
