@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Sign in | TRU</PageTitle>

<style>
html, body { margin: 0 !important; padding: 0 !important; background: #f4f8fc !important; }
.si {
  --ink: #0f2744; --navy: #0a2a5c; --blue: #1a6bb5; --green: #2db87a; --muted: #5a6f88; --line: #e2eaf3;
  font-family: "DM Sans", "Roboto", system-ui, sans-serif; color: var(--ink);
  min-height: 100vh; background:
    radial-gradient(ellipse 80% 50% at 10% -10%, rgba(45,184,122,.12), transparent 50%),
    radial-gradient(ellipse 60% 40% at 100% 0%, rgba(26,107,181,.1), transparent 45%),
    #f4f8fc;
}
.si a { text-decoration: none; color: inherit; }

.si-top {
  display: flex; align-items: center; justify-content: space-between;
  gap: 1rem; padding: .85rem 1.5rem; flex-wrap: wrap;
}
.si-top__brand { display: flex; align-items: center; gap: .65rem; }
.si-top__brand .mark {
  width: 44px; height: 44px; border-radius: 14px;
  background: linear-gradient(145deg, #1a6bb5 0%, #2db87a 55%, #f0b429 100%);
  display: grid; place-items: center; color: #fff; font-weight: 800; font-size: .72rem;
  box-shadow: 0 6px 18px rgba(26,107,181,.25);
}
.si-top__brand .txt strong { display: block; font-size: 1.2rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.1; }
.si-top__brand .txt small { display: block; font-size: .72rem; color: var(--muted); font-weight: 600; margin-top: .1rem; }
.si-top__sign {
  display: inline-flex; align-items: center; gap: .35rem;
  padding: .55rem 1.25rem; border-radius: 999px;
  background: linear-gradient(135deg, #0a2a5c, #1a6bb5); color: #fff;
  font-weight: 700; font-size: .88rem; border: 0; cursor: pointer; font-family: inherit;
  box-shadow: 0 6px 16px rgba(10,42,92,.22);
}
.si-top__sign:hover { filter: brightness(1.08); }

.si-hero {
  max-width: 720px; margin: 0 auto; padding: 2rem 1.25rem 1.5rem; text-align: center;
}
.si-hero__logo {
  width: 72px; height: 72px; margin: 0 auto 1rem; border-radius: 22px;
  background: linear-gradient(145deg, #1a6bb5 0%, #2db87a 50%, #f0b429 100%);
  display: grid; place-items: center; color: #fff; font-weight: 800; font-size: 1.1rem;
  box-shadow: 0 12px 32px rgba(26,107,181,.28);
}
.si-hero h1 {
  margin: 0 0 .35rem; font-size: clamp(1.75rem, 4vw, 2.4rem); font-weight: 800;
  letter-spacing: -.03em; color: var(--ink);
}
.si-hero .tag {
  margin: 0 0 .75rem; font-size: 1.05rem; font-weight: 700; color: var(--blue);
  letter-spacing: .02em;
}
.si-hero p {
  margin: 0 auto 1.5rem; max-width: 28rem; font-size: .98rem; line-height: 1.55; color: var(--muted);
}
.si-hero__actions { display: flex; flex-wrap: wrap; gap: .65rem; justify-content: center; }
.si-btn-primary {
  display: inline-flex; align-items: center; gap: .4rem;
  padding: .75rem 1.6rem; border-radius: 999px; border: 0; cursor: pointer;
  background: linear-gradient(135deg, #0a2a5c, #1a6bb5); color: #fff;
  font: inherit; font-weight: 700; font-size: .95rem;
  box-shadow: 0 8px 22px rgba(10,42,92,.25);
}
.si-btn-primary:hover { filter: brightness(1.06); }
.si-btn-ghost {
  display: inline-flex; align-items: center;
  padding: .72rem 1.4rem; border-radius: 999px;
  border: 1.5px solid var(--line); background: #fff; color: var(--ink);
  font: inherit; font-weight: 700; font-size: .92rem; cursor: pointer;
}
.si-btn-ghost:hover { border-color: #b8d0e8; background: #f7fafc; }

.si-pillars {
  max-width: 900px; margin: 0 auto 2rem; padding: 0 1.25rem;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: .85rem;
}
.si-pillar {
  background: #fff; border: 1px solid var(--line); border-radius: 16px;
  padding: 1.15rem 1rem; text-align: center;
  box-shadow: 0 4px 16px rgba(15,39,68,.04);
}
.si-pillar .ico {
  width: 42px; height: 42px; margin: 0 auto .65rem; border-radius: 12px;
  display: grid; place-items: center; font-size: 1.15rem;
}
.si-pillar h3 { margin: 0 0 .3rem; font-size: .95rem; font-weight: 700; }
.si-pillar p { margin: 0; font-size: .8rem; color: var(--muted); line-height: 1.4; }

.si-insights {
  max-width: 1100px; margin: 0 auto; padding: 0 1.25rem 2.5rem; text-align: center;
}
.si-insights h2 {
  margin: 0 0 .4rem; font-size: 1.25rem; font-weight: 800; color: var(--ink);
}
.si-insights > p { margin: 0 auto 1.15rem; max-width: 36rem; font-size: .9rem; color: var(--muted); }
.si-cards {
  display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; text-align: left;
}
.si-card {
  background: #fff; border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  transition: transform .15s, box-shadow .15s;
}
.si-card:hover { transform: translateY(-2px); box-shadow: 0 10px 24px rgba(15,39,68,.08); }
.si-card__img { width: 100%; aspect-ratio: 16/10; object-fit: cover; display: block; background: #d8e2ee; }
.si-card__body { padding: .6rem .7rem .75rem; }
.si-card__type { font-size: .65rem; font-weight: 700; color: var(--blue); margin: 0 0 .15rem; text-transform: uppercase; letter-spacing: .04em; }
.si-card h3 { margin: 0 0 .2rem; font-size: .84rem; font-weight: 700; line-height: 1.25; }
.si-card p { margin: 0; font-size: .74rem; line-height: 1.4; color: var(--muted); }

.si-features {
  max-width: 900px; margin: 0 auto 2rem; padding: 0 1.25rem;
  display: flex; flex-wrap: wrap; gap: .55rem; justify-content: center;
}
.si-features span {
  display: inline-flex; align-items: center; gap: .35rem;
  padding: .4rem .85rem; border-radius: 999px; background: #fff;
  border: 1px solid var(--line); font-size: .78rem; font-weight: 600; color: var(--ink);
}

.si-foot {
  text-align: center; padding: 1rem; font-size: .75rem; color: #8a9bb0;
  border-top: 1px solid var(--line); background: rgba(255,255,255,.6);
}

.si-modal-bg {
  position: fixed; inset: 0; z-index: 1000;
  background: rgba(10, 30, 60, .5); backdrop-filter: blur(5px);
  display: flex; align-items: center; justify-content: center; padding: 1.25rem;
}
.si-modal {
  width: 100%; max-width: 380px; background: #fff; border-radius: 18px;
  padding: 1.5rem 1.35rem 1.3rem; box-shadow: 0 24px 60px rgba(10,30,60,.28); position: relative;
}
.si-modal__close {
  position: absolute; top: .65rem; right: .75rem;
  width: 30px; height: 30px; border: 0; border-radius: 50%;
  background: #f0f4f9; color: var(--ink); font-size: 1.15rem; cursor: pointer;
  display: grid; place-items: center; line-height: 1;
}
.si-modal h3 { margin: 0 0 .2rem; font-size: 1.2rem; font-weight: 800; text-align: center; }
.si-modal > p { margin: 0 0 1rem; font-size: .84rem; color: var(--muted); text-align: center; }
.si-error {
  margin-bottom: .75rem; padding: .55rem .7rem; border-left: 4px solid #e31837;
  border-radius: 8px; background: #fdecee; color: #9b1027; font-size: .82rem;
}
.si-field { margin-bottom: .75rem; }
.si-label {
  display: block; margin-bottom: .25rem; font-weight: 700; font-size: .65rem;
  letter-spacing: .08em; text-transform: uppercase; color: var(--blue);
}
.si-input {
  display: block; width: 100%; padding: .7rem .85rem; border: 1.5px solid #d0dce8;
  border-radius: 10px; background: #f7f9fc; color: var(--ink); font: inherit; font-size: .92rem;
  box-sizing: border-box;
}
.si-input:focus {
  outline: none; border-color: #1a6bb5; box-shadow: 0 0 0 3px rgba(26,107,181,.15); background: #fff;
}
.si-submit {
  width: 100%; margin-top: .15rem; padding: .78rem 1rem; border: 0; border-radius: 10px;
  background: linear-gradient(135deg, #0a2a5c, #1a6bb5); color: #fff;
  font: inherit; font-weight: 700; font-size: .92rem; cursor: pointer;
}
.si-submit:hover { filter: brightness(1.06); }

@@media (max-width: 900px) {
  .si-cards { grid-template-columns: 1fr 1fr; }
  .si-pillars { grid-template-columns: 1fr; max-width: 360px; }
}
@@media (max-width: 520px) {
  .si-cards { grid-template-columns: 1fr; max-width: 320px; margin: 0 auto; }
}
</style>

