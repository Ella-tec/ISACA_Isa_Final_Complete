@page "/sign-in"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using IsaChatApp.Services
@inject KeycloakSignInService SignInService
@inject NavigationManager Navigation

<PageTitle>Sign in | TRU</PageTitle>

<style>
html, body { margin: 0 !important; padding: 0 !important; }
.signin {
  --navy-deep: #1d2d5c;
  --blue: #00a4e4;
  --mid: #07649d;
  --muted: #5f6b85;
  --line: #e2e8f0;
  display: grid !important;
  grid-template-columns: 1fr 1fr !important;
  width: 100% !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  margin: 0 !important;
  background: #f4f7fb;
  font-family: "Roboto", system-ui, sans-serif;
  color: var(--navy-deep);
}

.signin__brand {
  position: relative !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  overflow: hidden !important;
  background:
    radial-gradient(ellipse 55% 50% at 50% 50%, rgba(0, 164, 228, 0.12), transparent 60%),
    radial-gradient(circle at 50% 50%, rgba(8, 20, 40, 0.2), transparent 70%),
    linear-gradient(165deg, #050b14 0%, #0a1628 40%, #101e36 100%) !important;
}

.signin__lattice {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 32px;
  z-index: 5;
  pointer-events: none;
  background-color: #1a5c45;
  background-image:
    linear-gradient(45deg, #0f3d2e 25%, transparent 25%),
    linear-gradient(-45deg, #2d8a6a 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #6cb33f 75%),
    linear-gradient(-45deg, transparent 75%, #8fd15a 75%),
    linear-gradient(45deg, #36ac91 25%, transparent 25%),
    linear-gradient(-45deg, #4db89a 25%, transparent 25%),
    linear-gradient(45deg, transparent 75%, #a8d98a 75%),
    linear-gradient(-45deg, transparent 75%, #1f6b55 75%);
  background-size: 16px 16px;
  background-position: 0 0, 0 8px, 8px -8px, -8px 0, 0 0, 0 8px, 8px -8px, -8px 0;
  border-right: 2px solid #0a2e22;
}

/* Wider stage so rings have room */
.signin__orbitStage {
  position: relative;
  z-index: 3;
  width: min(460px, 82%);
  height: min(460px, 82%);
  display: grid;
  place-items: center;
}
.signin__orbits {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
}

/* Thin orbital paths — more space between each ring */
.signin__orbit {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(140, 190, 230, 0.22);
  box-sizing: border-box;
  animation: siOrbit linear infinite;
  box-shadow: 0 0 12px rgba(0, 164, 228, 0.04) inset;
}

/* ~12% gap between consecutive orbits for a planetary feel */
.signin__orbit--1 { width: 22%; height: 22%; animation-duration: 14s; border-color: rgba(0,164,228,.32); }
.signin__orbit--2 { width: 34%; height: 34%; animation-duration: 20s; animation-direction: reverse; border-color: rgba(100,180,220,.26); }
.signin__orbit--3 { width: 46%; height: 46%; animation-duration: 28s; border-color: rgba(80,160,210,.22); }
.signin__orbit--4 { width: 58%; height: 58%; animation-duration: 36s; animation-direction: reverse; border-color: rgba(70,150,200,.2); }
.signin__orbit--5 { width: 70%; height: 70%; animation-duration: 46s; border-color: rgba(90,170,215,.18); }
.signin__orbit--6 { width: 82%; height: 82%; animation-duration: 58s; animation-direction: reverse; border-color: rgba(60,140,190,.16); }
.signin__orbit--7 { width: 92%; height: 92%; animation-duration: 72s; border-color: rgba(120,180,220,.14); }
.signin__orbit--8 { width: 100%; height: 100%; animation-duration: 90s; animation-direction: reverse; border-color: rgba(150,200,230,.12); }
.signin__orbit--9 { width: 108%; height: 108%; animation-duration: 110s; border-color: rgba(180,210,240,.1); opacity: 0.85; }

/* Planet bodies on each orbit — different sizes/colors like a solar system */
.signin__planet {
  position: absolute;
  top: 0;
  left: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
}
.signin__orbit--1 .signin__planet {
  width: 7px; height: 7px;
  background: radial-gradient(circle at 30% 30%, #e8f6ff, #00a4e4 55%, #07649d);
  box-shadow: 0 0 10px rgba(0,164,228,.9), 0 0 2px #fff;
}
.signin__orbit--2 .signin__planet {
  width: 9px; height: 9px; left: 18%;
  background: radial-gradient(circle at 35% 30%, #b8f0e0, #36ac91 50%, #1a6b5a);
  box-shadow: 0 0 10px rgba(54,172,145,.85);
}
.signin__orbit--3 .signin__planet {
  width: 6px; height: 6px; left: 78%;
  background: radial-gradient(circle at 30% 30%, #d4f0a8, #6cb33f 55%, #3d6e20);
  box-shadow: 0 0 8px rgba(108,179,63,.8);
}
.signin__orbit--4 .signin__planet {
  width: 11px; height: 11px; left: 28%;
  background: radial-gradient(circle at 32% 28%, #cceeff, #00a4e4 45%, #054a7a);
  box-shadow: 0 0 12px rgba(0,164,228,.75), inset -2px -1px 3px rgba(0,0,0,.25);
}
.signin__orbit--5 .signin__planet {
  width: 8px; height: 8px; left: 88%;
  background: radial-gradient(circle at 30% 30%, #ffe8a8, #fbb034 50%, #c47810);
  box-shadow: 0 0 12px rgba(251,176,52,.9);
}
.signin__orbit--6 .signin__planet {
  width: 5px; height: 5px; left: 12%;
  background: radial-gradient(circle at 30% 30%, #dff6ff, #7ec8e8);
  box-shadow: 0 0 8px rgba(126,200,232,.7);
}
.signin__orbit--7 .signin__planet {
  width: 10px; height: 10px; left: 62%;
  background: radial-gradient(circle at 35% 30%, #a8f0dc, #36ac91 50%, #0d5c4a);
  box-shadow: 0 0 11px rgba(54,172,145,.75), inset -2px -1px 2px rgba(0,0,0,.2);
}
.signin__orbit--8 .signin__planet {
  width: 4px; height: 4px; left: 40%;
  background: radial-gradient(circle at 30% 30%, #fff, #c5d4e8);
  box-shadow: 0 0 6px rgba(255,255,255,.5);
  opacity: 0.9;
}
.signin__orbit--9 .signin__planet {
  width: 12px; height: 12px; left: 22%;
  background: radial-gradient(circle at 32% 28%, #e0f4ff, #00a4e4 40%, #0a4a7a 80%);
  box-shadow: 0 0 14px rgba(0,164,228,.7), inset -3px -2px 4px rgba(0,0,0,.3);
}

@@keyframes siOrbit {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Central planet (TRU) — sphere with atmosphere */
.signin__core {
  position: relative;
  z-index: 4;
  width: 14%;
  height: 14%;
  min-width: 68px;
  min-height: 68px;
  display: grid;
  place-items: center;
}
.signin__sphere {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background:
    radial-gradient(circle at 32% 28%, rgba(255,255,255,.45) 0%, transparent 28%),
    radial-gradient(circle at 50% 50%, #5ed4c4 0%, #00a4e4 38%, #36ac91 62%, #1a6b5a 100%);
  box-shadow:
    0 0 0 3px rgba(0, 164, 228, 0.25),
    0 0 0 8px rgba(0, 164, 228, 0.08),
    0 0 36px rgba(0, 164, 228, 0.45),
    0 0 60px rgba(54, 172, 145, 0.2),
    inset -6px -8px 16px rgba(0, 40, 60, 0.35),
    inset 4px 4px 12px rgba(255, 255, 255, 0.2);
  display: grid;
  place-items: center;
  animation: siPulse 5s ease-in-out infinite;
}
.signin__sphereText {
  font-family: "Roboto Slab", Georgia, serif;
  font-weight: 700;
  font-size: clamp(0.75rem, 1.8vw, 1.05rem);
  color: #fff;
  letter-spacing: 0.1em;
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.35);
}
@@keyframes siPulse {
  0%, 100% {
    box-shadow:
      0 0 0 3px rgba(0,164,228,.25), 0 0 0 8px rgba(0,164,228,.08),
      0 0 36px rgba(0,164,228,.4), 0 0 60px rgba(54,172,145,.18),
      inset -6px -8px 16px rgba(0,40,60,.35), inset 4px 4px 12px rgba(255,255,255,.2);
  }
  50% {
    box-shadow:
      0 0 0 4px rgba(0,164,228,.3), 0 0 0 12px rgba(0,164,228,.1),
      0 0 48px rgba(0,164,228,.55), 0 0 80px rgba(54,172,145,.25),
      inset -6px -8px 16px rgba(0,40,60,.35), inset 4px 4px 12px rgba(255,255,255,.25);
  }
}

.signin__panel {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  padding: 2.5rem 2rem;
  background: linear-gradient(180deg, #f7fafc 0%, #eef2f7 100%);
  box-sizing: border-box;
}
.signin__card {
  width: 100%; max-width: 400px; background: #fff; border-radius: 18px;
  padding: 1.75rem 1.85rem 1.6rem; border: 1px solid var(--line);
  box-shadow: 0 16px 48px rgba(29, 45, 92, 0.08);
}
.signin__title { margin: 0 0 0.35rem; font-size: 1.55rem; font-weight: 700; color: var(--navy-deep); }
.signin__lede { margin: 0 0 1.35rem; color: var(--muted); font-size: 0.92rem; }
.signin__error {
  margin-bottom: 1rem; padding: 0.75rem 0.9rem;
  border-left: 4px solid #e31837; border-radius: 8px;
  background: #fdecee; color: #9b1027; font-size: 0.88rem;
}
.signin__field { margin-bottom: 1.05rem; }
.signin__label {
  display: block; margin-bottom: 0.35rem; font-weight: 700;
  font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid);
}
.signin__input, .signin__field input {
  display: block; width: 100%; padding: 0.75rem 0.9rem;
  border: 1.5px solid #c9d3e0; border-radius: 10px;
  background: #f8fafc; color: var(--navy-deep);
  font: inherit; font-size: 0.95rem; box-sizing: border-box;
}
.signin__input:focus, .signin__field input:focus {
  outline: none; border-color: var(--blue);
  box-shadow: 0 0 0 4px rgba(0, 164, 228, 0.2); background: #fff;
}
.signin__submit {
  width: 100%; margin-top: 0.25rem; padding: 0.85rem 1rem;
  border: none; border-radius: 10px;
  background: linear-gradient(135deg, var(--navy-deep), var(--mid));
  color: #fff; font: inherit; font-weight: 600; font-size: 0.95rem; cursor: pointer;
}
.signin__submit:hover { filter: brightness(1.08); }
.signin__note { margin: 1.25rem 0 0; font-size: 0.8rem; color: var(--muted); }
.signin__back {
  display: inline-block; margin-top: 0.85rem;
  color: var(--mid); font-weight: 600; font-size: 0.88rem; text-decoration: none;
}
.signin__back:hover { color: var(--navy-deep); text-decoration: underline; }

@@media (max-width: 900px) {
  .signin { grid-template-columns: 1fr !important; }
  .signin__brand { min-height: 300px !important; }
  .signin__orbitStage { width: min(280px, 72vw); height: min(280px, 72vw); }
  .signin__panel { min-height: auto !important; padding: 1.75rem 1.25rem 2rem; }
}
@@media (prefers-reduced-motion: reduce) {
  .signin__orbit, .signin__sphere { animation: none !important; }
}
</style>

<div class="signin">
    <aside class="signin__brand">
        <div class="signin__lattice" aria-hidden="true"></div>

        <div class="signin__orbitStage">
            <div class="signin__orbits" aria-hidden="true">
                <div class="signin__orbit signin__orbit--1"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--2"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--3"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--4"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--5"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--6"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--7"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--8"><span class="signin__planet"></span></div>
                <div class="signin__orbit signin__orbit--9"><span class="signin__planet"></span></div>
            </div>
            <div class="signin__core">
                <div class="signin__sphere">
                    <span class="signin__sphereText">TRU</span>
                </div>
            </div>
        </div>
    </aside>

    <main class="signin__panel">
        <div class="signin__card">
            <h1 class="signin__title">Sign in</h1>
            <p class="signin__lede">Use the email and password for your TRU account.</p>

            @if (ErrorMessage is not null)
            {
                <div class="signin__error" role="alert">@ErrorMessage</div>
            }

            @if (Input is not null)
            {
                <EditForm Model="Input" method="post" OnValidSubmit="HandleSignInAsync" FormName="isa-sign-in" class="signin__form">
                    <DataAnnotationsValidator />
                    <div class="signin__field">
                        <label class="signin__label" for="signin-email">Email address</label>
                        <InputText id="signin-email" class="signin__input" @bind-Value="Input.Email"
                                   type="text" inputmode="email" autocomplete="username"
                                   autocapitalize="none" spellcheck="false" />
                        <ValidationMessage For="() => Input.Email" />
                    </div>
                    <div class="signin__field">
                        <label class="signin__label" for="signin-password">Password</label>
                        <InputText id="signin-password" class="signin__input" @bind-Value="Input.Password"
                                   type="password" autocomplete="current-password" />
                        <ValidationMessage For="() => Input.Password" />
                    </div>
                    <button type="submit" class="signin__submit">Sign in</button>
                </EditForm>
            }

            <p class="signin__note">TRU is a prototype. Test accounts are set up by the project team.</p>
            <a class="signin__back" href="/" data-enhance-nav="false">&larr; Back to TRU home</a>
        </div>
    </main>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm(FormName = "isa-sign-in")]
    private SignInInput? Input { get; set; }

    protected override void OnInitialized() => Input ??= new();

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    private string? ErrorMessage { get; set; }

    private async Task HandleSignInAsync()
    {
        if (Input is null) return;
        try
        {
            var result = await SignInService.SignInAsync(Input.Email, Input.Password);
            if (result.Outcome == SignInOutcome.Success && result.Principal is not null)
            {
                if (HttpContext is not null)
                    await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, result.Principal);
                Navigation.NavigateTo(SafeReturnUrl, forceLoad: true);
                return;
            }
            ErrorMessage = result.Outcome switch
            {
                SignInOutcome.WrongCredentials => "That email and password don't match a TRU account.",
                SignInOutcome.NotConfigured => "Sign-in isn't set up on this server yet.",
                _ => "The sign-in service isn't reachable right now."
            };
        }
        catch { ErrorMessage = "Something went wrong. Please reload and try again."; }
        Input.Password = string.Empty;
    }

    private string SafeReturnUrl =>
        !string.IsNullOrEmpty(ReturnUrl) && ReturnUrl.StartsWith('/') && !ReturnUrl.StartsWith("//") && !ReturnUrl.StartsWith("/\\")
            ? ReturnUrl : "/";

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        public string Email { get; set; } = string.Empty;
        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}
