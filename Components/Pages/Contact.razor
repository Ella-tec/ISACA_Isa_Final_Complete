@page "/contact"
@rendermode InteractiveServer

<PageTitle>Contact | TRU Ask</PageTitle>

<style>
.ct{--navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--teal:#36ac91;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);width:100%;max-width:none;margin:0;padding:0.65rem 0.85rem 1rem;box-sizing:border-box}
.ct-hero{border-radius:14px;padding:1rem 1.25rem;color:#fff;margin-bottom:0.75rem;
background:linear-gradient(120deg,#1d2d5c,#07649d 50%,#00a4e4);box-shadow:0 8px 24px rgba(29,45,92,.12)}
.ct-hero h1{margin:.1rem 0 .2rem;font-family:"Roboto Slab",Georgia,serif;font-weight:600;font-size:1.55rem;color:#fff!important;line-height:1.25}
.ct-hero p{margin:0;opacity:.92;font-size:.88rem}
.ct-grid{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(280px,1fr);gap:.85rem;margin-bottom:.85rem;align-items:stretch}
.ct-card{background:#fff;border-radius:14px;padding:1.1rem 1.2rem;min-width:0;border:1px solid var(--line);box-shadow:0 4px 14px rgba(29,45,92,.05)}
.ct-card h2{margin:0 0 .55rem;font-size:1rem}
.ct-card label{display:block;font-size:.72rem;font-weight:600;color:var(--muted);margin-bottom:.15rem}
.ct-card input,.ct-card textarea,.ct-card select{width:100%;box-sizing:border-box;padding:.48rem .65rem;border-radius:9px;border:1px solid var(--line);margin-bottom:.5rem;font-family:inherit}
.ct-btn{border:none;cursor:pointer;padding:.5rem 1rem;border-radius:10px;font-weight:700;font-family:inherit;
background:linear-gradient(135deg,var(--navy),var(--mid));color:#fff}
.ct-btn:hover{filter:brightness(1.06)}
.ct-ok{background:#e8f6e8;color:#2d6a2d;padding:.5rem .75rem;border-radius:9px;font-size:.85rem;margin-bottom:.5rem}
@@media(max-width:900px){.ct-grid{grid-template-columns:1fr}} @@media(max-width:560px){.ct{padding:.5rem}.ct-card{padding:.9rem}.ct-hero{padding:.85rem 1rem}.ct-btn{margin:.15rem 0}}
.ct{min-height:100dvh;display:flex;flex-direction:column;}
/* Let the contact grid absorb the available height so both cards align. */
.ct-grid{flex:1 0 auto;align-items:stretch;}
.ct-card{height:100%;}
/* Keep the footer at the bottom of the viewport on short pages. */
.ct > .sf{margin-top:auto!important;flex:0 0 auto;}
@@media(max-width:900px){.ct-grid{flex:0 0 auto;align-items:stretch;}}
@@media(max-width:560px){.ct{min-height:100dvh;}}
</style>

<section class="ct">
    <header class="ct-hero">
        <div style="font-size:.62rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">TRU Ask</div>
        <h1>Contact</h1>
        <p>Reach chapter support or explore official ISACA resources.</p>
    </header>

    <div class="ct-grid">
        <article class="ct-card">
            <h2>Send a message</h2>
            @if (sent)
            {
                <div class="ct-ok">Message recorded for chapter follow-up. Thank you.</div>
            }
            <label>Name</label>
            <input @bind="name" placeholder="Your name" />
            <label>Email</label>
            <input @bind="email" type="email" placeholder="you@example.com" />
            <label>Topic</label>
            <select @bind="topic">
                <option>General</option>
                <option>Membership</option>
                <option>Events</option>
                <option>Certification</option>
                <option>Technical support</option>
            </select>
            <label>Message</label>
            <textarea rows="3" @bind="message" placeholder="How can we help?"></textarea>
            <button type="button" class="ct-btn" @onclick="Send">Send message</button>
        </article>
        <article class="ct-card">
            <h2>Chapter &amp; ISACA</h2>
            <p style="margin:0 0 .55rem;font-size:.86rem;color:var(--muted);line-height:1.4">
                For official ISACA member services use the links below. Chapter-specific questions can use the form.
            </p>
            <p style="font-size:.86rem;margin:0 0 .25rem"><strong>ISACA HQ</strong></p>
            <p style="font-size:.82rem;color:var(--muted);margin:0 0 .65rem;line-height:1.4">
                1700 E. Golf Road, Suite 400<br />Schaumburg, Illinois 60173, USA<br />+1-847-660-5505
            </p>
            <a class="ct-btn" style="display:inline-block" href="https://www.isaca.org/contact-us" target="_blank" rel="noopener">ISACA Contact Us</a>
            <a class="ct-btn" style="display:inline-block;margin-left:.3rem;background:linear-gradient(135deg,#36ac91,#07649d)" href="https://www.isaca.org" target="_blank" rel="noopener">ISACA.org</a>
        </article>
    </div>

    @* Footer only on Contact *@
    <SiteFooter />
</section>

@code {
    private string name = "", email = "", topic = "General", message = "";
    private bool sent;
    private void Send()
    {
        if (string.IsNullOrWhiteSpace(message)) return;
        sent = true;
        message = "";
    }
}
