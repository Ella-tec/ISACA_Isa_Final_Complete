@page "/analytics"
@rendermode InteractiveServer

<PageTitle>Analytics | Isa</PageTitle>

<style>
.an{--navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;--red:#e31837;--orange:#e57524;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);width:100%;max-width:none;margin:0;padding:var(--tru-page-gutter, 12px);padding-bottom:1rem;box-sizing:border-box}
.an-hero{border-radius:20px;padding:1.75rem 2rem;color:#fff;margin-bottom:1rem;width:100%;box-sizing:border-box;
background:linear-gradient(115deg,#1d2d5c 0%,#07649d 55%,#00a4e4 100%);box-shadow:0 16px 44px rgba(29,45,92,.18);
display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:1rem}
.an-hero h1{margin:.2rem 0 .35rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.9rem}
.an-hero p{margin:0;opacity:.92;max-width:48ch;line-height:1.45}
.an-hero-actions{display:flex;gap:.5rem;flex-wrap:wrap}
.an-hero select,.an-hero button{border:none;cursor:pointer;padding:.55rem 1rem;border-radius:10px;font-weight:600;font-family:inherit;font-size:.88rem}
.an-hero select{background:#fff;color:var(--navy)}
.an-hero button{background:rgba(255,255,255,.18);color:#fff;box-shadow:inset 0 0 0 1.5px rgba(255,255,255,.45)}
.an-hero button:hover{background:rgba(255,255,255,.28)}
.an-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:.65rem;margin-bottom:.75rem}
.an-kpi{background:#fff;border-radius:16px;padding:1.15rem;border:1px solid var(--line);box-shadow:0 8px 24px rgba(29,45,92,.06);
cursor:pointer;text-align:left;font-family:inherit;color:inherit;transition:transform .12s,box-shadow .12s,border-color .12s}
.an-kpi:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(29,45,92,.12);border-color:var(--blue)}
.an-kpi.on{border-color:var(--mid);box-shadow:0 0 0 2px rgba(7,100,157,.28)}
.an-kpi .l{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.an-kpi .v{font-size:1.65rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;margin:.15rem 0}
.an-kpi .t{font-size:.8rem;color:var(--muted)}
.an-detail{background:#e8f4fc;border-radius:14px;padding:1rem 1.2rem;margin-bottom:1rem;border:1px solid #c5e0f5;font-size:.92rem;line-height:1.45}
.an-grid{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin-bottom:.75rem}
.an-card{background:#fff;border-radius:16px;padding:1rem;border:1px solid var(--line);box-shadow:0 8px 24px rgba(29,45,92,.06)}
.an-card h2{margin:0 0 .25rem;font-size:1.05rem}
.an-card .sub{margin:0 0 .85rem;font-size:.82rem;color:var(--muted)}
.an-donut-wrap{display:flex;align-items:center;gap:1.25rem;flex-wrap:wrap}
.an-donut{width:110px;height:110px;border-radius:50%;background:conic-gradient(var(--mid) 0 calc(var(--p)*1%),#e2e8f0 0);display:grid;place-items:center;flex-shrink:0}
.an-donut span{width:72px;height:72px;border-radius:50%;background:#fff;display:grid;place-items:center;font-weight:700;font-size:1.15rem}
.an-bars{display:flex;align-items:flex-end;gap:8px;height:150px}
.an-bar{flex:1;border-radius:8px 8px 4px 4px;background:linear-gradient(180deg,var(--blue),var(--mid));cursor:pointer;position:relative;min-height:12px;transition:filter .12s,transform .12s;border:none;padding:0}
.an-bar:hover,.an-bar.on{filter:brightness(1.12);transform:scaleY(1.04)}
.an-bar span{position:absolute;bottom:-1.25rem;left:50%;transform:translateX(-50%);font-size:.68rem;color:var(--muted)}
.an-tip{margin-top:1.5rem;padding:.65rem .85rem;background:var(--light);border-radius:10px;font-size:.85rem}
.an-table{width:100%;border-collapse:collapse;font-size:.88rem}
.an-table th{text-align:left;font-size:.65rem;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding:.5rem;border-bottom:1px solid var(--line)}
.an-table td{padding:.55rem .5rem;border-bottom:1px solid var(--line)}
.an-table tr{cursor:pointer}.an-table tr:hover td{background:var(--light)}
.an-up{color:#2d6a2d;font-weight:600}.an-down{color:#a12a2a;font-weight:600}
.an-activity{padding:.65rem .85rem;border-radius:10px;background:var(--light);margin-bottom:.5rem;font-size:.88rem}
.an-activity strong{display:block}
.an-activity span{font-size:.78rem;color:var(--muted)}
.an-btn{border:1px solid var(--line);background:#fff;border-radius:8px;padding:.35rem .7rem;font-size:.8rem;font-weight:600;cursor:pointer;font-family:inherit;margin-right:.35rem}
@@media(max-width:900px){.an-kpis{grid-template-columns:1fr 1fr}.an-grid{grid-template-columns:1fr}}
</style>

<section class="an">
    <header class="an-hero">
        <div>
            <div style="font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">Intelligence</div>
            <h1>Analytics</h1>
            <p>Chapter usage trends, self-service rates, escalation health and member questions. Every KPI card is clickable.</p>
        </div>
        <div class="an-hero-actions">
            <select @bind="range">
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
            <button type="button" @onclick="Refresh">↻ Refresh</button>
        </div>
    </header>

    <div class="an-kpis">
        <button type="button" class="an-kpi @(focus=="q"?"on":null)" @onclick='() => SetFocus("q")'>
            <div class="l">Questions</div>
            <div class="v">@questions.ToString("N0")</div>
            <div class="t">@range</div>
        </button>
        <button type="button" class="an-kpi @(focus=="ss"?"on":null)" @onclick='() => SetFocus("ss")'>
            <div class="l">Self-service</div>
            <div class="v">@selfService%</div>
            <div class="t">Target 80%</div>
        </button>
        <button type="button" class="an-kpi @(focus=="rt"?"on":null)" @onclick='() => SetFocus("rt")'>
            <div class="l">Avg response</div>
            <div class="v">@avgResponse s</div>
            <div class="t">Illustrative</div>
        </button>
        <button type="button" class="an-kpi @(focus=="ot"?"on":null)" @onclick='() => SetFocus("ot")'>
            <div class="l">Open tickets</div>
            <div class="v">@openTickets</div>
            <div class="t">Need attention</div>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(focusText))
    {
        <div class="an-detail">@focusText</div>
    }

    <div class="an-grid">
        <article class="an-card">
            <h2>Self-service resolution</h2>
            <p class="sub">Resolved without chapter team help</p>
            <div class="an-donut-wrap">
                <div class="an-donut" style="--p:@selfService"><span>@selfService%</span></div>
                <div>
                    <div style="font-size:.9rem;margin-bottom:.5rem">Current @selfService% · Goal 80%</div>
                    <div style="height:8px;background:#e2e8f0;border-radius:99px;overflow:hidden;width:160px">
                        <div style="height:100%;width:@(selfService)%;background:linear-gradient(90deg,var(--mid),var(--green))"></div>
                    </div>
                    <ul style="margin:.75rem 0 0;padding-left:1.1rem;font-size:.85rem;color:var(--muted)">
                        <li>Review unanswered weekly</li>
                        <li>Add missing documentation</li>
                        <li>Improve search titles</li>
                    </ul>
                </div>
            </div>
        </article>
        <article class="an-card">
            <h2>Question volume</h2>
            <p class="sub">Daily pattern · click a day for detail</p>
            <div class="an-bars">
                @for (var i = 0; i < days.Length; i++)
                {
                    var di = i;
                    var h = (int)(100.0 * days[i].Count / maxDay);
                    <button type="button" class="an-bar @(dayIndex==i?"on":null)" style="height:@h%" @onclick="() => SelectDay(di)">
                        <span>@days[i].Label</span>
                    </button>
                }
            </div>
            <div class="an-tip">
                @if (dayIndex >= 0)
                {
                    <text>@days[dayIndex].Label — @days[dayIndex].Count questions (@((100.0*days[dayIndex].Count/questions).ToString("0.0"))% of period)</text>
                }
                else
                {
                    <text>Click a bar to see daily detail</text>
                }
            </div>
        </article>
    </div>

    <div class="an-grid">
        <article class="an-card">
            <h2>Top topics</h2>
            <p class="sub">Most frequent member questions · click a row</p>
            <table class="an-table">
                <thead><tr><th>Topic</th><th>Count</th><th>Trend</th></tr></thead>
                <tbody>
                    @foreach (var t in topics)
                    {
                        <tr @onclick="() => ShowTopic(t)">
                            <td><strong>@t.Name</strong></td>
                            <td>@t.Count</td>
                            <td class="@(t.Trend>=0?"an-up":"an-down")">@(t.Trend>=0?"+":"")@t.Trend%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </article>
        <article class="an-card">
            <h2>Recent activity</h2>
            <p class="sub">Workspace timeline</p>
            @foreach (var a in activity)
            {
                <div class="an-activity">
                    <strong>@a.Title</strong>
                    <span>@a.When</span>
                </div>
            }
            <button type="button" class="an-btn" @onclick="Refresh">Refresh data</button>
            <button type="button" class="an-btn" @onclick='() => SetFocus("ot")'>View open tickets</button>
        </article>
    </div>
</section>

@code {
    private string range = "Last 30 days";
    private string focus = "q";
    private string focusText = "";
    private int questions = 1248, selfService = 76, openTickets = 3;
    private double avgResponse = 2.4;
    private int dayIndex = 4;
    private int maxDay = 1;

    private record Day(string Label, int Count);
    private record Topic(string Name, int Count, int Trend);
    private record Act(string Title, string When);

    private Day[] days = Array.Empty<Day>();
    private List<Topic> topics = new();
    private List<Act> activity = new();
    private readonly Random rng = new();

    protected override void OnInitialized()
    {
        Seed();
        SetFocus("q");
    }

    private void Seed()
    {
        days = new[]
        {
            new Day("Mon", 142), new Day("Tue", 168), new Day("Wed", 155),
            new Day("Thu", 190), new Day("Fri", 158), new Day("Sat", 210), new Day("Sun", 175)
        };
        maxDay = days.Max(d => d.Count);
        questions = days.Sum(d => d.Count);
        topics = new List<Topic>
        {
            new("Membership renewal", 186, 12),
            new("Event registration", 142, 8),
            new("CPE credit questions", 98, -3),
            new("Certification prep", 87, 15),
            new("Chapter governance", 64, 5),
        };
        activity = new List<Act>
        {
            new("Spike in membership questions", "2h ago · Renewal season pattern"),
            new("New knowledge article published", "Yesterday · Event planning checklist"),
            new("Escalation ISA-1023 updated", "Yesterday · In progress"),
            new("Self-service rate improved", "3 days ago · +2 pts"),
        };
    }

    private void SetFocus(string key)
    {
        focus = key;
        focusText = key switch
        {
            "q" => $"Questions in {range}: {questions:N0}. Peak days often correlate with membership renewal windows and event registration deadlines.",
            "ss" => $"Self-service rate is {selfService}% (goal 80%). Improving article titles and tags usually lifts this metric within 2–3 weeks.",
            "rt" => $"Average first response is {avgResponse:0.0}s for automated answers. Human escalations average longer — see Escalations & Tickets.",
            "ot" => $"There are {openTickets} open tickets needing attention. Open Escalations to progress, escalate, or close them.",
            _ => ""
        };
    }

    private void SelectDay(int i)
    {
        dayIndex = i;
        focusText = $"{days[i].Label}: {days[i].Count} questions ({100.0 * days[i].Count / questions:0.0}% of period volume).";
    }

    private void ShowTopic(Topic t)
    {
        focusText = $"{t.Name}: {t.Count} questions, trend {(t.Trend >= 0 ? "+" : "")}{t.Trend}% vs prior period.";
    }

    private void Refresh()
    {
        selfService = Math.Clamp(selfService + rng.Next(-2, 3), 60, 92);
        avgResponse = Math.Round(Math.Clamp(avgResponse + (rng.NextDouble() - 0.5) * 0.3, 1.5, 4.0), 1);
        openTickets = Math.Clamp(openTickets + rng.Next(-1, 2), 0, 12);
        for (var i = 0; i < days.Length; i++)
            days[i] = days[i] with { Count = Math.Max(80, days[i].Count + rng.Next(-15, 20)) };
        maxDay = days.Max(d => d.Count);
        questions = days.Sum(d => d.Count);
        SetFocus(focus);
    }
}
