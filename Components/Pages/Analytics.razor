@page "/analytics"
@rendermode InteractiveServer

<PageTitle>Analytics | Isa</PageTitle>

<style>
.an{--accent:#0b3d91;--accent2:#1a5bb8;--soft:#e8f0fe;--navy:#1d2d5c;--muted:#5f6b85;--line:#e2e8f0;max-width:1100px;margin:0 auto;font-family:"Roboto",system-ui,sans-serif;color:var(--navy)}
.an-hero{background:linear-gradient(125deg,#0b3d91 0%,#1a5bb8 50%,#00a4e4 100%);color:#fff;border-radius:20px;padding:1.5rem 1.6rem;margin-bottom:1.25rem;box-shadow:0 12px 32px rgba(11,61,145,.25)}
.an-hero h1{margin:.2rem 0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.75rem}
.an-hero p{margin:.4rem 0 0;opacity:.92;max-width:52ch}
.an-controls{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
.an-select{border:none;border-radius:10px;padding:.5rem .9rem;font:inherit;font-weight:600;background:rgba(255,255,255,.95);color:var(--navy);cursor:pointer}
.an-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:.85rem;margin-bottom:1.25rem}
.an-stat{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.1rem 1.15rem;box-shadow:0 6px 18px rgba(11,61,145,.08)}
.an-stat span{display:block;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.an-stat strong{display:block;font-size:1.65rem;font-weight:300;font-family:"Roboto Slab",Georgia,serif;margin:.25rem 0;color:var(--accent)}
.an-stat small{font-size:.8rem;color:var(--muted)}
.an-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem}
.an-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.2rem 1.25rem;box-shadow:0 8px 22px rgba(11,61,145,.07)}
.an-card h2{margin:0 0 .35rem;font-size:1.1rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300}
.an-card p.sub{margin:0 0 1rem;font-size:.85rem;color:var(--muted)}
.an-ring{width:90px;height:90px;border-radius:50%;background:conic-gradient(var(--accent) calc(var(--pct)*1%),#e8f0fe 0);display:grid;place-items:center;margin:0 auto .75rem}
.an-ring i{width:62px;height:62px;border-radius:50%;background:#fff;display:grid;place-items:center;font-weight:700;font-size:1.1rem;color:var(--accent)}
.an-bar{height:8px;background:#e8f0fe;border-radius:99px;overflow:hidden;margin:.4rem 0}
.an-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),#00a4e4);border-radius:99px}
.an-spark{display:flex;align-items:flex-end;gap:6px;height:90px;margin:1rem 0 .5rem}
.an-spark i{flex:1;background:linear-gradient(180deg,#00a4e4,var(--accent));border-radius:4px 4px 0 0;min-height:8px}
.an-table{width:100%;border-collapse:collapse;font-size:.9rem}
.an-table th{text-align:left;padding:.55rem .4rem;font-size:.75rem;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);border-bottom:1px solid var(--line)}
.an-table td{padding:.6rem .4rem;border-bottom:1px solid #f1f5f9}
.an-badge{display:inline-block;padding:.2rem .55rem;border-radius:999px;font-size:.75rem;font-weight:700}
.an-badge.up{background:#e6f7ed;color:#1a7a4c}
.an-badge.down{background:#fff0e8;color:#c2410c}
.an-timeline{display:flex;flex-direction:column;gap:.85rem}
.an-tl{padding-left:1rem;border-left:3px solid var(--accent)}
.an-tl strong{display:block;font-size:.92rem}
.an-tl span{font-size:.82rem;color:var(--muted)}
@@media(max-width:900px){.an-stats{grid-template-columns:1fr 1fr}.an-grid{grid-template-columns:1fr}}
@@media(max-width:560px){.an-stats{grid-template-columns:1fr}}
</style>

<section class="an">
    <header class="an-hero">
        <p style="margin:0;font-size:.7rem;font-weight:700;letter-spacing:.12em;opacity:.9">INTELLIGENCE</p>
        <h1>Analytics</h1>
        <p>Chapter usage trends, self-service rates, escalation health and member questions.</p>
        <div class="an-controls">
            <select class="an-select" @bind="Period">
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
            <button type="button" class="an-select" @onclick="Refresh">↻ Refresh</button>
        </div>
    </header>

    <div class="an-stats">
        <div class="an-stat"><span>Questions</span><strong>@QuestionsTotal.ToString("N0")</strong><small>@Period</small></div>
        <div class="an-stat"><span>Self-service</span><strong>@SelfService%</strong><small>Target 80%</small></div>
        <div class="an-stat"><span>Avg response</span><strong>@AvgResponse</strong><small>Illustrative</small></div>
        <div class="an-stat"><span>Open tickets</span><strong>@OpenTickets</strong><small>Need attention</small></div>
    </div>

    <div class="an-grid">
        <article class="an-card">
            <h2>Self-service resolution</h2>
            <p class="sub">Resolved without chapter team help</p>
            <div class="an-ring" style="--pct:@SelfService"><i>@SelfService%</i></div>
            <div class="an-bar"><span style="width:@(SelfService)%"></span></div>
            <div style="display:flex;justify-content:space-between;font-size:.82rem;color:var(--muted)">
                <span>Current @SelfService%</span><span>Goal 80%</span>
            </div>
        </article>

        <article class="an-card">
            <h2>Question volume</h2>
            <p class="sub">Daily pattern (sample)</p>
            <div class="an-spark">
                @foreach (var h in SparkHeights){ <i style="height:@(h)%"></i> }
            </div>
            <div style="display:flex;justify-content:space-between;font-size:.78rem;color:var(--muted)">
                <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
            </div>
        </article>

        <article class="an-card">
            <h2>Top search topics</h2>
            <p class="sub">Most frequent member questions</p>
            <table class="an-table">
                <thead><tr><th>Topic</th><th>Count</th><th>Trend</th></tr></thead>
                <tbody>
                    @foreach (var t in TopTopics)
                    {
                        <tr>
                            <td><strong>@t.Topic</strong></td>
                            <td>@t.Count</td>
                            <td><span class="an-badge @(t.Trend.StartsWith("+") ? "up" : "down")">@t.Trend</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </article>

        <article class="an-card">
            <h2>Recent activity</h2>
            <p class="sub">Workspace timeline</p>
            <div class="an-timeline">
                @foreach (var a in Activity)
                {
                    <div class="an-tl">
                        <strong>@a.Title</strong>
                        <span>@a.When · @a.Detail</span>
                    </div>
                }
            </div>
        </article>
    </div>
</section>

@code {
    private string Period = "Last 30 days";
    private int OpenTickets = 3;
    private int SelfService => Period switch { "Last 7 days" => 79, "Last 90 days" => 74, _ => 76 };
    private int QuestionsTotal => Period switch { "Last 7 days" => 312, "Last 90 days" => 3480, _ => 1248 };
    private string AvgResponse => Period switch { "Last 7 days" => "2.1s", "Last 90 days" => "2.6s", _ => "2.4s" };
    private readonly int[] SparkHeights = { 40, 55, 48, 72, 65, 80, 58 };

    private readonly (string Topic, int Count, string Trend)[] TopTopics =
    {
        ("Membership renewal", 186, "+12%"),
        ("Event registration", 142, "+8%"),
        ("CPE credit questions", 98, "-3%"),
        ("Board role duties", 71, "+5%"),
        ("Portal access issues", 54, "+15%")
    };

    private readonly (string Title, string When, string Detail)[] Activity =
    {
        ("Spike in membership questions", "2h ago", "Renewal season pattern"),
        ("New knowledge article published", "Yesterday", "Event planning checklist"),
        ("Escalation ISA-1023 updated", "Yesterday", "Status → In progress"),
        ("Content health score improved", "3 days ago", "84 → 87"),
        ("Weekly analytics digest sent", "5 days ago", "Board distribution list")
    };

    private void Refresh() { /* demo refresh – values already reactive via Period */ }
}
