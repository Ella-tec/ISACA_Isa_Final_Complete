@page "/isaca-resources"
@rendermode InteractiveServer
<PageTitle>ISACA Resources Gallery | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">ISACA ALIGNMENT</p>
            <h1>ISACA resources &amp; gallery</h1>
            <p class="isa-intro">
                Official ISACA topics, chapter leader links, and public marketing imagery from isaca.org.
                Images are linked from ISACA’s public site for demonstration only — not redistributed as app-owned assets.
            </p>
        </div>
        <span class="isa-pill">Compatible with isaca.org</span>
    </div>

    <div class="isa-notice">
        Prototype only. Confirm all guidance against current documents on
        <a href="https://www.isaca.org" target="_blank" rel="noopener">isaca.org</a>,
        <a href="https://engage.isaca.org" target="_blank" rel="noopener">Engage</a>, and the Chapter Leader Portal.
        Image rights remain with ISACA.
    </div>

    <div class="isa-stat-grid isa-stat-grid--three">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">🌐</span>
            <span class="isa-stat-label">Official links</span>
            <strong>@Links.Count</strong>
            <small>isaca.org / Engage</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">▣</span>
            <span class="isa-stat-label">Gallery tiles</span>
            <strong>@Gallery.Count</strong>
            <small>Public page images</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon purple">✓</span>
            <span class="isa-stat-label">Focus areas</span>
            <strong>6</strong>
            <small>Chapter 360 style</small>
        </article>
    </div>

    <article class="isa-panel" style="margin-bottom:1.25rem">
        <div class="isa-panel-heading">
            <div>
                <h2>Chapter leader quick links</h2>
                <p>Opens on ISACA systems (sign-in may be required)</p>
            </div>
        </div>
        <div class="isa-card-grid">
            @foreach (var l in Links)
            {
                <a class="isa-card" href="@l.Url" target="_blank" rel="noopener" style="text-decoration:none;color:inherit">
                    <h3>@l.Title</h3>
                    <p>@l.Description</p>
                    <small class="isa-muted">↗ @l.Host</small>
                </a>
            }
        </div>
    </article>

    <article class="isa-panel">
        <div class="isa-panel-heading">
            <div>
                <h2>Visual gallery</h2>
                <p>@Gallery.Count public tiles referenced from isaca.org pages</p>
            </div>
        </div>
        <div class="isaca-gallery">
            @foreach (var g in Gallery)
            {
                <figure class="isaca-gallery__item">
                    <a href="@g.PageUrl" target="_blank" rel="noopener">
                        <img src="@g.ImageUrl" alt="@g.Title" loading="lazy" width="550" height="550" />
                    </a>
                    <figcaption>
                        <strong>@g.Title</strong>
                        <a href="@g.PageUrl" target="_blank" rel="noopener">View on ISACA ↗</a>
                    </figcaption>
                </figure>
            }
        </div>
    </article>

    <article class="isa-panel" style="margin-top:1.25rem">
        <div class="isa-panel-heading">
            <div>
                <h2>Chapter 360 focus areas (summary)</h2>
                <p>Aligned with ISACA chapter enablement language used in this prototype</p>
            </div>
        </div>
        <div class="isa-card-grid">
            @foreach (var f in FocusAreas)
            {
                <div class="isa-card">
                    <span class="isa-badge isa-badge--blue">@f.Code</span>
                    <h3>@f.Name</h3>
                    <p>@f.Summary</p>
                </div>
            }
        </div>
    </article>
</section>

