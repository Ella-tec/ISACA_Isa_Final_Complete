@page "/not-found"
@layout Layout.MainLayout

<PageTitle>Page not found | TRU</PageTitle>

<div style="max-width:480px;margin:3rem auto;padding:1.5rem;text-align:center;font-family:Roboto,system-ui,sans-serif;color:#1d2d5c;">
    <h1 style="font-size:1.6rem;margin:0 0 .5rem;">Page not found</h1>
    <p style="color:#5f6b85;line-height:1.5;margin:0 0 1.25rem;">
        That link does not match a page in TRU. It may have moved or the address may be mistyped.
    </p>
    <a href="/" style="display:inline-block;padding:.55rem 1.1rem;border-radius:10px;background:#1d2d5c;color:#fff;font-weight:600;text-decoration:none;">
        Back to Home
    </a>
</div>
