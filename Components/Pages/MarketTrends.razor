@page "/market-trends"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Market trends | TRU</PageTitle>

<style>
.mt{
  font-family:"Roboto",system-ui,sans-serif;color:#1d2d5c;
  width:100%!important;max-width:none!important;margin:0!important;
  padding:10px!important;box-sizing:border-box;
  display:flex!important;flex-direction:column!important;gap:10px!important;
  flex:1 1 auto!important;
  min-height:calc(100vh - 20px)!important;
  min-height:calc(100dvh - 20px)!important;
}
.mt h1{margin:0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.3rem}
.mt .sub{margin:0;color:#5f6b85;font-size:.84rem}
.mt-kpis{flex:0 0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.mt-kpi{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:.65rem .8rem;box-shadow:0 2px 10px rgba(29,45,92,.04);cursor:pointer;text-align:left;font-family:inherit;color:inherit}
.mt-kpi:hover,.mt-kpi.on{border-color:#00a4e4;box-shadow:0 0 0 2px rgba(0,164,228,.15)}
.mt-kpi span{display:block;font-size:.62rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#5f6b85}
.mt-kpi strong{font-size:1.2rem;color:#1d2d5c}
.mt-kpi small{font-size:.74rem;color:#6cb33f}
.mt-grid{
  flex:1 1 auto!important;
  display:grid!important;
  grid-template-columns:1.3fr 1fr;
  gap:10px;
  align-items:stretch!important;
  min-height:0;
}
.mt-panel{
  background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:.85rem 1rem;
  box-shadow:0 2px 10px rgba(29,45,92,.04);
  display:flex;flex-direction:column;min-height:0;height:100%;
}
.mt-panel h2{margin:0 0 .1rem;font-size:.95rem;font-family:"Roboto Slab",Georgia,serif;font-weight:400}
.mt-panel p.lead{margin:0 0 .5rem;font-size:.78rem;color:#5f6b85}
.mt-toolbar{display:flex;gap:.4rem;margin-bottom:.45rem;flex-wrap:wrap;flex:0 0 auto}
.mt-toolbar input{flex:1;min-width:120px;padding:.4rem .6rem;border:1px solid #e2e8f0;border-radius:9px;font-family:inherit}
.mt-toolbar button{border:none;cursor:pointer;padding:.4rem .85rem;border-radius:9px;font-weight:600;font-family:inherit;background:linear-gradient(135deg,#1d2d5c,#07649d);color:#fff}
.mt-table-wrap{flex:1 1 auto;min-height:180px;overflow:auto}
.mt table{width:100%;border-collapse:collapse;font-size:.82rem}
.mt th{text-align:left;padding:.35rem;font-size:.62rem;letter-spacing:.05em;text-transform:uppercase;color:#5f6b85;border-bottom:2px solid #e2e8f0;position:sticky;top:0;background:#fff}
.mt td{padding:.38rem .35rem;border-bottom:1px solid #eef1f5}
.mt tr{cursor:pointer}.mt tr:hover,.mt tr.is-on{background:#eef6fb}
.mt .up{color:#2d6a2d;font-weight:600}.mt .down{color:#e31837;font-weight:600}
.mt-bars{display:flex;align-items:flex-end;gap:5px;height:100px;margin:.35rem 0 .25rem}
.mt-bars button{flex:1;border:none;padding:0;cursor:pointer;border-radius:5px 5px 0 0;background:linear-gradient(180deg,#00a4e4,#07649d);min-height:8px;position:relative;font-family:inherit}
.mt-bars button span{position:absolute;bottom:-1.1rem;left:50%;transform:translateX(-50%);font-size:.6rem;color:#5f6b85;white-space:nowrap}
.mt-bars button.is-on{filter:brightness(1.15);box-shadow:0 0 0 2px rgba(0,164,228,.35)}
.mt-skills{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin-top:1.1rem}
.mt-skill{
  background:#f4f7fb;border-radius:10px;padding:.55rem .7rem;font-size:.8rem;border:1px solid transparent;
  cursor:pointer;text-align:left;font-family:inherit;color:inherit;
}
.mt-skill:hover,.mt-skill.on{border-color:#00a4e4;background:#e8f4fc}
.mt-skill strong{display:block;font-size:1rem;color:#1d2d5c;margin-top:.15rem}
.mt-skill em{display:block;font-style:normal;font-size:.72rem;color:#5f6b85;margin-top:.2rem}
.mt-detail-head{display:flex;justify-content:space-between;gap:.5rem;margin-bottom:.35rem}
.mt-detail-head strong{font-size:1.3rem}
.mt-trade{display:grid;grid-template-columns:1fr 1fr;gap:.35rem;margin-top:.45rem}
.mt-trade input{padding:.35rem .5rem;border:1px solid #e2e8f0;border-radius:8px;font-family:inherit}
.mt-trade button{border:none;cursor:pointer;padding:.42rem;border-radius:8px;font-weight:700;font-family:inherit}
.mt-buy{background:#6cb33f;color:#fff}.mt-sell{background:#e31837;color:#fff}
.mt-note{font-size:.72rem;color:#5f6b85;margin-top:.35rem}
.mt-actions{display:flex;gap:.35rem;flex-wrap:wrap;margin-top:auto;padding-top:.55rem}
.mt-actions a,.mt-actions button{
  border:none;cursor:pointer;padding:.4rem .75rem;border-radius:9px;font-weight:600;font-size:.78rem;
  font-family:inherit;background:#e7f0f5;color:#1d2d5c;text-decoration:none;display:inline-flex;align-items:center;
}
.mt-actions .pri{background:linear-gradient(135deg,#1d2d5c,#07649d);color:#fff}
@@media(max-width:960px){
  .mt{min-height:0!important}
  .mt-grid,.mt-kpis{grid-template-columns:1fr 1fr}
}
@@media(max-width:560px){.mt-kpis{grid-template-columns:1fr}}
</style>

<section class="mt">
    <div>
        <h1>Market trends</h1>
        <p class="sub">Cybersecurity, governance, AI, risk, and tech signals for chapter planning. Paper trade is educational only.</p>
    </div>

    <div class="mt-kpis">
        <button type="button" class="mt-kpi @(selected?.Symbol=="CRWD"?"on":null)" @onclick='() => Select("CRWD")'><span>Cyber demand</span><strong>118</strong><small>▲ 6% QoQ</small></button>
        <button type="button" class="mt-kpi @(selected?.Symbol=="NVDA"?"on":null)" @onclick='() => Select("NVDA")'><span>AI governance</span><strong>+34%</strong><small>YoY CPE topics</small></button>
        <button type="button" class="mt-kpi @(selected?.Symbol=="OKTA"?"on":null)" @onclick='() => Select("OKTA")'><span>Privacy interest</span><strong>High</strong><small>▲ study groups</small></button>
        <button type="button" class="mt-kpi @(selected?.Symbol=="PANW"?"on":null)" @onclick='() => Select("PANW")'><span>Vendor risk</span><strong>+12%</strong><small>ticket volume</small></button>
    </div>

    <div class="mt-grid">
        <div class="mt-panel">
            <h2>Equity watchlist</h2>
            <p class="lead">Click a row for chart &amp; paper trade · prices refresh on a timer</p>
            <div class="mt-toolbar">
                <input @bind="search" @bind:event="oninput" placeholder="Search symbol or name" />
                <button type="button" @onclick="Refresh">Refresh</button>
            </div>
            <div class="mt-table-wrap">
                <table>
                    <thead><tr><th>Symbol</th><th>Name</th><th>Price</th><th>Change</th><th>Sector</th></tr></thead>
                    <tbody>
                        @foreach (var s in Filtered)
                        {
                            <tr class="@(selected?.Symbol==s.Symbol?"is-on":null)" @onclick="() => Select(s.Symbol)">
                                <td><strong>@s.Symbol</strong></td>
                                <td>@s.Name</td>
                                <td>$@s.Price.ToString("0.00")</td>
                                <td class="@(s.Change>=0?"up":"down")">@(s.Change>=0?"+":"")@s.Change.ToString("0.00")%</td>
                                <td>@s.Sector</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-panel">
            @if (selected is null)
            {
                <h2>Market overview</h2>
                <p class="lead">Skill demand · click a bar or card for detail</p>
                <div class="mt-bars">
                    @for (var i = 0; i < skillBars.Length; i++)
                    {
                        var ii = i;
                        <button type="button" class="@(skillFocus==skillBars[i].Label?"is-on":null)" style="height:@skillBars[i].H%" @onclick="() => FocusSkill(skillBars[ii].Label)">
                            <span>@skillBars[i].Label</span>
                        </button>
                    }
                </div>
                <div class="mt-skills">
                    @foreach (var sk in skills)
                    {
                        <button type="button" class="mt-skill @(skillFocus==sk.Name?"on":null)" @onclick="() => FocusSkill(sk.Name)">
                            <span>@sk.Name</span>
                            <strong>@sk.Level</strong>
                            <em>@sk.Note</em>
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(skillMsg))
                {
                    <p class="mt-note" style="margin-top:.65rem;padding:.5rem .65rem;background:#e8f4fc;border-radius:8px;color:#1d2d5c">@skillMsg</p>
                }
                <div class="mt-actions">
                    <button type="button" class="pri" @onclick='() => Select("CRWD")'>Open cyber sample</button>
                    <a href="analytics">Analytics</a>
                    <a href="knowledge-base">Knowledge base</a>
                </div>
            }
            else
            {
                <div class="mt-detail-head">
                    <div>
                        <h2>@selected.Symbol · @selected.Name</h2>
                        <p class="lead">@selected.Sector</p>
                    </div>
                    <div style="text-align:right">
                        <strong>$@selected.Price.ToString("0.00")</strong>
                        <div class="@(selected.Change>=0?"up":"down")">@(selected.Change>=0?"+":"")@selected.Change.ToString("0.00")%</div>
                    </div>
                </div>
                <div class="mt-bars">
                    @foreach (var h in selected.Spark)
                    {
                        <button type="button" style="height:@h%" title="Sample"></button>
                    }
                </div>
                <p class="lead">Paper trade (educational)</p>
                <div class="mt-trade">
                    <input type="number" @bind="qty" min="1" placeholder="Shares" />
                    <input type="number" @bind="limit" step="0.01" placeholder="Limit price" />
                    <button type="button" class="mt-buy" @onclick="Buy">Buy</button>
                    <button type="button" class="mt-sell" @onclick="Sell">Sell</button>
                </div>
                <p class="mt-note">@(string.IsNullOrEmpty(tradeMsg) ? "Simulated only — not real brokerage." : tradeMsg)</p>
                <div class="mt-actions">
                    <button type="button" @onclick="() => selected = null">Back to overview</button>
                    <a href="escalations">Related tickets</a>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string search = "", tradeMsg = "", skillFocus = "", skillMsg = "";
    private int qty = 10;
    private double limit = 0;
    private Stock? selected;
    private System.Threading.Timer? timer;
    private readonly Random rng = new();
    private record Stock(string Symbol, string Name, double Price, double Change, string Sector, int[] Spark);
    private record Bar(string Label, int H);
    private record Skill(string Name, string Level, string Note);
    private List<Stock> stocks = new();
    private readonly Bar[] skillBars =
    {
        new("Audit", 55), new("Security", 88), new("AI", 95),
        new("Risk", 70), new("Privacy", 62), new("Cloud", 58)
    };
    private readonly Skill[] skills =
    {
        new("Audit", "High", "Member questions +12%"),
        new("Security", "Very high", "Top CPE topic"),
        new("AI", "Rising", "Governance workshops"),
        new("Risk", "Steady", "Vendor reviews up"),
        new("Privacy", "High", "Study group demand"),
        new("Cloud", "High", "Controls mapping"),
    };
    private IEnumerable<Stock> Filtered =>
        string.IsNullOrWhiteSpace(search) ? stocks
        : stocks.Where(s => s.Symbol.Contains(search, StringComparison.OrdinalIgnoreCase) || s.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

    protected override void OnInitialized()
    {
        Seed();
        timer = new System.Threading.Timer(_ =>
        {
            for (var i = 0; i < stocks.Count; i++)
            {
                var s = stocks[i];
                var d = (rng.NextDouble() - 0.48) * 0.8;
                var p = Math.Max(1, s.Price * (1 + d / 100));
                var ch = s.Change + (rng.NextDouble() - 0.5) * 0.15;
                stocks[i] = s with { Price = p, Change = ch, Spark = s.Spark.Skip(1).Append(rng.Next(30, 100)).ToArray() };
                if (selected?.Symbol == s.Symbol) selected = stocks[i];
            }
            _ = InvokeAsync(StateHasChanged);
        }, null, 4000, 4000);
    }

    private void Seed()
    {
        stocks = new List<Stock>
        {
            Mk("AAPL","Apple Inc.",225.92,0.64,"Technology"), Mk("MSFT","Microsoft",414.11,0.36,"Technology"),
            Mk("GOOGL","Alphabet",175.85,-0.28,"Technology"), Mk("AMZN","Amazon",187.39,1.14,"Consumer"),
            Mk("NVDA","NVIDIA",120.85,2.32,"Semiconductors"), Mk("CRWD","CrowdStrike",309.76,1.45,"Cybersecurity"),
            Mk("PANW","Palo Alto Networks",347.32,0.87,"Cybersecurity"), Mk("ZS","Zscaler",190.17,-0.56,"Cybersecurity"),
            Mk("S","SentinelOne",24.12,1.09,"Cybersecurity"), Mk("FTNT","Fortinet",78.12,0.26,"Cybersecurity"),
            Mk("OKTA","Okta",81.47,-1.22,"Identity"), Mk("NET","Cloudflare",93.23,1.89,"Cloud security"),
            Mk("IBM","IBM",222.05,0.25,"Enterprise IT"), Mk("ORCL","Oracle",168.67,0.60,"Enterprise IT"),
            Mk("CRM","Salesforce",282.01,-0.67,"SaaS"), Mk("PLTR","Palantir",99.50,0.88,"AI / Analytics"),
        };
    }
    private Stock Mk(string sym, string name, double price, double ch, string sector)
        => new(sym, name, price, ch, sector, Enumerable.Range(0, 8).Select(_ => rng.Next(35, 100)).ToArray());
    private void Select(string symbol)
    {
        selected = stocks.FirstOrDefault(s => s.Symbol == symbol);
        if (selected != null) limit = Math.Round(selected.Price, 2);
        tradeMsg = ""; skillMsg = "";
    }
    private void FocusSkill(string name)
    {
        skillFocus = name;
        var sk = skills.FirstOrDefault(s => s.Name == name);
        skillMsg = sk is null ? $"{name} selected." : $"{sk.Name}: {sk.Level} — {sk.Note}. Open related stocks from the watchlist or KPIs.";
    }
    private void Refresh() { Seed(); if (selected != null) Select(selected.Symbol); }
    private void Buy() { if (selected is null) return; tradeMsg = $"Paper BUY {qty} {selected.Symbol} @ ${(limit > 0 ? limit : selected.Price):0.00}"; }
    private void Sell() { if (selected is null) return; tradeMsg = $"Paper SELL {qty} {selected.Symbol} @ ${(limit > 0 ? limit : selected.Price):0.00}"; }
    public void Dispose() => timer?.Dispose();
}
