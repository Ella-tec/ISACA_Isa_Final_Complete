@page "/events"
@rendermode InteractiveServer

<PageTitle>Events & Calendar | Isa</PageTitle>

<style>
.ev{--accent:#2e7d32;--accent2:#43a047;--soft:#e8f5e9;--navy:#1d2d5c;--muted:#5f6b85;--line:#e2e8f0;max-width:1100px;margin:0 auto;font-family:"Roboto",system-ui,sans-serif;color:var(--navy)}
.ev-hero{background:linear-gradient(125deg,#1b5e20 0%,#2e7d32 45%,#66bb6a 100%);color:#fff;border-radius:20px;padding:1.5rem 1.6rem;margin-bottom:1.25rem;box-shadow:0 12px 32px rgba(46,125,50,.25)}
.ev-hero h1{margin:.2rem 0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.75rem}
.ev-hero p{margin:.4rem 0 0;opacity:.92;max-width:52ch}
.ev-hero .actions{display:flex;flex-wrap:wrap;gap:.6rem;margin-top:1rem}
.ev-btn{border:none;border-radius:10px;padding:.55rem 1.1rem;font-weight:600;font-size:.9rem;cursor:pointer;font-family:inherit}
.ev-btn--solid{background:#fff;color:var(--accent)}
.ev-btn--ghost{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.4)}
.ev-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem;margin-bottom:1.25rem}
.ev-stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.1rem;box-shadow:0 6px 16px rgba(46,125,50,.08)}
.ev-stat span{font-size:.72rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.ev-stat strong{display:block;font-size:1.5rem;font-weight:300;font-family:"Roboto Slab",Georgia,serif;color:var(--accent);margin:.2rem 0}
.ev-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:1.1rem}
.ev-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.2rem 1.25rem;box-shadow:0 8px 22px rgba(46,125,50,.07)}
.ev-card h2{margin:0 0 .35rem;font-size:1.1rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300}
.ev-row{display:flex;align-items:center;gap:.85rem;padding:.75rem 0;border-bottom:1px solid #f1f5f9}
.ev-row:last-child{border-bottom:none}
.ev-date{width:48px;text-align:center;background:var(--soft);border-radius:10px;padding:.35rem;color:var(--accent)}
.ev-date strong{display:block;font-size:1.15rem;line-height:1.1}
.ev-date span{font-size:.7rem;font-weight:700}
.ev-copy{flex:1}
.ev-copy strong{display:block;font-size:.95rem}
.ev-copy span{font-size:.82rem;color:var(--muted)}
.ev-form{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-top:.75rem}
.ev-form label{display:grid;gap:.25rem;font-size:.8rem;font-weight:600;color:var(--muted)}
.ev-form input,.ev-form select{border:1.5px solid var(--line);border-radius:10px;padding:.5rem .7rem;font:inherit}
.ev-form input:focus,.ev-form select:focus{outline:none;border-color:var(--accent)}
.ev-toast{margin-top:.75rem;padding:.55rem .85rem;background:var(--soft);border-radius:10px;font-size:.88rem;color:var(--accent);font-weight:600}
@@media(max-width:900px){.ev-stats{grid-template-columns:1fr}.ev-grid{grid-template-columns:1fr}.ev-form{grid-template-columns:1fr}}
</style>

<section class="ev">
    <header class="ev-hero">
        <p style="margin:0;font-size:.7rem;font-weight:700;letter-spacing:.12em;opacity:.9">CHAPTER EXPERIENCE</p>
        <h1>Events & calendar</h1>
        <p>Keep chapter activities, webinars and learning opportunities organized in one place.</p>
        <div class="actions">
            <button type="button" class="ev-btn ev-btn--solid" @onclick="() => showForm = !showForm">@(showForm ? "Hide form" : "+ Add event")</button>
        </div>
    </header>

    <div class="ev-stats">
        <div class="ev-stat"><span>Upcoming</span><strong>@chapterEvents.Count(e => e.Date >= DateTime.Today)</strong></div>
        <div class="ev-stat"><span>This month</span><strong>@chapterEvents.Count(e => e.Date.Month == DateTime.Today.Month)</strong></div>
        <div class="ev-stat"><span>Online</span><strong>@chapterEvents.Count(e => e.Location.Contains("Online", StringComparison.OrdinalIgnoreCase))</strong></div>
    </div>

    @if (showForm)
    {
        <article class="ev-card" style="margin-bottom:1.15rem">
            <h2>Add an event</h2>
            <div class="ev-form">
                <label>Event name <input @bind="newItem.Title" placeholder="e.g. Chapter Meetup" /></label>
                <label>Date <input type="date" @bind="newItem.Date" /></label>
                <label>Type
                    <select @bind="newItem.Type">
                        <option>Webinar</option><option>Networking</option><option>Workshop</option><option>Meeting</option><option>Conference</option>
                    </select>
                </label>
                <label>Location / link <input @bind="newItem.Location" placeholder="Online or venue" /></label>
            </div>
            <div style="margin-top:1rem">
                <button type="button" class="ev-btn" style="background:var(--accent);color:#fff" @onclick="AddItem">Add event</button>
            </div>
            @if (!string.IsNullOrEmpty(message)) { <div class="ev-toast">@message</div> }
        </article>
    }

    <div class="ev-grid">
        <article class="ev-card">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem">
                <h2 style="margin:0">Upcoming events</h2>
                <select @bind="typeFilter" style="border:1.5px solid var(--line);border-radius:8px;padding:.35rem .6rem;font:inherit">
                    <option value="">All types</option>
                    <option>Webinar</option><option>Networking</option><option>Workshop</option><option>Meeting</option><option>Conference</option>
                </select>
            </div>
            @foreach (var item in filteredItems)
            {
                <div class="ev-row">
                    <div class="ev-date"><strong>@item.Date.ToString("dd")</strong><span>@item.Date.ToString("MMM")</span></div>
                    <div class="ev-copy"><strong>@item.Title</strong><span>@item.Type · @item.Location</span></div>
                    <button type="button" style="border:none;background:var(--soft);color:var(--accent);border-radius:8px;padding:.3rem .55rem;cursor:pointer;font-weight:700" @onclick="() => RemoveItem(item)">✕</button>
                </div>
            }
            @if (!filteredItems.Any()) { <p style="color:var(--muted);font-size:.9rem">No events match the filter.</p> }
        </article>

        <article class="ev-card">
            <h2>By type</h2>
            @foreach (var g in chapterEvents.GroupBy(e => e.Type).OrderByDescending(g => g.Count()))
            {
                var pct = chapterEvents.Count == 0 ? 0 : (int)Math.Round(100.0 * g.Count() / chapterEvents.Count);
                <div style="margin:.6rem 0">
                    <div style="display:flex;justify-content:space-between;font-size:.88rem"><span>@g.Key</span><strong>@g.Count()</strong></div>
                    <div style="height:7px;background:var(--soft);border-radius:99px;overflow:hidden;margin-top:.25rem"><div style="height:100%;width:@(pct)%;background:var(--accent);border-radius:99px"></div></div>
                </div>
            }
            <h3 style="margin:1.1rem 0 .5rem;font-size:.95rem">Planning tips</h3>
            <ul style="margin:0;padding-left:1.1rem;font-size:.88rem;color:var(--muted);line-height:1.55">
                <li>Publish registration at least 3 weeks ahead</li>
                <li>Collect CPE details before the event</li>
                <li>Send a reminder 48 hours prior</li>
                <li>Log attendance for chapter reporting</li>
            </ul>
        </article>
    </div>
</section>

@code {
    private bool showForm;
    private string typeFilter = "";
    private string? message;

    private List<ChapterEventItem> chapterEvents = new()
    {
        new() { Title = "ISACA Chapter Meetup", Date = DateTime.Today.AddDays(5), Type = "Networking", Location = "Kansas City" },
        new() { Title = "Security Awareness Webinar", Date = DateTime.Today.AddDays(12), Type = "Webinar", Location = "Online" },
        new() { Title = "Career Development Workshop", Date = DateTime.Today.AddDays(19), Type = "Workshop", Location = "Online" },
        new() { Title = "Board planning meeting", Date = DateTime.Today.AddDays(8), Type = "Meeting", Location = "Hybrid" },
        new() { Title = "CPE Lunch & Learn", Date = DateTime.Today.AddDays(26), Type = "Webinar", Location = "Online" }
    };

    private ChapterEventItem newItem = new() { Date = DateTime.Today.AddDays(7), Type = "Webinar" };

    private IEnumerable<ChapterEventItem> filteredItems => chapterEvents
        .Where(e => string.IsNullOrWhiteSpace(typeFilter) || e.Type == typeFilter)
        .OrderBy(e => e.Date);

    private void AddItem()
    {
        if (string.IsNullOrWhiteSpace(newItem.Title))
        {
            message = "Please enter an event name.";
            return;
        }
        chapterEvents.Add(new ChapterEventItem
        {
            Title = newItem.Title.Trim(),
            Date = newItem.Date,
            Type = newItem.Type,
            Location = string.IsNullOrWhiteSpace(newItem.Location) ? "TBC" : newItem.Location.Trim()
        });
        message = $"Added “{newItem.Title}”.";
        newItem = new ChapterEventItem { Date = DateTime.Today.AddDays(7), Type = "Webinar" };
    }

    private void RemoveItem(ChapterEventItem item)
    {
        chapterEvents.Remove(item);
        message = $"Removed “{item.Title}”.";
    }

    private sealed class ChapterEventItem
    {
        public string Title { get; set; } = "";
        public DateTime Date { get; set; } = DateTime.Today;
        public string Type { get; set; } = "Webinar";
        public string Location { get; set; } = "";
    }
}
