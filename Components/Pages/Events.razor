@page "/events"
@rendermode InteractiveServer

<PageTitle>Events | Isa</PageTitle>

<style>
.pg{--navy:#1d2d5c;--blue:#00a4e4;--green:#6cb33f;--mid:#07649d;--teal:#36ac91;--red:#e31837;--orange:#e57524;--yellow:#fbb034;--purple:#6558b1;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;
max-width:1180px;margin:0 auto;font-family:"Roboto",system-ui,sans-serif;color:var(--navy)}
.pg a{text-decoration:none!important}
.pg-hero{padding:1.2rem 1.35rem;border-radius:18px;margin-bottom:1rem;background:linear-gradient(125deg,#6cb33f,#36ac91);color:#fff;display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:center}
.pg-hero h1{margin:.15rem 0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.6rem}
.pg-hero p{margin:.3rem 0 0;opacity:.92;max-width:52ch}
.pg-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:.65rem;margin-bottom:1rem}
.pg-stat{display:block;background:#fff;border:1px solid var(--line);border-radius:14px;padding:.85rem .9rem;box-shadow:0 6px 16px rgba(29,45,92,.05);cursor:pointer;transition:transform .12s,box-shadow .12s;color:inherit;text-align:left;font:inherit;width:100%}
.pg-stat:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(29,45,92,.1);border-color:#36ac91}
.pg-stat span{display:block;font-size:.68rem;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.pg-stat strong{display:block;font-size:1.25rem;margin:.2rem 0 .15rem;color:var(--navy)}
.pg-stat em{font-style:normal;font-size:.78rem;color:var(--mid)}
.pg-grid{display:grid;grid-template-columns:1.25fr 1fr;gap:1rem}
.pg-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.1rem 1.15rem;box-shadow:0 8px 22px rgba(29,45,92,.06)}
.pg-card h2{margin:0 0 .75rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.1rem}
.pg-card--wide{grid-column:1/-1}
.pg-list{list-style:none;margin:0;padding:0}
.pg-list li{display:flex;justify-content:space-between;gap:.75rem;align-items:center;padding:.6rem 0;border-bottom:1px solid var(--line)}
.pg-list strong{display:block}.pg-list span{font-size:.8rem;color:var(--muted)}
.pg-btn{border:none;border-radius:10px;padding:.4rem .85rem;font-weight:600;font-size:.82rem;cursor:pointer;font-family:inherit;background:linear-gradient(135deg,#6cb33f,#36ac91);color:#fff}
.pg-btn--ghost{background:var(--light);color:var(--navy)}
.pg-actions{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.75rem}
.pg-chip{display:inline-flex;padding:.2rem .55rem;border-radius:999px;font-size:.72rem;font-weight:700;background:var(--light);color:var(--mid)}
.pg-bar{height:8px;background:var(--light);border-radius:999px;overflow:hidden;margin:.35rem 0}
.pg-bar i{display:block;height:100%;background:linear-gradient(90deg,#6cb33f,#36ac91);border-radius:999px}

@@media(max-width:900px){.pg-grid{grid-template-columns:1fr}}
</style>

<section class="pg">
  <header class="pg-hero">
    <div>
      <p style="margin:0;font-size:.7rem;font-weight:700;letter-spacing:.12em;opacity:.88">CHAPTER EXPERIENCE</p>
      <h1>Events & calendar</h1>
      <p>Chapter activities and learning opportunities — every tile opens an action.</p>
    </div>
  </header>

  <div class="pg-stats">
    <button type="button" class="pg-stat" @onclick="ShowUpcoming"><span>Upcoming</span><strong>5</strong><em>Scheduled →</em></button>
    <button type="button" class="pg-stat" @onclick="ShowMonth"><span>This month</span><strong>0</strong><em>October →</em></button>
    <button type="button" class="pg-stat" @onclick="ShowOnline"><span>Online</span><strong>3</strong><em>Virtual →</em></button>
    <button type="button" class="pg-stat" @onclick="AddEvent"><span>Add event</span><strong>+</strong><em>Create →</em></button>
  </div>
  <div class="pg-grid">
    <article class="pg-card">
      <h2>Upcoming events</h2>
      <ul class="pg-list">
        @foreach (var e in Events)
        {
          <li>
            <div><strong>@e.Title</strong><span>@e.When · @e.Type</span></div>
            <button type="button" class="pg-btn" @onclick="() => OpenEvent(e.Title)">Details</button>
          </li>
        }
      </ul>
    </article>
    <article class="pg-card">
      <h2>By type</h2>
      @foreach (var t in Types)
      {
        <div style="display:grid;grid-template-columns:90px 1fr 24px;gap:.4rem;align-items:center;margin:.4rem 0;font-size:.85rem">
          <span>@t.Name</span><div class="pg-bar"><i style="width:@(t.Count*40)%"></i></div><strong>@t.Count</strong>
        </div>
      }
      <div class="pg-actions">
        <button type="button" class="pg-btn" @onclick="AddEvent">+ Add event</button>
        <button type="button" class="pg-btn pg-btn--ghost" @onclick='() => Go("knowledge-base")'>Event planning guide</button>
      </div>
      @if (!string.IsNullOrEmpty(toast)) { <p style="margin-top:.75rem;color:var(--mid)">@toast</p> }
    </article>
  </div>

</section>

@code {

    [Inject] private NavigationManager Nav { get; set; } = default!;
    private string? toast;
    private List<(string Title,string When,string Type)> Events = new()
    {
        ("ISACA Chapter Meetup","02 Nov · Networking","Networking"),
        ("Board planning meeting","05 Nov · Hybrid","Meeting"),
        ("Security Awareness Webinar","09 Nov · Online","Webinar"),
        ("CPE workshop","12 Nov · Online","Workshop"),
        ("Member orientation","18 Nov · Online","Webinar"),
    };
    private readonly List<(string Name,int Count)> Types = new(){("Webinar",2),("Networking",1),("Workshop",1),("Meeting",1)};
    private void Go(string p) => Nav.NavigateTo(p);
    private void ShowUpcoming() => toast = "Showing upcoming events";
    private void ShowMonth() => toast = "October has 0 events in sample";
    private void ShowOnline() => toast = "3 online sessions";
    private void AddEvent() => toast = "New event form (sample) — connect to calendar API next";
    private void OpenEvent(string t) => toast = "Opened: " + t;

}
