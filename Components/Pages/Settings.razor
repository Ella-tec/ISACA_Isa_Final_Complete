@page "/settings"
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>Settings | Isa</PageTitle>

<section class="set-page">
    <header class="set-hero">
        <div>
            <p class="set-eyebrow">WORKSPACE</p>
            <h1>Settings</h1>
            <p class="set-lede">Preferences, profile, notifications, and chapter options for Isa.</p>
        </div>
        <div class="set-hero-badges">
            <span class="set-chip set-chip--green">Interactive</span>
            <span class="set-chip">Saved in this browser</span>
        </div>
    </header>

    <div class="set-layout">
        <aside class="set-tabs" role="tablist">
            <button type="button" class="set-tab @(Tab=="profile"?"is-on":"")" @onclick='() => Tab = "profile"'>Profile</button>
            <button type="button" class="set-tab @(Tab=="prefs"?"is-on":"")" @onclick='() => Tab = "prefs"'>Preferences</button>
            <button type="button" class="set-tab @(Tab=="notify"?"is-on":"")" @onclick='() => Tab = "notify"'>Notifications</button>
            <button type="button" class="set-tab @(Tab=="chapter"?"is-on":"")" @onclick='() => Tab = "chapter"'>Chapter</button>
            <button type="button" class="set-tab @(Tab=="security"?"is-on":"")" @onclick='() => Tab = "security"'>Security</button>
            <button type="button" class="set-tab @(Tab=="about"?"is-on":"")" @onclick='() => Tab = "about"'>About Isa</button>
        </aside>

        <div class="set-panel">
            @if (Tab == "profile")
            {
                <h2>Profile</h2>
                <p class="set-hint">How you appear in chapter tools. Demo only — not synced to ISACA membership.</p>
                <div class="set-form">
                    <label>Display name <input class="set-input" @bind="Profile.Name" placeholder="Your name" /></label>
                    <label>Email <input class="set-input" type="email" @bind="Profile.Email" placeholder="you@chapter.org" /></label>
                    <label>Role
                        <select class="set-input" @bind="Profile.Role">
                            <option>Chapter leader</option>
                            <option>Volunteer</option>
                            <option>Administrator</option>
                            <option>Member</option>
                        </select>
                    </label>
                    <label>Preferred language
                        <select class="set-input" @bind="Profile.Language">
                            <option>English</option>
                            <option>Spanish</option>
                            <option>French</option>
                            <option>Arabic</option>
                            <option>Chinese</option>
                            <option>German</option>
                        </select>
                    </label>
                    <button type="button" class="set-btn set-btn--primary" @onclick="SaveProfile">Save profile</button>
                    @if (SavedMsg is not null) { <span class="set-ok">@SavedMsg</span> }
                </div>
            }
            else if (Tab == "prefs")
            {
                <h2>Preferences</h2>
                <p class="set-hint">Workspace look and default behavior.</p>
                <div class="set-toggles">
                    <label class="set-toggle"><input type="checkbox" @bind="Prefs.CompactTables" /> Compact tables</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Prefs.DarkSidebar" /> Prefer dark sidebar accents</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Prefs.AutoRefresh" /> Auto-refresh dashboards</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Prefs.ShowTips" /> Show helpful tips</label>
                </div>
                <label class="set-field">Default landing page
                    <select class="set-input" @bind="Prefs.Landing">
                        <option value="/">Home</option>
                        <option value="/knowledge-base">Knowledge base</option>
                        <option value="/escalations">Escalations</option>
                        <option value="/governance">Governance</option>
                        <option value="/translator">Translator</option>
                    </select>
                </label>
                <button type="button" class="set-btn set-btn--primary" @onclick="SavePrefs">Save preferences</button>
                @if (SavedMsg is not null) { <span class="set-ok">@SavedMsg</span> }
            }
            else if (Tab == "notify")
            {
                <h2>Notifications</h2>
                <p class="set-hint">Choose what Isa should surface for chapter work.</p>
                <div class="set-toggles">
                    <label class="set-toggle"><input type="checkbox" @bind="Notify.Escalations" /> New escalations & tickets</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Notify.Events" /> Upcoming chapter events</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Notify.Policy" /> Policy review reminders</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Notify.Digest" /> Weekly chapter digest</label>
                    <label class="set-toggle"><input type="checkbox" @bind="Notify.Security" /> Security & sign-in alerts</label>
                </div>
                <button type="button" class="set-btn set-btn--primary" @onclick="SaveNotify">Save notifications</button>
                @if (SavedMsg is not null) { <span class="set-ok">@SavedMsg</span> }
            }
            else if (Tab == "chapter")
            {
                <h2>Chapter</h2>
                <p class="set-hint">Local chapter context used across workspace tools.</p>
                <div class="set-form">
                    <label>Chapter name <input class="set-input" @bind="Chapter.Name" placeholder="e.g. Kansas City Chapter" /></label>
                    <label>Region
                        <select class="set-input" @bind="Chapter.Region">
                            <option>North America</option>
                            <option>Europe</option>
                            <option>Asia Pacific</option>
                            <option>Latin America</option>
                            <option>Africa</option>
                            <option>Middle East</option>
                        </select>
                    </label>
                    <label>Time zone <input class="set-input" @bind="Chapter.TimeZone" placeholder="America/Chicago" /></label>
                    <label>Support email <input class="set-input" @bind="Chapter.SupportEmail" placeholder="support@chapter.org" /></label>
                    <button type="button" class="set-btn set-btn--primary" @onclick="SaveChapter">Save chapter</button>
                    @if (SavedMsg is not null) { <span class="set-ok">@SavedMsg</span> }
                </div>
            }
            else if (Tab == "security")
            {
                <h2>Security</h2>
                <p class="set-hint">Session and access controls for this prototype.</p>
                <div class="set-cards">
                    <div class="set-card">
                        <strong>Sign out</strong>
                        <p>End this browser session and return to the sign-in page.</p>
                        <button type="button" class="set-btn set-btn--danger" @onclick="SignOut">Sign out</button>
                    </div>
                    <div class="set-card">
                        <strong>Clear local demo data</strong>
                        <p>Reset preferences and profile stored in this browser.</p>
                        <button type="button" class="set-btn set-btn--ghost" @onclick="ClearLocal">Clear local data</button>
                    </div>
                </div>
            }
            else
            {
                <h2>About Isa</h2>
                <div class="set-about">
                    <p><strong>Isa</strong> is a chapter support assistant prototype for ISACA communities.</p>
                    <ul>
                        <li>Colors follow the official ISACA brand palette</li>
                        <li>Pages use sample data unless connected to live systems</li>
                        <li>Not an official ISACA product or website</li>
                    </ul>
                    <div class="set-palette">
                        <span style="background:#1d2d5c" title="Dark Blue"></span>
                        <span style="background:#00a4e4" title="Blue"></span>
                        <span style="background:#6cb33f" title="Green"></span>
                        <span style="background:#07649d" title="Medium Blue"></span>
                        <span style="background:#36ac91" title="Teal"></span>
                        <span style="background:#e31837" title="Red"></span>
                        <span style="background:#e57524" title="Orange"></span>
                        <span style="background:#6558b1" title="Purple"></span>
                    </div>
                    <a class="set-btn set-btn--primary" href="/">Back to Home</a>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string Tab = "profile";
    private string? SavedMsg;

    private ProfileModel Profile = new() { Name = "Chapter User", Email = "member@chapter.org", Role = "Chapter leader", Language = "English" };
    private PrefsModel Prefs = new() { CompactTables = false, DarkSidebar = true, AutoRefresh = true, ShowTips = true, Landing = "/" };
    private NotifyModel Notify = new() { Escalations = true, Events = true, Policy = true, Digest = false, Security = true };
    private ChapterModel Chapter = new() { Name = "Local ISACA Chapter", Region = "North America", TimeZone = "America/Chicago", SupportEmail = "support@chapter.org" };

    private void Flash(string msg) { SavedMsg = msg; }
    private void SaveProfile() => Flash("Profile saved for this browser session.");
    private void SavePrefs() => Flash("Preferences saved.");
    private void SaveNotify() => Flash("Notification choices saved.");
    private void SaveChapter() => Flash("Chapter details saved.");
    private void SignOut() => Nav.NavigateTo("/sign-in", forceLoad: true);
    private void ClearLocal()
    {
        Profile = new() { Name = "", Email = "", Role = "Member", Language = "English" };
        Prefs = new() { Landing = "/" };
        Notify = new();
        Flash("Local demo data cleared.");
    }

    private sealed class ProfileModel { public string Name { get; set; } = ""; public string Email { get; set; } = ""; public string Role { get; set; } = "Member"; public string Language { get; set; } = "English"; }
    private sealed class PrefsModel { public bool CompactTables { get; set; } public bool DarkSidebar { get; set; } public bool AutoRefresh { get; set; } public bool ShowTips { get; set; } public string Landing { get; set; } = "/"; }
    private sealed class NotifyModel { public bool Escalations { get; set; } public bool Events { get; set; } public bool Policy { get; set; } public bool Digest { get; set; } public bool Security { get; set; } }
    private sealed class ChapterModel { public string Name { get; set; } = ""; public string Region { get; set; } = ""; public string TimeZone { get; set; } = ""; public string SupportEmail { get; set; } = ""; }
}
