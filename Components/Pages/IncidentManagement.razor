@page "/incident-management"
@rendermode InteractiveServer
<PageTitle>Incident Management | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">OPERATIONS</p>
            <h1>Incident management</h1>
            <p class="isa-intro">Incident reports, severity, response status, and corrective actions.</p>
        </div>
        <span class="isa-pill">Sample workspace</span>
    </div>
<div class="isa-stat-grid">
        <article class="isa-stat-card">
            <span class="isa-stat-icon orange">!</span>
            <span class="isa-stat-label">Open incidents</span>
            <strong>@Incidents.Count(i => i.Status is "Open" or "Investigating" or "Contained")</strong>
            <small>Active response</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon red">↑</span>
            <span class="isa-stat-label">Critical / High</span>
            <strong>@Incidents.Count(i => i.Severity is "Critical" or "High" && i.Status != "Closed")</strong>
            <small>Elevated priority</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">◷</span>
            <span class="isa-stat-label">Avg time to contain</span>
            <strong>4.2h</strong>
            <small>Sample metric</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">✓</span>
            <span class="isa-stat-label">Closed (30d)</span>
            <strong>@Incidents.Count(i => i.Status == "Closed")</strong>
            <small>Sample period</small>
        </article>
    </div>

    <div class="isa-toolbar">
        <InputText class="form-control isa-filter" @bind-Value="Filter" placeholder="Search incidents..." />
        <InputSelect class="form-select isa-status-select" @bind-Value="SeverityFilter" style="min-width:140px">
            <option value="">All severities</option>
            <option>Critical</option>
            <option>High</option>
            <option>Medium</option>
            <option>Low</option>
        </InputSelect>
        <button type="button" class="isa-btn isa-btn--primary" @onclick="AddSample">+ Log sample incident</button>
    </div>

    <article class="isa-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Severity</th>
                        <th>Category</th>
                        <th>Owner</th>
                        <th>Reported</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var i in Filtered)
                    {
                        <tr>
                            <td><strong>@i.Id</strong></td>
                            <td>
                                <strong>@i.Title</strong>
                                <div class="isa-table-sub">@i.Summary</div>
                            </td>
                            <td>
                                <span class="isa-badge @(i.Severity == "Critical" || i.Severity == "High" ? "isa-badge--red" : i.Severity == "Medium" ? "isa-badge--orange" : "isa-badge--blue")">
                                    @i.Severity
                                </span>
                            </td>
                            <td>@i.Category</td>
                            <td>@i.Owner</td>
                            <td>@i.Reported</td>
                            <td>
                                <InputSelect class="form-select isa-status-select" @bind-Value="i.Status">
                                    <option>Open</option>
                                    <option>Investigating</option>
                                    <option>Contained</option>
                                    <option>Resolved</option>
                                    <option>Closed</option>
                                </InputSelect>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </article>

    <article class="isa-panel" style="margin-top:1.25rem">
        <h2>Corrective action checklist</h2>
        <div class="isa-checklist" style="margin-top:.75rem">
            @foreach (var item in Actions)
            {
                <label class="isa-check-row">
                    <InputCheckbox @bind-Value="item.Done" />
                    <span>@item.Text</span>
                </label>
            }
        </div>
        <p class="isa-muted small" style="margin-top:.75rem">Checklist is temporary and resets when the app restarts.</p>
    </article>
</section>

@code {
    private string Filter = "";
    private string SeverityFilter = "";
    private int _nextId = 1005;

    private List<IncidentItem> Incidents = new()
    {
        new() { Id = "INC-1001", Title = "Suspected phishing to board list", Summary = "Two officers reported suspicious emails claiming to be from the treasurer.", Severity = "High", Category = "Security", Owner = "IT lead", Reported = "Oct 18", Status = "Investigating" },
        new() { Id = "INC-1002", Title = "Event registration site outage", Summary = "Registration form returned 500 errors for ~40 minutes during peak signup.", Severity = "Medium", Category = "Availability", Owner = "Events chair", Reported = "Oct 12", Status = "Resolved" },
        new() { Id = "INC-1003", Title = "Lost chapter laptop", Summary = "Volunteer reported lost laptop containing offline event attendee list.", Severity = "High", Category = "Data", Owner = "Secretary", Reported = "Oct 5", Status = "Contained" },
        new() { Id = "INC-1004", Title = "Incorrect CPE hours submitted", Summary = "Member reported overstated hours on certificate for September workshop.", Severity = "Low", Category = "Process", Owner = "Events chair", Reported = "Sep 28", Status = "Closed" }
    };

    private List<ActionItem> Actions = new()
    {
        new() { Text = "Notify affected parties where required" },
        new() { Text = "Contain and eradicate root cause" },
        new() { Text = "Document timeline and evidence" },
        new() { Text = "Implement corrective / preventive actions" },
        new() { Text = "Close incident and update lessons learned" }
    };

    private IEnumerable<IncidentItem> Filtered => Incidents.Where(i =>
        (string.IsNullOrWhiteSpace(Filter) || (i.Id + i.Title + i.Summary + i.Owner).Contains(Filter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(SeverityFilter) || i.Severity == SeverityFilter));

    private void AddSample()
    {
        Incidents.Insert(0, new IncidentItem
        {
            Id = $"INC-{_nextId++}",
            Title = "New sample incident",
            Summary = "Logged from the workspace for demonstration.",
            Severity = "Medium",
            Category = "Process",
            Owner = "Unassigned",
            Reported = "Today",
            Status = "Open"
        });
    }

    private sealed class IncidentItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Summary { get; set; } = "";
        public string Severity { get; set; } = "";
        public string Category { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Reported { get; set; } = "";
        public string Status { get; set; } = "Open";
    }

    private sealed class ActionItem
    {
        public string Text { get; set; } = "";
        public bool Done { get; set; }
    }
}
