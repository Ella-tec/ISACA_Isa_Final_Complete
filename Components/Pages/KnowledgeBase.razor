@page "/knowledge-base"
@rendermode InteractiveServer

<PageTitle>Knowledge base | Isa</PageTitle>

<style>
.kb{--navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);max-width:1100px;margin:0 auto;padding-bottom:1.5rem}
.kb-hero{border-radius:18px;padding:1.5rem 1.6rem;color:#fff;margin-bottom:.85rem;
background:linear-gradient(115deg,#07649d,#00a4e4 60%,#1d2d5c);box-shadow:0 12px 36px rgba(29,45,92,.16)}
.kb-hero h1{margin:.15rem 0 .3rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.7rem}
.kb-hero p{margin:0;opacity:.92;max-width:48ch}
.kb-tools{display:flex;gap:.5rem;margin-bottom:.85rem;flex-wrap:wrap}
.kb-tools input,.kb-tools select{padding:.55rem .8rem;border-radius:10px;border:1px solid var(--line);font-family:inherit}
.kb-tools input{flex:1;min-width:180px}
.kb-kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:.65rem;margin-bottom:.85rem}
.kb-kpi{background:#fff;border-radius:14px;padding:1.1rem;border:1px solid var(--line);cursor:pointer;text-align:left;font-family:inherit;color:inherit;transition:border-color .12s,transform .12s}
.kb-kpi:hover{border-color:var(--blue);transform:translateY(-2px)}
.kb-kpi.on{border-color:var(--mid);box-shadow:0 0 0 2px rgba(7,100,157,.22)}
.kb-kpi .l{font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.kb-kpi .v{font-size:1.5rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300}
.kb-detail{background:#e8f4fc;border-radius:12px;padding:.75rem 1rem;margin-bottom:.85rem;font-size:.88rem;border:1px solid #c5e0f5}
.kb-list{background:#fff;border-radius:14px;border:1px solid var(--line);overflow:hidden}
.kb-item{padding:1rem 1.1rem;border-bottom:1px solid var(--line);cursor:pointer;transition:background .12s}
.kb-item:hover{background:var(--light)}
.kb-item:last-child{border-bottom:0}
.kb-item strong{display:block}
.kb-item span{font-size:.82rem;color:var(--muted)}
</style>

<section class="kb">
    <header class="kb-hero">
        <div style="font-size:.65rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">Resources</div>
        <h1>Knowledge base</h1>
        <p>Approved guidance, chapter articles and support content. Search and filter by topic. KPI cards are clickable.</p>
    </header>

    <div class="kb-tools">
        <input @bind="search" @bind:event="oninput" placeholder="Search articles, topics or keywords…" />
        <select @bind="category">
            <option>All categories</option>
            <option>Membership</option>
            <option>Events</option>
            <option>Governance</option>
            <option>Security</option>
            <option>Education</option>
        </select>
    </div>

    <div class="kb-kpis">
        <button type="button" class="kb-kpi @(focus=="a"?"on":null)" @onclick='() => SetFocus("a")'>
            <div class="l">Articles</div><div class="v">@articles.Count</div>
        </button>
        <button type="button" class="kb-kpi @(focus=="c"?"on":null)" @onclick='() => SetFocus("c")'>
            <div class="l">Categories</div><div class="v">@catCount</div>
        </button>
        <button type="button" class="kb-kpi @(focus=="m"?"on":null)" @onclick='() => SetFocus("m")'>
            <div class="l">Matching</div><div class="v">@Filtered.Count()</div>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(detail))
    {
        <div class="kb-detail">@detail</div>
    }

    <div class="kb-list">
        @foreach (var a in Filtered)
        {
            <div class="kb-item" @onclick="() => Open(a)">
                <strong>@a.Title</strong>
                <span>@a.Category · @a.Summary</span>
            </div>
        }
    </div>
</section>

@code {
    private sealed class Art { public string Title { get; set; } = ""; public string Category { get; set; } = ""; public string Summary { get; set; } = ""; }
    private readonly List<Art> articles = new()
    {
        new() { Title = "Chapter meeting checklist", Category = "Governance", Summary = "Board agenda and quorum reminders" },
        new() { Title = "CPE reporting guide", Category = "Education", Summary = "How members claim credits" },
        new() { Title = "Event registration playbook", Category = "Events", Summary = "Capacity, waitlists, and CPE codes" },
        new() { Title = "New member onboarding", Category = "Membership", Summary = "First 30 days checklist" },
        new() { Title = "Incident response contacts", Category = "Security", Summary = "Severity and escalation paths" },
        new() { Title = "Vendor risk questionnaire", Category = "Governance", Summary = "Third-party due diligence" },
        new() { Title = "Study group facilitator tips", Category = "Education", Summary = "CISA/CISM circles" },
        new() { Title = "Hybrid event AV checklist", Category = "Events", Summary = "Room and streaming setup" },
    };
    private string search = "", category = "All categories", focus = "a", detail = "";
    private int catCount => articles.Select(a => a.Category).Distinct().Count();
    private IEnumerable<Art> Filtered
    {
        get
        {
            IEnumerable<Art> q = articles;
            if (category != "All categories") q = q.Where(a => a.Category == category);
            if (!string.IsNullOrWhiteSpace(search))
                q = q.Where(a => a.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || a.Summary.Contains(search, StringComparison.OrdinalIgnoreCase)
                    || a.Category.Contains(search, StringComparison.OrdinalIgnoreCase));
            return q;
        }
    }
    private void SetFocus(string f)
    {
        focus = f;
        detail = f switch
        {
            "a" => $"Knowledge base has {articles.Count} articles across membership, events, governance, security, and education.",
            "c" => $"{catCount} categories in use. Filter with the dropdown to narrow results.",
            "m" => $"{Filtered.Count()} articles match your current search and category filters.",
            _ => ""
        };
    }
    private void Open(Art a) => detail = $"Opened: {a.Title} ({a.Category}) — {a.Summary}";
}
