@page "/policies-documents"
@rendermode InteractiveServer
<PageTitle>Policies & Documents | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">DOCUMENT GOVERNANCE</p>
            <h1>Policies & documents</h1>
            <p class="isa-intro">Policy library, version history, approvals, and review calendar.</p>
        </div>
        <span class="isa-pill">Sample workspace</span>
    </div>
<div class="isa-stat-grid isa-stat-grid--three">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">▤</span>
            <span class="isa-stat-label">Documents</span>
            <strong>@Docs.Count</strong>
            <small>In library</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">✓</span>
            <span class="isa-stat-label">Approved</span>
            <strong>@Docs.Count(d => d.Status == "Approved")</strong>
            <small>Current version</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon orange">!</span>
            <span class="isa-stat-label">Review due</span>
            <strong>@Docs.Count(d => d.Status == "Review due" || d.Status == "Expired")</strong>
            <small>Action needed</small>
        </article>
    </div>

    <div class="isa-toolbar">
        <InputText class="form-control isa-filter" @bind-Value="Filter" placeholder="Search documents..." />
        <InputSelect class="form-select isa-status-select" @bind-Value="TypeFilter" style="min-width:150px">
            <option value="">All types</option>
            <option>Policy</option>
            <option>Procedure</option>
            <option>Guideline</option>
            <option>Form</option>
        </InputSelect>
    </div>

    <div class="isa-card-grid">
        @foreach (var d in Filtered)
        {
            <article class="isa-card">
                <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:.5rem">
                    <span class="isa-badge isa-badge--blue">@d.Type</span>
                    <span class="isa-badge @(d.Status == "Approved" ? "isa-badge--green" : d.Status == "Draft" ? "isa-badge--gray" : "isa-badge--orange")">@d.Status</span>
                </div>
                <h3>@d.Title</h3>
                <p>@d.Summary</p>
                <div style="margin-top:auto;padding-top:.6rem;font-size:.8rem;color:var(--isa-muted)">
                    <div>v@(d.Version) · Owner: @d.Owner</div>
                    <div>Reviewed: @d.LastReview · Next: @d.NextReview</div>
                </div>
                <div style="display:flex;gap:.4rem;margin-top:.6rem">
                    <button type="button" class="isa-btn isa-btn--ghost" style="font-size:.78rem;padding:.3rem .6rem" @onclick="() => SelectDoc(d)">History</button>
                    <button type="button" class="isa-btn isa-btn--primary" style="font-size:.78rem;padding:.3rem .6rem" @onclick="() => CycleStatus(d)">Advance status</button>
                </div>
            </article>
        }
    </div>

    @if (Selected is not null)
    {
        <article class="isa-panel" style="margin-top:1.25rem">
            <div class="isa-panel-heading">
                <div><h2>Version history — @Selected.Title</h2><p>Illustrative change log</p></div>
                <button type="button" class="isa-btn isa-btn--ghost" @onclick="() => Selected = null">Close</button>
            </div>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th>Version</th><th>Date</th><th>Author</th><th>Change</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Selected.History)
                        {
                            <tr>
                                <td><strong>@v.Ver</strong></td>
                                <td>@v.Date</td>
                                <td>@v.Author</td>
                                <td>@v.Note</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </article>
    }
</section>

@code {
    private string Filter = "";
    private string TypeFilter = "";
    private DocItem? Selected;

    private List<DocItem> Docs = new()
    {
        new() {
            Title = "Chapter code of conduct", Type = "Policy", Summary = "Expected behavior for officers, volunteers, and event participants.",
            Owner = "President", Version = "2.1", LastReview = "Jun 2026", NextReview = "Jun 2027", Status = "Approved",
            History = new() { new("2.1", "Jun 2026", "Board", "Minor wording updates"), new("2.0", "Jun 2025", "Governance", "Major rewrite") }
        },
        new() {
            Title = "Expense reimbursement procedure", Type = "Procedure", Summary = "How members submit and receive reimbursement for approved expenses.",
            Owner = "Treasurer", Version = "1.4", LastReview = "Mar 2026", NextReview = "Mar 2027", Status = "Approved",
            History = new() { new("1.4", "Mar 2026", "Treasurer", "Raised receipt threshold"), new("1.3", "Mar 2025", "Treasurer", "Digital form link") }
        },
        new() {
            Title = "Event safety guideline", Type = "Guideline", Summary = "Venue checks, emergency contacts, and accessibility considerations.",
            Owner = "Events chair", Version = "1.0", LastReview = "Jan 2026", NextReview = "Jan 2027", Status = "Review due",
            History = new() { new("1.0", "Jan 2026", "Events", "Initial publication") }
        },
        new() {
            Title = "Volunteer onboarding checklist", Type = "Form", Summary = "Checklist for new board and committee members.",
            Owner = "Secretary", Version = "3.0", LastReview = "Sep 2026", NextReview = "Sep 2027", Status = "Draft",
            History = new() { new("3.0", "Sep 2026", "Secretary", "Added Keycloak account steps"), new("2.1", "Sep 2025", "Secretary", "Prior version") }
        },
        new() {
            Title = "Data retention policy", Type = "Policy", Summary = "Retention periods for membership, financial, and event records.",
            Owner = "Secretary", Version = "1.2", LastReview = "Feb 2025", NextReview = "Feb 2026", Status = "Expired",
            History = new() { new("1.2", "Feb 2025", "Secretary", "Aligned with privacy notice"), new("1.1", "Feb 2024", "Board", "Initial") }
        }
    };

    private IEnumerable<DocItem> Filtered => Docs.Where(d =>
        (string.IsNullOrWhiteSpace(Filter) || (d.Title + d.Summary + d.Owner).Contains(Filter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(TypeFilter) || d.Type == TypeFilter));

    private void SelectDoc(DocItem d) => Selected = d;

    private void CycleStatus(DocItem d)
    {
        d.Status = d.Status switch
        {
            "Draft" => "Review due",
            "Review due" => "Approved",
            "Expired" => "Review due",
            _ => d.Status
        };
    }

    private sealed class DocItem
    {
        public string Title { get; set; } = "";
        public string Type { get; set; } = "";
        public string Summary { get; set; } = "";
        public string Owner { get; set; } = "";
        public string Version { get; set; } = "";
        public string LastReview { get; set; } = "";
        public string NextReview { get; set; } = "";
        public string Status { get; set; } = "";
        public List<(string Ver, string Date, string Author, string Note)> History { get; set; } = new();
    }
}
