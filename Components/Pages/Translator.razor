@page "/translator"
@rendermode InteractiveServer
<PageTitle>Translator | Isa</PageTitle>
<section class="isa-page">
    <div class="isa-page-heading"><div><p class="isa-eyebrow">ACCESSIBILITY & REACH</p><h1>Translator</h1><p class="isa-intro">Prepare chapter communications for a multilingual audience.</p></div></div>
    <div class="isa-notice">This page is a user-interface prototype. Translation is not connected to a translation provider; the button below creates a local preview reminder, not a translated result.</div>
    <div class="isa-content-grid isa-content-grid--translator">
        <article class="isa-panel">
            <div class="isa-panel-heading"><div><h2>Translation workspace</h2><p>Choose languages and enter the text to prepare.</p></div><span class="isa-article-icon">文</span></div>
            <div class="isa-form-grid">
                <label class="isa-field">Source language <InputSelect class="form-select" @bind-Value="SourceLanguage"><option>English</option><option>Spanish</option><option>French</option><option>Arabic</option><option>Chinese</option><option>German</option></InputSelect></label>
                <label class="isa-field">Target language <InputSelect class="form-select" @bind-Value="TargetLanguage"><option>Spanish</option><option>English</option><option>French</option><option>Arabic</option><option>Chinese</option><option>German</option></InputSelect></label>
            </div>
            <label class="isa-field mt-3">Text to translate <InputTextArea class="form-control isa-translation-input" @bind-Value="SourceText" placeholder="Paste chapter announcement, event details, or member communication here..." /></label>
            <div class="isa-translation-actions"><span class="isa-muted small">@SourceText.Length characters</span><button class="btn btn-primary" @onclick="PreparePreview">Prepare translation preview</button></div>
            @if (PreviewReady)
            {
                <div class="isa-preview-box" role="status"><strong>Translation request prepared</strong><p>From @SourceLanguage to @TargetLanguage</p><p>@SourceText</p><small>Connect a translation API to generate a translated version. Review any generated translation before publishing.</small></div>
            }
        </article>
        <article class="isa-panel"><h2>Good practices</h2><ul class="isa-action-list"><li>Keep names, certification titles, and official terminology consistent.</li><li>Protect personal or confidential information.</li><li>Ask a fluent reviewer to check important member communications.</li><li>Include a link to the official source when translating policy guidance.</li></ul><div class="isa-notice isa-notice--soft">Never treat an unreviewed machine translation as an official policy statement.</div></article>
    </div>
</section>
@code {
    private string SourceLanguage = "English";
    private string TargetLanguage = "Spanish";
    private string SourceText = "";
    private bool PreviewReady;
    private void PreparePreview() => PreviewReady = !string.IsNullOrWhiteSpace(SourceText);
}
