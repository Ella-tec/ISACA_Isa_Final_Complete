@page "/translator"
@rendermode InteractiveServer

<PageTitle>Translator | Isa</PageTitle>

<section class="tr-page">
    <header class="tr-hero">
        <div>
            <p class="tr-eyebrow">ACCESSIBILITY & REACH</p>
            <h1>Translator</h1>
            <p class="tr-lede">Prepare chapter communications for a multilingual audience with a clean, ISACA-styled workspace.</p>
        </div>
        <div class="tr-stats">
            <div><strong>@SourceText.Length</strong><span>characters</span></div>
            <div><strong>@WordCount</strong><span>words</span></div>
            <div><strong>@History.Count</strong><span>previews</span></div>
        </div>
    </header>

    <div class="tr-grid">
        <article class="tr-card tr-card--main">
            <div class="tr-card-head">
                <h2>Translation workspace</h2>
                <span class="tr-icon" aria-hidden="true">文A</span>
            </div>

            <div class="tr-langs">
                <label>Source
                    <select class="tr-select" @bind="SourceLanguage">
                        @foreach (var l in Languages) { <option>@l</option> }
                    </select>
                </label>
                <button type="button" class="tr-swap" @onclick="SwapLanguages" title="Swap languages">⇄</button>
                <label>Target
                    <select class="tr-select" @bind="TargetLanguage">
                        @foreach (var l in Languages) { <option>@l</option> }
                    </select>
                </label>
            </div>

            <label class="tr-label">Text to prepare
                <textarea class="tr-area" @bind="SourceText" @bind:event="oninput"
                          placeholder="Paste a chapter announcement, event details, or member note…" rows="8"></textarea>
            </label>

            <div class="tr-actions">
                <button type="button" class="tr-btn tr-btn--ghost" @onclick="ClearText" disabled="@(string.IsNullOrWhiteSpace(SourceText))">Clear</button>
                <button type="button" class="tr-btn tr-btn--primary" @onclick="PreparePreview" disabled="@(string.IsNullOrWhiteSpace(SourceText))">
                    Prepare preview
                </button>
            </div>

            @if (Preview is not null)
            {
                <div class="tr-preview" role="status">
                    <div class="tr-preview-top">
                        <strong>Preview ready</strong>
                        <span>@Preview.From → @Preview.To</span>
                    </div>
                    <p class="tr-preview-body">@Preview.Text</p>
                    <p class="tr-preview-note">This is a workspace preview — connect a translation API for live output. Always review before publishing.</p>
                    <div class="tr-preview-actions">
                        <button type="button" class="tr-btn tr-btn--teal" @onclick="CopyPreview">Copy text</button>
                        <a class="tr-btn tr-btn--ghost" href="https://translate.google.com/?sl=auto&tl=es&text=@Uri.EscapeDataString(SourceText)" target="_blank" rel="noopener">Open in Google Translate</a>
                        <a class="tr-btn tr-btn--ghost" href="https://www.deepl.com/translator" target="_blank" rel="noopener">Open DeepL</a>
                    </div>
                </div>
            }
        </article>

        <aside class="tr-side">
            <article class="tr-card">
                <h2>Quick phrases</h2>
                <p class="tr-muted">Insert common chapter phrases</p>
                <div class="tr-chips">
                    @foreach (var q in QuickPhrases)
                    {
                        <button type="button" class="tr-chip" @onclick="() => InsertPhrase(q)">@q</button>
                    }
                </div>
            </article>

            <article class="tr-card">
                <h2>Good practices</h2>
                <ul class="tr-list">
                    <li>Keep certification titles (CISA, CISM, CRISC) unchanged.</li>
                    <li>Protect member names and confidential details.</li>
                    <li>Have a bilingual reviewer check final copy.</li>
                    <li>Match formal tone for board and policy messages.</li>
                </ul>
            </article>

            @if (History.Count > 0)
            {
                <article class="tr-card">
                    <h2>Recent previews</h2>
                    <ul class="tr-history">
                        @foreach (var h in History.Take(5))
                        {
                            <li><span>@h.From → @h.To</span><small>@h.Text.Substring(0, Math.Min(48, h.Text.Length))…</small></li>
                        }
                    </ul>
                </article>
            }
        </aside>
    </div>
</section>

@code {
    private static readonly string[] Languages = { "English", "Spanish", "French", "Arabic", "Chinese", "German", "Portuguese", "Japanese" };
    private static readonly string[] QuickPhrases =
    {
        "You are invited to our next chapter meeting.",
        "Registration closes this Friday.",
        "CPE credits will be awarded after attendance.",
        "Please bring your membership ID.",
        "Contact the chapter board for questions."
    };

    private string SourceLanguage = "English";
    private string TargetLanguage = "Spanish";
    private string SourceText = "";
    private PreviewItem? Preview;
    private readonly List<PreviewItem> History = new();

    private int WordCount => string.IsNullOrWhiteSpace(SourceText)
        ? 0
        : SourceText.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private void SwapLanguages()
    {
        (SourceLanguage, TargetLanguage) = (TargetLanguage, SourceLanguage);
    }

    private void InsertPhrase(string q)
    {
        SourceText = string.IsNullOrWhiteSpace(SourceText) ? q : SourceText.TrimEnd() + " " + q;
    }

    private void ClearText()
    {
        SourceText = "";
        Preview = null;
    }

    private void PreparePreview()
    {
        if (string.IsNullOrWhiteSpace(SourceText)) return;
        Preview = new PreviewItem(SourceLanguage, TargetLanguage, SourceText.Trim());
        History.Insert(0, Preview);
        if (History.Count > 12) History.RemoveAt(History.Count - 1);
    }

    private async Task CopyPreview()
    {
        // UI-only: text already visible; clipboard needs JS — left as no-op shell
        await Task.CompletedTask;
    }

    private sealed record PreviewItem(string From, string To, string Text);
}
