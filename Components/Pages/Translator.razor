@page "/translator"
@rendermode InteractiveServer
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inject IsaChatApp.Services.Orchestrator.Orchestrator Pipeline

<PageTitle>Translator | TRU</PageTitle>

<style>
.tr {
  --navy:#1d2d5c; --blue:#00a4e4; --mid:#07649d; --green:#6cb33f; --teal:#36ac91;
  --light:#e7f0f5; --muted:#5f6b85; --line:#e2e8f0;
  font-family:"Roboto",system-ui,sans-serif; color:var(--navy);
  width:100%; margin:0; padding:0.65rem 0.85rem 1rem; box-sizing:border-box;
}
.tr-top { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:0.75rem; }
.tr-top h1 { margin:0; font-family:"Roboto Slab",Georgia,serif; font-weight:400; font-size:1.3rem; }
.tr-top p { margin:0.15rem 0 0; color:var(--muted); font-size:0.84rem; }
.tr-meta { display:flex; gap:0.4rem; flex-wrap:wrap; }
.tr-meta span { background:#fff; border:1px solid var(--line); border-radius:999px; padding:0.28rem 0.65rem; font-size:0.74rem; font-weight:600; color:var(--muted); }
.tr-bar {
  display:flex; align-items:center; gap:0.45rem; flex-wrap:wrap;
  background:#fff; border:1px solid var(--line); border-radius:14px;
  padding:0.5rem 0.7rem; margin-bottom:0.7rem;
  box-shadow:0 2px 8px rgba(29,45,92,0.04);
}
.tr-bar select {
  flex:1; min-width:130px; max-width:210px;
  padding:0.42rem 0.6rem; border-radius:10px; border:1px solid var(--line);
  font:inherit; font-weight:600; color:var(--navy); background:#f7fafc;
}
.tr-swap {
  width:40px; height:40px; border:none; border-radius:50%; cursor:pointer;
  background:linear-gradient(135deg,var(--navy),var(--mid)); color:#fff; font-size:1.1rem;
  flex-shrink:0; box-shadow:0 4px 12px rgba(7,100,157,0.25);
}
.tr-swap:hover { filter:brightness(1.08); }
.tr-grid { display:grid; grid-template-columns:1fr 1fr; gap:0.7rem; margin-bottom:0.65rem; }
.tr-box {
  background:#fff; border:1px solid var(--line); border-radius:14px;
  display:flex; flex-direction:column; overflow:hidden;
  box-shadow:0 4px 14px rgba(29,45,92,0.05); min-height:260px;
}
.tr-box__h {
  display:flex; justify-content:space-between; align-items:center;
  padding:0.45rem 0.8rem; background:var(--light); border-bottom:1px solid var(--line);
  font-size:0.7rem; font-weight:700; letter-spacing:0.04em; text-transform:uppercase; color:var(--muted);
}
.tr-box__h button { border:none; background:transparent; cursor:pointer; color:var(--mid); font-weight:600; font-size:0.78rem; font-family:inherit; }
.tr-box__h button:hover { color:var(--blue); }
.tr-box textarea, .tr-box__out {
  flex:1; border:0; resize:none; padding:0.85rem 1rem;
  font:inherit; font-size:1rem; line-height:1.55; min-height:220px; background:#fff; color:var(--navy);
}
.tr-box textarea:focus { outline:none; }
.tr-box__out { white-space:pre-wrap; }
.tr-box__out.is-empty { color:var(--muted); }
.tr-actions { display:flex; gap:0.4rem; flex-wrap:wrap; margin-bottom:0.75rem; }
.tr-btn {
  border:none; cursor:pointer; padding:0.48rem 0.95rem; border-radius:10px;
  font-weight:600; font-family:inherit; font-size:0.84rem;
  transition:transform 0.12s;
}
.tr-btn:hover:not(:disabled) { transform:translateY(-1px); }
.tr-btn:disabled { opacity:0.5; cursor:not-allowed; }
.tr-btn-p { background:linear-gradient(135deg,var(--navy),var(--blue)); color:#fff; box-shadow:0 4px 14px rgba(0,164,228,0.28); }
.tr-btn-g { background:#fff; color:var(--navy); border:1px solid var(--line); }
.tr-status { font-size:0.8rem; color:var(--muted); margin:0 0 0.45rem; min-height:1.15em; }
.tr-status.is-busy { color:var(--mid); font-weight:600; }
.tr-hist {
  background:#fff; border:1px solid var(--line); border-radius:14px;
  padding:0.8rem 1rem; box-shadow:0 2px 8px rgba(29,45,92,0.04);
}
.tr-hist h2 { margin:0 0 0.45rem; font-size:0.9rem; }
.tr-hist__item { font-size:0.82rem; padding:0.4rem 0; border-bottom:1px solid var(--line); cursor:pointer; }
.tr-hist__item:last-child { border-bottom:none; }
.tr-hist__item:hover { color:var(--mid); }
.tr-hist__meta { font-size:0.7rem; color:var(--muted); }
@@media (max-width:900px) {
  .tr-grid { grid-template-columns:1fr; }
  .tr-bar select { max-width:none; }
}
</style>

<section class="tr">
    <div class="tr-top">
        <div>
            <h1>Translator</h1>
            <p>60+ languages · auto-detect · powered by TRU AI</p>
        </div>
        <div class="tr-meta">
            <span>@chars chars</span>
            <span>@words words</span>
            <span>@history.Count saved</span>
        </div>
    </div>

    <div class="tr-bar">
        <select @bind="sourceLang" aria-label="Source language">
            @foreach (var l in Langs) { <option value="@l.Code">@l.Name</option> }
        </select>
        <button type="button" class="tr-swap" @onclick="Swap" title="Swap" aria-label="Swap languages">⇄</button>
        <select @bind="targetLang" aria-label="Target language">
            @foreach (var l in Langs.Where(x => x.Code != "auto")) { <option value="@l.Code">@l.Name</option> }
        </select>
    </div>

    <div class="tr-grid">
        <div class="tr-box">
            <div class="tr-box__h"><span>Source</span><button type="button" @onclick="Clear">Clear</button></div>
            <textarea @bind="sourceText" @bind:event="oninput" placeholder="Type or paste text…" aria-label="Source text"></textarea>
        </div>
        <div class="tr-box">
            <div class="tr-box__h"><span>Translation</span><button type="button" @onclick="CopyOut">Copy</button></div>
            <div class="tr-box__out @(string.IsNullOrWhiteSpace(outputText) ? "is-empty" : null)">
                @(string.IsNullOrWhiteSpace(outputText) ? "Translation appears here…" : outputText)
            </div>
        </div>
    </div>

    <p class="tr-status @(busy ? "is-busy" : null)">@statusMsg</p>

    <div class="tr-actions">
        <button type="button" class="tr-btn tr-btn-p" @onclick="TranslateAsync" disabled="@(busy || string.IsNullOrWhiteSpace(sourceText))">
            @(busy ? "Translating…" : "Translate")
        </button>
        <button type="button" class="tr-btn tr-btn-g" @onclick="CopyOut" disabled="@string.IsNullOrWhiteSpace(outputText)">Copy</button>
        <button type="button" class="tr-btn tr-btn-g" @onclick="Swap">Swap</button>
        <button type="button" class="tr-btn tr-btn-g" @onclick="Clear">Clear</button>
        <button type="button" class="tr-btn tr-btn-g" @onclick="SaveHistory" disabled="@string.IsNullOrWhiteSpace(outputText)">Save</button>
    </div>

    <div class="tr-hist">
        <h2>Recent</h2>
        @if (history.Count == 0)
        {
            <p style="margin:0;font-size:0.85rem;color:var(--muted)">No saved translations yet.</p>
        }
        else
        {
            @foreach (var h in history)
            {
                <div class="tr-hist__item" @onclick="() => LoadHistory(h)">
                    <div class="tr-hist__meta">@h.From → @h.To</div>
                    <div>@h.Preview</div>
                </div>
            }
        }
    </div>
</section>

@code {
    private record Lang(string Code, string Name);
    private record HistItem(string From, string To, string Preview, string Full);

    private static readonly Lang[] Langs =
    {
        new("auto","Auto-detect"),
        new("en","English"), new("es","Spanish"), new("fr","French"), new("de","German"),
        new("pt","Portuguese"), new("it","Italian"), new("nl","Dutch"), new("pl","Polish"),
        new("ru","Russian"), new("uk","Ukrainian"), new("cs","Czech"), new("sk","Slovak"),
        new("ro","Romanian"), new("hu","Hungarian"), new("bg","Bulgarian"), new("hr","Croatian"),
        new("sr","Serbian"), new("sl","Slovenian"), new("el","Greek"), new("tr","Turkish"),
        new("ar","Arabic"), new("he","Hebrew"), new("fa","Persian"), new("ur","Urdu"),
        new("hi","Hindi"), new("bn","Bengali"), new("pa","Punjabi"), new("ta","Tamil"),
        new("te","Telugu"), new("mr","Marathi"), new("gu","Gujarati"), new("kn","Kannada"),
        new("ml","Malayalam"), new("th","Thai"), new("vi","Vietnamese"), new("id","Indonesian"),
        new("ms","Malay"), new("tl","Filipino"), new("zh","Chinese (Simplified)"), new("zh-TW","Chinese (Traditional)"),
        new("ja","Japanese"), new("ko","Korean"), new("sw","Swahili"), new("am","Amharic"),
        new("yo","Yoruba"), new("zu","Zulu"), new("af","Afrikaans"), new("sq","Albanian"),
        new("hy","Armenian"), new("az","Azerbaijani"), new("eu","Basque"), new("be","Belarusian"),
        new("bs","Bosnian"), new("ca","Catalan"), new("da","Danish"), new("et","Estonian"),
        new("fi","Finnish"), new("gl","Galician"), new("ka","Georgian"), new("is","Icelandic"),
        new("ga","Irish"), new("lv","Latvian"), new("lt","Lithuanian"), new("lb","Luxembourgish"),
        new("mk","Macedonian"), new("mt","Maltese"), new("no","Norwegian"), new("sv","Swedish"),
        new("cy","Welsh"), new("eo","Esperanto")
    };

    private static readonly string[] OllamaHosts = { "http://100.89.6.69:11434", "http://localhost:11434" };

    private string sourceLang = "auto";
    private string targetLang = "es";
    private string sourceText = "";
    private string outputText = "";
    private string statusMsg = "";
    private bool busy;
    private readonly List<HistItem> history = new();

    private int chars => sourceText?.Length ?? 0;
    private int words => string.IsNullOrWhiteSpace(sourceText)
        ? 0 : sourceText.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private string LangName(string code) => Langs.FirstOrDefault(l => l.Code == code)?.Name ?? code;

    private async Task TranslateAsync()
    {
        if (string.IsNullOrWhiteSpace(sourceText) || busy) return;
        busy = true;
        statusMsg = "Translating with TRU AI…";
        outputText = "";
        StateHasChanged();

        var from = sourceLang == "auto" ? "the detected source language" : LangName(sourceLang);
        var to = LangName(targetLang);
        var prompt =
            $"Translate the following text from {from} to {to}.\n" +
            "Return ONLY the translation. No quotes, labels, notes, or explanation.\n\n" +
            sourceText.Trim();

        try
        {
            var ctx = new IsaChatApp.Services.Orchestrator.QueryContext
            {
                TraceId = Guid.NewGuid().ToString("N"),
                Question = prompt,
                IncomingToken = null
            };
            var result = await Pipeline.RunAsync(ctx);
            var text = (result.Message ?? "").Trim().Trim('"');
            if (!string.IsNullOrWhiteSpace(text) && result.Status is "answered" or "escalated")
            {
                outputText = text;
                statusMsg = "Done · TRU pipeline";
            }
            else
            {
                text = await TryOllamaAsync(prompt);
                outputText = string.IsNullOrWhiteSpace(text) ? "(No translation returned — check AI connection)" : text.Trim().Trim('"');
                statusMsg = string.IsNullOrWhiteSpace(text) ? "AI unavailable" : "Done · model";
            }
        }
        catch (Exception ex)
        {
            try
            {
                var text = await TryOllamaAsync(prompt);
                outputText = string.IsNullOrWhiteSpace(text) ? "" : text.Trim().Trim('"');
                statusMsg = string.IsNullOrWhiteSpace(outputText) ? "Translation failed: " + ex.Message : "Done · model";
            }
            catch
            {
                outputText = "";
                statusMsg = "Translation failed: " + ex.Message;
            }
        }
        finally { busy = false; }
    }

    private async Task<string?> TryOllamaAsync(string prompt)
    {
        foreach (var host in OllamaHosts)
        {
            try
            {
                using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
                var tags = await Http.GetFromJsonAsync<TagsResponse>($"{host}/api/tags", cts.Token);
                var model = tags?.Models?.FirstOrDefault()?.Name;
                if (string.IsNullOrEmpty(model)) continue;

                var res = await Http.PostAsJsonAsync($"{host}/api/generate", new
                {
                    model,
                    prompt,
                    stream = false
                }, cts.Token);
                if (!res.IsSuccessStatusCode) continue;
                var body = await res.Content.ReadFromJsonAsync<GenResponse>(cancellationToken: cts.Token);
                if (!string.IsNullOrWhiteSpace(body?.Response)) return body.Response;
            }
            catch { }
        }
        return null;
    }

    private void Swap()
    {
        if (sourceLang == "auto") { sourceLang = targetLang; targetLang = "en"; }
        else (sourceLang, targetLang) = (targetLang, sourceLang);
        if (!string.IsNullOrWhiteSpace(outputText) && !string.IsNullOrWhiteSpace(sourceText))
            (sourceText, outputText) = (outputText, sourceText);
    }

    private void Clear() { sourceText = ""; outputText = ""; statusMsg = ""; }

    private async Task CopyOut()
    {
        if (string.IsNullOrWhiteSpace(outputText)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", outputText);
            statusMsg = "Copied";
        }
        catch { statusMsg = "Copy not available"; }
    }

    private void SaveHistory()
    {
        if (string.IsNullOrWhiteSpace(outputText)) return;
        var preview = outputText.Length > 90 ? outputText[..90] + "…" : outputText;
        history.Insert(0, new HistItem(LangName(sourceLang), LangName(targetLang), preview, outputText));
        if (history.Count > 20) history.RemoveAt(history.Count - 1);
        statusMsg = "Saved";
    }

    private void LoadHistory(HistItem h) { outputText = h.Full; statusMsg = ""; }

    private class TagsResponse { public List<TagsModel>? Models { get; set; } }
    private class TagsModel { public string? Name { get; set; } }
    private class GenResponse { public string? Response { get; set; } }
}
