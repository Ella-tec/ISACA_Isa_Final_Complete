@page "/reports-insights"
@rendermode InteractiveServer

<PageTitle>Reports & Insights | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">INTELLIGENCE</p>
            <h1>Reports & Insights</h1>
            <p class="isa-intro">
                Management reports, trends, KPIs, charts, and export-ready summaries.
            </p>
        </div>
        <span class="isa-pill">Sample Dashboard</span>
    </div>
<div class="isa-stat-grid">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">↗</span>
            <span class="isa-stat-label">Questions (Period)</span>
            <strong>1,248</strong>
            <small>+12% vs prior</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">✓</span>
            <span class="isa-stat-label">Self-Service Rate</span>
            <strong>76%</strong>
            <small>Target 80%</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon purple">◎</span>
            <span class="isa-stat-label">Risks Mitigated</span>
            <strong>68%</strong>
            <small>Of Open Register</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon orange">!</span>
            <span class="isa-stat-label">Open Findings</span>
            <strong>7</strong>
            <small>Across Audits</small>
        </article>
    </div>

    <div class="isa-content-grid">
        <article class="isa-panel">
            <div class="isa-panel-heading">
                <div>
                    <h2>KPI Trends</h2>
                    <p>Illustrative Monthly Trend</p>
                </div>
            </div>
            @foreach (var k in Kpis)
            {
                <div class="isa-category-row">
                    <div>
                        <span>@k.Name</span>
                        <strong>@k.Value</strong>
                    </div>
                    <div class="isa-progress">
                        <span style="width:@(k.Percent)%"></span>
                    </div>
                    <div class="isa-panel-foot" style="margin-top:.25rem">
                        <span>@k.Trend</span>
                        <span>Goal: @k.Goal</span>
                    </div>
                </div>
            }
        </article>

        <article class="isa-panel">
            <div class="isa-panel-heading">
                <div>
                    <h2>Report Catalogue</h2>
                    <p>Select a report to preview</p>
                </div>
            </div>
            <div class="isa-card-grid" style="grid-template-columns:1fr">
                @foreach (var r in Reports)
                {
                    <div class="isa-card"
                         style="cursor:pointer"
                         @onclick="() => SelectReport(r.Title)">
                        <div style="display:flex;justify-content:space-between">
                            <h3>@r.Title</h3>
                            <span class="isa-badge isa-badge--blue">@r.Audience</span>
                        </div>
                        <p>@r.Description</p>
                        <small class="isa-muted">Updated: @r.Updated</small>
                    </div>
                }
            </div>
        </article>
    </div>

    @if (!string.IsNullOrWhiteSpace(SelectedReport))
    {
        var report = Reports.First(r => r.Title == SelectedReport);
        <article class="isa-panel" style="margin-top:1.5rem">
            <div class="isa-panel-heading">
                <div>
                    <h2>Preview — @report.Title</h2>
                    <p>@report.Description</p>
                </div>
                <div style="display:flex;gap:.5rem">
                    <button type="button" class="isa-btn isa-btn--ghost" @onclick="ClosePreview">
                        Close
                    </button>
                    <button type="button" class="isa-btn isa-btn--primary" @onclick="ExportReport">
                        Export (Demo)
                    </button>
                </div>
            </div>
            <ul class="isa-action-list">
                @foreach (var line in report.Highlights)
                {
                    <li>@line</li>
                }
            </ul>
            @if (!string.IsNullOrEmpty(ExportMessage))
            {
                <div class="isa-notice" style="margin-top:1rem">
                    @ExportMessage
                </div>
            }
        </article>
    }
</section>

@code {
    private string? SelectedReport;
    private string? ExportMessage;

    private void SelectReport(string title)
    {
        SelectedReport = title;
        ExportMessage = null;
    }

    private void ClosePreview()
    {
        SelectedReport = null;
        ExportMessage = null;
    }

    private void ExportReport()
    {
        ExportMessage = $"Export of '{SelectedReport}' is illustrative only.";
    }

    private readonly (string Name, string Value, int Percent, string Trend, string Goal)[] Kpis =
    {
        ("Self-Service Resolution", "76%", 76, "+3 pts MoM", "80%"),
        ("Average Response Time", "2.4s", 60, "Stable", "< 3s"),
        ("Risk Register Coverage", "92%", 92, "+5 pts", "95%"),
        ("Compliance Score", "81%", 81, "+2 pts", "90%")
    };

    private List<ReportItem> Reports = new()
    {
        new()
        {
            Title = "Monthly Chapter Health",
            Audience = "Board",
            Description = "Membership, events, escalations and content health snapshot.",
            Updated = "Oct 2026",
            Highlights = new()
            {
                "Membership questions up 12%",
                "3 open escalations older than 7 days",
                "Content health score 84/100",
                "2 policies due for review this quarter"
            }
        },
        new()
        {
            Title = "Risk & Control Summary",
            Audience = "Governance",
            Description = "Top residual risks, control effectiveness and open findings.",
            Updated = "Oct 2026",
            Highlights = new()
            {
                "2 high residual risks require board attention",
                "Control effectiveness 71%",
                "4 audit findings open",
                "Vendor review overdue for one critical supplier"
            }
        },
        new()
        {
            Title = "Incident Trend Report",
            Audience = "Operations",
            Description = "Incident volume, severity mix and mean time to contain.",
            Updated = "Sep 2026",
            Highlights = new()
            {
                "4 incidents in sample period",
                "1 high-severity phishing event",
                "Mean time to contain 4.2 hours",
                "Lessons learned logged for 3 of 4 incidents"
            }
        }
    };

    private sealed class ReportItem
    {
        public string Title { get; set; } = "";
        public string Audience { get; set; } = "";
        public string Description { get; set; } = "";
        public string Updated { get; set; } = "";
        public List<string> Highlights { get; set; } = new();
    }
}
