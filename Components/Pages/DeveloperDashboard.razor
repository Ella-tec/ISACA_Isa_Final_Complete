@page "/developer-dashboard"
@page "/developer"
@rendermode InteractiveServer

<PageTitle>Developer Dashboard | Isa</PageTitle>

<style>
.dd{--navy:#1d2d5c;--blue:#00a4e4;--green:#6cb33f;--mid:#07649d;--teal:#36ac91;--light:#e7f0f5;--muted:#5f6b85;--line:#dce4ed;width:100%;max-width:none;margin:0;font-family:"Roboto",system-ui,sans-serif;color:var(--navy);padding:.75rem .85rem 1.25rem;box-sizing:border-box}
.dd-hero{display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap;align-items:center;padding:1.25rem 1.4rem;border-radius:18px;margin-bottom:1rem;background:linear-gradient(125deg,#152447,#1d2d5c,#00a4e4);color:#fff}
.dd-hero h1{margin:.15rem 0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.65rem}
.dd-hero p{margin:.3rem 0 0;opacity:.92;max-width:50ch}
.dd-pill{display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;border-radius:999px;background:rgba(255,255,255,.15);font-weight:600;font-size:.88rem}
.dd-pill i{width:10px;height:10px;border-radius:50%;background:#6cb33f;display:block;box-shadow:0 0 0 3px rgba(108,179,63,.3)}
.dd-stats{display:grid;grid-template-columns:repeat(6,1fr);gap:.6rem;margin-bottom:1rem}
.dd-stat{background:#fff;border:1px solid var(--line);border-radius:14px;padding:.8rem;box-shadow:0 6px 16px rgba(29,45,92,.05)}
.dd-stat span{display:block;font-size:.7rem;color:var(--muted);font-weight:600;text-transform:uppercase}
.dd-stat strong{display:block;font-size:1.2rem;margin:.15rem 0}
.dd-stat small{font-size:.78rem;color:var(--green)}
.dd-grid{display:grid;grid-template-columns:1.15fr 1fr;gap:1rem}
.dd-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.1rem 1.15rem;box-shadow:0 8px 22px rgba(29,45,92,.06)}
.dd-card--wide{grid-column:1/-1}
.dd-card-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:.75rem}
.dd-card h2{margin:0;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.1rem}
.dd-api,.dd-deploy,.dd-search,.dd-sec{list-style:none;margin:0;padding:0}
.dd-api li,.dd-deploy li,.dd-sec li{display:flex;justify-content:space-between;gap:.75rem;align-items:center;padding:.6rem 0;border-bottom:1px solid var(--line)}
.dd-api strong,.dd-deploy strong,.dd-sec strong{display:block}
.dd-api span,.dd-deploy span,.dd-sec span{font-size:.8rem;color:var(--muted)}
.dd-badge{display:inline-flex;padding:.16rem .48rem;border-radius:999px;font-size:.68rem;font-weight:700}
.dd-badge.ok{background:#e8f6df;color:#3d6e1f}.dd-badge.warn{background:#fff3d6;color:#8a5a00}.dd-badge.muted{background:var(--light);color:var(--mid)}
.dd-metrics{display:grid;gap:.75rem}
.dd-metric span{font-size:.82rem;color:var(--muted)}.dd-metric strong{display:block;margin:.12rem 0 .3rem}
.dd-meter{height:8px;background:var(--light);border-radius:999px;overflow:hidden}
.dd-meter i{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--teal))}
.dd-table{width:100%;border-collapse:collapse;font-size:.9rem}
.dd-table th{text-align:left;font-size:.7rem;text-transform:uppercase;color:var(--muted);padding:.45rem .55rem;border-bottom:1px solid var(--line)}
.dd-table td{padding:.55rem;border-bottom:1px solid var(--line)}
.dd-search li{display:flex;justify-content:space-between;padding:.45rem 0;border-bottom:1px solid var(--line)}
.dd-activity{display:grid;gap:.5rem}
.dd-act-row{display:grid;grid-template-columns:110px 1fr 40px;gap:.45rem;align-items:center;font-size:.85rem}
.dd-bar{height:8px;background:var(--light);border-radius:999px;overflow:hidden}
.dd-bar i{display:block;height:100%;background:linear-gradient(90deg,var(--navy),var(--blue))}
.dd-btn{border:none;border-radius:10px;padding:.4rem .8rem;font-weight:600;font-size:.82rem;cursor:pointer;font-family:inherit;background:var(--navy);color:#fff}
.dd-btn--ghost{background:var(--light);color:var(--navy)}.dd-btn--sm{padding:.28rem .55rem;font-size:.75rem;background:var(--light);color:var(--navy)}
.dd-toast{position:fixed;bottom:1.2rem;right:1.2rem;background:var(--navy);color:#fff;padding:.7rem 1rem;border-radius:12px;z-index:50}
@@media(max-width:1100px){.dd-stats{grid-template-columns:repeat(3,minmax(0,1fr))}.dd-grid{grid-template-columns:repeat(2,minmax(0,1fr))}} @@media(max-width:760px){.dd-stats{grid-template-columns:repeat(2,minmax(0,1fr))}.dd-grid{grid-template-columns:1fr}.dd-card--wide{grid-column:auto}.dd{padding:.55rem}} @@media(max-width:420px){.dd-stats{grid-template-columns:1fr}.dd-act-row{grid-template-columns:85px minmax(0,1fr) 35px}.dd-table{font-size:.78rem}}
</style>

<section class="dd">
    <header class="dd-hero">
        <div>
            <p style="margin:0;font-size:.7rem;font-weight:700;letter-spacing:.12em;opacity:.88">PLATFORM OPS</p>
            <h1>Developer Dashboard</h1>
            <p>API health, performance, deployments, search quality, and security signals for the Isa workspace.</p>
        </div>
        <div class="dd-pill"><i></i> All systems operational</div>
    </header>

    <div class="dd-stats">
        @foreach (var s in Stats)
        {
            <article class="dd-stat"><span>@s.Label</span><strong>@s.Value</strong><small>@s.Hint</small></article>
        }
    </div>

    <div class="dd-grid">
        <article class="dd-card">
            <div class="dd-card-head"><h2>API health</h2>
                <button type="button" class="dd-btn dd-btn--ghost" @onclick="Ping">Ping all</button></div>
            <ul class="dd-api">
                @foreach (var a in Apis)
                {
                    <li>
                        <div><strong>@a.Name</strong><span>@a.Endpoint</span></div>
                        <div style="display:flex;align-items:center;gap:.45rem">
                            <span>@a.Ms ms</span>
                            <span class="dd-badge @a.Badge">@a.Status</span>
                        </div>
                    </li>
                }
            </ul>
        </article>
        <article class="dd-card">
            <div class="dd-card-head"><h2>Performance (24h)</h2></div>
            <div class="dd-metrics">
                @foreach (var m in Metrics)
                {
                    <div class="dd-metric"><span>@m.Label</span><strong>@m.Value</strong>
                        <div class="dd-meter"><i style="width:@m.Pct%"></i></div></div>
                }
            </div>
        </article>
        <article class="dd-card dd-card--wide">
            <div class="dd-card-head"><h2>Recent errors</h2><span style="color:var(--muted);font-size:.85rem">@Errors.Count open</span></div>
            <table class="dd-table">
                <thead><tr><th>Time</th><th>Service</th><th>Message</th><th>Count</th><th></th></tr></thead>
                <tbody>
                @foreach (var e in Errors.ToList())
                {
                    <tr>
                        <td>@e.Time</td><td>@e.Service</td><td>@e.Message</td><td>@e.Count</td>
                        <td><button type="button" class="dd-btn dd-btn--sm" @onclick="() => Ack(e.Message)">Ack</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </article>
        <article class="dd-card">
            <div class="dd-card-head"><h2>Deployments</h2></div>
            <ul class="dd-deploy">
                @foreach (var d in Deploys)
                {
                    <li><span class="dd-badge @d.Badge">@d.Env</span>
                        <div><strong>@d.Version</strong><span>@d.When · @d.By</span></div></li>
                }
            </ul>
        </article>
        <article class="dd-card">
            <div class="dd-card-head"><h2>Search performance</h2></div>
            <ul class="dd-search">
                @foreach (var s in Search) { <li><strong>@s.Label</strong><span>@s.Value</span></li> }
            </ul>
            <p style="margin:.75rem 0 0;font-size:.85rem;color:var(--muted)">Top zero-result query: <em>“AI governance chapter”</em></p>
        </article>
        <article class="dd-card">
            <div class="dd-card-head"><h2>Security &amp; audit</h2></div>
            <ul class="dd-sec">
                @foreach (var s in Security)
                {
                    <li><span class="dd-badge @s.Badge">@s.Level</span>
                        <div><strong>@s.Title</strong><span>@s.Detail</span></div></li>
                }
            </ul>
        </article>
        <article class="dd-card">
            <div class="dd-card-head"><h2>User activity</h2></div>
            <div class="dd-activity">
                @foreach (var a in Activity)
                {
                    <div class="dd-act-row"><span>@a.Label</span><div class="dd-bar"><i style="width:@a.Pct%"></i></div><strong>@a.Value</strong></div>
                }
            </div>
        </article>
    </div>
    @if (toast is not null) { <div class="dd-toast">@toast</div> }
</section>

@code {
    // NO role checks — open to all workspace users
    private string? toast;
    private readonly List<(string Label,string Value,string Hint)> Stats = new()
    {
        ("Uptime (30d)","99.96%","SLA met"),("Avg latency","142 ms","p95 310 ms"),
        ("Error rate","0.12%","Below target"),("Active users","38","Last hour"),
        ("Index docs","12.4k","Synced"),("Queue depth","3","Healthy"),
    };
    private List<(string Name,string Endpoint,int Ms,string Status,string Badge)> Apis = new()
    {
        ("Auth API","/api/auth",48,"Up","ok"),("Knowledge API","/api/kb",96,"Up","ok"),
        ("Search","/api/search",121,"Up","ok"),("Chat / Isa","/api/chat",210,"Degraded","warn"),
        ("Files","/api/files",67,"Up","ok"),("Ollama bridge","localhost:11434",0,"Local","muted"),
    };
    private List<(string Label,string Value,int Pct)> Metrics = new()
    {
        ("CPU","34%",34),("Memory","61%",61),("Disk","48%",48),("Network I/O","22%",22),
    };
    private List<(string Time,string Service,string Message,int Count)> Errors = new()
    {
        ("14:02","Chat","Timeout waiting for model response",3),
        ("13:41","Search","Index refresh lag > 5 min",1),
        ("12:18","Auth","Token refresh failed (transient)",2),
        ("11:05","Files","PDF extract worker restart",1),
    };
    private List<(string Env,string Badge,string Version,string When,string By)> Deploys = new()
    {
        ("Prod","ok","v2.14.3","Today 09:12","CI"),
        ("Staging","ok","v2.15.0-rc1","Yesterday","Maya"),
        ("Dev","muted","v2.15.0-dev","2h ago","James"),
    };
    private List<(string Label,string Value)> Search = new()
    {
        ("Avg query time","89 ms"),("Zero-result rate","4.2%"),("Click-through","61%"),("Indexed assets","12,408"),
    };
    private List<(string Badge,string Level,string Title,string Detail)> Security = new()
    {
        ("ok","Info","TLS","Certificates valid · expires in 86 days"),
        ("ok","Info","Auth","No failed admin logins (24h)"),
        ("warn","Watch","Rate limit","Chat endpoint near soft limit twice"),
        ("ok","Info","Audit","Last export completed successfully"),
    };
    private List<(string Label,int Pct,string Value)> Activity = new()
    {
        ("Knowledge views",78,"1.8k"),("Chat sessions",64,"420"),("Translations",41,"96"),
        ("Escalations",28,"18"),("Settings saves",15,"12"),
    };

    private void Ping()
    {
        for (var i = 0; i < Apis.Count; i++)
        {
            var a = Apis[i];
            var ms = 40 + Random.Shared.Next(20, 180);
            Apis[i] = (a.Name, a.Endpoint, ms, ms > 250 ? "Slow" : "Up", ms > 250 ? "warn" : "ok");
        }
        toast = "API probe complete · " + DateTime.Now.ToString("t");
    }
    private void Ack(string msg) { Errors.RemoveAll(e => e.Message == msg); toast = "Acknowledged"; }
}
