@page "/resource-library"
@rendermode InteractiveServer

<PageTitle>Resource Library | Isa</PageTitle>

<style>
.rl{--navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--teal:#36ac91;--light:#e7f0f5;--muted:#5f6b85;--line:#e2e8f0;--orange:#e57524;--purple:#6558b1;
font-family:"Roboto",system-ui,sans-serif;color:var(--navy);max-width:1180px;margin:0 auto}
.rl-hero{border-radius:20px;padding:1.5rem 1.75rem;color:#fff;margin-bottom:1.15rem;
background:linear-gradient(120deg,#00a4e4,#07649d 40%,#1d2d5c);box-shadow:0 14px 40px rgba(29,45,92,.16)}
.rl-hero h1{margin:.2rem 0 .4rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:1.75rem}
.rl-hero p{margin:0;opacity:.92}
.rl-tabs{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1.1rem}
.rl-tab{border:none;cursor:pointer;padding:.5rem 1rem;border-radius:999px;font-weight:600;font-size:.85rem;font-family:inherit;background:#fff;color:var(--navy);border:1px solid var(--line)}
.rl-tab.on{background:linear-gradient(135deg,var(--navy),var(--mid));color:#fff;border-color:transparent}
.rl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.85rem}
.rl-card{background:#fff;border-radius:16px;padding:1.15rem;border:1px solid var(--line);box-shadow:0 8px 24px rgba(29,45,92,.06);display:flex;flex-direction:column;gap:.45rem}
.rl-card .ico{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;font-weight:800;color:#fff;font-size:.85rem}
.rl-card h3{margin:0;font-size:1rem}
.rl-card p{margin:0;font-size:.88rem;color:var(--muted);line-height:1.45;flex:1}
.rl-card .actions{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.35rem}
.rl-card a,.rl-card button{padding:.45rem .85rem;border-radius:9px;font-weight:600;font-size:.82rem;border:none;cursor:pointer;font-family:inherit}
.rl-dl{background:linear-gradient(135deg,var(--navy),var(--mid));color:#fff!important}
.rl-link{background:var(--light);color:var(--mid)!important}
.rl-toast{position:fixed;bottom:1.25rem;right:1.25rem;background:var(--navy);color:#fff;padding:.75rem 1.1rem;border-radius:12px;font-weight:600;box-shadow:0 12px 32px rgba(0,0,0,.25);z-index:100}
@@media(max-width:900px){.rl-grid{grid-template-columns:1fr}}
</style>

<section class="rl">
    <header class="rl-hero">
        <div style="font-size:.68rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;opacity:.85">Library</div>
        <h1>Resource Library</h1>
        <p>Guides, policies, certification paths, learning packs, and templates for chapter leaders.</p>
    </header>

    <div class="rl-tabs">
        @foreach (var t in Tabs)
        {
            <button type="button" class="rl-tab @(tab==t?"on":null)" @onclick="() => tab=t">@t</button>
        }
    </div>

    <div class="rl-grid">
        @foreach (var r in Filtered)
        {
            <article class="rl-card">
                <div class="ico" style="background:@r.Color">@r.Icon</div>
                <h3>@r.Title</h3>
                <p>@r.Description</p>
                <div class="actions">
                    <button type="button" class="rl-dl" @onclick="() => Download(r)">Download</button>
                    @if (!string.IsNullOrEmpty(r.Url))
                    {
                        <a class="rl-link" href="@r.Url" target="_blank" rel="noopener">Open link</a>
                    }
                </div>
            </article>
        }
    </div>

    @if (!string.IsNullOrEmpty(toast))
    {
        <div class="rl-toast">@toast</div>
    }
</section>

@code {
    private string tab = "Guides";
    private string toast = "";
    private static readonly string[] Tabs = { "Guides", "Policies", "Certifications", "Learning", "Templates" };

    private record Res(string Category, string Title, string Description, string Icon, string Color, string Url, string FileName);

    private static readonly Res[] All =
