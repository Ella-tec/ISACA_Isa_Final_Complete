        R("Learning","Cloud Security Basics","Shared responsibility and control mapping.","CL","#00a4e4","https://www.isaca.org/resources","Cloud-Security-Basics.txt",G("Cloud Security Basics — models, shared duty, controls.")),
        R("Learning","AI Risk Awareness","Educational briefing on AI risk for members.","AR","#e57524","https://www.isaca.org/resources/white-papers/2025/leveraging-cobit-for-effective-ai-system-governance","AI-Risk-Awareness.txt",G("AI Risk Awareness — use cases, limits, discussion questions.")),
        R("Learning","Member Orientation Deck","First-meeting orientation script.","MO","#36ac91","","Member-Orientation.txt",G("Member Orientation — welcome, value, how to engage.")),
        R("Learning","Board Briefing Template","One-page monthly board brief.","BB","#1d2d5c","","Board-Briefing-Template.txt",G("Board Briefing — metrics, risks, decisions needed.")),
        R("Learning","COBIT Snapshot","COBIT for chapter education sessions.","CB","#07649d","https://www.isaca.org/resources","COBIT-Snapshot.txt",G("COBIT Snapshot — principles, objectives, discussion.")),
        R("Learning","Zero Trust Brief","Intro briefing for non-technical boards.","ZT","#6cb33f","https://www.isaca.org/resources","Zero-Trust-Brief.txt",G("Zero Trust — principles, myths, questions for leadership.")),
        R("Learning","Incident Tabletop","90-minute tabletop exercise outline.","IT","#e31837","","Incident-Tabletop.txt",G("Incident Tabletop — scenario, roles, injects, debrief.")),
        R("Learning","Mentorship Starter","Pair mentors and new members.","MS","#6558b1","","Mentorship-Starter.txt",G("Mentorship — matching, cadence, success signals.")),

        R("Templates","Meeting Agenda","Standard chapter meeting agenda.","TA","#07649d","","Meeting-Agenda.txt",G("Meeting Agenda — open, reports, decisions, close.")),
        R("Templates","Action Log","Track owners and due dates.","AL","#00a4e4","","Action-Log.txt",G("Action Log — item, owner, due, status.")),
        R("Templates","Event Run-of-Show","Minute-by-minute for live events.","RO","#36ac91","","Event-Run-of-Show.txt",G("Run-of-Show — time, activity, owner, notes.")),
        R("Templates","Sponsorship One-Pager","Offer for local partners.","SP","#6cb33f","","Sponsorship-One-Pager.txt",G("Sponsorship — tiers, exposure, contact.")),
        R("Templates","Risk Register Sample","Starter risk log for chapter ops.","RR","#e31837","","Risk-Register.txt",G("Risk Register — id, owner, likelihood, impact, treatment.")),
        R("Templates","Policy Change Request","Form for proposing policy updates.","PR","#6558b1","","Policy-Change-Request.txt",G("Policy Change Request — summary, rationale, impact.")),
        R("Templates","Volunteer Signup","Collect volunteer interest.","VS","#e57524","","Volunteer-Signup.txt",G("Volunteer Signup — role, availability, skills.")),
        R("Templates","Post-Event Survey","Quick feedback after sessions.","PS","#1d2d5c","","Post-Event-Survey.txt",G("Post-Event Survey — rating, value, topics next.")),
    };

    private static Res R(string cat, string title, string desc, string code, string accent, string url, string file, string body)
        => new(cat, title, desc, code, accent, url, file, body);
}
