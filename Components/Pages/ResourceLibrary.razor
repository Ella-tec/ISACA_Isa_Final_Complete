        new("Guides", "Chapter Leader Handbook", "Roles, calendar, and operating cadence for officers.", "HB", "linear-gradient(135deg,#1d2d5c,#07649d)", "https://www.isaca.org", "Chapter-Leader-Handbook.txt"),
        new("Guides", "Governance Guide", "Board practices and policy lifecycle overview.", "GV", "linear-gradient(135deg,#6558b1,#1d2d5c)", "https://www.isaca.org/resources", "Governance-Guide.txt"),
        new("Guides", "Financial Management Guide", "Budgets, controls, and reporting for chapters.", "FM", "linear-gradient(135deg,#00a4e4,#07649d)", "", "Financial-Management-Guide.txt"),
        new("Guides", "Event Planning Playbook", "End-to-end checklist for CPE and networking events.", "EV", "linear-gradient(135deg,#6cb33f,#1d2d5c)", "", "Event-Planning-Playbook.txt"),
        new("Policies", "Chapter Governance Policy", "Sample governance policy for chapter boards.", "PG", "linear-gradient(135deg,#1d2d5c,#00a4e4)", "", "Chapter-Governance-Policy.txt"),
        new("Policies", "Financial Controls Policy", "Approval thresholds and dual-control guidance.", "PF", "linear-gradient(135deg,#07649d,#36ac91)", "", "Financial-Controls-Policy.txt"),
        new("Policies", "Data Privacy Policy", "Member data handling and retention baseline.", "PP", "linear-gradient(135deg,#6558b1,#07649d)", "https://www.isaca.org/credentialing/cdpse", "Data-Privacy-Policy.txt"),
        new("Policies", "AI Usage Guidelines", "Acceptable use of AI tools in chapter work.", "AI", "linear-gradient(135deg,#e57524,#1d2d5c)", "", "AI-Usage-Guidelines.txt"),
        new("Policies", "Content Review Policy", "Review workflow before publishing guidance.", "CR", "linear-gradient(135deg,#00a4e4,#1d2d5c)", "", "Content-Review-Policy.txt"),
        new("Policies", "Incident Response Policy", "Severity levels and escalation contacts.", "IR", "linear-gradient(135deg,#e31837,#1d2d5c)", "", "Incident-Response-Policy.txt"),
        new("Certifications", "CISA", "Audit credential overview and prep links.", "CISA", "linear-gradient(135deg,#e31837,#1d2d5c)", "https://www.isaca.org/credentialing/cisa", "CISA-Overview.txt"),
        new("Certifications", "CISM", "Security management credential path.", "CISM", "linear-gradient(135deg,#6cb33f,#1d2d5c)", "https://www.isaca.org/credentialing/cism", "CISM-Overview.txt"),
        new("Certifications", "CRISC", "IT risk and control credential.", "CRISC", "linear-gradient(135deg,#fbb034,#e57524)", "https://www.isaca.org/credentialing/crisc", "CRISC-Overview.txt"),
        new("Certifications", "CGEIT", "Enterprise IT governance credential.", "CGEIT", "linear-gradient(135deg,#00a4e4,#07649d)", "https://www.isaca.org/credentialing/cgeit", "CGEIT-Overview.txt"),
