@page "/resource-library"
@rendermode InteractiveServer
<PageTitle>Resource Library | Isa</PageTitle>

<section class="rl-page">
    <header class="rl-header">
        <p class="rl-eyebrow">RESOURCES</p>
        <h1 class="rl-title">Resource Library</h1>
        <p class="rl-intro">Download approved guides and chapter policies. All documents are sample content for demonstration.</p>
    </header>

    @* ---- GUIDES ---- *@
    <section class="rl-section" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="rl-sectionTitle">Guides</h2>
        <div class="rl-guides">
            @foreach (var g in Guides)
            {
                <article class="rl-guideCard">
                    <div class="rl-guideIcon" aria-hidden="true">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                        </svg>
                    </div>
                    <h3 class="rl-guideName">@g.Title</h3>
                    <button type="button" class="rl-downloadBtn" @onclick="() => OnDownload(g.Title)">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                        Download
                    </button>
                </article>
            }
        </div>
    </section>

    @* ---- POLICIES ---- *@
    <section class="rl-section" aria-labelledby="policies-heading">
        <h2 id="policies-heading" class="rl-sectionTitle rl-sectionTitle--doc">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 2 14 8 20 8"/>
            </svg>
            Policies
        </h2>
        <div class="rl-policyList">
            @foreach (var p in Policies)
            {
                <div class="rl-policyRow">
                    <div class="rl-policyIcon" aria-hidden="true">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                        </svg>
                    </div>
                    <div class="rl-policyBody">
                        <p class="rl-policyName">@p.Title</p>
                        <p class="rl-policyMeta">@p.Version · @p.Category</p>
                    </div>
                    <button type="button" class="rl-policyDl" title="Download @p.Title" @onclick="() => OnDownload(p.Title)" aria-label="Download @p.Title">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="7 10 12 15 17 10"/>
                            <line x1="12" y1="15" x2="12" y2="3"/>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </section>

    @if (!string.IsNullOrEmpty(ToastMessage))
    {
        <div class="rl-toast" role="status">@ToastMessage</div>
    }
</section>

@code {
    private string? ToastMessage;

    private record GuideItem(string Title);
    private record PolicyItem(string Title, string Version, string Category);

    private readonly List<GuideItem> Guides = new()
    {
        new("Chapter Leader Handbook"),
        new("Governance Guide"),
        new("Financial Management Guide"),
        new("Event Planning Playbook")
    };

    private readonly List<PolicyItem> Policies = new()
    {
        new("Chapter Governance Policy", "v2.1", "Governance"),
        new("Financial Controls Policy", "v1.5", "Finance"),
        new("Data Privacy Policy", "v1.0", "Compliance"),
        new("AI Usage Guidelines", "v1.2", "Technology"),
        new("Content Review Policy", "v3.0", "Content"),
        new("Incident Response Policy", "v0.9", "Security")
    };

    private async Task OnDownload(string name)
    {
        ToastMessage = $"Download started: {name} (sample)";
        StateHasChanged();
        await Task.Delay(2200);
        ToastMessage = null;
        StateHasChanged();
    }
}
