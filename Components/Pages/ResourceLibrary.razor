@page "/resource-library"
@rendermode InteractiveServer
@inject IJSRuntime JS

<PageTitle>Resource Library | TRU</PageTitle>

<style>
.rl{
  --navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--teal:#36ac91;--light:#eef3f8;--muted:#5f6b85;--line:#e2e8f0;
  font-family:"Roboto",system-ui,sans-serif;color:var(--navy);
  width:100%;margin:0;padding:12px;box-sizing:border-box;
  display:flex;flex-direction:column;gap:12px;
}
.rl-hero{
  border-radius:14px;padding:1rem 1.2rem;color:#fff;
  background:linear-gradient(120deg,#00a4e4,#07649d 45%,#1d2d5c);
  display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:.75rem;
}
.rl-hero h1{margin:0;font-size:1.35rem;font-weight:700}
.rl-hero p{margin:.25rem 0 0;opacity:.92;font-size:.86rem;max-width:36rem}
.rl-hero-actions{display:flex;flex-wrap:wrap;gap:.4rem}
.rl-hero-actions a,.rl-btn{
  display:inline-flex;align-items:center;gap:.35rem;
  padding:.45rem .8rem;border-radius:8px;font-size:.78rem;font-weight:700;
  text-decoration:none;border:0;cursor:pointer;font-family:inherit;
}
.rl-hero-actions a{background:rgba(255,255,255,.95);color:var(--navy)}
.rl-hero-actions a:hover{background:#fff}
.rl-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.rl-stat{
  background:#fff;border:1px solid var(--line);border-radius:12px;padding:.7rem .85rem;
  display:flex;flex-direction:column;gap:.15rem;
}
.rl-stat span{font-size:.62rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.rl-stat strong{font-size:1.25rem;font-weight:700;color:var(--navy)}
.rl-toolbar{
  display:flex;flex-wrap:wrap;gap:.45rem;align-items:center;
  background:#fff;border:1px solid var(--line);border-radius:12px;padding:.55rem .65rem;
}
.rl-chip{
  border:1px solid var(--line);background:#f7fafc;color:var(--navy);
  border-radius:999px;padding:.38rem .75rem;font-size:.78rem;font-weight:600;
  cursor:pointer;font-family:inherit;
}
.rl-chip.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.rl-chip:hover:not(.on){border-color:var(--blue);color:var(--mid)}
.rl-search{
  flex:1 1 180px;min-width:140px;border:1px solid var(--line);border-radius:999px;
  padding:.42rem .85rem;font:inherit;font-size:.84rem;background:#f7fafc;
}
.rl-search:focus{outline:none;border-color:var(--blue);background:#fff}
.rl-grid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:12px;
}
.rl-card{
  background:#fff;border:1px solid var(--line);border-radius:14px;
  padding:.85rem .9rem;display:flex;flex-direction:column;gap:.45rem;
  min-height:0;box-shadow:0 2px 8px rgba(15,23,42,.04);
  transition:border-color .15s,box-shadow .15s,transform .15s;
}
.rl-card:hover{border-color:#b7d4f0;box-shadow:0 8px 22px rgba(7,100,157,.1);transform:translateY(-1px)}
.rl-card.on{border-color:var(--blue);box-shadow:0 0 0 2px rgba(0,164,228,.15)}
.rl-card__top{display:flex;align-items:flex-start;gap:.65rem}
.rl-card__ico{
  width:40px;height:40px;border-radius:10px;flex-shrink:0;
  display:grid;place-items:center;color:#fff;font-size:.72rem;font-weight:800;
}
.rl-card h3{margin:0;font-size:.92rem;font-weight:700;line-height:1.25}
.rl-card p{margin:0;font-size:.78rem;color:var(--muted);line-height:1.4}
.rl-card__meta{font-size:.68rem;font-weight:600;color:var(--mid);text-transform:uppercase;letter-spacing:.04em}
.rl-card__actions{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:auto;padding-top:.35rem}
.rl-card__actions button,.rl-card__actions a{
  border:0;border-radius:8px;padding:.4rem .65rem;font-size:.72rem;font-weight:700;
  cursor:pointer;font-family:inherit;text-decoration:none;display:inline-flex;align-items:center;
}
.rl-btn-dl{background:var(--navy);color:#fff}
.rl-btn-dl:hover{background:#123066}
.rl-btn-pv{background:var(--light);color:var(--navy)}
.rl-btn-pv:hover{background:#dde7f0}
.rl-btn-ext{background:#e8f7fc;color:var(--mid)}
.rl-btn-ext:hover{background:#d3eef8}
.rl-btn-fav{background:#fff8e8;color:#b45309}
.rl-btn-fav.on{background:#fbb034;color:#1d2d5c}
.rl-detail{
  background:#fff;border:1px solid var(--line);border-radius:14px;padding:1rem 1.1rem;
  display:none;
}
.rl-detail.show{display:block}
.rl-detail h2{margin:0 0 .35rem;font-size:1.1rem}
.rl-detail .meta{font-size:.75rem;color:var(--muted);margin-bottom:.75rem}
.rl-detail pre{
  white-space:pre-wrap;font-family:inherit;font-size:.84rem;line-height:1.5;
  background:var(--light);border-radius:10px;padding:.85rem;margin:0 0 .75rem;
}
.rl-toast{
  position:fixed;bottom:1.25rem;left:50%;transform:translateX(-50%);
  background:var(--navy);color:#fff;padding:.55rem 1rem;border-radius:999px;
  font-size:.8rem;font-weight:600;z-index:50;box-shadow:0 8px 24px rgba(0,0,0,.2);
}
@@media(max-width:900px){
  .rl-stats{grid-template-columns:1fr 1fr}
}
@@media(max-width:560px){
  .rl-stats{grid-template-columns:1fr}
  .rl-grid{grid-template-columns:1fr}
}
</style>

<div class="rl">
    <header class="rl-hero">
        <div>
            <h1>Resource Library</h1>
            <p>Guides, policies, certification paths, and templates — open ISACA links or download chapter packs.</p>
        </div>
        <div class="rl-hero-actions">
            <a href="https://www.isaca.org/credentialing" target="_blank" rel="noopener">Credentialing →</a>
            <a href="https://www.isaca.org/resources" target="_blank" rel="noopener">ISACA Resources →</a>
            <a href="https://www.isaca.org/credentialing/cisa" target="_blank" rel="noopener">CISA path →</a>
            <a href="https://trainotracksolutions.weebly.com/blog/top-isaca-certifications-for-professionals" target="_blank" rel="noopener">Cert guide →</a>
        </div>
    </header>

    <div class="rl-stats">
        <div class="rl-stat"><span>Total</span><strong>@All.Count</strong></div>
        <div class="rl-stat"><span>This category</span><strong>@Filtered.Count()</strong></div>
        <div class="rl-stat"><span>Favorites</span><strong>@favs.Count</strong></div>
        <div class="rl-stat"><span>Downloads</span><strong>@downloads</strong></div>
    </div>

    <div class="rl-toolbar">
        @foreach (var t in Tabs)
        {
            <button type="button" class="rl-chip @(tab==t ? "on" : null)" @onclick="() => SelectTab(t)">@t</button>
        }
        <input class="rl-search" @bind="search" @bind:event="oninput" placeholder="Search title or description…" />
    </div>

    <div class="rl-grid">
        @foreach (var r in Filtered)
        {
            <article class="rl-card @(selected?.Title==r.Title ? "on" : null)">
                <div class="rl-card__top">
                    <div class="rl-card__ico" style="background:@r.Accent">@r.Code</div>
                    <div>
                        <div class="rl-card__meta">@r.Category</div>
                        <h3>@r.Title</h3>
                    </div>
                </div>
                <p>@r.Description</p>
                <div class="rl-card__actions">
                    <button type="button" class="rl-btn-dl" @onclick="() => Download(r)">Download</button>
                    <button type="button" class="rl-btn-pv" @onclick="() => Select(r)">Preview</button>
                    @if (!string.IsNullOrEmpty(r.Url))
                    {
                        <a class="rl-btn-ext" href="@r.Url" target="_blank" rel="noopener">Open path</a>
                    }
                    <button type="button" class="rl-btn-fav @(favs.Contains(r.Title)?"on":null)" @onclick="() => ToggleFav(r)">★ Fav</button>
                </div>
            </article>
        }
    </div>

    @if (selected is not null)
    {
        <aside class="rl-detail show">
            <h2>@selected.Title</h2>
            <div class="meta">@selected.Category · @selected.FileName</div>
            <pre>@selected.Body</pre>
            <div class="rl-card__actions">
                <button type="button" class="rl-btn-dl" @onclick="() => Download(selected)">Download file</button>
                @if (!string.IsNullOrEmpty(selected.Url))
                {
                    <a class="rl-btn-ext" href="@selected.Url" target="_blank" rel="noopener">Open on ISACA</a>
                }
                <button type="button" class="rl-btn-pv" @onclick="() => selected = null">Close</button>
            </div>
        </aside>
    }
</div>

@if (!string.IsNullOrEmpty(toast))
{
    <div class="rl-toast">@toast</div>
}

@code {
    private string tab = "Guides";
    private string search = "";
    private string? toast;
    private int downloads;
    private Res? selected;
    private readonly HashSet<string> favs = new();
    private static readonly string[] Tabs = { "Guides", "Policies", "Certifications", "Learning", "Templates" };

    private record Res(string Category, string Title, string Description, string Code, string Accent, string Url, string FileName, string Body);

    private List<Res> All { get; } = Build();

    private IEnumerable<Res> Filtered => All
        .Where(r => r.Category == tab)
        .Where(r => string.IsNullOrWhiteSpace(search)
            || r.Title.Contains(search, StringComparison.OrdinalIgnoreCase)
            || r.Description.Contains(search, StringComparison.OrdinalIgnoreCase));

    private void SelectTab(string name) { tab = name; selected = null; }
    private void Select(Res r) => selected = r;
    private void ToggleFav(Res r)
    {
        if (!favs.Add(r.Title)) favs.Remove(r.Title);
        toast = favs.Contains(r.Title) ? $"Favorited · {r.Title}" : $"Removed favorite · {r.Title}";
    }
    private async Task Download(Res r)
    {
        downloads++;
        toast = $"Downloaded · {r.FileName}";
        try
        {
            await JS.InvokeVoidAsync("eval",
                $"(() => {{ const b=new Blob([`{EscapeJs(r.Body)}`],{{type:'text/plain'}}); const a=document.createElement('a'); a.href=URL.createObjectURL(b); a.download='{EscapeJs(r.FileName)}'; a.click(); URL.revokeObjectURL(a.href); }})()");
        }
        catch { }
    }
    private static string EscapeJs(string s) => s.Replace("\\", "\\\\").Replace("`", "\\`").Replace("$", "\\$");

    private static string G(string body) => body + "\n\nHow to use\n1. Review with your board or committee.\n2. Adapt names and contacts for your chapter.\n3. Store the approved version in your knowledge base.\n\nRelated\nUse TRU Ask to query approved documents after you publish this guide.\n\n© Chapter education pack · Not legal advice.";

    private static List<Res> Build() => new()
    {
        R("Guides","Chapter Officer Onboarding","First 90 days for new chapter officers.","CO","#07649d","https://www.isaca.org/","Chapter-Officer-Onboarding.txt",G("Chapter Officer Onboarding — roles, calendar, handoff checklist.")),
        R("Guides","CPE Event Playbook","Plan webinars and CPE sessions end to end.","CP","#00a4e4","https://www.isaca.org/","CPE-Event-Playbook.txt",G("CPE Event Playbook — topics, speakers, registration, follow-up.")),
        R("Guides","Member Engagement Tips","Practical ways to grow active membership.","ME","#36ac91","https://www.isaca.org/membership","Member-Engagement.txt",G("Member Engagement — welcome cadence, value moments, feedback loops.")),
        R("Guides","Board Reporting Guide","Monthly metrics the board expects.","BR","#1d2d5c","","Board-Reporting-Guide.txt",G("Board Reporting — attendance, CPE hours, pipeline, risks.")),
        R("Guides","Volunteer Handbook","Roles, expectations, and recognition.","VH","#6cb33f","","Volunteer-Handbook.txt",G("Volunteer Handbook — roles, hours, recognition, escalation.")),
        R("Guides","Security Awareness Brief","Short brief for chapter events.","SA","#e31837","https://www.isaca.org/resources","Security-Awareness-Brief.txt",G("Security Awareness — phishing, MFA, data handling basics.")),
        R("Guides","Partnership Outreach","Approach local partners professionally.","PO","#07649d","","Partnership-Outreach.txt",G("Partnership Outreach — value prop, ask, follow-up template.")),
        R("Guides","Crisis Comms Outline","What to say if something goes wrong.","CC","#e57524","","Crisis-Comms-Outline.txt",G("Crisis Comms — who speaks, channels, facts-first template.")),

        R("Policies","Code of Conduct","Expected behavior for officers and volunteers.","PC","#1d2d5c","","Code-of-Conduct.txt",G("Code of Conduct — respect, confidentiality, conflicts.")),
        R("Policies","Privacy Notice (Chapter)","How member data is handled at chapter level.","PN","#07649d","","Privacy-Notice.txt",G("Privacy Notice — what we collect, why, retention, contacts.")),
        R("Policies","Expense Policy","When and how reimbursements work.","EP","#36ac91","","Expense-Policy.txt",G("Expense Policy — limits, receipts, approval path.")),
        R("Policies","Event Safety Policy","In-person and online event safety baseline.","ES","#00a4e4","","Event-Safety-Policy.txt",G("Event Safety — venues, virtual controls, incident steps.")),
        R("Policies","Conflict of Interest","Declare and manage conflicts.","CI","#e57524","","Conflict-of-Interest.txt",G("Conflict of Interest — disclosure form and recusal rules.")),
        R("Policies","Document Retention","How long to keep chapter records.","DR","#6cb33f","","Document-Retention.txt",G("Document Retention — categories, years, secure disposal.")),
        R("Policies","Social Media Policy","Voice and approval for chapter channels.","SM","#6558b1","","Social-Media-Policy.txt",G("Social Media — tone, approvals, escalation.")),
        R("Policies","Whistleblower Path","How to raise concerns safely.","WP","#e31837","","Whistleblower-Path.txt",G("Whistleblower Path — channels, non-retaliation, follow-up.")),

        R("Certifications","CISA Path","Audit and assurance certification overview.","CISA","#1d2d5c","https://www.isaca.org/credentialing/cisa","CISA-Path.txt",G("CISA — audience, domains, exam tips, study plan.")),
        R("Certifications","CISM Path","Security management certification overview.","CISM","#07649d","https://www.isaca.org/credentialing/cism","CISM-Path.txt",G("CISM — audience, domains, leadership focus.")),
        R("Certifications","CRISC Path","Risk and control certification overview.","CRISC","#00a4e4","https://www.isaca.org/credentialing/crisc","CRISC-Path.txt",G("CRISC — IT risk, controls, exam focus.")),
        R("Certifications","CGEIT Path","Governance of enterprise IT overview.","CGEIT","#36ac91","https://www.isaca.org/credentialing/cgeit","CGEIT-Path.txt",G("CGEIT — governance, value, risk, resources.")),
        R("Certifications","CDPSE Path","Privacy engineering certification overview.","CDPSE","#6cb33f","https://www.isaca.org/credentialing/cdpse","CDPSE-Path.txt",G("CDPSE — privacy tech, governance, exam domains.")),
        R("Certifications","Top Certs Guide","CISA, CISM, CRISC, CGEIT, CDPSE comparison.","TOP","#e57524","https://trainotracksolutions.weebly.com/blog/top-isaca-certifications-for-professionals","Top-Certs-Guide.txt",G("Top certifications — who each is for and next steps.")),
