@page "/controls-library"
@rendermode InteractiveServer
<PageTitle>Controls Library | Isa</PageTitle>

<section class="isa-page">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">SECURITY & ASSURANCE</p>
            <h1>Controls library</h1>
            <p class="isa-intro">Security controls, owners, evidence links, and effectiveness testing status.</p>
        </div>
        <span class="isa-pill">Sample workspace</span>
    </div>

    <div class="isa-notice">Sample control catalogue for demonstration. Map to your approved control frameworks before operational use.</div>

    <div class="isa-stat-grid">
        <article class="isa-stat-card">
            <span class="isa-stat-icon blue">▣</span>
            <span class="isa-stat-label">Total controls</span>
            <strong>@Controls.Count</strong>
            <small>In library</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon green">✓</span>
            <span class="isa-stat-label">Effective</span>
            <strong>@Controls.Count(c => c.Effectiveness == "Effective")</strong>
            <small>Last test passed</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon orange">!</span>
            <span class="isa-stat-label">Needs testing</span>
            <strong>@Controls.Count(c => c.Effectiveness == "Not tested")</strong>
            <small>Due or overdue</small>
        </article>
        <article class="isa-stat-card">
            <span class="isa-stat-icon purple">◎</span>
            <span class="isa-stat-label">Partial</span>
            <strong>@Controls.Count(c => c.Effectiveness == "Partial")</strong>
            <small>Remediation open</small>
        </article>
    </div>

    <div class="isa-toolbar">
        <InputText class="form-control isa-filter" @bind-Value="Filter" placeholder="Search controls..." />
        <InputSelect class="form-select isa-status-select" @bind-Value="DomainFilter" style="min-width:160px">
            <option value="">All domains</option>
            <option>Access control</option>
            <option>Data protection</option>
            <option>Operations</option>
            <option>Governance</option>
        </InputSelect>
    </div>

    <article class="isa-panel">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Control ID</th>
                        <th>Name / description</th>
                        <th>Domain</th>
                        <th>Owner</th>
                        <th>Last tested</th>
                        <th>Effectiveness</th>
                        <th>Evidence</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Filtered)
                    {
                        <tr>
                            <td><strong>@c.Id</strong></td>
                            <td>
                                <strong>@c.Name</strong>
                                <div class="isa-table-sub">@c.Description</div>
                            </td>
                            <td>@c.Domain</td>
                            <td>@c.Owner</td>
                            <td>@c.LastTested</td>
                            <td>
                                <span class="isa-badge @(c.Effectiveness == "Effective" ? "isa-badge--green" : c.Effectiveness == "Partial" ? "isa-badge--orange" : "isa-badge--gray")">
                                    @c.Effectiveness
                                </span>
                            </td>
                            <td>
                                <button type="button" class="isa-btn isa-btn--ghost" style="padding:.25rem .55rem;font-size:.78rem" @onclick="() => ToggleEvidence(c)">
                                    @(c.ShowEvidence ? "Hide" : "View")
                                </button>
                            </td>
                        </tr>
                        @if (c.ShowEvidence)
                        {
                            <tr>
                                <td colspan="7" style="background:#f8fafc;font-size:.85rem;color:var(--isa-muted)">
                                    <strong>Evidence:</strong> @c.Evidence
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </article>
</section>

@code {
    private string Filter = "";
    private string DomainFilter = "";

    private List<ControlItem> Controls = new()
    {
        new() { Id = "AC-01", Name = "Role-based access", Description = "Least-privilege role assignment for chapter systems.", Domain = "Access control", Owner = "IT lead", LastTested = "Sep 2026", Effectiveness = "Effective", Evidence = "Access review log Q3; 0 excess privileges found." },
        new() { Id = "AC-02", Name = "Multi-factor authentication", Description = "MFA required for admin and finance accounts.", Domain = "Access control", Owner = "IT lead", LastTested = "Aug 2026", Effectiveness = "Effective", Evidence = "SSO config export; MFA enrollment 100% for admins." },
        new() { Id = "DP-01", Name = "Member data encryption", Description = "Encryption at rest for membership database.", Domain = "Data protection", Owner = "Secretary", LastTested = "Oct 2026", Effectiveness = "Effective", Evidence = "DB encryption status report; key rotation log." },
        new() { Id = "DP-02", Name = "Data retention policy", Description = "Retention and deletion schedules for personal data.", Domain = "Data protection", Owner = "Secretary", LastTested = "Jul 2026", Effectiveness = "Partial", Evidence = "Policy approved; automated purge job pending." },
        new() { Id = "OP-01", Name = "Backup and recovery", Description = "Weekly backups with quarterly restore test.", Domain = "Operations", Owner = "IT lead", LastTested = "Sep 2026", Effectiveness = "Effective", Evidence = "Restore test report 2026-09-12; RTO met." },
        new() { Id = "OP-02", Name = "Change management", Description = "Documented approval for system changes.", Domain = "Operations", Owner = "President", LastTested = "—", Effectiveness = "Not tested", Evidence = "No formal change tickets yet this cycle." },
        new() { Id = "GV-01", Name = "Policy annual review", Description = "All chapter policies reviewed within 12 months.", Domain = "Governance", Owner = "Governance lead", LastTested = "Oct 2026", Effectiveness = "Partial", Evidence = "3 of 5 policies reviewed; 2 overdue." }
    };

    private IEnumerable<ControlItem> Filtered => Controls.Where(c =>
        (string.IsNullOrWhiteSpace(Filter) || (c.Id + c.Name + c.Description + c.Owner).Contains(Filter, StringComparison.OrdinalIgnoreCase)) &&
        (string.IsNullOrWhiteSpace(DomainFilter) || c.Domain == DomainFilter));

    private void ToggleEvidence(ControlItem c) => c.ShowEvidence = !c.ShowEvidence;

    private sealed class ControlItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Domain { get; set; } = "";
        public string Owner { get; set; } = "";
        public string LastTested { get; set; } = "";
        public string Effectiveness { get; set; } = "";
        public string Evidence { get; set; } = "";
        public bool ShowEvidence { get; set; }
    }
}
