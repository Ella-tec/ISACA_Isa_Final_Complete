@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>TRU</PageTitle>

<style>
.hm{--ink:#1d2d5c;--blue:#00a4e4;--teal:#36ac91;--green:#6cb33f;--muted:#5f6b85;--line:#e2e8f0;
font-family:"Roboto",system-ui,sans-serif;color:var(--ink);
width:100%!important;max-width:none!important;margin:0!important;
padding:.55rem .85rem .7rem!important;box-sizing:border-box;
display:flex;flex-direction:column;gap:.55rem}
.hm a{text-decoration:none!important}

/* TRU Universe banner */
.hm-uni{
  position:relative;overflow:hidden;border-radius:16px;
  background:linear-gradient(145deg,#050a14 0%,#0c1a30 50%,#12233f 100%);
  padding:1rem 1.15rem;color:#fff;
  display:grid;grid-template-columns:minmax(140px,180px) 1fr;gap:1rem;align-items:center;
  min-height:150px;
}
.hm-uni__stars{position:absolute;inset:0;pointer-events:none;opacity:.55;
background-image:
radial-gradient(1px 1px at 10% 20%,#fff,transparent),
radial-gradient(1.5px 1.5px at 30% 70%,rgba(255,255,255,.8),transparent),
radial-gradient(1px 1px at 55% 15%,#fff,transparent),
radial-gradient(1px 1px at 75% 55%,rgba(255,255,255,.7),transparent),
radial-gradient(1.5px 1.5px at 90% 25%,#fff,transparent),
radial-gradient(1px 1px at 45% 85%,rgba(255,255,255,.6),transparent)}
.hm-uni__sun-wrap{position:relative;z-index:2;width:120px;height:120px;margin:0 auto;display:grid;place-items:center}
.hm-uni__orbit{position:absolute;border-radius:50%;border:1px solid rgba(0,164,228,.2);left:50%;top:50%;transform:translate(-50%,-50%)}
.hm-uni__orbit:nth-child(1){width:42%;height:42%}
.hm-uni__orbit:nth-child(2){width:62%;height:62%;border-color:rgba(54,172,145,.22)}
.hm-uni__orbit:nth-child(3){width:82%;height:82%}
.hm-uni__orbit:nth-child(4){width:100%;height:100%;border-color:rgba(255,255,255,.12)}
.hm-uni__sun{
  position:relative;z-index:3;width:56px;height:56px;border-radius:50%;
  background:linear-gradient(145deg,#00a4e4,#36ac91 50%,#6cb33f);
  box-shadow:0 0 0 4px rgba(0,164,228,.2),0 0 28px rgba(0,164,228,.5);
  display:grid;place-items:center;font-weight:800;font-size:.72rem;letter-spacing:.08em;
}
.hm-uni__planets{position:relative;z-index:2;display:flex;flex-wrap:wrap;gap:.4rem}
.hm-uni__p{
  display:inline-flex;align-items:center;gap:.35rem;
  padding:.35rem .65rem;border-radius:999px;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);
  color:#e8eef6;font-size:.74rem;font-weight:600;cursor:pointer;
  transition:background .15s,border-color .15s,transform .15s;
}
.hm-uni__p:hover{background:rgba(0,164,228,.2);border-color:rgba(0,164,228,.4);transform:translateY(-1px)}
.hm-uni__dot{width:8px;height:8px;border-radius:50%;background:var(--c,#00a4e4);box-shadow:0 0 6px var(--c,#00a4e4);flex-shrink:0}
.hm-uni__label{font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.7;margin-bottom:.35rem}

.hm-strip{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
.hm-widget{
  border-radius:12px;padding:.7rem .9rem;color:#fff;min-height:68px;
  display:flex;flex-direction:column;gap:.05rem;cursor:pointer;text-align:left;
  font-family:inherit;border:none;width:100%;
}
.hm-widget--clock{background:linear-gradient(120deg,#07649d,#00a4e4)}
.hm-widget--weather{background:linear-gradient(120deg,#00a4e4,#36ac91)}
.hm-widget__l{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.9}
.hm-widget__v{font-size:1.3rem;font-weight:600;line-height:1.2}
.hm-widget__m{font-size:.76rem;opacity:.9}

.hm-media{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(260px,.85fr);gap:.55rem}
.hm-slides{
  position:relative;height:clamp(220px,30vh,320px);border-radius:14px;overflow:hidden;
  background:#0c1a30;border:1px solid var(--line);
}
.hm-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .7s;background-size:cover;background-position:center}
.hm-slide.is-on{opacity:1;visibility:visible;z-index:1}
.hm-slide__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,20,40,.65),rgba(10,20,40,.15));pointer-events:none}
.hm-slide__copy{position:absolute;left:1.1rem;bottom:1.1rem;right:1.1rem;z-index:2;color:#fff;max-width:34rem;pointer-events:none}
.hm-slide__copy h2{margin:0 0 .25rem;font-size:clamp(1.05rem,1.6vw,1.35rem);font-weight:700}
.hm-slide__copy p{margin:0;font-size:.84rem;opacity:.95}
.hm-slide__nav{
  position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:34px;height:34px;
  border-radius:50%;border:none;cursor:pointer;background:rgba(255,255,255,.95);color:var(--ink);
  font-size:1.15rem;font-weight:700;display:grid;place-items:center;
}
.hm-slide__nav.prev{left:10px}.hm-slide__nav.next{right:10px}
.hm-slide__dots{position:absolute;bottom:10px;left:50%;transform:translateX(-50%);z-index:4;display:flex;gap:5px}
.hm-slide__dot{width:6px;height:6px;border-radius:50%;border:none;padding:0;background:rgba(255,255,255,.55);cursor:pointer}
.hm-slide__dot.is-on{background:#fff;width:16px;border-radius:4px}
.hm-vid{width:100%;height:clamp(220px,30vh,320px)}
.hm-vid__frame{position:relative;width:100%;height:100%;border-radius:14px;overflow:hidden;background:#0c1a30;border:1px solid var(--line)}
.hm-vid__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

.hm-wx-bg{position:fixed;inset:0;background:rgba(15,23,42,.4);backdrop-filter:blur(3px);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem}
.hm-wx-modal{background:#fff;border-radius:16px;padding:1.2rem 1.35rem;max-width:400px;width:100%;box-shadow:0 16px 40px rgba(0,0,0,.15);color:var(--ink)}
.hm-wx-modal h3{margin:0 0 .7rem;font-size:1.1rem}
.hm-wx-modal input{width:100%;box-sizing:border-box;padding:.55rem .65rem;border:1px solid var(--line);border-radius:9px;font:inherit;margin-bottom:.45rem}
.hm-wx-modal button{border:0;cursor:pointer;padding:.45rem .85rem;border-radius:9px;font-weight:600;font-family:inherit;margin-right:.3rem;margin-bottom:.3rem;background:var(--ink);color:#fff}
.hm-wx-modal button.ghost{background:#e7f0f5;color:var(--ink)}
.hm-wx-grid{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin:.65rem 0 .45rem}
.hm-wx-grid div{background:#f4f7fb;border-radius:10px;padding:.55rem .65rem;font-size:.84rem}
.hm-wx-grid strong{display:block;font-size:.68rem;color:var(--muted);text-transform:uppercase;margin-bottom:.1rem}

@@media(max-width:900px){
  .hm-uni{grid-template-columns:1fr}
  .hm-media{grid-template-columns:1fr}
  .hm-slides,.hm-vid{height:240px}
}
@@media(max-width:600px){
  .hm-strip{grid-template-columns:1fr}
  .hm{padding:.45rem!important}
}
</style>

<div class="hm">
    <div class="hm-uni">
        <div class="hm-uni__stars" aria-hidden="true"></div>
        <div class="hm-uni__sun-wrap">
            <span class="hm-uni__orbit"></span><span class="hm-uni__orbit"></span>
            <span class="hm-uni__orbit"></span><span class="hm-uni__orbit"></span>
            <div class="hm-uni__sun">TRU</div>
        </div>
        <div>
            <div class="hm-uni__label">TRU Universe · workspaces</div>
            <div class="hm-uni__planets">
                <button type="button" class="hm-uni__p" style="--c:#00a4e4" @onclick='() => Go("")'><span class="hm-uni__dot"></span>Home</button>
                <button type="button" class="hm-uni__p" style="--c:#07649d" @onclick='() => Go("analytics")'><span class="hm-uni__dot"></span>Analytics</button>
                <button type="button" class="hm-uni__p" style="--c:#36ac91" @onclick='() => Go("events")'><span class="hm-uni__dot"></span>Events</button>
                <button type="button" class="hm-uni__p" style="--c:#6558b1" @onclick='() => Go("knowledge-base")'><span class="hm-uni__dot"></span>Knowledge</button>
                <button type="button" class="hm-uni__p" style="--c:#e31837" @onclick='() => Go("escalations")'><span class="hm-uni__dot"></span>Escalations</button>
                <button type="button" class="hm-uni__p" style="--c:#1d2d5c" @onclick='() => Go("governance")'><span class="hm-uni__dot"></span>Governance</button>
                <button type="button" class="hm-uni__p" style="--c:#00a4e4" @onclick='() => Go("translator")'><span class="hm-uni__dot"></span>Translator</button>
                <button type="button" class="hm-uni__p" style="--c:#6cb33f" @onclick='() => Go("content-health")'><span class="hm-uni__dot"></span>Content health</button>
                <button type="button" class="hm-uni__p" style="--c:#e57524" @onclick='() => Go("market-trends")'><span class="hm-uni__dot"></span>Market</button>
                <button type="button" class="hm-uni__p" style="--c:#07649d" @onclick='() => Go("resource-library")'><span class="hm-uni__dot"></span>Resources</button>
                <button type="button" class="hm-uni__p" style="--c:#fbb034" @onclick='() => Go("weather")'><span class="hm-uni__dot"></span>Weather</button>
                <button type="button" class="hm-uni__p" style="--c:#36ac91" @onclick='() => Go("developer-dashboard")'><span class="hm-uni__dot"></span>Developer</button>
                <button type="button" class="hm-uni__p" style="--c:#00a4e4" @onclick='() => Go("pipeline-monitor")'><span class="hm-uni__dot"></span>Pipeline</button>
                <button type="button" class="hm-uni__p" style="--c:#6558b1" @onclick='() => Go("contact")'><span class="hm-uni__dot"></span>Contact</button>
                <button type="button" class="hm-uni__p" style="--c:#8b9bb4" @onclick='() => Go("settings")'><span class="hm-uni__dot"></span>Settings</button>
            </div>
        </div>
    </div>

    <div class="hm-strip">
        <button type="button" class="hm-widget hm-widget--clock" @onclick="() => clockOpen = true">
            <span class="hm-widget__l">Local time</span>
            <span class="hm-widget__v">@timeText</span>
            <span class="hm-widget__m">@dateText · world clocks</span>
        </button>
        <button type="button" class="hm-widget hm-widget--weather" @onclick="() => wxOpen = true">
            <span class="hm-widget__l">Weather · @wxCity</span>
            <span class="hm-widget__v">@wxTemp</span>
            <span class="hm-widget__m">@wxDesc · details</span>
        </button>
    </div>

    <div class="hm-media">
        <div class="hm-slides">
            <button type="button" class="hm-slide__nav prev" @onclick="PrevSlide" aria-label="Previous">‹</button>
            <button type="button" class="hm-slide__nav next" @onclick="NextSlide" aria-label="Next">›</button>
            @for (var i = 0; i < slides.Length; i++)
            {
                var s = slides[i];
                <div class="hm-slide @(i==slideIndex?"is-on":null)" style="background-image:url('@s.ImageUrl')">
                    <div class="hm-slide__shade"></div>
                    <div class="hm-slide__copy"><h2>@s.Title</h2><p>@s.Caption</p></div>
                </div>
            }
            <div class="hm-slide__dots">
                @for (var i = 0; i < slides.Length; i++)
                {
                    var di = i;
                    <button type="button" class="hm-slide__dot @(i==slideIndex?"is-on":null)" @onclick="() => slideIndex = di"></button>
                }
            </div>
        </div>
        <div class="hm-vid">
            <div class="hm-vid__frame">
                <iframe src="@CurrentEmbed" title="@CurrentTitle"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen></iframe>
            </div>
        </div>
    </div>
</div>

@if (wxOpen)
{
    <div class="hm-wx-bg" @onclick="() => wxOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>Weather · @wxCity</h3>
            <input @bind="wxSearch" placeholder="City" />
            <button type="button" @onclick="ApplyWx">Update</button>
            <button type="button" class="ghost" @onclick='() => Go("weather")'>Full page</button>
            <button type="button" class="ghost" @onclick="() => wxOpen = false">Close</button>
            <div class="hm-wx-grid">
                <div><strong>Now</strong>@wxTemp · @wxDesc</div>
                <div><strong>Humidity</strong>@wxHumidity%</div>
                <div><strong>Wind</strong>@wxWind mph</div>
                <div><strong>UV</strong>@wxUv</div>
            </div>
        </div>
    </div>
}
@if (clockOpen)
{
    <div class="hm-wx-bg" @onclick="() => clockOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>World clocks</h3>
            <div class="hm-wx-grid">
                <div><strong>Local</strong>@timeText</div>
                <div><strong>New York</strong>@NyTime</div>
                <div><strong>London</strong>@LondonTime</div>
                <div><strong>Singapore</strong>@SgTime</div>
            </div>
            <button type="button" class="ghost" @onclick="() => clockOpen = false">Close</button>
        </div>
    </div>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private bool wxOpen, clockOpen;
    private string timeText = "--:--", dateText = "";
    private string wxCity = "Kansas City", wxTemp = "72°F", wxDesc = "Partly cloudy", wxSearch = "Kansas City";
    private int wxHumidity = 48, wxWind = 9, wxUv = 4;
    private int slideIndex, videoIndex;
    private System.Threading.Timer? clockTimer, slideTimer, videoTimer;
    private readonly Random rng = new();
    private string NyTime => DateTime.UtcNow.AddHours(-4).ToString("h:mm tt");
    private string LondonTime => DateTime.UtcNow.AddHours(1).ToString("h:mm tt");
    private string SgTime => DateTime.UtcNow.AddHours(8).ToString("h:mm tt");
    private record Slide(string Title, string Caption, string ImageUrl);
    private record YtVideo(string Id, string Title);
    private static readonly Slide[] slides =
    {
        new("Digital trust leadership","Governance, risk, and cybersecurity for chapters.","https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=80"),
        new("Certification pathways","CISA, CISM, CRISC, CGEIT, CDPSE and more.","https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1600&q=80"),
        new("Chapter excellence","Playbooks and tools for officers and volunteers.","https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=80"),
        new("Cybersecurity awareness","Practical guidance for members and boards.","https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=80"),
        new("AI & emerging tech","Layer AI into audit, security, and risk.","https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1600&q=80"),
        new("Enterprise & community","Connect chapters with global ISACA resources.","https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80"),
    };
    private static readonly YtVideo[] Videos =
    {
        new("2xBJcXFpPm4","ISACA session"), new("yxXQnKUUR4k","ISACA learning"),
        new("Chw9iTTHyhk","Chapter guidance"), new("wi2be8nt6lw","Digital trust"),
    };
    private string CurrentEmbed => $"https://www.youtube.com/embed/{Videos[videoIndex].Id}?autoplay=1&mute=1&rel=0&modestbranding=1";
    private string CurrentTitle => Videos[videoIndex].Title;

    protected override void OnInitialized()
    {
        videoIndex = rng.Next(0, Videos.Length);
        Tick(null);
        clockTimer = new System.Threading.Timer(Tick, null, 1000, 1000);
        slideTimer = new System.Threading.Timer(_ => { slideIndex = (slideIndex + 1) % slides.Length; _ = InvokeAsync(StateHasChanged); }, null, 6000, 6000);
        videoTimer = new System.Threading.Timer(_ => { videoIndex = (videoIndex + 1) % Videos.Length; _ = InvokeAsync(StateHasChanged); }, null, 180000, 180000);
    }
    private void Tick(object? _)
    {
        var n = DateTime.Now;
        timeText = n.ToString("h:mm:ss tt");
        dateText = n.ToString("dddd, MMM d yyyy");
        _ = InvokeAsync(StateHasChanged);
    }
    private void PrevSlide() => slideIndex = slideIndex == 0 ? slides.Length - 1 : slideIndex - 1;
    private void NextSlide() => slideIndex = (slideIndex + 1) % slides.Length;
    private void Go(string p) { wxOpen = false; clockOpen = false; Nav.NavigateTo(string.IsNullOrEmpty(p) ? "/" : p); }
    private void ApplyWx()
    {
        if (string.IsNullOrWhiteSpace(wxSearch)) return;
        wxCity = wxSearch.Trim();
        wxTemp = $"{60 + rng.Next(0, 25)}°F";
        wxDesc = rng.Next(0, 3) switch { 0 => "Sunny", 1 => "Partly cloudy", _ => "Cloudy" };
        wxHumidity = 35 + rng.Next(0, 40);
        wxWind = 4 + rng.Next(0, 14);
        wxUv = 1 + rng.Next(0, 9);
    }
    public void Dispose() { clockTimer?.Dispose(); slideTimer?.Dispose(); videoTimer?.Dispose(); }
}
