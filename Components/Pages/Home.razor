@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>TRU</PageTitle>

<style>
.hm{
  --ink:#1d2d5c;--blue:#00a4e4;--teal:#36ac91;--muted:#5f6b85;--line:#e2e8f0;
  font-family:"Roboto",system-ui,sans-serif;color:var(--ink);
  width:100%!important;max-width:none!important;margin:0!important;
  padding:10px!important;box-sizing:border-box;
  display:flex;flex-direction:column;gap:10px;
}
.hm a{text-decoration:none!important}

.hm-strip{display:grid;grid-template-columns:1fr 1fr;gap:10px;flex:0 0 auto}
.hm-widget{
  border-radius:14px;padding:.7rem 1rem;color:#fff;min-height:70px;
  display:flex;flex-direction:column;gap:.05rem;cursor:pointer;text-align:left;
  font-family:inherit;border:none;width:100%;
}
.hm-widget--clock{background:linear-gradient(120deg,#07649d,#00a4e4)}
.hm-widget--weather{background:linear-gradient(120deg,#00a4e4,#36ac91)}
.hm-widget__l{font-size:.62rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.9}
.hm-widget__v{font-size:1.35rem;font-weight:600;line-height:1.2}
.hm-widget__m{font-size:.78rem;opacity:.9}

/* Full-size slides */
.hm-slides{
  position:relative;width:100%;
  height:clamp(280px,42vh,460px);
  border-radius:16px;overflow:hidden;background:#0c1a30;
  flex:0 0 auto;
}
.hm-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .7s ease;background-size:cover;background-position:center}
.hm-slide.is-on{opacity:1;visibility:visible;z-index:1}
.hm-slide__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(10,20,40,.55),rgba(10,20,40,.08) 65%,transparent);pointer-events:none}
.hm-slide__copy{position:absolute;left:1.35rem;bottom:1.35rem;right:1.35rem;z-index:2;color:#fff;max-width:42rem;pointer-events:none}
.hm-slide__copy h2{margin:0 0 .25rem;font-size:clamp(1.15rem,2.1vw,1.55rem);font-weight:700;text-shadow:0 2px 10px rgba(0,0,0,.3)}
.hm-slide__copy p{margin:0;font-size:.9rem;opacity:.96}
.hm-slide__nav{
  position:absolute;top:50%;transform:translateY(-50%);z-index:4;
  width:40px;height:40px;border-radius:50%;border:none;cursor:pointer;
  background:rgba(255,255,255,.95);color:var(--ink);font-size:1.25rem;font-weight:700;
  display:grid;place-items:center;box-shadow:0 4px 14px rgba(0,0,0,.12);
}
.hm-slide__nav.prev{left:14px}.hm-slide__nav.next{right:14px}
.hm-slide__dots{position:absolute;bottom:14px;left:50%;transform:translateX(-50%);z-index:4;display:flex;gap:6px}
.hm-slide__dot{width:7px;height:7px;border-radius:50%;border:none;padding:0;background:rgba(255,255,255,.55);cursor:pointer}
.hm-slide__dot.is-on{background:#fff;width:18px;border-radius:5px}

/* Video: scale iframe slightly to crop black side bars */
.hm-vid{width:100%;flex:0 0 auto}
.hm-vid__frame{
  position:relative;width:100%;
  aspect-ratio:16/9;
  max-height:min(520px,55vh);
  border-radius:16px;
  overflow:hidden;
  background:#0c1a30;
}
.hm-vid__frame iframe{
  position:absolute;
  top:50%;
  left:50%;
  width:100%;
  height:100%;
  border:0;
  display:block;
  transform:translate(-50%,-50%) scale(1.12);
  transform-origin:center center;
}

.hm-wx-bg{position:fixed;inset:0;background:rgba(15,23,42,.4);backdrop-filter:blur(3px);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem}
.hm-wx-modal{background:#fff;border-radius:16px;padding:1.2rem 1.35rem;max-width:400px;width:100%;box-shadow:0 16px 40px rgba(0,0,0,.15);color:var(--ink)}
.hm-wx-modal h3{margin:0 0 .7rem;font-size:1.1rem}
.hm-wx-modal input{width:100%;box-sizing:border-box;padding:.55rem .65rem;border:1px solid var(--line);border-radius:9px;font:inherit;margin-bottom:.45rem}
.hm-wx-modal button{border:0;cursor:pointer;padding:.45rem .85rem;border-radius:9px;font-weight:600;font-family:inherit;margin-right:.3rem;margin-bottom:.3rem;background:var(--ink);color:#fff}
.hm-wx-modal button.ghost{background:#e7f0f5;color:var(--ink)}
.hm-wx-grid{display:grid;grid-template-columns:1fr 1fr;gap:.45rem;margin:.65rem 0 .45rem}
.hm-wx-grid div{background:#f4f7fb;border-radius:10px;padding:.55rem .65rem;font-size:.84rem}
.hm-wx-grid strong{display:block;font-size:.68rem;color:var(--muted);text-transform:uppercase;margin-bottom:.1rem}

@@media(max-width:700px){
  .hm-strip{grid-template-columns:1fr}
  .hm-slides{height:220px}
  .hm-vid__frame{max-height:none}
  .hm{padding:8px!important;gap:8px}
}
</style>

<div class="hm">
    <div class="hm-strip">
        <button type="button" class="hm-widget hm-widget--clock" @onclick="() => clockOpen = true">
            <span class="hm-widget__l">Local time</span>
            <span class="hm-widget__v">@timeText</span>
            <span class="hm-widget__m">@dateText · world clocks</span>
        </button>
        <button type="button" class="hm-widget hm-widget--weather" @onclick="() => wxOpen = true">
            <span class="hm-widget__l">Weather · @wxCity</span>
            <span class="hm-widget__v">@wxTemp</span>
            <span class="hm-widget__m">@wxDesc · details</span>
        </button>
    </div>

    <div class="hm-slides">
        <button type="button" class="hm-slide__nav prev" @onclick="PrevSlide" aria-label="Previous">‹</button>
        <button type="button" class="hm-slide__nav next" @onclick="NextSlide" aria-label="Next">›</button>
        @for (var i = 0; i < slides.Length; i++)
        {
            var s = slides[i];
            <div class="hm-slide @(i==slideIndex?"is-on":null)" style="background-image:url('@s.ImageUrl')">
                <div class="hm-slide__shade"></div>
                <div class="hm-slide__copy"><h2>@s.Title</h2><p>@s.Caption</p></div>
            </div>
        }
        <div class="hm-slide__dots">
            @for (var i = 0; i < slides.Length; i++)
            {
                var di = i;
                <button type="button" class="hm-slide__dot @(i==slideIndex?"is-on":null)" @onclick="() => slideIndex = di"></button>
            }
        </div>
    </div>

    <div class="hm-vid">
        <div class="hm-vid__frame">
            <iframe src="@CurrentEmbed" title="@CurrentTitle"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    referrerpolicy="strict-origin-when-cross-origin"></iframe>
        </div>
    </div>
</div>

@if (wxOpen)
{
    <div class="hm-wx-bg" @onclick="() => wxOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>Weather · @wxCity</h3>
            <input @bind="wxSearch" placeholder="City" />
            <button type="button" @onclick="ApplyWx">Update</button>
            <button type="button" class="ghost" @onclick='() => Go("weather")'>Full page</button>
            <button type="button" class="ghost" @onclick="() => wxOpen = false">Close</button>
            <div class="hm-wx-grid">
                <div><strong>Now</strong>@wxTemp · @wxDesc</div>
                <div><strong>Humidity</strong>@wxHumidity%</div>
                <div><strong>Wind</strong>@wxWind mph</div>
                <div><strong>UV</strong>@wxUv</div>
            </div>
        </div>
    </div>
}
@if (clockOpen)
{
    <div class="hm-wx-bg" @onclick="() => clockOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>World clocks</h3>
            <div class="hm-wx-grid">
                <div><strong>Local</strong>@timeText</div>
                <div><strong>New York</strong>@NyTime</div>
                <div><strong>London</strong>@LondonTime</div>
                <div><strong>Singapore</strong>@SgTime</div>
            </div>
            <button type="button" class="ghost" @onclick="() => clockOpen = false">Close</button>
        </div>
    </div>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private bool wxOpen, clockOpen;
    private string timeText = "--:--", dateText = "";
    private string wxCity = "Kansas City", wxTemp = "72°F", wxDesc = "Partly cloudy", wxSearch = "Kansas City";
    private int wxHumidity = 48, wxWind = 9, wxUv = 4;
    private int slideIndex, videoIndex;
    private System.Threading.Timer? clockTimer, slideTimer, videoTimer;
    private readonly Random rng = new();
    private string NyTime => DateTime.UtcNow.AddHours(-4).ToString("h:mm tt");
    private string LondonTime => DateTime.UtcNow.AddHours(1).ToString("h:mm tt");
    private string SgTime => DateTime.UtcNow.AddHours(8).ToString("h:mm tt");
    private record Slide(string Title, string Caption, string ImageUrl);
    private record YtVideo(string Id, string Title);
    private static readonly Slide[] slides =
    {
        new("Digital trust leadership","Governance, risk, and cybersecurity for chapters.","https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=80"),
        new("Certification pathways","CISA, CISM, CRISC, CGEIT, CDPSE and more.","https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1600&q=80"),
        new("Chapter excellence","Playbooks and tools for officers and volunteers.","https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=80"),
        new("Cybersecurity awareness","Practical guidance for members and boards.","https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=80"),
        new("AI & emerging tech","Layer AI into audit, security, and risk.","https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1600&q=80"),
        new("Enterprise & community","Connect chapters with global ISACA resources.","https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80"),
    };
    private static readonly YtVideo[] Videos =
    {
        new("2xBJcXFpPm4","ISACA session"),
        new("yxXQnKUUR4k","ISACA learning"),
        new("Chw9iTTHyhk","Chapter guidance"),
        new("wi2be8nt6lw","Digital trust"),
    };
    private string CurrentEmbed =>
        $"https://www.youtube-nocookie.com/embed/{Videos[videoIndex].Id}?autoplay=1&mute=1&rel=0&modestbranding=1&playsinline=1&controls=1&fs=1";
    private string CurrentTitle => Videos[videoIndex].Title;

    protected override void OnInitialized()
    {
        videoIndex = rng.Next(0, Videos.Length);
        Tick(null);
        clockTimer = new System.Threading.Timer(Tick, null, 1000, 1000);
        slideTimer = new System.Threading.Timer(_ => { slideIndex = (slideIndex + 1) % slides.Length; _ = InvokeAsync(StateHasChanged); }, null, 6000, 6000);
        videoTimer = new System.Threading.Timer(_ => { videoIndex = (videoIndex + 1) % Videos.Length; _ = InvokeAsync(StateHasChanged); }, null, 180000, 180000);
    }
    private void Tick(object? _)
    {
        var n = DateTime.Now;
        timeText = n.ToString("h:mm:ss tt");
        dateText = n.ToString("dddd, MMM d yyyy");
        _ = InvokeAsync(StateHasChanged);
    }
    private void PrevSlide() => slideIndex = slideIndex == 0 ? slides.Length - 1 : slideIndex - 1;
    private void NextSlide() => slideIndex = (slideIndex + 1) % slides.Length;
    private void Go(string p) { wxOpen = false; clockOpen = false; Nav.NavigateTo(p); }
    private void ApplyWx()
    {
        if (string.IsNullOrWhiteSpace(wxSearch)) return;
        wxCity = wxSearch.Trim();
        wxTemp = $"{60 + rng.Next(0, 25)}°F";
        wxDesc = rng.Next(0, 3) switch { 0 => "Sunny", 1 => "Partly cloudy", _ => "Cloudy" };
        wxHumidity = 35 + rng.Next(0, 40);
        wxWind = 4 + rng.Next(0, 14);
        wxUv = 1 + rng.Next(0, 9);
    }
    public void Dispose() { clockTimer?.Dispose(); slideTimer?.Dispose(); videoTimer?.Dispose(); }
}
