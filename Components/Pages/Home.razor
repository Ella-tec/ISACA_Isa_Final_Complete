@page "/"
@layout LandingLayout
@using IsaChatApp.Services
@inject NavigationManager Nav
@rendermode InteractiveServer

@* Clean landing: after sign-in go straight to workspace. Guests see intro + feature grid. *@

<PageTitle>Isa | Chapter Support Assistant</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="landing">
            <header class="landing__topbar">
                <div class="landing__brand">
                    <span class="landing__brandMark">
                        <img src="images/isa-mark.svg" alt="" width="40" height="40" />
                    </span>
                    <span class="landing__brandText">
                        <span class="landing__brandName">Isa</span>
                        <span class="landing__brandTag">ISACA Chapter Support Workspace</span>
                    </span>
                </div>
                <div class="landing__topbarRight">
                    <a class="landing__btn landing__btn--primary" href="/knowledge-base">Knowledge base</a>
                </div>
            </header>
            <section class="landing__hero">
                <div class="landing__heroInner">
                    <div class="landing__heroText">
                        <p class="landing__eyebrow">WELCOME TO YOUR WORKSPACE</p>
                        <h1 class="landing__headline">How can Isa help your chapter today?</h1>
                        <p class="landing__lede">Access chapter resources, review activity, manage events, and get support from one place.</p>
                        <div class="landing__ctaRow">
                            <a class="landing__btn landing__btn--primary" href="/knowledge-base">Browse knowledge base</a>
                            <a class="landing__btn landing__btn--ghost" href="/analytics">View analytics</a>
                            <a class="landing__btn landing__btn--ghost" href="/events">Open events calendar</a>
                        </div>
                    </div>
                </div>
            </section>
            <section id="workspace" class="landing__section">
                <h2 class="landing__sectionTitle">Your workspace</h2>
                <p class="landing__sectionLede">Choose a tool to get started.</p>
                <div class="landing__featureGrid">
                    <a class="landing__featureCard" href="/knowledge-base"><strong>Knowledge base</strong><span>Find chapter guidance and resources</span></a>
                    <a class="landing__featureCard" href="/analytics"><strong>Analytics</strong><span>Review activity and service metrics</span></a>
                    <a class="landing__featureCard" href="/events"><strong>Events &amp; calendar</strong><span>Plan chapter events and follow-ups</span></a>
                    <a class="landing__featureCard" href="/escalations"><strong>Escalations &amp; tickets</strong><span>Track questions needing human support</span></a>
                    <a class="landing__featureCard" href="/governance"><strong>Governance &amp; policies</strong><span>Review governance resources</span></a>
                    <a class="landing__featureCard" href="/translator"><strong>Translator</strong><span>Translate chapter communications</span></a>
                    <a class="landing__featureCard" href="/content-health-dashboard"><strong>Content health</strong><span>Review content quality indicators</span></a>
                    <a class="landing__featureCard" href="/pipeline-monitor"><strong>Pipeline monitor</strong><span>Inspect processing stages</span></a>
                </div>
            </section>
            <footer class="landing__footer">
                Isa is a prototype built for ISACA chapter support scenarios. This is a demonstration workspace, not an official ISACA website.
            </footer>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="landing">

            <header class="landing__topbar">
                <div class="landing__brand">
                    <span class="landing__brandMark">
                        <img src="images/isa-mark.svg" alt="" width="40" height="40" />
                    </span>
                    <span class="landing__brandText">
                        <span class="landing__brandName">Isa</span>
                        <span class="landing__brandTag">Chapter Support Assistant</span>
                    </span>
                </div>
                <div class="landing__topbarRight">
                    <nav class="landing__links">
                        <a href="#how">How it works</a>
                        <a href="#workspace">Workspace</a>
                        <a href="#try">Try it</a>
                    </nav>
                    <a class="landing__btn landing__btn--primary" href="/sign-in" data-enhance-nav="false">Sign in</a>
                </div>
            </header>

            <section class="landing__hero">
                <div class="landing__heroInner">
                    <div class="landing__heroText">
                        <p class="landing__eyebrow">FOR ISACA CHAPTER LEADERS</p>
                        <h1 class="landing__headline">Meet Isa, your chapter support assistant</h1>
                        <p class="landing__lede">
                            Ask a question about running your chapter. Isa searches approved
                            chapter guidance, shows its sources, and hands off to a person when needed.
                        </p>
                        <div class="landing__ctaRow">
                            <a class="landing__btn landing__btn--primary" href="/sign-in" data-enhance-nav="false">Sign in</a>
                            <a class="landing__btn landing__btn--ghost" href="/knowledge-base">Open workspace</a>
                            <a class="landing__btn landing__btn--ghost" href="/analytics">Analytics</a>
                        </div>
                        <p class="landing__cta">
                            Or click the Isa button in the bottom-right corner to chat.
                        </p>
                    </div>
                    <div class="landing__heroBadge" aria-hidden="true">
                        <svg viewBox="0 0 120 120" width="120" height="120">
                            <circle cx="60" cy="60" r="52" fill="none" stroke="#6cb33f" stroke-width="10" stroke-dasharray="240 80" stroke-linecap="round"/>
                            <text x="60" y="68" text-anchor="middle" font-family="Roboto,sans-serif" font-size="28" font-weight="700" fill="#1d2d5c">Isa</text>
                        </svg>
                    </div>
                </div>
            </section>

            <section id="how" class="landing__section">
                <h2 class="landing__sectionTitle">How Isa answers</h2>
                <div class="landing__steps">
                    <div class="landing__step">
                        <span class="landing__stepNum">1</span>
                        <h3 class="landing__stepTitle">SEARCHES APPROVED CONTENT</h3>
                        <p>Isa looks only in documents ISACA has approved for chapter leaders, not the open internet.</p>
                    </div>
                    <div class="landing__step">
                        <span class="landing__stepNum">2</span>
                        <h3 class="landing__stepTitle">SHOWS ITS SOURCES</h3>
                        <p>Each answer lists the document and section it came from, so you can check it yourself.</p>
                    </div>
                    <div class="landing__step">
                        <span class="landing__stepNum">3</span>
                        <h3 class="landing__stepTitle">KNOWS WHEN TO HAND OFF</h3>
                        <p>Sensitive questions, or ones the documents don't cover, go to a person. You get a reference number to follow up.</p>
                    </div>
                </div>
            </section>

            <section id="workspace" class="landing__section landing__section--tint">
                <h2 class="landing__sectionTitle">Explore the full workspace</h2>
                <p class="landing__sectionLede">
                    All features live in the workspace sidebar. Open any area below to try it.
                </p>
                <div class="landing__featureGrid">
                    <a class="landing__featureCard" href="/knowledge-base"><strong>Knowledge base</strong><span>Search chapter guidance</span></a>
                    <a class="landing__featureCard" href="/analytics"><strong>Analytics</strong><span>KPIs and trends</span></a>
                    <a class="landing__featureCard" href="/events"><strong>Events &amp; calendar</strong><span>Plan chapter events</span></a>
                    <a class="landing__featureCard" href="/escalations"><strong>Escalations</strong><span>Hand-offs and tickets</span></a>
                    <a class="landing__featureCard" href="/governance"><strong>Governance</strong><span>Policy register</span></a>
                    <a class="landing__featureCard" href="/risk-management"><strong>Risk management</strong><span>Residual risk view</span></a>
                    <a class="landing__featureCard" href="/compliance-center"><strong>Compliance</strong><span>Obligations &amp; evidence</span></a>
                    <a class="landing__featureCard" href="/audit-management"><strong>Audit management</strong><span>Findings tracking</span></a>
                    <a class="landing__featureCard" href="/incident-management"><strong>Incidents</strong><span>Incident log</span></a>
                    <a class="landing__featureCard" href="/vendor-risk"><strong>Vendor risk</strong><span>Supplier snapshots</span></a>
                    <a class="landing__featureCard" href="/reports-insights"><strong>Reports &amp; insights</strong><span>Management reports</span></a>
                    <a class="landing__featureCard" href="/controls-library"><strong>Controls library</strong><span>Control catalogue</span></a>
                    <a class="landing__featureCard" href="/policies-documents"><strong>Policies &amp; documents</strong><span>Document library</span></a>
                    <a class="landing__featureCard" href="/content-health-dashboard"><strong>Content health</strong><span>Coverage checks</span></a>
                    <a class="landing__featureCard" href="/translator"><strong>Translator</strong><span>Demo translation</span></a>
                    <a class="landing__featureCard" href="/world-clock"><strong>World clock</strong><span>Clocks &amp; news</span></a>
                    <a class="landing__featureCard" href="/isaca-resources"><strong>ISACA resources</strong><span>Official links</span></a>
                    <a class="landing__featureCard" href="/users-settings"><strong>Users &amp; settings</strong><span>Roles</span></a>
                    <a class="landing__featureCard" href="/pipeline-monitor"><strong>Pipeline monitor</strong><span>Stage traces</span></a>
                    <a class="landing__featureCard" href="/dev-dashboard"><strong>Developer dashboard</strong><span>Diagnostics</span></a>
                    <a class="landing__featureCard" href="/isa-config"><strong>Isa configuration</strong><span>Model settings</span></a>
                </div>
            </section>

            <section id="try" class="landing__section">
                <h2 class="landing__sectionTitle">Questions to try</h2>
                <p class="landing__sectionLede">Open Isa and type any of these.</p>
                <div class="landing__questions">
                    <div class="landing__question">How many board meetings must a chapter hold each year?</div>
                    <div class="landing__question">How many educational events must a chapter hold?</div>
                    <div class="landing__question">Who writes down what the board decided?</div>
                    <div class="landing__question">When do we send in our yearly paperwork?</div>
                </div>
            </section>

            <footer class="landing__footer">
                Isa is a prototype built for ISACA by Second Star Collective (i.c.stars Kansas City).
                This is a demonstration page, not an official ISACA website.
            </footer>
        </div>
    </NotAuthorized>
</AuthorizeView>


@code {
    // The authenticated root route is the workspace home. Do not redirect
    // users to the knowledge base after sign-in.
}
