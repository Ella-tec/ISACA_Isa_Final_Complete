@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>TRU</PageTitle>

<style>
.hm{--ink:#24436b;--blue:#eaf4fb;--teal:#239f9a;--muted:#71839a;--line:#dfe9f1;font-family:"Roboto",system-ui,sans-serif;color:var(--ink);width:100%!important;max-width:none!important;margin:0!important;padding:.75rem 1rem 1rem!important;box-sizing:border-box;min-height:calc(100vh - .15rem);display:flex;flex-direction:column;gap:.8rem;background:#f8fbfd}
.hm a{text-decoration:none!important}.hm-strip{flex:0 0 auto;display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
.hm-widget{border-radius:12px;padding:.75rem 1rem;color:var(--ink);min-height:74px;display:flex;flex-direction:column;gap:.05rem;background:#fff;border:1px solid var(--line);box-shadow:0 3px 12px rgba(36,67,107,.04);cursor:pointer;text-align:left;font-family:inherit;width:100%;transition:border-color .2s,transform .2s}
.hm-widget:hover{transform:translateY(-1px);border-color:var(--teal)}.hm-widget--clock,.hm-widget--weather{background:#fff}.hm-widget__l{font-size:.65rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal)}.hm-widget__v{font-size:1.35rem;font-weight:600;line-height:1.25;color:var(--ink)}.hm-widget__m{font-size:.78rem;color:var(--muted)}
.hm-media{flex:0 0 auto;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.85fr);align-items:stretch;gap:.85rem;min-height:0}
.hm-slides{position:relative;height:clamp(250px,34vh,360px);min-height:250px;margin:0;padding:0;width:100%;border-radius:14px;overflow:hidden;background:#eaf4fb;border:1px solid var(--line);box-shadow:0 4px 16px rgba(36,67,107,.06);touch-action:pan-y;user-select:none}
.hm-slide{position:absolute;inset:0;opacity:0;visibility:hidden;transition:opacity .8s ease,visibility .8s ease;background-size:cover;background-position:center}.hm-slide.is-on{opacity:1;visibility:visible;z-index:1}
.hm-slide__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(20,48,76,.52),rgba(20,48,76,.12) 72%,rgba(20,48,76,.03));pointer-events:none}
.hm-slide__copy{position:absolute;left:1.2rem;bottom:1.25rem;right:1.2rem;z-index:2;color:#fff;max-width:36rem;pointer-events:none}.hm-slide__copy h2{margin:0 0 .3rem;font-size:clamp(1.1rem,1.8vw,1.5rem);font-weight:700;color:#fff;text-shadow:0 1px 5px rgba(0,0,0,.2)}.hm-slide__copy p{margin:0;font-size:.88rem;opacity:.96}
.hm-slide__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:4;width:36px;height:36px;border-radius:50%;border:1px solid rgba(36,67,107,.08);cursor:pointer;background:rgba(255,255,255,.94);color:var(--ink);font-size:1.2rem;font-weight:700;box-shadow:0 2px 8px rgba(20,48,76,.12);display:grid;place-items:center;transition:background .2s}
.hm-slide__nav:hover{background:#fff;transform:translateY(-50%) scale(1.04)}.hm-slide__nav.prev{left:10px}.hm-slide__nav.next{right:10px}.hm-slide__dots{position:absolute;bottom:12px;left:50%;transform:translateX(-50%);z-index:4;display:flex;gap:6px}
.hm-slide__dot{width:7px;height:7px;border-radius:50%;border:none;padding:0;background:rgba(255,255,255,.6);cursor:pointer;transition:width .25s,background .25s}.hm-slide__dot.is-on{background:#fff;width:18px;border-radius:5px}
.hm-vid{width:100%;height:clamp(250px,34vh,360px);min-height:250px;margin:0;padding:0}.hm-vid__frame{position:relative;width:100%;height:100%;min-height:250px;border-radius:14px;overflow:hidden;background:#eaf4fb;border:1px solid var(--line);box-shadow:0 4px 16px rgba(36,67,107,.06)}.hm-vid__frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
.hm-wx-bg{position:fixed;inset:0;background:rgba(36,67,107,.24);backdrop-filter:blur(3px);z-index:2000;display:flex;align-items:center;justify-content:center;padding:1rem}.hm-wx-modal{background:#fff;border:1px solid var(--line);border-radius:16px;padding:1.25rem 1.4rem;max-width:420px;width:100%;box-shadow:0 16px 40px rgba(36,67,107,.14)}
.hm-wx-modal h3{margin:0 0 .75rem;font-family:"Roboto",system-ui,sans-serif;font-weight:700;font-size:1.15rem;color:var(--ink)}.hm-wx-modal input{width:100%;box-sizing:border-box;padding:.6rem .7rem;border:1px solid var(--line);border-radius:9px;font:inherit;margin-bottom:.5rem}.hm-wx-modal button{border:0;cursor:pointer;padding:.5rem .9rem;border-radius:9px;font-weight:600;font-family:inherit;margin-right:.35rem;margin-bottom:.35rem;background:var(--ink);color:#fff}.hm-wx-modal button.ghost{background:var(--blue);color:var(--ink)}
.hm-wx-grid{display:grid;grid-template-columns:1fr 1fr;gap:.5rem;margin:.75rem 0 .5rem}.hm-wx-grid div{background:#f3f8fc;border-radius:10px;padding:.65rem .75rem;font-size:.86rem}.hm-wx-grid strong{display:block;font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:.04em;margin-bottom:.15rem}
@@media(max-width:900px){.hm-media{grid-template-columns:1fr}.hm-slides{height:280px}.hm-vid{height:240px;min-height:240px}.hm-vid__frame{min-height:240px}.hm{min-height:auto}}
@@media(max-width:600px){.hm{padding:.5rem!important}.hm-strip{grid-template-columns:1fr}.hm-slides{height:245px;min-height:245px}.hm-vid{height:220px;min-height:220px}.hm-vid__frame{min-height:220px}.hm-slide__copy{left:.9rem;right:.9rem;bottom:1rem}}
@@media(prefers-reduced-motion:reduce){.hm-slide,.hm-slide__dot,.hm-widget{transition:none!important}}
</style>

<div class="hm">
    @* TOP SCREEN: live time + weather *@
    <div class="hm-strip">
        <button type="button" class="hm-widget hm-widget--clock" @onclick="() => clockOpen = true" title="Open world clocks">
            <span class="hm-widget__l">Local time</span>
            <span class="hm-widget__v">@timeText</span>
            <span class="hm-widget__m">@dateText · click for world clocks</span>
        </button>
        <button type="button" class="hm-widget hm-widget--weather" @onclick="() => wxOpen = true" title="Open weather">
            <span class="hm-widget__l">Weather · @wxCity</span>
            <span class="hm-widget__v">@wxTemp</span>
            <span class="hm-widget__m">@wxDesc · click for details</span>
        </button>
    </div>

    <div class="hm-media">
        <div class="hm-slides"
             @ontouchstart="OnTouchStart"
             @ontouchend="OnTouchEnd"
             @onpointerdown="OnPointerDown"
             @onpointerup="OnPointerUp">
            <button type="button" class="hm-slide__nav prev" @onclick="PrevSlide" aria-label="Previous">‹</button>
            <button type="button" class="hm-slide__nav next" @onclick="NextSlide" aria-label="Next">›</button>
            @for (var i = 0; i < slides.Length; i++)
            {
                var s = slides[i];
                <div class="hm-slide @(i==slideIndex?"is-on":null)" style="background-image:url('@s.ImageUrl')">
                    <div class="hm-slide__shade"></div>
                    <div class="hm-slide__copy"><h2>@s.Title</h2><p>@s.Caption</p></div>
                </div>
            }
            <div class="hm-slide__dots">
                @for (var i = 0; i < slides.Length; i++)
                {
                    var di = i;
                    <button type="button" class="hm-slide__dot @(i==slideIndex?"is-on":null)" @onclick="() => slideIndex = di" aria-label="@($"Slide {i+1}")"></button>
                }
            </div>
        </div>

        <div class="hm-vid">
            <div class="hm-vid__frame">
                <iframe src="@CurrentEmbed" title="@CurrentTitle"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
        </div>
    </div>
</div>

@if (wxOpen)
{
    <div class="hm-wx-bg" @onclick="() => wxOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>Weather · @wxCity</h3>
            <input @bind="wxSearch" placeholder="City (e.g. Chicago)" />
            <button type="button" @onclick="ApplyWx">Update city</button>
            <button type="button" class="ghost" @onclick='() => Go("weather")'>Full weather page</button>
            <button type="button" class="ghost" @onclick="() => wxOpen = false">Close</button>
            <div class="hm-wx-grid">
                <div><strong>Now</strong>@wxTemp · @wxDesc</div>
                <div><strong>Humidity</strong>@wxHumidity%</div>
                <div><strong>Wind</strong>@wxWind mph</div>
                <div><strong>UV</strong>@wxUv</div>
            </div>
        </div>
    </div>
}
@if (clockOpen)
{
    <div class="hm-wx-bg" @onclick="() => clockOpen = false">
        <div class="hm-wx-modal" @onclick:stopPropagation="true">
            <h3>World clocks</h3>
            <div class="hm-wx-grid">
                <div><strong>Local</strong>@timeText</div>
                <div><strong>New York</strong>@NyTime</div>
                <div><strong>London</strong>@LondonTime</div>
                <div><strong>Singapore</strong>@SgTime</div>
            </div>
            <button type="button" class="ghost" @onclick="() => clockOpen = false">Close</button>
        </div>
    </div>
}

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;
    private bool wxOpen, clockOpen;
    private string timeText = "--:--", dateText = "";
    private string wxCity = "Kansas City", wxTemp = "72°F", wxDesc = "Partly cloudy", wxSearch = "Kansas City";
    private int wxHumidity = 48, wxWind = 9, wxUv = 4;
    private int slideIndex, videoIndex;
    private System.Threading.Timer? clockTimer, slideTimer, videoTimer;
    private readonly Random rng = new();

    private string NyTime => DateTime.UtcNow.AddHours(-4).ToString("h:mm tt");
    private string LondonTime => DateTime.UtcNow.AddHours(1).ToString("h:mm tt");
    private string SgTime => DateTime.UtcNow.AddHours(8).ToString("h:mm tt");

    private record Slide(string Title, string Caption, string ImageUrl);
    private record YtVideo(string Id, string Title);

    private static readonly Slide[] slides =
    {
        new("Digital trust leadership","Governance, risk, and cybersecurity for chapters.","https://images.unsplash.com/photo-1556761175-5973dc0f32e7?auto=format&fit=crop&w=1600&q=80"),
        new("Certification pathways","CISA, CISM, CRISC, CGEIT, CDPSE and more.","https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1600&q=80"),
        new("Chapter excellence","Playbooks and tools for officers and volunteers.","https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1600&q=80"),
        new("Cybersecurity awareness","Practical guidance for members and boards.","https://images.unsplash.com/photo-1563986768609-322da13575f3?auto=format&fit=crop&w=1600&q=80"),
        new("AI & emerging tech","Layer AI into audit, security, and risk.","https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&w=1600&q=80"),
        new("Enterprise & community","Connect chapters with global ISACA resources.","https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1600&q=80"),
    };

    private static readonly YtVideo[] Videos =
    {
        new("2xBJcXFpPm4","ISACA session"), new("yxXQnKUUR4k","ISACA learning"),
        new("Chw9iTTHyhk","Chapter guidance"), new("wi2be8nt6lw","Digital trust"),
        new("9mPEksxW8VY","Certification path"), new("ez54DQRYmqc","ISACA insights"),
    };

    private string CurrentEmbed => $"https://www.youtube.com/embed/{Videos[videoIndex].Id}?autoplay=1&mute=1&rel=0&modestbranding=1&playsinline=1";
    private string CurrentTitle => Videos[videoIndex].Title;

    protected override void OnInitialized()
    {
        videoIndex = rng.Next(0, Videos.Length);
        Tick(null);
        clockTimer = new System.Threading.Timer(Tick, null, 1000, 1000);
        slideTimer = new System.Threading.Timer(_ => { slideIndex = (slideIndex + 1) % slides.Length; _ = InvokeAsync(StateHasChanged); }, null, 6000, 6000);
        videoTimer = new System.Threading.Timer(_ => { videoIndex = (videoIndex + 1) % Videos.Length; _ = InvokeAsync(StateHasChanged); }, null, 180000, 180000);
    }

    private void Tick(object? _)
    {
        var n = DateTime.Now;
        timeText = n.ToString("h:mm:ss tt");
        dateText = n.ToString("dddd, MMM d yyyy");
        _ = InvokeAsync(StateHasChanged);
    }

    private double _touchX;
    private void OnTouchStart(Microsoft.AspNetCore.Components.Web.TouchEventArgs e) { if (e.Touches.Length > 0) _touchX = e.Touches[0].ClientX; }
    private void OnTouchEnd(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0) return;
        var dx = e.ChangedTouches[0].ClientX - _touchX;
        if (dx > 50) PrevSlide(); else if (dx < -50) NextSlide();
    }
    private void OnPointerDown(Microsoft.AspNetCore.Components.Web.PointerEventArgs e) => _touchX = e.ClientX;
    private void OnPointerUp(Microsoft.AspNetCore.Components.Web.PointerEventArgs e)
    {
        var dx = e.ClientX - _touchX;
        if (dx > 60) PrevSlide(); else if (dx < -60) NextSlide();
    }
    private void PrevSlide() => slideIndex = slideIndex == 0 ? slides.Length - 1 : slideIndex - 1;
    private void NextSlide() => slideIndex = (slideIndex + 1) % slides.Length;
    private void Go(string p) { wxOpen = false; Nav.NavigateTo(p); }
    private void ApplyWx()
    {
        if (string.IsNullOrWhiteSpace(wxSearch)) return;
        wxCity = wxSearch.Trim();
        wxTemp = $"{60 + rng.Next(0, 25)}°F";
        wxDesc = rng.Next(0, 3) switch { 0 => "Sunny", 1 => "Partly cloudy", _ => "Cloudy" };
        wxHumidity = 35 + rng.Next(0, 40);
        wxWind = 4 + rng.Next(0, 14);
        wxUv = 1 + rng.Next(0, 9);
    }
    public void Dispose() { clockTimer?.Dispose(); slideTimer?.Dispose(); videoTimer?.Dispose(); }
}
