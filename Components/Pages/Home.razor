@page "/"
@layout LandingLayout
@inject NavigationManager Nav
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Isa | Chapter Support Assistant</PageTitle>

<div class="ws">
    <header class="ws__bar">
        <div class="ws__brand">
            <span class="ws__logo" aria-hidden="true">
                <svg viewBox="0 0 40 40" width="36" height="36">
                    <rect width="40" height="40" rx="10" fill="#1d2d5c"/>
                    <circle cx="20" cy="20" r="12" fill="#fff"/>
                    <path d="M26 20a6 6 0 1 1-6-6" fill="none" stroke="#6cb33f" stroke-width="4.5" stroke-linecap="round"/>
                </svg>
            </span>
            <div>
                <strong class="ws__name">Isa</strong>
                <span class="ws__tag">ISACA Chapter Support</span>
            </div>
        </div>
        <div class="ws__barRight">
            <a class="ws__ghost" href="https://library.isaca.org" target="_blank" rel="noopener">Online Library</a>
            <a class="ws__primary" href="/knowledge-base">Knowledge base</a>
            <a class="ws__primary ws__primary--soft" href="/sign-in" data-enhance-nav="false">Account</a>
        </div>
    </header>

    <section class="ws__hero">
        <div class="ws__heroInner">
            <p class="ws__eyebrow">ISACA chapter workspace</p>
            <h1>Everything your chapter needs in one place</h1>
            <p class="ws__lede">Search tools, check live weather, see upcoming holidays, and open official ISACA resources.</p>

            <div class="ws__searchWrap">
                <input class="ws__search"
                       type="search"
                       placeholder="Search pages, tools, resources…"
                       @bind="Query"
                       @bind:event="oninput"
                       aria-label="Search workspace" />
                @if (!string.IsNullOrWhiteSpace(Query))
                {
                    <button type="button" class="ws__searchClear" @onclick="ClearSearch">Clear</button>
                }
            </div>
        </div>
    </section>

    <section class="ws__body">
        @* Live weather + calendar + clock *@
        <div class="ws__live">
            <article class="card card--weather">
                <p class="card__label">Live weather · Kansas City</p>
                <div class="card__row">
                    <span class="card__icon" aria-hidden="true">@WeatherIcon</span>
                    <div>
                        <p class="card__big">@WeatherTemp</p>
                        <p class="card__sub">@WeatherCondition</p>
                    </div>
                </div>
                <p class="card__meta">Open-Meteo · updates on load</p>
            </article>

            <article class="card card--time">
                <p class="card__label">Local time</p>
                <p class="card__big card__big--mono">@LiveTime</p>
                <p class="card__sub">@LiveDate</p>
            </article>

            <article class="card card--cal">
                <p class="card__label">Upcoming US holidays</p>
                @if (Holidays.Count == 0)
                {
                    <p class="card__sub">Loading calendar…</p>
                }
                else
                {
                    <ul class="cal-list">
                        @foreach (var h in Holidays.Take(4))
                        {
                            <li>
                                <span class="cal-list__date">@h.DateLabel</span>
                                <span class="cal-list__name">@h.Name</span>
                            </li>
                        }
                    </ul>
                }
                <a class="card__link" href="https://the-calendar.net/api/" target="_blank" rel="noopener">Calendar data ↗</a>
            </article>
        </div>

        @* Filtered tools *@
        <div class="ws__sectionHead">
            <h2>Workspace tools</h2>
            <p>@(FilteredTools.Count) available@(string.IsNullOrWhiteSpace(Query) ? "" : " matching your search")</p>
        </div>

        <div class="tool-grid">
            @foreach (var t in FilteredTools)
            {
                if (t.External)
                {
                    <a class="tool" href="@t.Href" target="_blank" rel="noopener">
                        <span class="tool__badge">@t.Badge</span>
                        <strong>@t.Title</strong>
                        <span>@t.Desc</span>
                        <span class="tool__go">Open ↗</span>
                    </a>
                }
                else
                {
                    <a class="tool" href="@t.Href">
                        <span class="tool__badge">@t.Badge</span>
                        <strong>@t.Title</strong>
                        <span>@t.Desc</span>
                        <span class="tool__go">Open →</span>
                    </a>
                }
            }
            @if (FilteredTools.Count == 0)
            {
                <p class="ws__empty">No tools match “@Query”. Try “events”, “library”, or “weather”.</p>
            }
        </div>

        @* Official ISACA resources *@
        <div class="ws__sectionHead">
            <h2>Official ISACA resources</h2>
            <p>Free and member resources outside this prototype</p>
        </div>
        <div class="res-grid">
            <a class="res" href="https://library.isaca.org" target="_blank" rel="noopener">
                <strong>ISACA Online Library</strong>
                <span>Search approved guidance and publications</span>
            </a>
            <a class="res" href="https://www.isaca.org/membership/maximize-your-membership/free-resources" target="_blank" rel="noopener">
                <strong>Free ISACA resources</strong>
                <span>Maximize membership · free materials</span>
            </a>
            <a class="res" href="https://www.isaca.org/credentialing" target="_blank" rel="noopener">
                <strong>Certifications</strong>
                <span>CISA, CISM, CRISC, CGEIT and more</span>
            </a>
            <a class="res" href="https://www.isaca.org/chapters" target="_blank" rel="noopener">
                <strong>Find a chapter</strong>
                <span>Chapter directory and contacts</span>
            </a>
        </div>
    </section>

    <footer class="ws__foot">
        Isa is a prototype for ISACA chapter support. Not an official ISACA website.
        Weather via <a href="https://open-meteo.com" target="_blank" rel="noopener">Open-Meteo</a> ·
        Holidays via <a href="https://the-calendar.net/api/" target="_blank" rel="noopener">the-calendar.net</a>
    </footer>
</div>

@code {
    private string Query { get; set; } = "";
    private string LiveTime { get; set; } = "--:--:--";
    private string LiveDate { get; set; } = "";
    private string WeatherTemp { get; set; } = "--°";
    private string WeatherCondition { get; set; } = "Loading…";
    private string WeatherIcon { get; set; } = "☁";
    private List<HolidayItem> Holidays { get; set; } = new();
    private System.Threading.Timer? _clock;

    private static readonly List<ToolItem> AllTools = new()
    {
        new("Home / Isa Assistant", "Workspace home and chat", "/","Home", false),
        new("Knowledge base", "Approved guidance with sources", "/knowledge-base","KB", false),
        new("Analytics", "Activity and service metrics", "/analytics","Data", false),
        new("Events & calendar", "Plan sessions and follow-ups", "/events","Events", false),
        new("Escalations & tickets", "Hand-offs needing human support", "/escalations","Tickets", false),
        new("Governance & policies", "Board and policy resources", "/governance","Gov", false),
        new("Translator", "Translate chapter communications", "/translator","Lang", false),
        new("Content health", "Coverage and quality indicators", "/content-health","Health", false),
        new("Developer dashboard", "Build and service status", "/developer","Dev", false),
        new("Pipeline monitor", "Trace answer processing stages", "/pipeline","Pipe", false),
        new("ISACA Online Library", "Official library search", "https://library.isaca.org","Library", true),
        new("Free ISACA resources", "Member free materials", "https://www.isaca.org/membership/maximize-your-membership/free-resources","Free", true),
        new("Live weather", "Kansas City conditions (this page)", "#","Weather", false),
        new("US holidays", "Federal holiday calendar (this page)", "#","Calendar", false),
    };

    private IReadOnlyList<ToolItem> FilteredTools
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Query)) return AllTools;
            var q = Query.Trim();
            return AllTools
                .Where(t => t.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || t.Desc.Contains(q, StringComparison.OrdinalIgnoreCase)
                         || t.Badge.Contains(q, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Tick();
        _clock = new System.Threading.Timer(_ =>
        {
            Tick();
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        await Task.WhenAll(LoadWeatherAsync(), LoadHolidaysAsync());
    }

    private void Tick()
    {
        var n = DateTime.Now;
        LiveTime = n.ToString("hh:mm:ss tt");
        LiveDate = n.ToString("dddd, MMMM d, yyyy");
    }

    private void ClearSearch() => Query = "";

    private async Task LoadWeatherAsync()
    {
        try
        {
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var url = "https://api.open-meteo.com/v1/forecast?latitude=39.0997&longitude=-94.5786&current=temperature_2m,weather_code&temperature_unit=fahrenheit&timezone=auto";
            var json = await http.GetStringAsync(url);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var cur = doc.RootElement.GetProperty("current");
            WeatherTemp = $"{cur.GetProperty("temperature_2m").GetDouble():0}°F";
            (WeatherCondition, WeatherIcon) = CodeToWeather(cur.GetProperty("weather_code").GetInt32());
        }
        catch
        {
            WeatherTemp = "—";
            WeatherCondition = "Unavailable";
            WeatherIcon = "☁";
        }
    }

    private async Task LoadHolidaysAsync()
    {
        try
        {
            using var http = new HttpClient { Timeout = TimeSpan.FromSeconds(8) };
            var year = DateTime.Now.Year;
            var url = $"https://the-calendar.net/api/holidays/us-federal/{year}.json";
            var json = await http.GetStringAsync(url);
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var today = DateTime.Today;
            var list = new List<HolidayItem>();
            foreach (var h in doc.RootElement.GetProperty("holidays").EnumerateArray())
            {
                var dateStr = h.GetProperty("date").GetString() ?? "";
                if (!DateTime.TryParse(dateStr, out var d) || d < today) continue;
                list.Add(new HolidayItem(
                    h.GetProperty("name").GetString() ?? "Holiday",
                    d.ToString("MMM d")));
            }
            Holidays = list.OrderBy(x => x.DateLabel).Take(6).ToList();
        }
        catch
        {
            Holidays = new List<HolidayItem>
            {
                new("New Year's Day", "Jan 1"),
                new("Martin Luther King Jr. Day", "Jan 19"),
                new("Presidents' Day", "Feb 16"),
                new("Memorial Day", "May 25"),
            };
        }
    }

    private static (string, string) CodeToWeather(int code) => code switch
    {
        0 => ("Clear sky", "☀"),
        1 or 2 => ("Partly cloudy", "🌤"),
        3 => ("Overcast", "☁"),
        45 or 48 => ("Foggy", "🌫"),
        51 or 53 or 55 => ("Drizzle", "🌦"),
        61 or 63 or 65 => ("Rain", "🌧"),
        71 or 73 or 75 => ("Snow", "❄"),
        80 or 81 or 82 => ("Showers", "🌧"),
        95 or 96 or 99 => ("Thunderstorm", "⛈"),
        _ => ("Fair", "🌤")
    };

    public void Dispose() => _clock?.Dispose();

    private sealed record ToolItem(string Title, string Desc, string Href, string Badge, bool External);
    private sealed record HolidayItem(string Name, string DateLabel);
}
