@page "/"
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Isa | Chapter Support Assistant</PageTitle>

<style>
.eh{--navy:#1d2d5c;--blue:#00a4e4;--green:#6cb33f;--mid:#07649d;--teal:#36ac91;--light:#e7f0f5;--muted:#5f6b85;font-family:"Roboto",system-ui,sans-serif;color:var(--navy);width:100%;margin:0;padding:0}
.eh a{text-decoration:none!important}
.eh-inner{max-width:1280px;margin:0 auto;padding:0 1rem}
.eh-top{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:.75rem;padding-top:.15rem}
.eh-brand{display:flex;align-items:center;gap:.65rem}
.eh-logo{width:40px;height:40px;border-radius:12px;background:#fff;border:2px solid var(--green);color:var(--green);display:grid;place-items:center;font-weight:800;font-size:1.2rem}
.eh-brand strong{display:block;font-size:1.1rem;line-height:1.1}
.eh-brand small{color:var(--muted);font-size:.68rem}
.eh-actions{display:flex;align-items:center;gap:.5rem;position:relative}
.eh-link{color:var(--mid);font-weight:600;font-size:.9rem;padding:.45rem .8rem;border-radius:10px}
.eh-link:hover{background:var(--light)}
.eh-account-btn{border:none;cursor:pointer;font-family:inherit;background:linear-gradient(135deg,var(--navy),var(--mid));color:#fff!important;font-weight:600;font-size:.9rem;padding:.5rem 1rem;border-radius:10px}
.eh-account-panel{position:absolute;top:calc(100% + .4rem);right:0;width:240px;background:#fff;border:1px solid #e2e8f0;border-radius:14px;box-shadow:0 16px 40px rgba(29,45,92,.16);padding:.45rem;z-index:50}
.eh-account-panel a{display:block;padding:.55rem .75rem;border-radius:9px;color:var(--navy)!important;font-weight:500;font-size:.88rem}
.eh-account-panel a:hover{background:var(--light)}
.eh-account-panel .sep{height:1px;background:#e2e8f0;margin:.3rem 0}
.eh-strip{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;margin-bottom:.75rem}
.eh-widget{border-radius:14px;padding:.9rem 1.1rem;color:#fff;min-height:84px;display:flex;flex-direction:column;gap:.12rem}
.eh-widget--clock{background:linear-gradient(135deg,#1d2d5c,#07649d,#00a4e4)}
.eh-widget--weather{background:linear-gradient(135deg,#36ac91,#00a4e4,#6cb33f)}
.eh-widget__label{font-size:.65rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;opacity:.88}
.eh-widget__value{font-size:1.5rem;font-weight:300;font-family:"Roboto Slab",Georgia,serif}
.eh-widget__meta{font-size:.8rem;opacity:.9}
.eh-slides{position:relative;width:100%;overflow:hidden;aspect-ratio:21/8;min-height:260px;max-height:400px;background:#0b1220;margin:0}
.eh-slide{position:absolute;inset:0;opacity:0;transition:opacity .55s ease;background-size:cover;background-position:center}
.eh-slide.on{opacity:1}
.eh-slide__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(21,36,71,.72),rgba(21,36,71,.15) 55%,transparent)}
.eh-slide__copy{position:absolute;left:1.5rem;bottom:1.35rem;right:1.5rem;color:#fff;max-width:480px}
.eh-slide__copy h2{margin:0 0 .3rem;font-family:"Roboto Slab",Georgia,serif;font-weight:300;font-size:clamp(1.15rem,2.4vw,1.55rem)}
.eh-slide__copy p{margin:0;font-size:.9rem;opacity:.93}
.eh-dots{position:absolute;bottom:.85rem;right:1.1rem;display:flex;gap:.35rem;z-index:2}
.eh-dots button{width:9px;height:9px;border-radius:50%;border:none;background:rgba(255,255,255,.4);cursor:pointer;padding:0}
.eh-dots button.on{background:#fff;width:22px;border-radius:999px}
.eh-nav-btn{position:absolute;top:50%;transform:translateY(-50%);z-index:2;width:40px;height:40px;border-radius:50%;border:none;background:rgba(255,255,255,.92);color:var(--navy);font-size:1.1rem;cursor:pointer}
.eh-nav-btn.prev{left:.85rem}.eh-nav-btn.next{right:.85rem}
.eh-video{width:100%;overflow:hidden;background:#0b1220;aspect-ratio:16/9;max-height:520px;margin:0;line-height:0;display:block}
.eh-video iframe{width:100%;height:100%;border:0;display:block}
@@media(max-width:700px){.eh-strip{grid-template-columns:1fr}.eh-slides{aspect-ratio:16/10;min-height:200px}}
</style>

<div class="eh" @onclick="CloseAccount">
    <div class="eh-inner">
        <header class="eh-top">
            <div class="eh-brand">
                <div class="eh-logo">C</div>
                <div><strong>Isa</strong><small>ISACA Chapter Support</small></div>
            </div>
            <div class="eh-actions">
                <a class="eh-link" href="https://openlibrary.org" target="_blank" rel="noopener">Online Library</a>
                <button type="button" class="eh-account-btn" @onclick="ToggleAccount" @onclick:stopPropagation="true">Account ▾</button>
                @if (accountOpen)
                {
                    <div class="eh-account-panel" @onclick:stopPropagation="true">
                        <a href="settings">Profile &amp; preferences</a>
                        <a href="settings">Notifications</a>
                        <a href="users-settings">Users &amp; roles</a>
                        <a href="isa-config">Isa configuration</a>
                        <div class="sep"></div>
                        <a href="sign-in">Sign out</a>
                    </div>
                }
            </div>
        </header>
        <div class="eh-strip">
            <div class="eh-widget eh-widget--clock">
                <span class="eh-widget__label">Local time</span>
                <span class="eh-widget__value">@timeText</span>
                <span class="eh-widget__meta">@dateText</span>
            </div>
            <div class="eh-widget eh-widget--weather">
                <span class="eh-widget__label">Weather · Kansas City</span>
                <span class="eh-widget__value">@weatherTemp</span>
                <span class="eh-widget__meta">@weatherDesc</span>
            </div>
        </div>
    </div>

    <div class="eh-slides">
        @for (var i = 0; i < Slides.Length; i++)
        {
            var s = ConcurrentSlides[i];
            <div class="eh-slide @(i == slideIndex ? "on" : null)" style="background-image:url('@s.ImageUrl')">
                <div class="eh-slide__shade"></div>
                <div class="eh-slide__copy"><h2>@s.Title</h2><p>@s.Caption</p></div>
            </div>
        }
        <button type="button" class="eh-nav-btn prev" @onclick="Prev">‹</button>
        <button type="button" class="eh-nav-btn next" @onclick="Next">›</button>
        <div class="eh-dots">
            @for (var i = 0; i < Slides.Length; i++)
            {
                var idx = i;
                <button type="button" class="@(idx == slideIndex ? "on" : null)" @onclick="() => Go(idx)"></button>
            }
        </div>
    </div>

    <div class="eh-video">
        <iframe src="https://www.youtube.com/embed/@CurrentVideoId?autoplay=1&mute=1&rel=0&modestbranding=1&playlist=@Playlist"
                title="ISACA video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
</div>

@code {
    private SlideItem[] ConcurrentSlides => Slides;
    private bool accountOpen;
    private string timeText = "--:--", dateText = "", weatherTemp = "72°F", weatherDesc = "Partly cloudy · Chapter local";
    private int slideIndex;
    private System.Threading.Timer? timer, slideTimer;
    private static readonly string[] VideoIds = { "nqxTZWaFhnM","JRAUhgIy8LY","cIxtlh_LuR4","LdRVeCLJO9I","sLZyoqCzKdA","arRQbN68ceE" };
    private string CurrentVideoId = "nqxTZWaFhnM", Playlist = "";
    private static readonly SlideItem[] Slides =
    {
        new("https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1600&q=80","Empower your team today","Advance chapter capability with ISACA training and credentials."),
        new("https://images.unsplash.com/photo-1551434678-e076c223a6922?w=1600&q=80","ISACA is your AI learning partner","Foundational to advanced pathways for digital trust."),
        new("https://images.unsplash.com/photo-1552664730-d307ca884978?w=1600&q=80","Credentialing that opens doors","CISA, CISM, CRISC, CGEIT, CDPSE — globally recognized."),
        new("https://images.unsplash.com/photo-1504384308090-c894fdcc538d?w=1600&q=80","Enterprise performance","CMMI and team solutions for process and cyber maturity."),
        new("https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=1600&q=80","Grow your network","Connect with professionals across chapters worldwide."),
        new("https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?w=1600&q=80","Chapter excellence","Guidance and tools built for local chapter leaders."),
    };
    protected override void OnInitialized()
    {
        CurrentVideoId = VideoIds[Random.Shared.Next(VideoIds.Length)];
        Playlist = string.Join(",", VideoIds);
        Tick(null);
        timer = new System.Threading.Timer(Tick, null, 1000, 1000);
        slideTimer = new System.Threading.Timer(_ => { slideIndex = (slideIndex + 1) % Slides.Length; _ = InvokeAsync(StateHasChanged); }, null, 5000, 5000);
    }
    private void Tick(object? _) { var n = DateTime.Now; timeText = n.ToString("h:mm:ss tt"); dateText = n.ToString("dddd, MMM d yyyy"); _ = InvokeAsync(StateHasChanged); }
    private void ToggleAccount() => accountOpen = !accountOpen;
    private void CloseAccount() => accountOpen = false;
    private void Next() => slideIndex = (slideIndex + 1) % Slides.Length;
    private void Prev() => slideIndex = (slideIndex - 1 + Slides.Length) % Slides.Length;
    private void Go(int i) => slideIndex = i;
    public void Dispose() { timer?.Dispose(); slideTimer?.Dispose(); }
    private sealed record SlideItem(string ImageUrl, string Title, string Caption);
}
