@page "/pipeline-monitor"
@rendermode InteractiveServer
@using IsaChatApp.Services
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Navigation
<PageTitle>Pipeline Monitor | Isa</PageTitle>

<section class="isa-page pipeline-monitor">
    <div class="isa-page-heading">
        <div>
            <p class="isa-eyebrow">PIPELINE BUILT · DEVELOPER TOOLS</p>
            <h1>Pipeline Monitor</h1>
            <p class="isa-intro">Inspect the backend stage trail for one request using its trace ID.</p>
        </div>
    </div>

    <div class="isa-notice">
        Developer view: event data includes stage names and technical reasons. Do not share traces that contain sensitive operational details.
    </div>

    <article class="isa-panel pipeline-search">
        <label class="isa-field" for="trace-id">Trace ID</label>
        <div class="pipeline-search-row">
            <input id="trace-id" class="form-control" @bind="TraceId" placeholder="Paste the traceId returned by /api/ask" />
            <button class="isa-btn isa-btn--primary" @onclick="LoadTraceAsync" disabled="@Loading">@(Loading ? "Loading…" : "Load trace")</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <p class="pipeline-error" role="alert">@ErrorMessage</p>
        }
    </article>

    <article class="isa-panel">
        <div class="isa-panel-heading">
            <div><h2>Stage event trail</h2><p>@Rows.Count event(s) found</p></div>
            @if (Rows.Count > 0)
            {
                <span class="isa-pill">@Rows.Last().Timestamp</span>
            }
        </div>
        @if (Rows.Count == 0)
        {
            <div class="isa-empty">Enter a trace ID and select “Load trace” to view the stages that ran.</div>
        }
        else
        {
            <div class="pipeline-stage-list">
                @foreach (var row in Rows)
                {
                    var result = GetValue(row.Data, "result") ?? "recorded";
                    <div class="pipeline-stage-row">
                        <div class="pipeline-stage-marker @result.ToLowerInvariant()">@(result == "pass" ? "✓" : result == "stop" ? "×" : result == "escalate" ? "!" : "•")</div>
                        <div class="pipeline-stage-body">
                            <div class="pipeline-stage-title"><strong>@row.Stage</strong><span class="pipeline-status">@result</span></div>
                            <p>@row.Data</p>
                            <small>@row.Timestamp</small>
                        </div>
                    </div>
                }
            </div>
        }
    </article>

    <article class="isa-panel">
        <div class="isa-panel-heading"><div><h2>Pipeline order</h2><p>Expected stage sequence for Pipeline Built</p></div></div>
        <ol class="pipeline-order">
            <li>front_end <small>orchestrator records request arrival</small></li>
            <li>access_control <small>validate identity and role</small></li>
            <li>translation <small>skip when the question is English</small></li>
            <li>input_compliance <small>stop or escalate unsafe/out-of-scope requests</small></li>
            <li>database_search <small>approved full-text search</small></li>
            <li>knowledge_graph <small>currently a stub</small></li>
            <li>rag <small>retrieval/context stub</small></li>
            <li>complex_ai <small>phi4-mini via Ollama on a miss with approved passages</small></li>
            <li>output_compliance <small>check answer and source before returning</small></li>
            <li>ticketing <small>only after escalation</small></li>
        </ol>
    </article>
</section>

@code {
    private string TraceId = "";
    private bool Loading;
    private string? ErrorMessage;
    private List<EventRow> Rows = new();

    private async Task LoadTraceAsync()
    {
        ErrorMessage = null;
        Rows.Clear();
        if (string.IsNullOrWhiteSpace(TraceId))
        {
            ErrorMessage = "Enter a trace ID first.";
            return;
        }

        Loading = true;
        try
        {
            var client = HttpFactory.CreateClient();
            var result = await client.GetFromJsonAsync<List<EventRow>>(
                new Uri(new Uri(Navigation.BaseUri), $"api/events/{Uri.EscapeDataString(TraceId.Trim())}"));
            Rows = result ?? new List<EventRow>();
            if (Rows.Count == 0) ErrorMessage = "No events found for this trace ID yet.";
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Could not load events: {ex.Message}";
        }
        finally
        {
            Loading = false;
        }
    }

    private static string? GetValue(string data, string key)
    {
        foreach (var part in (data ?? "").Split(';'))
        {
            var pair = part.Trim().Split('=', 2);
            if (pair.Length == 2 && pair[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return pair[1].Trim();
        }
        return null;
    }
}
