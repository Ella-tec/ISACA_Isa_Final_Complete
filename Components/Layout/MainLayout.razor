@inherits LayoutComponentBase
@inject NavigationManager Navigation

<style>
html, body {
  margin: 0 !important;
  padding: 0 !important;
  height: 100% !important;
  background: #f0f4f8 !important;
}
body { overflow-x: clip !important; }

.sidebar {
  position: fixed !important;
  left: 0 !important; top: 0 !important; bottom: 0 !important;
  width: 260px !important; min-width: 260px !important; max-width: 260px !important;
  height: 100vh !important;
  overflow-y: auto !important; overflow-x: hidden !important;
  z-index: 100 !important;
  margin: 0 !important; padding: 0 !important; border: none !important;
  background: linear-gradient(175deg, #0a1224 0%, #1d2d5c 48%, #12233f 100%) !important;
  display: block !important;
  align-content: start !important;
}

.main {
  margin-left: 260px !important;
  width: calc(100% - 260px) !important;
  max-width: none !important;
  min-height: 100vh !important;
  display: flex !important;
  flex-direction: column !important;
  margin-top: 0 !important; margin-right: 0 !important; margin-bottom: 0 !important;
  padding: 0 !important;
  background: #f0f4f8 !important;
  box-sizing: border-box !important;
}

.page {
  display: block !important;
  width: 100% !important;
  margin: 0 !important; padding: 0 !important;
  min-height: 0 !important;
  background: transparent !important;
  overflow: visible !important;
}

.top-row { display: none !important; }

.content, article.content {
  flex: 1 1 auto !important;
  padding: 0 !important; margin: 0 !important;
  max-width: none !important; width: 100% !important;
  box-sizing: border-box !important;
  min-height: 0 !important;
  display: flex !important; flex-direction: column !important;
  overflow: auto !important;
}

.hm, .mt, .isa-page, .gov, .esc, .tr, .ch, .kb, .ev, .dev, .pipe,
.contact-page, .an, .settings-page, .translator-page, .market-page,
.page-root, .page-content, .dashboard, .card-grid,
.container, .container-fluid, .ct {
  max-width: none !important; width: 100% !important;
  margin-left: 0 !important; margin-right: 0 !important;
  padding-left: 0.65rem !important; padding-right: 0.65rem !important;
  box-sizing: border-box !important;
}

/* TRU ASK global floating */
.isa-widget {
  position: relative !important;
  z-index: 2147483000 !important;
  --isa-rail-w: 0px;
}
.isa-widget__backdrop {
  position: fixed !important;
  inset: 0 !important;
  background: rgba(29, 45, 92, 0.25) !important;
  z-index: 2147483000 !important;
}
.isa-widget__bubble {
  position: fixed !important;
  bottom: 24px !important;
  right: 24px !important;
  width: 64px !important;
  height: 64px !important;
  border: none !important;
  border-radius: 50% !important;
  background: transparent !important;
  cursor: pointer !important;
  display: grid !important;
  place-items: center !important;
  padding: 0 !important;
  box-shadow: none !important;
  z-index: 2147483001 !important;
}
.isa-widget__panel.is-expanded {
  position: fixed !important;
  top: auto !important;
  bottom: 24px !important;
  right: 24px !important;
  width: min(380px, calc(100vw - 2rem)) !important;
  height: min(560px, calc(100vh - 3rem)) !important;
  max-height: calc(100vh - 3rem) !important;
  display: flex !important;
  flex-direction: column !important;
  background: #fff !important;
  border-radius: 16px !important;
  border: 1px solid #cbd2d9 !important;
  box-shadow: 0 12px 40px rgba(0,0,0,0.22) !important;
  overflow: hidden !important;
  z-index: 2147483001 !important;
  font-family: Roboto, Arial, sans-serif !important;
}

#blazor-error-ui {
  display: none;
  position: fixed;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  background: #1d2d5c;
  color: #fff;
  padding: 0.7rem 1.1rem;
  border-radius: 12px;
  z-index: 9999;
}

@@media (max-width: 900px) {
  .sidebar {
    position: relative !important;
    width: 100% !important; max-width: none !important;
    height: auto !important; max-height: 42vh !important;
  }
  .main { margin-left: 0 !important; width: 100% !important; }
  .isa-widget__panel.is-expanded {
    width: calc(100vw - 1rem) !important;
    right: 0.5rem !important;
    bottom: 0.5rem !important;
    height: min(85vh, calc(100vh - 1rem)) !important;
  }
}
</style>

@* ========== TRU ASK — global floating widget on every page ========== *@
<ChatWidget @rendermode="InteractiveServer"
            Hosts="@(new Dictionary<string,string> {
                ["remote"] = "http://100.89.6.69:11434",
                ["local"]  = "http://localhost:11434"
            })" />

<div class="page">
    <aside class="sidebar"><NavMenu /></aside>
    <div class="main">
        <article class="content">@Body</article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred. You can reload the page to continue.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">✕</span>
</div>
