@inherits LayoutComponentBase
@inject NavigationManager Navigation

<style>
html, body {
  margin: 0 !important;
  padding: 0 !important;
  height: 100% !important;
  background: #eef2f7 !important;
}
body {
  min-height: 100vh;
  min-height: 100dvh;
  overflow-x: clip !important;
}

/* Hide any residual Blazor/bootstrap top brand bars */
.top-row,
.page > .top-row,
header.top-row,
.navbar,
.navbar-brand,
.sidebar > .top-row,
.sidebar > header:not(.nv),
.sidebar > .brand,
.sidebar > a.navbar-brand {
  display: none !important;
  height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  overflow: hidden !important;
  visibility: hidden !important;
}

.sidebar {
  position: fixed !important;
  left: 0 !important; top: 0 !important; bottom: 0 !important;
  width: 252px !important; min-width: 252px !important; max-width: 252px !important;
  height: 100vh !important; height: 100dvh !important;
  display: flex !important; flex-direction: column !important;
  overflow: hidden !important;
  z-index: 100 !important;
  margin: 0 !important; padding: 0 !important; border: none !important;
  background: linear-gradient(175deg, #0a1224 0%, #1d2d5c 48%, #12233f 100%) !important;
}
.sidebar > .nv,
.sidebar > nav {
  flex: 1 1 auto !important;
  min-height: 0 !important;
  height: 100% !important;
  width: 100% !important;
}

.page {
  display: block !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
}

.main {
  position: relative !important;
  margin-left: 252px !important;
  width: calc(100% - 252px) !important;
  max-width: none !important;
  min-height: 100vh !important;
  min-height: 100dvh !important;
  display: flex !important;
  flex-direction: column !important;
  margin-top: 0 !important; margin-right: 0 !important; margin-bottom: 0 !important;
  padding: 0 !important;
  background: #eef2f7 !important;
  box-sizing: border-box !important;
}

.content, article.content {
  display: flex !important;
  flex-direction: column !important;
  flex: 1 1 auto !important;
  padding: 0 !important;
  margin: 0 !important;
  max-width: none !important;
  width: 100% !important;
  box-sizing: border-box !important;
  min-height: 0 !important;
}

.hm, .mt, .es, .tr, .gov, .kb, .an, .ev, .ch, .wx, .rl, .pipe, .dev, .pg, .st, .dd,
.isa-page, .settings-page, .translator-page, .market-page, .page-root, .ct {
  flex: 1 1 auto !important;
  display: flex !important;
  flex-direction: column !important;
  width: 100% !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 10px !important;
  box-sizing: border-box !important;
  gap: 10px !important;
  min-height: calc(100vh - 20px) !important;
  min-height: calc(100dvh - 20px) !important;
}

.ev-grid, .es-grid, .st-body, .wx-now, .pg-grid, .kb-grid,
.an-grid, .gov-grid, .mt-grid, .rl-main, .rl-body, .rl-stage, .dd-grid, .ch-grid, .tr-main,
.tr-grid, .hm-vid, .wx-bottom, .pipe-grid {
  flex: 1 1 auto !important;
  min-height: 0 !important;
}

.ct { padding: 10px 10px 0 !important; }
.ct > .sf,
.ct > footer.sf {
  margin-top: auto !important;
  margin-bottom: 0 !important;
  flex: 0 0 auto !important;
  border-radius: 14px 14px 0 0 !important;
}

#blazor-error-ui {
  display: none;
  position: fixed;
  bottom: 1rem;
  left: 50%;
  transform: translateX(-50%);
  background: #1d2d5c;
  color: #fff;
  padding: 0.7rem 1.1rem;
  border-radius: 12px;
  z-index: 9999;
}

@@media (max-width: 1100px) {
  .sidebar { width: 236px !important; min-width: 236px !important; max-width: 236px !important; }
  .main { margin-left: 236px !important; width: calc(100% - 236px) !important; }
}
@@media (max-width: 800px) {
  .sidebar {
    position: relative !important; width: 100% !important; min-width: 0 !important; max-width: none !important;
    height: auto !important; max-height: 48vh !important; overflow-y: auto !important;
  }
  .main { margin-left: 0 !important; width: 100% !important; }
  .hm, .mt, .es, .tr, .gov, .kb, .an, .ev, .ch, .wx, .rl, .pipe, .dev, .pg, .st, .dd, .ct {
    min-height: 0 !important;
  }
}
</style>

<ChatWidget @rendermode="InteractiveServer"
            Hosts="@(new Dictionary<string,string> {
                [\"remote\"] = \"http://100.89.6.69:11434\",
                [\"local\"]  = \"http://localhost:11434\"
            })" />

<div class="page">
    <aside class="sidebar"><NavMenu /></aside>
    <div class="main">
        <article class="content">
            @Body
        </article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred. You can reload the page to continue.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">✕</span>
</div>
