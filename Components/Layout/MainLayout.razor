@inherits LayoutComponentBase
@inject NavigationManager Navigation

<style>
html, body {
  margin: 0 !important;
  padding: 0 !important;
  min-height: 100% !important;
  width: 100% !important;
  background: #eef2f7 !important;
}
body { overflow-x: hidden !important; }
.page { min-height: 100dvh; width: 100%; }
.sidebar {
  position: fixed;
  inset: 0 auto 0 0;
  width: 218px;
  min-width: 218px;
  max-width: 218px;
  height: 100dvh;
  overflow-y: auto;
  overflow-x: hidden;
  z-index: 100;
  margin: 0;
  padding: 0;
  background: linear-gradient(175deg,#0a1224 0%,#1d2d5c 48%,#12233f 100%);
  scrollbar-width: thin;
  scrollbar-color: rgba(180,200,225,.35) transparent;
}
.main {
  margin: 0 0 0 218px;
  width: calc(100% - 218px);
  min-width: 0;
  min-height: 100dvh;
  height: auto;
  display: block;
  padding: 0;
  background:
    radial-gradient(1200px 600px at 100% -10%,rgba(0,164,228,.06),transparent 55%),
    radial-gradient(900px 500px at -5% 100%,rgba(54,172,145,.05),transparent 50%),
    #eef2f7;
  box-sizing: border-box;
}
.content, article.content {
  display: block;
  width: 100%;
  max-width: none;
  min-height: 0;
  height: auto;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.mobile-topbar {
  display: none;
}
.isa-widget { position: relative !important; z-index: 2147483000 !important; --isa-rail-w: 0px; }
.isa-widget__backdrop { position: fixed !important; inset: 0 !important; background: rgba(29,45,92,.25) !important; z-index: 2147483000 !important; }
.isa-widget__bubble { position: fixed !important; bottom: 24px !important; right: 24px !important; width: 64px !important; height: 64px !important; border: none !important; border-radius: 50% !important; background: transparent !important; cursor: pointer !important; display: grid !important; place-items: center !important; padding: 0 !important; z-index: 2147483001 !important; }
.isa-widget__panel.is-expanded { position: fixed !important; top: auto !important; bottom: 24px !important; right: 24px !important; width: min(380px,calc(100vw - 2rem)) !important; height: min(560px,calc(100vh - 3rem)) !important; display: flex !important; flex-direction: column !important; background: #fff !important; border-radius: 16px !important; border: 1px solid #cbd2d9 !important; box-shadow: 0 12px 40px rgba(0,0,0,.22) !important; overflow: hidden !important; z-index: 2147483001 !important; }
#blazor-error-ui { display:none; position:fixed; bottom:1rem; left:50%; transform:translateX(-50%); background:#1d2d5c; color:#fff; padding:.7rem 1.1rem; border-radius:12px; z-index:9999; }
@media (max-width: 1100px) {
  .sidebar { width: 230px; min-width: 230px; max-width: 230px; }
  .main { margin-left: 230px; width: calc(100% - 230px); }
}
@media (max-width: 800px) {
  .mobile-topbar {
    display:flex;
    align-items:center;
    gap:.55rem;
    height:42px;
    padding:0 .8rem;
    color:#fff;
    background:#1d2d5c;
    font-weight:700;
    box-sizing:border-box;
  }
  .mobile-topbar .tru-logo { width:22px; height:22px; }
  .sidebar {
    position:relative;
    inset:auto;
    width:100%;
    min-width:0;
    max-width:none;
    height:auto;
    max-height:calc(100dvh - 42px);
    overflow-y:auto;
  }
  .main { margin:0; width:100%; min-height:0; }
  .content, article.content { padding:0; }
  .nv__brand .tru-logo { width:46px; height:46px; }
  .nv__item { font-size:.9rem !important; padding:.52rem .65rem !important; }
  .nv__sec { font-size:.62rem; padding:.55rem .45rem .2rem; }
}
@media (max-width: 560px) {
  .isa-widget__bubble { width:54px !important; height:54px !important; right:14px !important; bottom:14px !important; }
}
</style>

<ChatWidget @rendermode="InteractiveServer"
            Hosts="@(new Dictionary<string,string> {
                ["remote"] = "http://100.89.6.69:11434",
                ["local"]  = "http://localhost:11434"
            })" />

<div class="mobile-topbar"><TruLogo /> <span>TRU</span></div>
<div class="page">
    <aside class="sidebar"><NavMenu /></aside>
    <div class="main">
        <article class="content">
            @Body
        </article>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred. You can reload the page to continue.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">✕</span>
</div>
