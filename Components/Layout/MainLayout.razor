@inherits LayoutComponentBase
@inject NavigationManager Navigation

@if (!IsEmbedded)
{
    <ChatWidget @rendermode="InteractiveServer"
                Hosts="@(new Dictionary<string,string> {
                    ["remote"] = "http://100.89.6.69:11434",
                    ["local"]  = "http://localhost:11434"
                })" />
}

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main class="main">
        <header class="top-row">
            <div class="top-row__context">
                <span class="top-row__eyebrow">ISACA CHAPTER SUPPORT</span>
                <span class="top-row__title">Isa workspace</span>
            </div>
            <nav class="top-row__actions" aria-label="Utility navigation">
                <a class="top-row__link" href="/" data-enhance-nav="false">Home</a>
                <a class="top-row__link top-row__link--primary" href="/sign-in" data-enhance-nav="false">Account</a>
            </nav>
        </header>

        <article class="content">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred. You can reload the page to continue.
    <a href="." class="reload">Reload</a>
    <span class="dismiss" aria-label="Dismiss">✕</span>
</div>

@code {
    private bool IsEmbedded => new Uri(Navigation.Uri).Query.Contains("embed=1");
}
