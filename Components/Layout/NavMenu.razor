@rendermode InteractiveServer

<style>
.nv {
  --isa-green: #79c653;
  --isa-mint: #b7f0ce;
  box-sizing: border-box;
  width: 100%; height: 100%; min-height: 100%;
  display: flex; flex-direction: column;
  padding: .8rem .7rem .75rem; margin: 0;
  color: #e8f3ed;
  font-family: "DM Sans", system-ui, sans-serif;
}
.nv a { text-decoration: none !important; color: inherit; max-width: 100%; display: flex !important; }
.nv__brand {
  flex: 0 0 auto; display: flex; align-items: center; gap: .75rem;
  padding: .35rem .45rem 1rem; margin-bottom: .45rem;
  border-bottom: 1px solid rgba(220,255,235,.12);
}
.nv__brand .tru-logo {
  width: 44px; height: 44px; flex-shrink: 0;
  filter: drop-shadow(0 5px 14px rgba(121,198,83,.28));
}
.nv__brand small {
  display: block; font-size: .62rem; font-weight: 700; opacity: .85;
  letter-spacing: .12em; text-transform: uppercase; color: #e8f3ed;
  line-height: 1.3; max-width: 9.5rem;
}
.nv__body { flex: 1 1 auto; min-height: 0; overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; padding: .15rem .05rem; }
.nv__body::-webkit-scrollbar { width: 4px; }
.nv__body::-webkit-scrollbar-thumb { background: rgba(190,230,205,.22); border-radius: 99px; }
.nv__foot { flex: 0 0 auto; margin-top: auto; padding-top: .65rem; border-top: 1px solid rgba(220,255,235,.12); }
.nv__sec {
  display: block; font-size: .58rem; font-weight: 800; letter-spacing: .16em;
  text-transform: uppercase; color: rgba(197,224,207,.52); padding: .7rem .65rem .35rem;
}
.nv__item {
  position: relative; display: flex !important; align-items: center; gap: .7rem;
  box-sizing: border-box; width: 100% !important;
  padding: .62rem .72rem !important; margin: .12rem 0 !important;
  border-radius: 12px !important; font-size: .79rem !important; font-weight: 600 !important;
  line-height: 1.25 !important; color: #bdcec4 !important;
  background: transparent !important; border: 1px solid transparent !important;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  transition: background .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
}
.nv__item:hover {
  background: rgba(255,255,255,.065) !important; color: #fff !important;
  transform: translateX(2px);
}
.nv__item.active {
  color: #f5fff7 !important;
  background: linear-gradient(105deg, rgba(121,198,83,.22), rgba(121,198,83,.075)) !important;
  border-color: rgba(151,220,119,.2) !important;
  box-shadow: inset 3px 0 0 var(--isa-green), 0 8px 24px rgba(0,0,0,.12) !important;
}
.nv__planet {
  width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
  background: var(--p, #79c653);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--p, #79c653) 15%, transparent), 0 0 9px color-mix(in srgb, var(--p, #79c653) 45%, transparent);
}
.nv__item.active .nv__planet { background: #b7f0a0; box-shadow: 0 0 0 4px rgba(183,240,160,.12), 0 0 13px rgba(183,240,160,.8); }
.nv__signout {
  display: flex !important; align-items: center; justify-content: center; gap: .5rem;
  margin: .45rem 0 0; padding: .65rem .75rem; border-radius: 12px;
  background: rgba(255,255,255,.045); color: #e3eee7 !important;
  font-weight: 700; font-size: .78rem; border: 1px solid rgba(220,255,235,.12);
  width: 100%; box-sizing: border-box; transition: .2s ease;
}
.nv__signout:hover { background: rgba(121,198,83,.12); border-color: rgba(121,198,83,.35); color: #fff !important; }
.nv__signout::before {
  content: ""; width: 7px; height: 7px; border-radius: 50%;
  background: #8bd46a; box-shadow: 0 0 9px #8bd46a; flex-shrink: 0;
}
@@media (max-width: 800px) {
  .nv { padding: .65rem; }
  .nv__brand { padding-bottom: .7rem; }
  .nv__item { padding: .58rem .65rem !important; }
}
</style>

<nav class="nv" aria-label="TRU workspace">
    <div class="nv__brand">
        <TruLogo />
        <div><small>ISACA chapter support</small></div>
    </div>

    <div class="nv__body">
        <div class="nv__sec">Workspace</div>
        <NavLink class="nv__item" style="--p:#8bd46a" href="" Match="NavLinkMatch.All"><span class="nv__planet"></span> Home / TRU Ask</NavLink>
        <NavLink class="nv__item" style="--p:#62b8e8" href="analytics"><span class="nv__planet"></span> Analytics</NavLink>
        <NavLink class="nv__item" style="--p:#5bd1ad" href="events"><span class="nv__planet"></span> Events &amp; Calendar</NavLink>
        <NavLink class="nv__item" style="--p:#a99cf4" href="knowledge-base"><span class="nv__planet"></span> Knowledge base</NavLink>
        <NavLink class="nv__item" style="--p:#f07178" href="escalations"><span class="nv__planet"></span> Escalations &amp; Tickets</NavLink>
        <NavLink class="nv__item" style="--p:#7aa2f7" href="governance"><span class="nv__planet"></span> Governance &amp; Policies</NavLink>
        <NavLink class="nv__item" style="--p:#4ecdc4" href="translator"><span class="nv__planet"></span> Translator</NavLink>
        <NavLink class="nv__item" style="--p:#95d475" href="content-health"><span class="nv__planet"></span> Content health</NavLink>
        <NavLink class="nv__item" style="--p:#e0af68" href="market-trends"><span class="nv__planet"></span> Market trends</NavLink>
        <NavLink class="nv__item" style="--p:#7dcfff" href="resource-library"><span class="nv__planet"></span> Resource library</NavLink>
        <NavLink class="nv__item" style="--p:#ff9e64" href="weather"><span class="nv__planet"></span> Weather</NavLink>

        <div class="nv__sec">Developer</div>
        <NavLink class="nv__item" style="--p:#9ece6a" href="dev"><span class="nv__planet"></span> Developer dashboard</NavLink>
        <NavLink class="nv__item" style="--p:#7aa2f7" href="pipeline"><span class="nv__planet"></span> Pipeline monitor</NavLink>

        <div class="nv__sec">Account</div>
        <NavLink class="nv__item" style="--p:#bb9af7" href="contact"><span class="nv__planet"></span> Contact</NavLink>
        <NavLink class="nv__item" style="--p:#89b4fa" href="settings"><span class="nv__planet"></span> Settings</NavLink>
    </div>

    <div class="nv__foot">
        <form method="post" action="/account/logout">
            <button type="submit" class="nv__signout">Sign out</button>
        </form>
    </div>
</nav>
