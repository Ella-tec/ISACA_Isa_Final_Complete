@rendermode InteractiveServer

<style>
.nav {
  --navy:#1d2d5c; --blue:#00a4e4; --green:#6cb33f; --mid:#07649d;
  display:flex; flex-direction:column; height:100%;
  background:linear-gradient(180deg,#152447 0%, #1d2d5c 40%, #1a3358 100%);
  color:#e8eef6; padding:1rem .85rem 1.1rem; box-sizing:border-box;
  font-family:"Roboto",system-ui,sans-serif;
}
.nav a { text-decoration:none !important; color:inherit; }
.nav__brand { display:flex; align-items:center; gap:.65rem; padding:.35rem .4rem 1rem; }
.nav__logo {
  width:40px; height:40px; border-radius:12px; background:#fff;
  border:2px solid var(--green); color:var(--green);
  display:grid; place-items:center; font-weight:800; font-size:1.2rem; flex-shrink:0;
}
.nav__brand strong { display:block; font-size:1.05rem; line-height:1.15; }
.nav__brand small { font-size:.65rem; opacity:.75; }
.nav__sec {
  font-size:.62rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  opacity:.55; padding:.75rem .55rem .35rem;
}
.nav__item {
  display:flex; align-items:center; gap:.55rem;
  padding:.55rem .7rem; border-radius:10px; margin:.12rem 0;
  font-size:.9rem; font-weight:500; color:#d7e2f0 !important;
  transition:background .15s, color .15s;
}
.nav__item:hover { background:rgba(255,255,255,.08); color:#fff !important; }
.nav__item.active {
  background:linear-gradient(135deg, rgba(0,164,228,.35), rgba(7,100,157,.55));
  color:#fff !important; box-shadow:inset 0 0 0 1px rgba(0,164,228,.35);
}
.nav__ico { width:1.15rem; text-align:center; opacity:.9; flex-shrink:0; }
.nav__spacer { flex:1 1 auto; }
.nav__signout {
  display:flex; align-items:center; gap:.55rem; margin-top:.5rem;
  padding:.6rem .85rem; border-radius:12px;
  background:#0b1220; color:#fff !important; font-weight:600; font-size:.9rem;
  border:none; cursor:pointer; width:100%; font-family:inherit;
  box-shadow:inset 4px 0 0 var(--green);
}
.nav__signout:hover { filter:brightness(1.08); }
.nav__settings {
  display:flex; align-items:center; gap:.55rem;
  padding:.5rem .7rem; margin-top:.35rem; border-radius:10px;
  font-size:.88rem; color:#c5d2e4 !important;
}
.nav__settings:hover { background:rgba(255,255,255,.08); color:#fff !important; }
</style>

<nav class="nav" aria-label="Isa workspace">
    <div class="nav__brand">
        <div class="nav__logo">C</div>
        <div>
            <strong>Isa</strong>
            <small>ISACA Chapter Support</small>
        </div>
    </div>

    <div class="nav__sec">Workspace</div>
    <NavLink class="nav__item" href="" Match="NavLinkMatch.All"><span class="nav__ico">⌂</span> Home / Isa Assistant</NavLink>
    <NavLink class="nav__item" href="analytics"><span class="nav__ico">▦</span> Analytics</NavLink>
    <NavLink class="nav__item" href="events"><span class="nav__ico">▭</span> Events &amp; Calendar</NavLink>
    <NavLink class="nav__item" href="knowledge-base"><span class="nav__ico">☰</span> Knowledge base</NavLink>
    <NavLink class="nav__item" href="escalations"><span class="nav__ico">△</span> Escalations &amp; Tickets</NavLink>
    <NavLink class="nav__item" href="governance"><span class="nav__ico">◈</span> Governance &amp; Policies</NavLink>
    <NavLink class="nav__item" href="translator"><span class="nav__ico">文</span> Translator</NavLink>
    <NavLink class="nav__item" href="content-health"><span class="nav__ico">◎</span> Content health</NavLink>
    <NavLink class="nav__item" href="market-trends"><span class="nav__ico">↗</span> Market trends</NavLink>
    <NavLink class="nav__item" href="resource-library"><span class="nav__ico">▣</span> Open Resource Library</NavLink>

    <div class="nav__sec">Developer</div>
    <NavLink class="nav__item" href="developer-dashboard"><span class="nav__ico">&lt;/&gt;</span> Developer dashboard</NavLink>
    <NavLink class="nav__item" href="pipeline-monitor"><span class="nav__ico">→</span> Pipeline monitor</NavLink>

    <div class="nav__spacer"></div>

    <a class="nav__signout" href="sign-in"><span class="nav__ico">→</span> Sign out</a>
    <NavLink class="nav__settings" href="settings"><span class="nav__ico">⚙</span> Settings</NavLink>
</nav>
