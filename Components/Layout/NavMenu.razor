@* NavMenu *@
<style>
.nav{--navy:#1d2d5c;--blue:#00a4e4;--green:#6cb33f;--mid:#07649d;--teal:#36ac91;--red:#e31837;--orange:#e57524;--yellow:#fbb034;--purple:#6558b1;
height:100%;display:flex;flex-direction:column;background:linear-gradient(180deg,#152447 0%,#1d2d5c 50%,#0f1c3d 100%);color:#fff;font-family:"Roboto",system-ui,sans-serif}
.nav a{text-decoration:none!important;color:inherit}
.nav__brand{padding:1.05rem 1rem .85rem;border-bottom:1px solid rgba(255,255,255,.08)}
.nav__logo{display:flex;align-items:center;gap:.65rem}
.nav__mark{width:40px;height:40px;border-radius:12px;background:#fff;display:grid;place-items:center}
.nav__name{font-weight:700;font-size:1.05rem}.nav__sub{font-size:.68rem;opacity:.75}
.nav__scroll{flex:1;overflow-y:auto;padding:.8rem .65rem}
.nav__section{margin:.5rem .5rem .3rem;font-size:.62rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;opacity:.55}
.nav__list{display:flex;flex-direction:column;gap:.18rem}
.nav__item{display:flex;align-items:center;gap:.6rem;padding:.52rem .7rem;border-radius:10px;font-size:.88rem;font-weight:500;color:rgba(255,255,255,.9)!important}
.nav__item:hover{background:rgba(255,255,255,.1)}
.nav__item.active{background:linear-gradient(135deg,rgba(0,164,228,.4),rgba(54,172,145,.25));box-shadow:inset 3px 0 0 var(--blue)}
.nav__foot{padding:.7rem .7rem 1rem;border-top:1px solid rgba(255,255,255,.08);display:flex;flex-direction:column;gap:.4rem}
.nav__contact{display:flex;align-items:center;justify-content:center;gap:.45rem;width:100%;padding:.62rem 1rem;border-radius:12px;font-weight:700;font-size:.88rem;
background:linear-gradient(135deg,#6558b1,#07649d);color:#fff!important;box-shadow:0 4px 14px rgba(101,88,177,.3)}
.nav__contact:hover{filter:brightness(1.08)}
.nav__signout{display:flex;align-items:center;justify-content:center;width:100%;padding:.68rem 1rem;border-radius:12px;font-weight:700;font-size:.9rem;
background:linear-gradient(135deg,#6cb33f 0%,#36ac91 45%,#00a4e4 100%);color:#0b1a33!important;box-shadow:0 6px 16px rgba(108,179,63,.28)}
.nav__signout:hover{filter:brightness(1.08)}
.nav__settings{display:flex;align-items:center;gap:.45rem;padding:.4rem .65rem;border-radius:10px;font-size:.85rem;color:rgba(255,255,255,.8)!important}
.nav__settings:hover{background:rgba(255,255,255,.08)}
</style>
<div class="nav">
  <div class="nav__brand">
    <a class="nav__logo" href="/" data-enhance-nav="false">
      <span class="nav__mark"><svg viewBox="0 0 48 48" width="26" height="26" fill="none"><path d="M34 24a10 10 0 1 1-10-10" stroke="#6cb33f" stroke-width="7" stroke-linecap="round"/></svg></span>
      <span><span class="nav__name">Isa</span><br/><span class="nav__sub">ISACA Chapter Support</span></span>
    </a>
  </div>
  <div class="nav__scroll">
    <p class="nav__section">Workspace</p>
    <nav class="nav__list">
      <NavLink class="nav__item" href="/" Match="NavLinkMatch.All">Home / Isa Assistant</NavLink>
      <NavLink class="nav__item" href="analytics">Analytics</NavLink>
      <NavLink class="nav__item" href="events">Events &amp; Calendar</NavLink>
      <NavLink class="nav__item" href="knowledge-base">Knowledge base</NavLink>
      <NavLink class="nav__item" href="escalations">Escalations &amp; Tickets</NavLink>
      <NavLink class="nav__item" href="governance">Governance &amp; Policies</NavLink>
      <NavLink class="nav__item" href="translator">Translator</NavLink>
      <NavLink class="nav__item" href="content-health">Content health</NavLink>
      <NavLink class="nav__item" href="market">Market trends</NavLink>
    </nav>
    <p class="nav__section">Developer</p>
    <nav class="nav__list">
      <NavLink class="nav__item" href="developer-dashboard">Developer dashboard</NavLink>
      <NavLink class="nav__item" href="pipeline-monitor">Pipeline monitor</NavLink>
    </nav>
  </div>
  <div class="nav__foot">
    <a class="nav__contact" href="contact">Contact</a>
    <a class="nav__signout" href="sign-in">Sign out</a>
    <NavLink class="nav__settings" href="settings">⚙ Settings</NavLink>
  </div>
</div>
