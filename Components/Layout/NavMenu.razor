@rendermode InteractiveServer

<style>
.nv{
  --navy:#1d2d5c;--blue:#00a4e4;--mid:#07649d;--green:#6cb33f;--teal:#36ac91;
  --orange:#e57524;--red:#e31837;--purple:#6558b1;--yellow:#fbb034;
  box-sizing:border-box;width:100%;max-width:260px;
  height:100%;min-height:100%;
  display:flex;flex-direction:column;justify-content:flex-start;
  padding:.5rem .5rem .55rem;margin:0;
  background:linear-gradient(175deg,#0a1224 0%,#1d2d5c 48%,#12233f 100%);
  color:#e8eef6;font-family:"Roboto",system-ui,sans-serif;
  overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;
}
.nv a{text-decoration:none!important;color:inherit;max-width:100%}
.nv__brand{display:flex;align-items:center;gap:.5rem;padding:.05rem .25rem .55rem;flex-shrink:0}
.nv__logo{
  width:36px;height:36px;border-radius:50%;flex-shrink:0;
  background:linear-gradient(145deg,#6cb33f 0%,#36ac91 42%,#00a4e4 100%);
  border:none;
  display:grid;place-items:center;box-shadow:0 4px 12px rgba(0,164,228,.3);
}
.nv__logo span{color:#fff;font-weight:800;font-size:.65rem;letter-spacing:.08em;font-family:"Roboto Slab",Georgia,serif}
.nv__brand strong{display:block;font-size:.95rem;font-weight:700}
.nv__brand small{font-size:.55rem;opacity:.7}
.nv__sec{
  font-size:.52rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  opacity:.48;padding:.4rem .4rem .12rem;flex-shrink:0;
}
.nv__item{
  position:relative;display:flex!important;align-items:center;gap:.45rem;
  box-sizing:border-box;width:100%!important;max-width:100%!important;
  padding:.32rem .55rem .32rem .55rem!important;margin:.02rem 0!important;
  border-radius:9px!important;font-size:.8rem!important;font-weight:600!important;
  color:#c9d6ea!important;background:transparent!important;
  border:1px solid transparent!important;transition:all .15s ease;flex-shrink:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.nv__item::before{
  content:"";position:absolute;left:0;top:20%;bottom:20%;width:3px;border-radius:0 3px 3px 0;
  background:var(--accent,#00a4e4);opacity:0;transition:opacity .15s,top .15s,bottom .15s;
}
.nv__item:hover{
  background:rgba(255,255,255,.07)!important;color:#fff!important;
  border-color:rgba(255,255,255,.08)!important;transform:translateX(2px);
}
.nv__item:hover::before,.nv__item.active::before{opacity:1;top:12%;bottom:12%}
.nv__item.active{
  background:rgba(255,255,255,.1)!important;color:#fff!important;
  border-color:rgba(255,255,255,.1)!important;
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);
}
.nv__ico{
  width:1.25rem;height:1.25rem;border-radius:6px;display:grid;place-items:center;
  font-size:.68rem;flex-shrink:0;background:var(--accent-bg,rgba(0,164,228,.2));
  color:var(--accent,#00a4e4);font-weight:700;
}
.nv__item.active .nv__ico{background:var(--accent,#00a4e4);color:#fff}
.nv__spacer{display:none!important;height:0!important;min-height:0!important;flex:none!important}

/* Account block pinned to bottom — no empty gap under Sign out */
.nv__foot{
  margin-top:auto;
  flex-shrink:0;
  padding-top:.35rem;
  padding-bottom:.15rem;
}
.nv__signout{
  display:flex;align-items:center;justify-content:center;gap:.35rem;
  margin-top:.25rem;margin-bottom:0;padding:.5rem .7rem;border-radius:10px;flex-shrink:0;
  background:linear-gradient(135deg,#0b1220,#1a3a28);color:#fff!important;
  font-weight:700;font-size:.82rem;border:1px solid rgba(108,179,63,.4);
  box-shadow:0 0 0 1px rgba(108,179,63,.1);
}
.nv__signout:hover{filter:brightness(1.12)}
.nv__signout::before{content:"";width:7px;height:7px;border-radius:50%;background:#6cb33f;box-shadow:0 0 8px #6cb33f}
.nv__settings{
  display:flex;align-items:center;gap:.4rem;padding:.32rem .55rem;margin-top:.1rem;
  border-radius:8px;font-size:.8rem;color:#b0bfd4!important;flex-shrink:0;
}
.nv__settings:hover{background:rgba(255,255,255,.07);color:#fff!important}
</style>

<nav class="nv" aria-label="TRU workspace">
    <div class="nv__brand">
        <div class="nv__logo"><span>TRU</span></div>
        <div><strong>TRU</strong><small>Ask</small></div>
    </div>

    <div class="nv__sec">Workspace</div>
    <NavLink class="nv__item" style="--accent:#00a4e4;--accent-bg:rgba(0,164,228,.18)" href="" Match="NavLinkMatch.All"><span class="nv__ico">⌂</span> Home / TRU Ask</NavLink>
    <NavLink class="nv__item" style="--accent:#07649d;--accent-bg:rgba(7,100,157,.2)" href="analytics"><span class="nv__ico">▦</span> Analytics</NavLink>
    <NavLink class="nv__item" style="--accent:#36ac91;--accent-bg:rgba(54,172,145,.2)" href="events"><span class="nv__ico">▭</span> Events &amp; Calendar</NavLink>
    <NavLink class="nv__item" style="--accent:#6558b1;--accent-bg:rgba(101,88,177,.2)" href="knowledge-base"><span class="nv__ico">☰</span> Knowledge base</NavLink>
    <NavLink class="nv__item" style="--accent:#e31837;--accent-bg:rgba(227,24,55,.18)" href="escalations"><span class="nv__ico">△</span> Escalations &amp; Tickets</NavLink>
    <NavLink class="nv__item" style="--accent:#1d2d5c;--accent-bg:rgba(255,255,255,.12)" href="governance"><span class="nv__ico">◈</span> Governance &amp; Policies</NavLink>
    <NavLink class="nv__item" style="--accent:#00a4e4;--accent-bg:rgba(0,164,228,.18)" href="translator"><span class="nv__ico">文</span> Translator</NavLink>
    <NavLink class="nv__item" style="--accent:#6cb33f;--accent-bg:rgba(108,179,63,.2)" href="content-health"><span class="nv__ico">◎</span> Content health</NavLink>
    <NavLink class="nv__item" style="--accent:#e57524;--accent-bg:rgba(229,117,36,.2)" href="market-trends"><span class="nv__ico">↗</span> Market trends</NavLink>
    <NavLink class="nv__item" style="--accent:#07649d;--accent-bg:rgba(7,100,157,.2)" href="resource-library"><span class="nv__ico">▣</span> Resource Library</NavLink>
    <NavLink class="nv__item" style="--accent:#fbb034;--accent-bg:rgba(251,176,52,.2)" href="weather"><span class="nv__ico">☀</span> Weather</NavLink>

    <div class="nv__sec">Developer</div>
    <NavLink class="nv__item" style="--accent:#36ac91;--accent-bg:rgba(54,172,145,.2)" href="developer-dashboard"><span class="nv__ico">&lt;/&gt;</span> Developer dashboard</NavLink>
    <NavLink class="nv__item" style="--accent:#00a4e4;--accent-bg:rgba(0,164,228,.18)" href="pipeline-monitor"><span class="nv__ico">→</span> Pipeline monitor</NavLink>

    <div class="nv__foot">
        <div class="nv__sec">Account</div>
        <NavLink class="nv__item" style="--accent:#6558b1;--accent-bg:rgba(101,88,177,.2)" href="contact"><span class="nv__ico">✉</span> Contact</NavLink>
        <NavLink class="nv__settings" href="settings"><span class="nv__ico">⚙</span> Settings</NavLink>
        <a class="nv__signout" href="sign-in">Sign out</a>
    </div>
</nav>
