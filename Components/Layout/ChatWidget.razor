@* TRU Ask — Learn · Ask · Grow style *@
@using IsaChatApp.Services
@implements IDisposable
@inject IJSRuntime JS
@inject HttpClient Http
@inject WidgetSettings Settings
@inject UsageLogService UsageLog
@inject IsaChatApp.Services.Orchestrator.Orchestrator Pipeline
@inject KeycloakSignInService SignInService
@inject IsaChatApp.Services.Onboarding.NotebookService Notebook
@inject IsaChatApp.Services.Onboarding.JourneyContextService JourneyContexts
@inject IsaChatApp.Services.Onboarding.ProgressService Progress

<div class="isa-widget">
    @if (ActiveDashboardUrl is not null)
    {
        <div class="isa-widget__dashboardHost">
            <button type="button" class="isa-widget__dashboardClose" @onclick="CloseDashboard" aria-label="Close">&times;</button>
            <iframe src="@ActiveDashboardUrl" class="isa-widget__dashboardFrame" title="Dashboard"></iframe>
        </div>
    }

    @if (!IsExpanded)
    {
        <button type="button" class="isa-widget__bubble" @onclick="Expand" aria-label="Open TRU Ask">
            <Throbber Spinning="false" SpinOnHover="true" />
        </button>
    }
    else
    {
        <div class="isa-widget__backdrop" @onclick="Collapse"></div>
        <div class="isa-widget__panel is-expanded">
            <div class="isa-widget__header">
                <div class="isa-widget__headerTop">
                    <div class="isa-widget__brand">
                        <span class="isa-widget__logoMark">TRU</span>
                        <div class="isa-widget__brandText">
                            <strong>TRU</strong>
                            <small>Learn · Ask · Grow</small>
                        </div>
                    </div>
                    <button type="button" class="isa-widget__close" @onclick="Collapse" aria-label="Close">&times;</button>
                </div>
                <p class="isa-widget__greet">Hi, Chapter Leader.</p>
                <p class="isa-widget__greetSub">How can TRU help you today?</p>
            </div>

            <div class="isa-widget__body">
                <div class="isa-widget__askBox">
                    <label class="isa-widget__attachBtn" title="Attach file" aria-label="Attach file">
                        <InputFile class="isa-widget__fileInput" OnChange="OnInputFiles" multiple
                                   accept=".pdf,.doc,.docx,.txt,.png,.jpg,.jpeg,.gif,.csv,.xlsx,.pptx"
                                   disabled="@IsSending" />
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48" />
                        </svg>
                    </label>
                    <input type="text"
                           placeholder="Ask anything about ISACA..."
                           aria-label="Ask TRU"
                           value="@DraftText"
                           @oninput="OnDraftInput"
                           @onkeydown="HandleKeyDown"
                           disabled="@IsSending" />
                    <button type="button" class="isa-widget__askSend" @onclick="Send"
                            disabled="@(IsSending || (string.IsNullOrWhiteSpace(DraftText) && _pendingFiles.Count == 0))"
                            aria-label="Send">
                        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 2L11 13" /><path d="M22 2L15 22L11 13L2 9L22 2Z" />
                        </svg>
                    </button>
                </div>

                @if (_pendingFiles.Count > 0)
                {
                    <div class="isa-widget__attachList">
                        @foreach (var f in _pendingFiles)
                        {
                            <span class="isa-widget__attachChip">
                                @f.Name
                                <button type="button" class="isa-widget__attachRemove" @onclick="() => RemovePending(f.Id)" disabled="@IsSending">×</button>
                            </span>
                        }
                    </div>
                }

                @if (Messages.Count == 0 && !IsSending)
                {
                    <p class="isa-widget__sectionLabel">Popular Topics</p>
                    <div class="isa-widget__topics">
                        <button type="button" class="isa-widget__topic" @onclick='() => QuickAsk("ISACA guidance for chapter officers")'>
                            <div class="isa-widget__topicIco">🛡</div>
                            <span>ISACA Guidance</span>
                        </button>
                        <button type="button" class="isa-widget__topic" @onclick='() => QuickAsk("Knowledge base articles")'>
                            <div class="isa-widget__topicIco">📚</div>
                            <span>Knowledge Base</span>
                        </button>
                        <button type="button" class="isa-widget__topic" @onclick='() => QuickAsk("Chapter analytics overview")'>
                            <div class="isa-widget__topicIco">📊</div>
                            <span>Chapter Analytics</span>
                        </button>
                        <button type="button" class="isa-widget__topic" @onclick='() => QuickAsk("How do I contact support?")'>
                            <div class="isa-widget__topicIco">🎧</div>
                            <span>Support Center</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="isa-widget__messages">
                        @foreach (var msg in Messages)
                        {
                            <div class="isa-widget__message isa-widget__message--@msg.Role">
                                <div class="isa-widget__who">@msg.DisplayName</div>
                                <div>@msg.Text</div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="isa-widget__footer">
                <span>Answers from approved documents</span>
                <a href="/contact">Contact Team</a>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Dictionary<string, string>? Hosts { get; set; }

    private bool IsExpanded;
    private bool IsSending;
    private string DraftText = "";
    private string? ActiveDashboardUrl;
    private readonly List<ChatEntry> Messages = new();

    private sealed class PendingFile
    {
        public string Id { get; init; } = Guid.NewGuid().ToString("N");
        public string Name { get; init; } = "";
        public long Size { get; init; }
        public byte[]? Bytes { get; init; }
    }
    private readonly List<PendingFile> _pendingFiles = new();
    private const long MaxAttachBytes = 8 * 1024 * 1024;
    private const int MaxAttachCount = 5;

    private void RemovePending(string id) => _pendingFiles.RemoveAll(f => f.Id == id);

    private async Task OnInputFiles(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles(MaxAttachCount))
        {
            if (_pendingFiles.Count >= MaxAttachCount) break;
            if (file.Size > MaxAttachBytes) continue;
            try
            {
                await using var stream = file.OpenReadStream(MaxAttachBytes);
                using var ms = new System.IO.MemoryStream();
                await stream.CopyToAsync(ms);
                _pendingFiles.Add(new PendingFile { Name = file.Name, Size = file.Size, Bytes = ms.ToArray() });
            }
            catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    private void Expand() => IsExpanded = true;
    private void Collapse() => IsExpanded = false;
    private void CloseDashboard() => ActiveDashboardUrl = null;

    private void OnDraftInput(ChangeEventArgs e) => DraftText = e.Value?.ToString() ?? "";

    private async Task QuickAsk(string q)
    {
        DraftText = q;
        await Send();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await Send();
    }

    private async Task Send()
    {
        var text = DraftText.Trim();
        if ((string.IsNullOrEmpty(text) && _pendingFiles.Count == 0) || IsSending) return;

        if (_pendingFiles.Count > 0)
        {
            var names = string.Join(", ", _pendingFiles.Select(f => f.Name));
            text = string.IsNullOrEmpty(text) ? $"[Attached: {names}]" : text + $"\n\n[Attached: {names}]";
            _pendingFiles.Clear();
        }

        DraftText = string.Empty;
        Messages.Add(new ChatEntry("you", "You", text));
        IsSending = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            try
            {
                var ctx = new IsaChatApp.Services.Orchestrator.QueryContext
                {
                    Question = text,
                    TraceId = Guid.NewGuid().ToString("N")
                };
                var resp = await Pipeline.RunAsync(ctx);
                Messages.Add(new ChatEntry("ai", "TRU Ask", resp.Message ?? "No answer produced."));
            }
            catch
            {
                Messages.Add(new ChatEntry("ai", "TRU Ask",
                    "I received your message. Start Ollama or check the pipeline host so full answers can run."));
            }
        }
        finally
        {
            IsSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose() { }

    private sealed record ChatEntry(string Role, string DisplayName, string Text);
}
